# ── Rhyno ERP - Docker Compose Environment Variables ──────────────────
#
# Instructions:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Replace all placeholder/default values with secure, real credentials.
#   3. Never commit .env to version control (Git).
#   4. Ensure ALL keys below are present before running `docker-compose up`.
#
# ─────────────────────────────────────────────────────────────────────

# ── ASP.NET Core Runtime ──────────────────────────────────────────────
# Production | Staging | Development
ASPNETCORE_ENVIRONMENT=Production
# Internal listen URLs inside the container (do not change unless ports change)
ASPNETCORE_URLS=http://+:8080

# ── SQL Server ────────────────────────────────────────────────────────
# SA password for the MSSQL container. Must meet SQL Server complexity
# requirements (min 8 chars, uppercase, lowercase, digit, special char).
DB_PASSWORD=ChangeThisPassword123!
MSSQL_SA_PASSWORD=${DB_PASSWORD}

# Connection strings injected into the app container.
# PlatformConnection points to the shared/tenant-registry database.
ConnectionStrings__PlatformConnection=Server=sqlserver,1433;Database=RhynoPlatformDb;User Id=sa;Password=${DB_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true
# DefaultConnection points to the default tenant database.
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=RhynoTenantDb;User Id=sa;Password=${DB_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true

# ── RabbitMQ (Message Broker) ─────────────────────────────────────────
RABBITMQ_USER=rhyno
RABBITMQ_PASS=ChangeThisPassword123!
# RabbitMQ hostname (use service name for Docker networking)
RabbitMQ__Host=rabbitmq
RabbitMQ__Username=${RABBITMQ_USER}
RabbitMQ__Password=${RABBITMQ_PASS}
# Optional: override virtual host, default is "/"
# RabbitMQ__VirtualHost=/
# Optional: enable TLS for AMQP connections
# RabbitMQ__UseSsl=false

# ── Redis (Cache & Session) ───────────────────────────────────────────
REDIS_PASSWORD=ChangeThisPassword123!
# Full Redis connection string (host:port,password=...,defaultDatabase=...)
Redis__ConnectionString=redis:6379,password=${REDIS_PASSWORD}

# ── Seq (Structured Logging Dashboard) ────────────────────────────────
# Admin password for the Seq web UI (first-run only).
SEQ_PASSWORD=ChangeThisPassword123!
# Seq ingestion & UI endpoint used by the app container.
Seq__ServerUrl=http://seq:5341
# If Seq requires an API key for ingestion, set it here.
# Seq__ApiKey=your-seq-api-key-here

# ── API Key Authentication ────────────────────────────────────────────
# Comma-separated or array of valid API keys for Swagger/external API access.
# The app reads ApiKeys__0, ApiKeys__1, … from environment.
API_KEY=ChangeThisApiKey123!
ApiKeys__0=${API_KEY}
# Additional API keys can be added as ApiKeys__1, ApiKeys__2, etc.
# ApiKeys__1=another-api-key-here

# ── Authentication & JWT (if applicable) ──────────────────────────────
# Secret key used for signing JWT tokens. Must be a long, random string.
# Jwt__SecretKey=ChangeThisToALongRandomStringAtLeast32Chars!
# Jwt__Issuer=rhyno-api
# Jwt__Audience=rhyno-client
# Jwt__AccessTokenExpirationMinutes=60
# Jwt__RefreshTokenExpirationDays=7

# ── OpenAI / AI Assistant (Optional) ───────────────────────────────────
# Provide your OpenAI API key to enable the AI assistant features.
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OpenAI__Model=gpt-4o-mini
# OpenAI__MaxTokens=4096

# ── Outbox Pattern ─────────────────────────────────────────────────────
# Outbox__BatchSize=20
# Outbox__PollIntervalSeconds=10
# Outbox__LockTimeoutSeconds=60
# Outbox__MaxRetryCount=15

# ── Audit Retention ────────────────────────────────────────────────────
# AuditRetention__Enabled=false
# AuditRetention__RetainDays=180
# AuditRetention__BatchSize=500
# AuditRetention__ArchivePath=logs/audit-archive

# ── Swagger ────────────────────────────────────────────────────────────
# Enable Swagger UI in non-Development environments.
# Swagger__Enabled=false

# ── Bootstrap ──────────────────────────────────────────────────────────
# Run database/bootstrap tasks automatically on startup.
# Bootstrap__RunOnStartup=false

# ── Connector / Integration Settings ───────────────────────────────────
# Connector__MaxRetryCount=3
# Connector__RetryDelaySeconds=5
# Connector__ExecutionTimeoutSeconds=30

# ── Tenant Defaults ────────────────────────────────────────────────────
# Tenancy__DefaultTenantId=default

# ── Email / SMTP (Optional) ────────────────────────────────────────────
# Email__SmtpHost=smtp.example.com
# Email__SmtpPort=587
# Email__SmtpUsername=noreply@example.com
# Email__SmtpPassword=ChangeThisPassword123!
# Email__FromAddress=noreply@rhyno.app
# Email__FromName=Rhyno ERP
# Email__EnableSsl=true