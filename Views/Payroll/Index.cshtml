@model PayrollHistoryIndexViewModel
@{
    ViewData["Title"] = "سوابق لیست حقوق";
    var quickActions = new List<OfficeAutomation.Models.FinancialQuickActionVM>
    {
        new() { Title = "ایجاد لیست", Description = "ساخت لیست حقوق جدید", Url = Url.Action("Create", "Payroll") ?? "#", Icon = "bi-plus-circle", Tone = "primary" },
        new() { Title = "هاب مالی", Description = "بازگشت به هاب مالی", Url = Url.Action("Dashboard", "Financial") ?? "#", Icon = "bi-speedometer2", Tone = "success" },
        new() { Title = "گزارش‌ها", Description = "ورود به گزارش‌ساز", Url = Url.Action("Index", "Reports") ?? "#", Icon = "bi-file-earmark-bar-graph", Tone = "warning" }
    };
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <!-- Header Card -->
    <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
        <div>
            <h1 class="m-0 text-sm font-black text-slate-900 dark:text-white tracking-tight">سوابق لیست حقوق و دستمزد</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">مرور لیست‌های ذخیره‌شده و وضعیت نهایی‌سازی</p>
        </div>
        <a asp-action="Create" class="flex items-center gap-1.5 px-2.5 h-8 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm no-underline self-start sm:self-auto">
            <i class="bi bi-plus-circle-fill"></i>
            <span>ایجاد لیست حقوق جدید</span>
        </a>
    </header>

    <!-- Quick Actions Panel -->
    <div class="shadow-sm border border-slate-200 dark:border-slate-800 rounded-lg p-2.5 bg-white dark:bg-slate-900">
        <partial name="_QuickActionsGrid" model="quickActions" />
    </div>

    <!-- Status Info Section -->
    <div class="flex flex-col gap-2 p-2.5 bg-slate-50 dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 rounded-lg text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
        <div class="flex flex-wrap gap-2 items-center">
            <span class="font-bold text-slate-700 dark:text-slate-300">وضعیت‌های لیست:</span>
            <span>پیش‌نویس</span>
            <span class="text-slate-300 dark:text-slate-700">|</span>
            <span>محاسبه‌شده</span>
            <span class="text-slate-300 dark:text-slate-700">|</span>
            <span>بررسی‌شده</span>
            <span class="text-slate-300 dark:text-slate-700">|</span>
            <span>نهایی‌شده</span>
            <span class="text-slate-300 dark:text-slate-700">|</span>
            <span>پرداخت‌شده</span>
            <span class="text-slate-300 dark:text-slate-700">|</span>
            <span>بازگشایی‌شده</span>
        </div>
        <div class="font-semibold text-teal-600 dark:text-teal-400">برای مقایسه ماه جاری، وارد ایجاد یا جزئیات شوید.</div>
    </div>

    <!-- Data Table Card Grid -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-xs text-right border-collapse" >
                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " ead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold" >سال</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold" >ماه</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-left" >جمع حقوق پایه</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-left" >جمع بیمه</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-left" >جمع خالص پرداختی</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-center" >وضعیت</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-center w-1" >عملیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                    @if (Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            var isPaid = item.Status == "Paid";
                            var isPending = item.Status == "Pending" || item.Status == "Approved" || (!item.IsFinalized && item.Status == "Calculated");
                            
                            var statusLabel = item.IsFinalized ? "نهایی‌شده" : (isPaid ? "پرداخت‌شده" : "پیش‌نویس");
                            var statusBadgeClass = item.IsFinalized
                                ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200/40"
                                : (isPaid ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200/40"
                                : (isPending ? "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200/40"
                                : "bg-slate-100 text-slate-700 dark:bg-slate-800/40 dark:text-slate-400 border-slate-200/40"));

                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 font-mono font-semibold text-slate-900 dark:text-white" >@item.Year</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 font-bold text-slate-800 dark:text-slate-200" >@item.Month</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 text-left font-mono tabular-nums text-slate-600 dark:text-slate-400" >@item.TotalBaseSalary.ToString("N0")</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 text-left font-mono tabular-nums text-slate-500" >@item.TotalInsurance.ToString("N0")</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 text-left font-mono tabular-nums font-bold text-slate-900 dark:text-white" >@item.TotalNetPayable.ToString("N0")</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 text-center" >
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border @statusBadgeClass">
                                        @statusLabel
                                    </span>
                                </td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 text-center w-1" >
                                    <div class="flex items-center justify-center gap-1.5">
                                        @if (item.IsFinalized)
                                        {
                                            <a asp-action="Details" asp-route-id="@item.Id" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition" title="مشاهده ریز فیش">
                                                <i class="bi bi-eye text-sm"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="p-1 text-slate-500 hover:text-amber-600 dark:text-slate-400 dark:hover:text-amber-400 transition" title="ویرایش">
                                                <i class="bi bi-pencil-square text-sm"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 "  colspan="7" class="px-3 py-8 text-center text-slate-400">
                                <partial name="_EmptyState" model='new { Icon = "bi-receipt", Title = "هنوز لیست حقوقی ثبت نشده است.", Description = "اولین لیست را از بخش ایجاد بسازید." }' />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
