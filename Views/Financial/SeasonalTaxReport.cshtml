@model SeasonalTaxReportVM
@{
    ViewData["Title"] = "گزارش معاملات فصلی";
    var missingNationalIdCount = Model.Rows.Count(item => string.IsNullOrWhiteSpace(item.NationalId));
}

<div class="container-fluid py-3" dir="rtl">
    <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between mb-2.5">
        <div>
            <h1 class="text-base font-black text-slate-900 dark:text-white">گزارش معاملات فصلی</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">نمای حسابرسی و آماده برای تصمیم‌گیری</p>
        </div>
        <div class="flex gap-2 flex-wrap">
            <a asp-action="SeasonalTaxReport" asp-route-year="@Model.Year" asp-route-quarter="1" class="inline-flex items-center gap-1 px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-300 no-underline transition shadow-sm">بهار</a>
            <a asp-action="SeasonalTaxReport" asp-route-year="@Model.Year" asp-route-quarter="2" class="inline-flex items-center gap-1 px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-300 no-underline transition shadow-sm">تابستان</a>
            <a asp-action="SeasonalTaxReport" asp-route-year="@Model.Year" asp-route-quarter="3" class="inline-flex items-center gap-1 px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-300 no-underline transition shadow-sm">پاییز</a>
            <a asp-action="SeasonalTaxReport" asp-route-year="@Model.Year" asp-route-quarter="4" class="inline-flex items-center gap-1 px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-300 no-underline transition shadow-sm">زمستان</a>
            <a asp-action="ExportInvoicesExcel" asp-route-year="@Model.Year" asp-route-quarter="@Model.Quarter" class="inline-flex items-center gap-1 px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg text-xs font-bold text-emerald-600 dark:text-emerald-400 no-underline transition shadow-sm">
                <i class="bi bi-file-earmark-excel"></i>خروجی اکسل
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-3">
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-4">
            <div class="text-muted text-[11px] text-slate-500 dark:text-slate-400">جمع مبلغ</div>
            <div class="text-lg font-black text-slate-900 dark:text-white font-mono tabular-nums mt-1">@Model.TotalAmount.ToString("N0")</div>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-4">
            <div class="text-muted text-[11px] text-slate-500 dark:text-slate-400">جمع مالیات</div>
            <div class="text-lg font-black text-slate-900 dark:text-white font-mono tabular-nums mt-1">@Model.TotalVat.ToString("N0")</div>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-4">
            <div class="text-muted text-[11px] text-slate-500 dark:text-slate-400">ردیف‌های ناقص</div>
            <div class="text-lg font-black font-mono tabular-nums mt-1 @(missingNationalIdCount > 0 ? "text-amber-600 dark:text-amber-400" : "text-emerald-600 dark:text-emerald-400")">@missingNationalIdCount</div>
        </div>
    </div>

    @if (missingNationalIdCount > 0)
    {
        <div class="rounded-lg border border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/30 px-3.5 py-2.5 text-[11px] text-amber-700 dark:text-amber-300 mb-3">
            <strong>هشدار:</strong> این گزارش برای ارسال نهایی هنوز کامل نیست. ردیف‌های بدون شناسه ملی / اقتصادی باید تکمیل شوند.
        </div>
    }

    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-4 overflow-x-auto">
        <div class="overflow-x-auto">
            <table class="w-full text-xs text-right border-collapse">
                <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-300 text-xs font-bold border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">نام خریدار/فروشنده</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">شناسه</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">نوع معامله</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">مبلغ</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">VAT</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">تاریخ</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Rows.Any())
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="@(string.IsNullOrWhiteSpace(row.NationalId) ? "bg-amber-50/40 dark:bg-amber-950/10" : "")">
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50">@row.PartyName</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50">@(row.NationalId ?? "-")</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50">
                                <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold @(row.TransactionType == "فروش" ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400" : "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400")">@row.TransactionType</span>
                            </td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-mono tabular-nums">@row.Amount.ToString("N0")</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-mono tabular-nums">@row.Vat.ToString("N0")</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-mono tabular-nums">@row.DateShamsi</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center text-slate-400 py-3" colspan="6">در حال حاضر داده‌ای برای نمایش وجود ندارد.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>