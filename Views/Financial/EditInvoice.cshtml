@model FinancialInvoiceUpsertVM
@{
    ViewData["Title"] = "ویرایش فاکتور خرید/فروش";
    var backAction = ViewBag.BackToListAction as string ?? "Sales";
}

<div class="container-fluid py-3">
    <h6 class="fw-bold mb-2.5">ویرایش فاکتور خرید/فروش</h6>
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-4 overflow-x-auto " >
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-4 overflow-x-auto -body p-2" >
            <form asp-action="EditInvoice" asp-route-id="@Model.Id" method="post" id="invoiceForm">
                @Html.AntiForgeryToken()
                <input class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="row g-2 mb-3 small">
                    <div class="col-md-2">
                        <label asp-for="InvoiceNumber" class="form-label small"></label>
                        <input asp-for="InvoiceNumber" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" />
                        <div id="invoiceNumberHint" class="small text-danger mt-1 d-none"></div>
                    </div>
                    <div class="col-md-2"><label asp-for="InvoiceType" class="form-label small"></label><select asp-for="InvoiceType" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none"><option value="Sale">فروش</option><option value="Purchase">خرید</option></select></div>
                    <div class="col-md-2"><label asp-for="DateShamsi" class="form-label small"></label><input asp-for="DateShamsi" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" /></div>
                    <div class="col-md-3">
                        <label asp-for="EmployerId" class="form-label small sale-only d-none"></label>
                        <select asp-for="EmployerId" asp-items="Model.EmployerOptions" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none">
                            <option value="">انتخاب کارفرما</option>
                        </select>
                        <label asp-for="PartyName" class="form-label small purchase-only d-none"></label>
                        <input asp-for="PartyName" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" />
                    </div>
                    <div class="col-md-3"><label asp-for="NationalCodeOrEconomicId" class="form-label small"></label><input asp-for="NationalCodeOrEconomicId" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" /></div>
                    <div class="col-md-4 purchase-only d-none"><label asp-for="WarehouseReceiptId" class="form-label small"></label><select asp-for="WarehouseReceiptId" asp-items="Model.WarehouseReceiptOptions" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none"><option value="">انتخاب رسید انبار</option></select></div>
                    <div class="col-md-4 purchase-only d-none"><label asp-for="FollowUpEmployeeId" class="form-label small"></label><select asp-for="FollowUpEmployeeId" asp-items="Model.FollowUpEmployeeOptions" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none"><option value="">انتخاب مسئول پیگیری</option></select></div>
                    <div class="col-md-4 purchase-only d-none"><label asp-for="DeadlineDateShamsi" class="form-label small"></label><input asp-for="DeadlineDateShamsi" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="1405/12/29" /></div>
                    <div class="col-12"><label asp-for="Notes" class="form-label small"></label><textarea asp-for="Notes" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" rows="2"></textarea></div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="small fw-bold mb-0">اقلام فاکتور</h6>
                    <button type="button" id="addInvoiceRow" class="btn btn-sm btn-outline-secondary">+ افزودن ردیف</button>
                </div>

                <div class="table-responsive">
                    <table class="w-full text-xs text-right border-collapse"   id="invoiceItemsTable">
                        <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-300 text-xs font-bold border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >کالا</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >شرح آیتم</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >تعداد</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >فی</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >جمع جزء</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >VAT 10%</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >جمع کل</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold "  ></th>
                            </tr>
                        </thead>
                        <tbody id="invoiceItemsBody"></tbody>
                    </table>
                </div>

                <div class="row g-2 mt-2 small">
                    <div class="col-md-4"><label asp-for="SubTotal" class="form-label small"></label><input asp-for="SubTotal" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" readonly /></div>
                    <div class="col-md-4"><label asp-for="VatAmount" class="form-label small"></label><input asp-for="VatAmount" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" readonly /></div>
                    <div class="col-md-4"><label asp-for="GrandTotal" class="form-label small"></label><input asp-for="GrandTotal" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" readonly /></div>
                </div>

                <div class="alert alert-light border small mb-3" id="invoicePreviewPanel">پیش‌نمایش فاکتور بعد از تکمیل فرم در همین‌جا نمایش داده می‌شود.</div>

                <div class="d-flex gap-2 mt-3">
                    <button type="button" id="previewInvoiceButton" class="btn btn-sm btn-outline-primary">پیش‌نمایش</button>
                    <button type="submit" id="submitInvoiceButton" class="btn btn-sm btn-success">ذخیره تغییرات</button>
                    <a asp-action="@backAction" class="btn btn-sm btn-outline-secondary">بازگشت</a>
                </div>
            </form>
        </div>
    </div>
</div>

<template id="invoiceRowTemplate">
    <tr>
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >
            <select data-field="ProductId" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none">
                <option value="">-</option>
                @foreach (var item in Model.ProductOptions)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
        </td>
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  ><input data-field="ItemName" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" /></td>
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  ><input type="number" data-field="Quantity" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" min="0.001" step="0.001" /></td>
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  ><input type="number" data-field="UnitPrice" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" min="0" step="0.01" /></td>
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  ><input type="number" data-field="LineSubTotal" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" readonly /></td>
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  ><input type="number" data-field="LineVatAmount" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" readonly /></td>
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  ><input type="number" data-field="LineGrandTotal" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" readonly /></td>
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 text-center"  ><button type="button" class="btn btn-sm btn-outline-danger removeRow">حذف</button></td>
    </tr>
</template>

@section Scripts {
    <script id="invoiceEditData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            currentInvoiceId = Model.Id?.ToString() ?? "",
            checkUrl = Url.Action("CheckInvoiceNumber", "Financial"),
            receiptItemsUrl = Url.Action("GetReceiptItemsJson", "Financial"),
            items = Model.Items ?? new List<FinancialInvoiceItemVM>()
        }))</script>
    <script src="~/js/financial-edit-invoice-script.js" asp-append-version="true"></script>
}

