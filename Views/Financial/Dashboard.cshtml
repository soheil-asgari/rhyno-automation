@model FinancialDashboardVM
@{
    ViewData["Title"] = "داشبورد مالی";
    var year = ViewBag.Year as int? ?? DateTime.Now.Year;
}

<div class="container-fluid py-1 space-y-1.5" dir="rtl">
    <div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between px-1">
        <div>
            <h1 class="text-[13px] font-black text-slate-900 dark:text-white">داشبورد مالی</h1>
            <p class="text-[9px] text-slate-500 dark:text-slate-400 mt-0.5">نمای عملیاتی فروش، خرید، مالیات، معاملات فصلی، حقوق و بیمه</p>
        </div>
        <form method="get" class="flex items-center gap-1.5 flex-wrap">
            <span class="text-[9px] text-slate-500 dark:text-slate-400">سال</span>
            <input name="year" value="@year" type="number" min="1300" max="1700" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded px-2 py-0.5 text-[11px] focus:ring-teal-500/20 focus:border-teal-500 outline-none" />
            <button class="h-6 rounded bg-teal-600 px-2 text-[10px] font-black text-white shadow-sm transition hover:bg-teal-700">اعمال</button>
        </form>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
        <!-- Monthly Sales -->
        <div class="bg-white dark:bg-slate-900 rounded shadow-sm border border-slate-200 dark:border-slate-800 p-2 flex flex-col justify-between">
            <div>
                <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400">فروش ماه</span>
                <h3 class="text-[11px] font-black text-emerald-600 dark:text-emerald-400 mt-0.5 font-mono tabular-nums">@Model.MonthlySalesTotal.ToString("N0")</h3>
            </div>
            <p class="text-[8px] text-slate-400 dark:text-slate-500 mt-0.5">جمع فروش ثبت‌شده</p>
        </div>

        <!-- Monthly Purchase -->
        <div class="bg-white dark:bg-slate-900 rounded shadow-sm border border-slate-200 dark:border-slate-800 p-2 flex flex-col justify-between">
            <div>
                <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400">خرید ماه</span>
                <h3 class="text-[11px] font-black text-rose-600 dark:text-rose-400 mt-0.5 font-mono tabular-nums">@Model.MonthlyPurchaseTotal.ToString("N0")</h3>
            </div>
            <p class="text-[8px] text-slate-400 dark:text-slate-500 mt-0.5">جمع خرید ثبت‌شده</p>
        </div>

        <!-- Tax Payable -->
        <div class="bg-white dark:bg-slate-900 rounded shadow-sm border border-slate-200 dark:border-slate-800 p-2 flex flex-col justify-between">
            <div>
                <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400">مالیات پرداختنی</span>
                <h3 class="text-[11px] font-black text-amber-600 dark:text-amber-400 mt-0.5 font-mono tabular-nums">@Model.MonthlyTaxPayable.ToString("N0")</h3>
            </div>
            <p class="text-[8px] text-slate-400 dark:text-slate-500 mt-0.5">خروجی نهایی کنترل مالیات</p>
        </div>

        <!-- Overdue Invoices -->
        <div class="bg-white dark:bg-slate-900 rounded shadow-sm border border-slate-200 dark:border-slate-800 p-2 flex flex-col justify-between">
            <div>
                <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400">فاکتور معوق</span>
                <h3 class="text-[11px] font-black text-sky-600 dark:text-sky-400 mt-0.5 font-mono tabular-nums">@Model.OverdueInvoices.ToString("N0")</h3>
            </div>
            <p class="text-[8px] text-slate-400 dark:text-slate-500 mt-0.5">نیازمند پیگیری فوری</p>
        </div>

        <!-- Dynamic KPIs -->
        @foreach (var kpi in Model.HubKpis)
        {
            var toneColor = kpi.Tone switch {
                "success" => "text-emerald-600 dark:text-emerald-400",
                "danger" => "text-rose-600 dark:text-rose-400",
                "warning" => "text-amber-600 dark:text-amber-400",
                "info" => "text-sky-600 dark:text-sky-400",
                _ => "text-slate-900 dark:text-white"
            };
            <div class="bg-white dark:bg-slate-900 rounded shadow-sm border border-slate-200 dark:border-slate-800 p-2 flex flex-col justify-between">
                <div>
                    <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400">@kpi.Title</span>
                    <h3 class="text-[11px] font-black @toneColor mt-0.5 font-mono tabular-nums">@kpi.Value</h3>
                </div>
                <p class="text-[8px] text-slate-400 dark:text-slate-500 mt-0.5">@kpi.Description</p>
            </div>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-2">
        <!-- Chart Shell -->
        <div class="lg:col-span-2 bg-white dark:bg-slate-900 rounded shadow-sm border border-slate-200 dark:border-slate-800 p-2 flex flex-col justify-between">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
                <div>
                    <h2 class="text-[11px] font-black text-slate-900 dark:text-white">روند مالی</h2>
                    <p class="text-[9px] text-slate-500 dark:text-slate-400 mt-0.5">درآمد، هزینه و سود یا زیان در دوازده ماه</p>
                </div>
                <div class="flex flex-wrap gap-1">
                    <a asp-action="Sales" class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800 no-underline">فروش</a>
                    <a asp-action="Purchases" class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800 no-underline">خرید</a>
                    <a asp-action="VatDashboard" class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800 no-underline">ارزش افزوده</a>
                    <a asp-action="SeasonalTax" class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800 no-underline">معاملات فصلی</a>
                </div>
            </div>

            <div class="flex gap-1 mb-2 flex-wrap">
                <button type="button" class="rounded bg-teal-600 px-2 py-0.5 text-[10px] font-black text-white hover:bg-teal-700 chart-mode is-active" data-mode="bar">نمودار ستونی</button>
                <button type="button" class="rounded border border-slate-200 bg-white px-2 py-0.5 text-[10px] font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 chart-mode" data-mode="line">نمودار خطی</button>
                <button type="button" class="rounded border border-slate-200 bg-white px-2 py-0.5 text-[10px] font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 chart-mode" data-mode="area">نمودار ناحیه‌ای</button>
            </div>

            @if (Model.ValidationWarnings > 0 || Model.OverdueInvoices > 0)
            {
                <div class="flex flex-col gap-1 rounded border border-amber-200 bg-amber-50 px-2 py-1.5 text-[10px] text-amber-700 dark:border-amber-700/40 dark:bg-amber-950/20 dark:text-amber-400 mb-2">
                    @if (Model.ValidationWarnings > 0)
                    {
                        <div>@Model.ValidationWarnings مورد نیازمند بررسی ثبت شده است.</div>
                    }
                    @if (Model.OverdueInvoices > 0)
                    {
                        <div>@Model.OverdueInvoices فاکتور معوق شناسایی شد.</div>
                    }
                </div>
            }

            <div class="h-56 w-full relative">
                <canvas id="finHubChart"></canvas>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white dark:bg-slate-900 rounded shadow-sm border border-slate-200 dark:border-slate-800 p-2 flex flex-col">
            <h2 class="text-[11px] font-black text-slate-900 dark:text-white mb-2">دسترسی سریع</h2>
            <div class="flex-1">
                <partial name="_QuickActionsGrid" model="Model.QuickActions" />
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-2">
        <!-- Recent Activities -->
        <div class="lg:col-span-3 bg-white dark:bg-slate-900 rounded shadow-sm border border-slate-200 dark:border-slate-800 p-2">
            <div class="flex items-center justify-between mb-2">
                <h2 class="text-[11px] font-black text-slate-900 dark:text-white">آخرین عملیات</h2>
                <a asp-action="Invoices" class="text-[10px] font-bold text-teal-600 hover:text-teal-700 dark:text-teal-400 no-underline">مشاهده همه</a>
            </div>
            <div class="divide-y divide-slate-100 dark:divide-slate-800/60">
                @if (Model.RecentActivities.Any())
                {
                    @foreach (var item in Model.RecentActivities)
                    {
                        <a href="@item.Url" class="flex items-center justify-between py-1.5 text-decoration-none group">
                            <div class="min-w-0">
                                <strong class="block truncate text-[10px] text-slate-800 group-hover:text-teal-600 dark:text-slate-200 dark:group-hover:text-teal-400">@item.Title</strong>
                                <span class="block text-[8px] text-slate-400 dark:text-slate-500 mt-0.5">@item.Subtitle</span>
                            </div>
                            <span class="inline-flex items-center rounded bg-slate-50 px-1.5 py-0.5 text-[8px] font-bold text-slate-600 dark:bg-slate-950 dark:text-slate-400 border border-slate-200/50 dark:border-slate-800">@item.Badge</span>
                        </a>
                    }
                }
                else
                {
                    <div class="text-slate-400 text-[10px] py-2 text-center">عملیات اخیر وجود ندارد.</div>
                }
            </div>
        </div>

        <!-- Warnings and Alerting -->
        <div class="lg:col-span-2 bg-white dark:bg-slate-900 rounded shadow-sm border border-slate-200 dark:border-slate-800 p-2 flex flex-col justify-between">
            <div>
                <h2 class="text-[11px] font-black text-slate-900 dark:text-white mb-2">هشدارهای عملیاتی</h2>
                <div class="space-y-1.5">
                    <div class="rounded border border-amber-200 bg-amber-50 px-2 py-1.5 text-[10px] text-amber-700 dark:border-amber-700/30 dark:bg-amber-950/20 dark:text-amber-400">
                        <strong class="block font-black">فاکتورهای در انتظار</strong>
                        <span class="block mt-0.5 text-[9px]">@Model.PendingSalesInvoices فاکتور فروش و @Model.PendingPurchaseInvoices فاکتور خرید نیاز به پیگیری دارند.</span>
                    </div>
                    <div class="rounded border border-rose-200 bg-rose-50 px-2 py-1.5 text-[10px] text-rose-700 dark:border-rose-700/30 dark:bg-rose-950/20 dark:text-rose-400">
                        <strong class="block font-black">هشدار اعتبارسنجی</strong>
                        <span class="block mt-0.5 text-[9px]">@Model.ValidationWarnings رکورد ناقص یا مشکوک شناسایی شده است.</span>
                    </div>
                    <div class="rounded border border-sky-200 bg-sky-50 px-2 py-1.5 text-[10px] text-sky-700 dark:border-sky-700/30 dark:bg-sky-950/20 dark:text-sky-400">
                        <strong class="block font-black">سررسید نزدیک</strong>
                        <span class="block mt-0.5 text-[9px]">@Model.DuePurchaseDeadlines فاکتور خرید دارای موعد نزدیک است.</span>
                    </div>
                </div>
            </div>
            <div class="mt-2">
                <a asp-action="ReportingHub" class="flex items-center justify-center h-6 w-full rounded bg-teal-600 text-[10px] font-black text-white shadow-sm transition hover:bg-teal-700 no-underline">رفتن به گزارش‌های پیشرفته</a>
            </div>
        </div>
    </div>
</div>

@section Styles {
}

@section Scripts {
    <script id="finDashboardData" type="application/json">@Html.Raw(Json.Serialize(new {
            labels = Model.MonthLabels,
            revenue = Model.RevenueSeries,
            costs = Model.CostSeries,
            profit = Model.ProfitSeries
        }))</script>
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/financial-dashboard-script.js" asp-append-version="true"></script>
}
