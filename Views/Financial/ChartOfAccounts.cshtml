@{
    ViewData["Title"] = "سرفصل حساب‌ها";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>سرفصل حساب‌ها</title>
    <link href="~/lib/vazirmatn/Vazirmatn-font-face.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="~/css/financial-chart-of-accounts-style.css" asp-append-version="true" />
</head>
<body>
    <div class="coa-shell">
        <!-- Tree / List Panel -->
        <div class="coa-panel coa-tree-panel">
            <div class="coa-toolbar">
                <h2>سرفصل حساب‌ها</h2>
                <div class="coa-search">
                    <input type="text" id="coaSearch" placeholder="جستجوی کد یا نام..." autocomplete="off" />
                </div>
                <div class="coa-view-toggle">
                    <button class="coa-view-btn active" id="btnTreeView" onclick="setView('tree')">درختی</button>
                    <button class="coa-view-btn" id="btnListView" onclick="setView('list')">لیستی</button>
                </div>
                <button class="coa-btn coa-btn-primary" onclick="openAddModal(null, 'group')">+ گروه</button>
            </div>
            <div class="coa-tree-container" id="coaTreeView"></div>
            <div class="coa-tree-container" id="coaListView" style="display:none;"></div>
        </div>

        <!-- Detail Panel -->
        <div class="coa-panel coa-detail-panel">
            <div class="coa-detail-header">
                <h3 id="detailTitle">جزئیات حساب</h3>
                <button class="coa-btn coa-btn-sm" id="btnEditAccount" style="display:none" onclick="openEditModal()">ویرایش</button>
                <button class="coa-btn coa-btn-sm coa-btn-primary" id="btnAddChild" style="display:none" onclick="openAddChildModal()">+ زیرمجموعه</button>
            </div>
            <div class="coa-detail-body" id="detailBody">
                <div class="coa-detail-empty">یک حساب را از لیست انتخاب کنید</div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="coa-modal-overlay" id="accountModal">
        <div class="coa-modal">
            <div class="coa-modal-header">
                <span id="modalTitle">افزودن حساب</span>
                <button class="coa-modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="coa-modal-body">
                <input type="hidden" id="modalAccountId" />
                <input type="hidden" id="modalLevel" />
                <input type="hidden" id="modalParentId" />
                <div class="coa-form-group" id="modalCodeGroup">
                    <label>کد حساب *</label>
                    <input type="text" id="modalCode" maxlength="20" />
                    <div class="coa-validation-error" id="modalCodeError"></div>
                </div>
                <div class="coa-form-group">
                    <label>نام حساب *</label>
                    <input type="text" id="modalName" maxlength="200" />
                </div>
                <div class="coa-form-row">
                    <div class="coa-form-group">
                        <label>ماهیت</label>
                        <select id="modalNature">
                            <option value="">انتخاب...</option>
                            <option value="Debit">بدهکار (Debit)</option>
                            <option value="Credit">بستانکار (Credit)</option>
                            <option value="NoControl">بدون کنترل</option>
                        </select>
                    </div>
                    <div class="coa-form-group" id="modalActiveGroup">
                        <label>فعال</label>
                        <select id="modalIsActive">
                            <option value="true">فعال</option>
                            <option value="false">غیرفعال</option>
                        </select>
                    </div>
                </div>
                <div class="coa-form-row" id="modalSubFields" style="display:none">
                    <div class="coa-form-group">
                        <label>موقت</label>
                        <select id="modalIsTemporary">
                            <option value="false">خیر</option>
                            <option value="true">بله</option>
                        </select>
                    </div>
                    <div class="coa-form-group">
                        <label>تفصیلی شناور</label>
                        <select id="modalAllowsFloating">
                            <option value="true">بله</option>
                            <option value="false">خیر</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="coa-modal-footer">
                <button class="coa-btn coa-btn-primary" onclick="submitAccount()">ذخیره</button>
                <button class="coa-btn" onclick="closeModal()">انصراف</button>
            </div>
        </div>
    </div>

    <script src="~/js/financial-chart-of-accounts-script.js" asp-append-version="true"></script>
</body>
</html>