@model TrialBalancePageVM
@using System.Text.Json
@{
    ViewData["Title"] = "تراز آزمایشی انترپرایز";
    var reportIssuer = User?.Identity?.Name ?? "کاربر سیستم";
}

<div class="trial-balance-page" dir="rtl">
    <section class="print-header-block" aria-hidden="true">
        <div class="print-header-col print-header-company">
            <strong>اتوماسیون اداری و مالی راینو</strong>
            <span>گزارش تراز آزمایشی اسناد دفتر کل</span>
        </div>
        <div class="print-header-col print-header-period">
            <strong>بازه گزارش</strong>
            <span id="printPeriodLabel"></span>
        </div>
        <div class="print-header-col print-header-meta">
            <strong id="printGeneratedAt"></strong>
            <span id="printReportCode"></span>
            <span>صادرکننده: @reportIssuer</span>
            <span class="print-page-number"></span>
        </div>
    </section>

    <header class="trial-balance-head">
        <div class="trial-balance-heading">
            <h1>تراز آزمایشی انترپرایز</h1>
            <div class="trial-balance-meta">
                <span id="trialBalancePeriodName">@Model.Report.FiscalPeriodName</span>
                <span class="trial-balance-meta-separator">|</span>
                <span id="trialBalancePeriodRange"></span>
            </div>
        </div>
        <div class="trial-balance-status" id="trialBalanceStatus" aria-live="polite">
            آماده نمایش
        </div>
    </header>

    <form id="trialBalanceForm"
          class="trial-balance-toolbar"
          method="get"
          asp-controller="Financial"
          asp-action="GetTrialBalance"
          data-json-url="@Url.Action("GetTrialBalance", "Financial")">
        <div class="tb-toolbar-section tb-toolbar-filters">
            <div class="tb-toolbar-group tb-period-group">
                <label for="fiscalPeriodId">دوره مالی</label>
                <select id="fiscalPeriodId"
                        name="fiscalPeriodId"
                        class="form-select form-select-sm tb-control"
                        asp-items="Model.FiscalPeriodOptions"></select>
            </div>

            <label class="tb-toggle" for="includeMoatagh">
                <input id="includeMoatagh" name="includeMoatagh" type="checkbox" value="true" checked="@Model.IncludeMoatagh" />
                <span class="tb-toggle-track"></span>
                <span class="tb-toggle-label">شامل اسناد موقت</span>
            </label>

            <label class="tb-toggle" for="groupByFloatingDetail">
                <input id="groupByFloatingDetail" name="groupByFloatingDetail" type="checkbox" value="true" checked="@Model.GroupByFloatingDetail" />
                <span class="tb-toggle-track"></span>
                <span class="tb-toggle-label">تفکیک تفصیلی شناور</span>
            </label>

            <label class="tb-check-filter" for="nonZeroOnly">
                <input id="nonZeroOnly" type="checkbox" />
                <span>فقط حساب‌های دارای مانده</span>
            </label>
        </div>

        <input type="hidden" id="sixColumnField" name="sixColumn" value="@Model.SixColumn.ToString().ToLowerInvariant()" />

        <div class="tb-toolbar-section tb-toolbar-actions">
            <button type="submit" class="tb-toolbar-link tb-toolbar-button tb-refresh-button" title="به‌روزرسانی سیستم">
                <i class="bi bi-arrow-clockwise"></i>
                <span>به‌روزرسانی سیستم</span>
            </button>

            <div class="tb-mode-toggle" role="group" aria-label="نوع نمایش">
                <button type="button" class="tb-mode-button @(!Model.SixColumn ? "is-active" : "")" data-six-column="false">۴ ستونی</button>
                <button type="button" class="tb-mode-button @(Model.SixColumn ? "is-active" : "")" data-six-column="true">۶ ستونی</button>
            </div>

            <button id="trialBalancePrintButton" type="button" class="tb-toolbar-link tb-toolbar-button" title="چاپ">
                <i class="bi bi-printer"></i>
                <span>چاپ</span>
            </button>

            <a id="trialBalanceJsonLink"
               class="tb-toolbar-link"
               asp-controller="Financial"
               asp-action="GetTrialBalance"
               asp-route-fiscalPeriodId="@Model.FiscalPeriodId"
               asp-route-includeMoatagh="@Model.IncludeMoatagh"
               asp-route-groupByFloatingDetail="@Model.GroupByFloatingDetail"
               asp-route-sixColumn="@Model.SixColumn"
               asp-route-format="json">JSON</a>
        </div>
    </form>

    <section class="trial-balance-matrix">
        <div class="trial-balance-grid-wrap" id="trialBalanceGridWrap">
            <table class="trial-balance-grid" id="trialBalanceGrid">
                <thead id="trialBalanceHead"></thead>
                <tbody id="trialBalanceBody"></tbody>
                <tfoot id="trialBalanceFoot"></tfoot>
            </table>
        </div>
    </section>

    <section class="print-signatures-block" aria-hidden="true">
        <div class="print-signature-cell">
            <strong>تنظیم کننده</strong>
            <span>نام و امضا</span>
        </div>
        <div class="print-signature-cell">
            <strong>رئیس حسابداری</strong>
            <span>نام و امضا</span>
        </div>
        <div class="print-signature-cell">
            <strong>مدیر مالی</strong>
            <span>نام و امضا</span>
        </div>
        <div class="print-signature-cell">
            <strong>مدیر عامل</strong>
            <span>نام و امضا</span>
        </div>
    </section>
</div>

<script id="trialBalanceInitialState" type="application/json">
@Html.Raw(JsonSerializer.Serialize(new
{
    fiscalPeriodId = Model.FiscalPeriodId,
    includeMoatagh = Model.IncludeMoatagh,
    groupByFloatingDetail = Model.GroupByFloatingDetail,
    sixColumn = Model.SixColumn,
    report = Model.Report
}))
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/trial-balance.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/trial-balance.js" asp-append-version="true"></script>
}
