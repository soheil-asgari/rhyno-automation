@model WarehouseReceipt
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>Warehouse Receipt Print</title>
    <style>
        body { font-family: Tahoma, sans-serif; margin: 24px; color: #111827; direction: rtl; }
        .print-title-sm { font-size: 20px; font-weight: bold; margin-bottom: 10px; }
        .meta { font-size: 13px; color: #4b5563; margin-bottom: 6px; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; font-size: 13px; }
        th, td { border: 1px solid #d1d5db; padding: 8px 10px; text-align: right; }
        th { background: #f3f4f6; font-weight: bold; }
    </style>
</head>
<body>
    <h3 class="print-title-sm">رسید انبار</h3>
    <div class="meta">شماره: @Model.ReceiptNumber | تاریخ: @Model.DateShamsi</div>
    <div class="meta">انبار: @Model.Warehouse.Name | منبع: @Model.SupplierOrSource</div>

    <table>
        <thead>
            <tr><th>کالا</th><th>تعداد</th><th>فی واحد</th><th>جمع</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity.ToString("N3")</td>
                <td>@item.UnitPrice.ToString("N0")</td>
                <td>@(item.Quantity * item.UnitPrice).ToString("N0")</td>
            </tr>
        }
        </tbody>
    </table>
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                window.print();
                window.close();
            }, 250);
        });
    </script>
</body>
</html>
