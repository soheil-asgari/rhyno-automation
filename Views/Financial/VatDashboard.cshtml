@model FinancialDashboardVM
@{
    ViewData["Title"] = "داشبورد مالیات بر ارزش افزوده";
    var year = ViewBag.Year as int? ?? DateTime.Now.Year;
    var vatGap = Math.Abs(Model.VatReconciliationDifference);
    var hasMismatch = vatGap > 0 || Model.VatMismatchInvoices > 0;
}

@section Styles {
}

<div class="container-fluid py-2 space-y-2" dir="rtl">
    <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between px-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-lg shadow-sm">
        <div>
            <h1 class="text-[16px] font-black text-slate-900 dark:text-white">داشبورد مالیات بر ارزش افزوده</h1>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">تطبیق VAT سطح فاکتور، هشدار مغایرت و خروجی قابل حسابرسی</p>
        </div>
        <div class="flex items-center gap-1.5 flex-wrap">
            <a asp-action="ExportInvoicesExcel" asp-route-year="@year" class="px-2.5 py-1.5 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-850 hover:bg-slate-50 dark:hover:bg-slate-900 rounded-lg text-[10px] font-bold text-emerald-600 dark:text-emerald-400 no-underline transition shadow-sm">
                <i class="bi bi-file-earmark-excel"></i>
                <span>خروجی اکسل</span>
            </a>
            <a asp-action="PrintInvoicePdf" asp-route-id="@(Model.VatRows.FirstOrDefault()?.Id ?? 0)" class="px-2.5 py-1.5 bg-white dark:bg-slate-955 border border-slate-200 dark:border-slate-850 hover:bg-slate-50 dark:hover:bg-slate-900 rounded-lg text-[10px] font-bold text-slate-700 dark:text-slate-300 print-invoice-btn no-underline transition shadow-sm @(Model.VatRows.Any() ? "" : "opacity-50 pointer-events-none")">
                <i class="bi bi-printer"></i>
                <span>چاپ PDF</span>
            </a>
        </div>
    </div>

    <div class="row g-2.5 mb-2.5">
        <div class="col-12 col-md-3">
            <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3 text-center vat-card vat-kpi" >
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">VAT وصولی فروش</div>
                <div class="text-[15px] font-black text-emerald-600 dark:text-emerald-400 mt-0.5 font-mono tabular-nums">@Model.TotalVatCollected.ToString("N0")</div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3 text-center vat-card vat-kpi" >
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">VAT پرداختی خرید</div>
                <div class="text-[15px] font-black text-blue-600 dark:text-blue-400 mt-0.5 font-mono tabular-nums">@Model.TotalVatPaid.ToString("N0")</div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3 text-center vat-card vat-kpi" >
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">VAT محاسبه‌شده از خطوط</div>
                <div class="text-[15px] font-black text-slate-800 dark:text-slate-100 mt-0.5 font-mono tabular-nums">@Model.TotalVatLineCalculated.ToString("N0")</div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3 text-center vat-card vat-kpi" >
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">خالص پرداختنی / استردادی</div>
                <div class="text-[15px] font-black @(Model.NetVatPayableOrRefundable >= 0 ? "text-rose-600 dark:text-rose-455" : "text-sky-600 dark:text-sky-455") mt-0.5 font-mono tabular-nums">@Model.NetVatPayableOrRefundable.ToString("N0")</div>
            </div>
        </div>
    </div>

    <div class="row g-2.5 mb-2.5">
        <div class="col-12 col-md-4">
            <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3 text-center vat-card" >
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">اختلاف reconcile</div>
                <div class="text-[15px] font-black @(hasMismatch ? "text-rose-600" : "text-emerald-600") mt-0.5 font-mono tabular-nums">@Model.VatReconciliationDifference.ToString("N0")</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3 text-center vat-card" >
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">فاکتورهای مشکوک</div>
                <div class="text-[15px] font-black @(Model.VatMismatchInvoices > 0 ? "text-amber-600" : "text-emerald-600") mt-0.5 font-mono tabular-nums">@Model.VatMismatchInvoices.ToString("N0")</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3 text-center vat-card" >
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">وضعیت کنترل</div>
                <div class="text-[15px] font-black @(hasMismatch ? "text-amber-600" : "text-emerald-600") mt-0.5">@(hasMismatch ? "نیاز به بررسی" : "تأیید شده")</div>
            </div>
        </div>
    </div>

    @if (hasMismatch)
    {
        <div class="alert alert-warning small mb-2.5 p-2.5 text-[11px] rounded-lg">
            <strong>هشدار مغایرت:</strong> مجموع VAT خطوط با VAT ثبت‌شده یکسان نیست یا چند فاکتور mismatch دارند. قبل از ارسال نهایی، موارد زیر را بررسی کنید:
            <ul class="mb-0 mt-1">
                <li>گرد کردن مبلغ خطوط</li>
                <li>فاکتورهای بدون ردیف یا با subtotal صفر</li>
                <li>اختلاف بین گزارش فصلی و مجموع فاکتور</li>
            </ul>
        </div>
    }

    <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3.5 overflow-x-auto vat-card" >
        <div class="table-responsive">
            <table class="w-full text-[11px] text-right border-collapse">
                <thead class="bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">شماره</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">نوع</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">تاریخ</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">طرف معامله</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">جمع جزء</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">VAT ثبت‌شده</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">VAT خطی</th>
                        <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">اختلاف</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.VatRows.Any())
                {
                    @foreach (var item in Model.VatRows)
                    {
                        var calculatedVat = Math.Round(item.SubTotal * 0.10m, 2);
                        var diff = Math.Round(item.VatAmount - calculatedVat, 2);
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors @(Math.Abs(diff) > 0 ? "bg-rose-50/30 dark:bg-rose-955/5" : "")">
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-mono font-semibold">@item.InvoiceNumber</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center">
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-bold @(item.InvoiceType == "Sale" ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border border-emerald-200/30" : "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 border border-blue-200/30")">
                                    @(item.InvoiceType == "Sale" ? "فروش" : "خرید")
                                </span>
                            </td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center font-mono text-slate-500">@item.DateShamsi</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-slate-800 dark:text-slate-200">@item.PartyName</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums">@item.SubTotal.ToString("N0")</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums text-slate-500">@item.VatAmount.ToString("N0")</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums text-slate-500">@calculatedVat.ToString("N0")</td>
                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums fw-semibold @(Math.Abs(diff) > 0 ? "text-rose-600" : "text-emerald-600")">@diff.ToString("N0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-slate-400 py-3 text-[11px] border-b border-slate-100 dark:border-slate-800/50">برای سال انتخاب‌شده داده VAT ثبت نشده است.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

