@model FinancialDashboardVM
@{
    ViewData["Title"] = "داشبورد مالیات بر ارزش افزوده";
    var year = ViewBag.Year as int? ?? DateTime.Now.Year;
    var vatGap = Math.Abs(Model.VatReconciliationDifference);
    var hasMismatch = vatGap > 0 || Model.VatMismatchInvoices > 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/financial-vat-dashboard-style.css" asp-append-version="true" />
}

<div class="container-fluid py-3" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-3 gap-2.5">
        <div>
            <h1 class="text-base font-black text-slate-900 dark:text-white">داشبورد مالیات بر ارزش افزوده</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">تطبیق VAT سطح فاکتور، هشدار مغایرت و خروجی قابل
                حسابرسی</p>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <a asp-action="ExportInvoicesExcel" asp-route-year="@year"
                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg text-xs font-bold text-emerald-600 dark:text-emerald-400 no-underline transition shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i>
                    <span>خروجی اکسل</span>
                </a>
                <a asp-action="PrintInvoicePdf" asp-route-id="@(Model.VatRows.FirstOrDefault()?.Id ?? 0)"
                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-300 print-invoice-btn no-underline transition shadow-sm @(Model.VatRows.Any() ? "" : "opacity-50 pointer-events-none")">
                    <i class="bi bi-printer"></i>
                    <span>چاپ PDF</span>
                </a>
            </div>
        </div>

        <!-- VAT Summary Cards - All in one row -->
        <div class="flex flex-wrap gap-2 mb-3 vat-cards-row">
            <div class="flex-1 min-w-0">
                <div class="vat-card vat-card-sales">
                    <div class="vat-card-icon">
                        <i class="bi bi-graph-up-arrow fs-5"></i>
                    </div>
                    <div class="vat-card-body">
                        <span class="vat-card-label">VAT وصولی فروش</span>
                        <span
                        class="vat-card-value text-emerald-600 dark:text-emerald-400">@Model.TotalVatCollected.ToString("N0")</span>
                        <span class="vat-card-unit">ریال</span>
                    </div>
                </div>
            </div>
            <div class="flex-1 min-w-0">
                <div class="vat-card vat-card-purchase">
                    <div class="vat-card-icon">
                        <i class="bi bi-cart3 fs-5"></i>
                    </div>
                    <div class="vat-card-body">
                        <span class="vat-card-label">VAT پرداختی خرید</span>
                        <span
                        class="vat-card-value text-blue-600 dark:text-blue-400">@Model.TotalVatPaid.ToString("N0")</span>
                        <span class="vat-card-unit">ریال</span>
                    </div>
                </div>
            </div>
            <div class="flex-1 min-w-0">
                <div class="vat-card vat-card-lines">
                    <div class="vat-card-icon">
                        <i class="bi bi-calculator fs-5"></i>
                    </div>
                    <div class="vat-card-body">
                        <span class="vat-card-label">VAT محاسبه‌شده از خطوط</span>
                        <span
                        class="vat-card-value text-indigo-600 dark:text-indigo-400">@Model.TotalVatLineCalculated.ToString("N0")</span>
                        <span class="vat-card-unit">ریال</span>
                    </div>
                </div>
            </div>
            <div class="flex-1 min-w-0">
                <div class="vat-card vat-card-net @(Model.NetVatPayableOrRefundable >= 0 ? "" : "vat-card-refund")">
                    <div class="vat-card-icon">
                        <i class="bi bi-cash-stack fs-5"></i>
                    </div>
                    <div class="vat-card-body">
                        <span class="vat-card-label">خالص پرداختنی / استردادی</span>
                        <span
                        class="vat-card-value @(Model.NetVatPayableOrRefundable >= 0 ? "text-rose-600 dark:text-rose-400" : "text-sky-600 dark:text-sky-400")">@Model.NetVatPayableOrRefundable.ToString("N0")</span>
                        <span class="vat-card-unit">ریال</span>
                    </div>
                </div>
            </div>
            <div class="flex-1 min-w-0">
                <div class="vat-card vat-card-reconcile @(hasMismatch ? "" : "vat-card-success")">
                    <div class="vat-card-icon">
                        <i class="bi bi-arrow-left-right fs-5"></i>
                    </div>
                    <div class="vat-card-body">
                        <span class="vat-card-label">اختلاف Reconcile</span>
                        <span
                        class="vat-card-value @(hasMismatch ? "text-rose-600 dark:text-rose-400" : "text-emerald-600 dark:text-emerald-400")">@Model.VatReconciliationDifference.ToString("N0")</span>
                        <span class="vat-card-unit">ریال</span>
                    </div>
                </div>
            </div>
            <div class="flex-1 min-w-0">
                <div class="vat-card vat-card-suspicious @(Model.VatMismatchInvoices > 0 ? "" : "vat-card-success")">
                    <div class="vat-card-icon">
                        <i class="bi bi-exclamation-triangle fs-5"></i>
                    </div>
                    <div class="vat-card-body">
                        <span class="vat-card-label">فاکتورهای مشکوک</span>
                        <span
                        class="vat-card-value @(Model.VatMismatchInvoices > 0 ? "text-amber-600 dark:text-amber-400" : "text-emerald-600 dark:text-emerald-400")">@Model.VatMismatchInvoices.ToString("N0")</span>
                        <span class="vat-card-unit">فاکتور</span>
                    </div>
                </div>
            </div>
            <div class="flex-1 min-w-0">
                <div class="vat-card vat-card-status @(hasMismatch ? "" : "vat-card-success")">
                    <div class="vat-card-icon">
                        <i class="bi @(hasMismatch ? "bi-shield-exclamation" : "bi-shield-check") fs-5"></i>
                    </div>
                    <div class="vat-card-body">
                        <span class="vat-card-label">وضعیت کنترل</span>
                        <span class="vat-status-badge @(hasMismatch ? "badge-warn" : "badge-ok")">
                            @(hasMismatch ? "نیاز به بررسی" : "تأیید شده")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mismatch Alert -->
        @if (hasMismatch)
        {
            <div class="rounded-lg border border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/30 px-3.5 py-2.5 text-[11px] text-amber-700 dark:text-amber-300 mb-3">
                <strong>هشدار مغایرت:</strong> مجموع VAT خطوط با VAT ثبت‌شده یکسان نیست یا چند فاکتور mismatch دارند. قبل از
                ارسال نهایی، موارد زیر را بررسی کنید:
                <ul class="mb-0 mt-1">
                    <li>گرد کردن مبلغ خطوط</li>
                    <li>فاکتورهای بدون ردیف یا با subtotal صفر</li>
                    <li>اختلاف بین گزارش فصلی و مجموع فاکتور</li>
                </ul>
            </div>
        }

        <!-- VAT Rows Table -->
        <div
            class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3.5 overflow-x-auto">
            <div class="overflow-x-auto">
                <table class="w-full text-[11px] text-right border-collapse">
                    <thead
                        class="bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">شماره</th>
                            <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">نوع
                            </th>
                            <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">تاریخ
                            </th>
                            <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">طرف معامله</th>
                            <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">جمع جزء
                            </th>
                            <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">VAT
                                ثبت‌شده</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">VAT خطی
                                </th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">اختلاف
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.VatRows.Any())
                            {
                                @foreach (var item in Model.VatRows)
                                {
                                    var calculatedVat = Math.Round(item.SubTotal * 0.10m, 2);
                                    var diff = Math.Round(item.VatAmount - calculatedVat, 2);
                                    <tr
                                        class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors @(Math.Abs(diff) > 0 ? "bg-rose-50/30 dark:bg-rose-950/5" : "")">
                                        <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-mono font-semibold">
                                            @item.InvoiceNumber</td>
                                            <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center">
                                                <span
                                                    class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-bold @(item.InvoiceType == "Sale" ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border border-emerald-200/30" : "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 border border-blue-200/30")">
                                                    @(item.InvoiceType == "Sale" ? "فروش" : "خرید")
                                                </span>
                                            </td>
                                            <td
                                                class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center font-mono text-slate-500">
                                                @item.DateShamsi</td>
                                                <td
                                                    class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-slate-800 dark:text-slate-200">
                                                    @item.PartyName</td>
                                                    <td
                                                        class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums">
                                                        @item.SubTotal.ToString("N0")</td>
                                                        <td
                                                            class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums text-slate-500">
                                                            @item.VatAmount.ToString("N0")</td>
                                                            <td
                                                                class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums text-slate-500">
                                                                @calculatedVat.ToString("N0")</td>
                                                                <td
                                                                    class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums fw-semibold @(Math.Abs(diff) > 0 ? "text-rose-600" : "text-emerald-600")">
                                                                    @diff.ToString("N0")</td>
                                                                </tr>
                                                            }
                                                        }
                    else
                                                        {
                                                            <tr>
                                                                <td colspan="8"
                                                                    class="text-center text-slate-400 py-3 text-[11px] border-b border-slate-100 dark:border-slate-800/50">
                                                                    برای سال انتخاب‌شده داده VAT ثبت نشده است.</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>