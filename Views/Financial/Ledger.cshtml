@model OfficeAutomation.Modules.Finance.Application.LedgerDto
@{
    ViewData["Title"] = "دفتر کل";
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
}

<div class="bg-gray-50 min-h-screen p-2" dir="rtl">
    <div class="bg-white border border-black/20 rounded-sm shadow-sm p-2">
        <div class="flex items-center justify-between border-b border-black/20 pb-1.5 mb-2">
            <div>
                <h1 class="text-[12px] font-black text-[#2d3446]">دفتر کل / معین / تفصیلی</h1>
                <p class="text-[10px] text-gray-600 mt-0.5">
                    @if (from.HasValue) { <text>از @from.Value.ToString("yyyy/MM/dd")</text> }
                    @if (to.HasValue) { <text>تا @to.Value.ToString("yyyy/MM/dd")</text> }
                    (@Model.Entries.Count ردیف)
                </p>
            </div>
            <a href="@Url.Action("LedgerOperations")" class="px-2 py-0.5 text-[10px] bg-gradient-to-b from-white to-gray-200 border border-black/30 shadow-sm rounded-sm hover:bg-white">بازگشت به عملیات حسابداری</a>
        </div>

        @if (Model.Entries.Count == 0)
        {
            <div class="text-center text-[12px] text-gray-500 py-8">هیچ ردیفی یافت نشد.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-[10px] border-collapse">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700" style="height:28px">
                            <th class="px-1.5 py-1 border border-black/30 text-right">تاریخ</th>
                            <th class="px-1.5 py-1 border border-black/30 text-right">شماره</th>
                            <th class="px-1.5 py-1 border border-black/30 text-right">شرح</th>
                            <th class="px-1.5 py-1 border border-black/30 text-right">حساب معین</th>
                            <th class="px-1.5 py-1 border border-black/30 text-right">تفصیلی</th>
                            <th class="px-1.5 py-1 border border-black/30 text-left tabular-nums">بدهکار</th>
                            <th class="px-1.5 py-1 border border-black/30 text-left tabular-nums">بستانکار</th>
                            <th class="px-1.5 py-1 border border-black/30 text-left tabular-nums">مانده</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="bg-[#fff6d2] font-bold" style="height:26px">
                            <td colspan="5" class="px-1.5 py-0.5 border border-black/20">مانده ابتدای دوره</td>
                            <td class="px-1.5 py-0.5 border border-black/20 text-center tabular-nums text-left">@Model.OpeningBalance.ToString("N2")</td>
                            <td class="px-1.5 py-0.5 border border-black/20"></td>
                            <td class="px-1.5 py-0.5 border border-black/20 text-center tabular-nums text-left">@Model.OpeningBalance.ToString("N2")</td>
                        </tr>
                        @foreach (var entry in Model.Entries)
                        {
                            var code = (entry.SubsidiaryAccountCode ?? entry.GeneralAccountCode ?? string.Empty) + (entry.FloatingDetailCode != null ? $"-{entry.FloatingDetailCode}" : "");
                            <tr class="odd:bg-white even:bg-[#f7f9fb]" style="height:26px">
                                <td class="px-1.5 py-0.5 border border-black/10">@entry.VoucherDate.ToString("yyyy/MM/dd")</td>
                                <td class="px-1.5 py-0.5 border border-black/10 font-mono tabular-nums text-left">@entry.VoucherNumber</td>
                                <td class="px-1.5 py-0.5 border border-black/10 truncate">@entry.Description</td>
                                <td class="px-1.5 py-0.5 border border-black/10">@entry.SubsidiaryAccountCode - @entry.SubsidiaryAccountName</td>
                                <td class="px-1.5 py-0.5 border border-black/10">@(entry.DetailedAccountName ?? entry.FloatingDetailName ?? "-")</td>
                                <td class="px-1.5 py-0.5 border border-black/10 text-center tabular-nums text-left">@(entry.Debit > 0 ? entry.Debit.ToString("N2") : "")</td>
                                <td class="px-1.5 py-0.5 border border-black/10 text-center tabular-nums text-left">@(entry.Credit > 0 ? entry.Credit.ToString("N2") : "")</td>
                                <td class="px-1.5 py-0.5 border border-black/10 text-center font-bold tabular-nums text-left">@entry.RunningBalance.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="bg-[#fff6d2] font-bold" style="height:26px">
                            <td colspan="5" class="px-1.5 py-0.5 border border-black/20">جمع کل</td>
                            <td class="px-1.5 py-0.5 border border-black/20 text-center tabular-nums text-left">@Model.TotalDebits.ToString("N2")</td>
                            <td class="px-1.5 py-0.5 border border-black/20 text-center tabular-nums text-left">@Model.TotalCredits.ToString("N2")</td>
                            <td class="px-1.5 py-0.5 border border-black/20 text-center tabular-nums text-left">@Model.ClosingBalance.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>