@model OfficeAutomation.Models.SettingsIndexViewModel
<div class="space-y-3"><div><h2 class="flex items-center gap-2 text-sm font-black text-slate-900 dark:text-white"><i class="bi bi-server text-teal-600 dark:text-teal-400"></i>اتصال و زیرساخت</h2><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">نمایش وضعیت زیرساخت و کنترل حالت نگهداری سامانه</p></div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"><div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-800 dark:bg-slate-950"><div class="text-[11px] font-black text-slate-500 dark:text-slate-400">وضعیت دیتابیس</div><div class="mt-3 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-black @(Model.System.IsDatabaseConnected ? "border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300" : "border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800 dark:bg-rose-950/30 dark:text-rose-300")"><i class="bi @(Model.System.IsDatabaseConnected ? "bi-check-circle" : "bi-x-circle")"></i>@(Model.System.IsDatabaseConnected ? "متصل" : "قطع")</div></div><div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-800 dark:bg-slate-950"><div class="text-[11px] font-black text-slate-500 dark:text-slate-400">محیط فعال</div><div class="mt-3 text-left font-mono text-xs font-black tabular-nums text-slate-900 dark:text-slate-100" dir="ltr">@Model.System.ActiveEnvironment</div></div><div class="rounded-lg border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-800 dark:bg-slate-950"><div class="text-[11px] font-black text-slate-500 dark:text-slate-400">آخرین بروزرسانی</div><div class="mt-3 text-left font-mono text-xs font-black tabular-nums text-slate-900 dark:text-slate-100" dir="ltr">@(Model.System.LastUpdatedUtc?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "-")</div></div></div>

@if (Model.CanManageSecurity)
{
    <div class="rounded-lg border border-slate-200 bg-slate-50/80 p-3.5 dark:border-slate-800 dark:bg-slate-950/40 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-2.5">
            <div class="p-2 rounded-lg bg-teal-50 dark:bg-teal-950/50 text-teal-700 dark:text-teal-300">
                <i class="bi bi-award text-lg"></i>
            </div>
            <div>
                <h3 class="text-xs font-black text-slate-900 dark:text-white">مدیریت لایسنس و فعال‌سازی نرم‌افزار</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">مشاهده وضعیت ماژول‌ها، مصرف مجاز کاربران، کد فعال‌سازی سرور و بارگذاری لایسنس در تب اختصاصی لایسنس</p>
            </div>
        </div>
        <button type="button" onclick="document.querySelector('.tab-btn[data-target=\'#license\']')?.click();" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-teal-600 px-3 py-2 text-xs font-black text-white hover:bg-teal-700 transition shrink-0 shadow-sm">
            <i class="bi bi-arrow-left"></i> ورود به بخش لایسنس
        </button>
    </div>
}
<form asp-action="UpdateSystem" asp-controller="Settings" method="post" class="settings-form">@Html.AntiForgeryToken()<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"><label class="flex min-h-32 cursor-pointer items-center justify-between gap-4 rounded-lg border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-800 dark:bg-slate-950"><span><span class="block text-xs font-black text-slate-800 dark:text-slate-200">حالت نگهداری سامانه</span><span class="mt-1 block text-xs leading-6 text-slate-500 dark:text-slate-400">در این حالت دسترسی کاربران عادی محدود می‌شود.</span></span><span class="relative inline-flex h-7 w-12 shrink-0 items-center"><input asp-for="System.MaintenanceMode" type="checkbox" role="switch" class="peer sr-only" /><span class="absolute inset-0 rounded-full bg-slate-300 transition peer-checked:bg-teal-600 dark:bg-slate-700"></span><span class="absolute right-1 h-5 w-5 rounded-full bg-white shadow-sm transition peer-checked:-translate-x-5"></span></span></label></div><div class="border-t border-slate-100 dark:border-slate-800 pt-3 mt-3">@if (Model.CanManageSecurity){<button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-3 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-teal-700"><i class="bi bi-hdd-network"></i>ذخیره تغییرات</button>}else{<div class="inline-flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-[11px] font-bold text-amber-700 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300"><i class="bi bi-info-circle"></i>مدیریت اتصال و نگهداری فقط در دسترس مدیر سیستم است.</div>}</div></form></div>
