@model OfficeAutomation.Models.SettingsIndexViewModel
@{
    ViewData["Title"] = "تنظیمات";
    var databaseStatusLabel = Model.System.IsDatabaseConnected ? "پایدار" : "نیازمند بررسی";
    var themeLabel = Model.Ui.ThemePreference switch { "Dark" => "تیره", "Light" => "روشن", _ => "سیستمی" };
}

<div class="settings-page w-full space-y-3" dir="rtl">
    @if (TempData["SettingsSuccess"] is string message)
    {
        <div class="flex items-center gap-2.5 rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-3 text-xs font-bold text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300"><i class="bi bi-check2-circle text-sm"></i><span>@message</span></div>
    }
    <div asp-validation-summary="ModelOnly" class="empty:hidden flex items-start gap-2.5 rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-3 text-xs text-rose-700 dark:border-rose-800 dark:bg-rose-950/30 dark:text-rose-300"></div>

    <div class="flex flex-col gap-3 px-1 sm:flex-row sm:items-end sm:justify-between">
        <div><h1 class="text-sm font-black tracking-tight text-slate-950 dark:text-white">تنظیمات سیستم</h1><p class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">پیکربندی هویت سامانه، امنیت، زیرساخت و تجربه کاربری</p></div>
        <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-black @(Model.System.IsDatabaseConnected ? "border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300" : "border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800 dark:bg-rose-950/30 dark:text-rose-300")"><i class="bi @(Model.System.IsDatabaseConnected ? "bi-database-check" : "bi-database-x")"></i>پایگاه داده: @databaseStatusLabel</span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[10px] font-black text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300"><i class="bi bi-circle-half"></i>تم: @themeLabel</span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[10px] font-black text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300"><i class="bi bi-shield-check"></i>@(Model.CanManageSecurity ? "مدیر سیستم" : "کاربر")</span>
        </div>
    </div>

    <section class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 p-3 md:p-4">
        <nav id="settings-tab" class="flex gap-3 overflow-x-auto border-b border-slate-200 pb-2 mb-3 dark:border-slate-800" aria-label="بخش‌های تنظیمات">
            <button type="button" data-target="#general" class="tab-btn active inline-flex shrink-0 items-center gap-2 border-b-2 border-teal-500 px-1 pb-2 text-xs font-black text-teal-700 dark:text-teal-300"><i class="bi bi-gear pointer-events-none"></i>عمومی</button>
            <button type="button" data-target="#security" class="tab-btn inline-flex shrink-0 items-center gap-2 border-b-2 border-transparent px-1 pb-2 text-xs font-bold text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"><i class="bi bi-shield-check pointer-events-none"></i>پروفایل و امنیت</button>
            <button type="button" data-target="#system" class="tab-btn inline-flex shrink-0 items-center gap-2 border-b-2 border-transparent px-1 pb-2 text-xs font-bold text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"><i class="bi bi-server pointer-events-none"></i>زیرساخت</button>
            <button type="button" data-target="#appearance" class="tab-btn inline-flex shrink-0 items-center gap-2 border-b-2 border-transparent px-1 pb-2 text-xs font-bold text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"><i class="bi bi-window-stack pointer-events-none"></i>ظاهر</button>
            @if (Model.CanManageSecurity)
            {
                <button type="button" data-target="#signature" class="tab-btn inline-flex shrink-0 items-center gap-2 border-b-2 border-transparent px-1 pb-2 text-xs font-bold text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"><i class="bi bi-pen-fill pointer-events-none"></i>امضا</button>
                <button type="button" data-target="#users" class="tab-btn inline-flex shrink-0 items-center gap-2 border-b-2 border-transparent px-1 pb-2 text-xs font-bold text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"><i class="bi bi-person-plus pointer-events-none"></i>کاربران</button>
                <button type="button" data-target="#branding" class="tab-btn inline-flex shrink-0 items-center gap-2 border-b-2 border-transparent px-1 pb-2 text-xs font-bold text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"><i class="bi bi-brush pointer-events-none"></i>هویت بصری</button>
            }
        </nav>

        <!-- اضافه شدن تگ فرم برای ذخیره تنظیمات -->
        <form asp-action="SaveSettings" method="post" class="settings-content">

            <div id="general" class="tab-pane block">
                <!-- نکته: اگر پارشیال عمومی مدل خاص خودش را دارد، به جای Model بنویس Model.General یا مشابه آن -->
                <partial name="_GeneralSettings" model="Model" />
            </div>

            <div id="security" class="tab-pane hidden">
                <partial name="_ProfileSecuritySettings" model="Model" />
            </div>

            <div id="system" class="tab-pane hidden">
                <partial name="_SystemConnectivitySettings" model="Model" />
            </div>

            <div id="appearance" class="tab-pane hidden">
                <partial name="_UiPreferencesSettings" model="Model" />
            </div>

            @if (Model.CanManageSecurity)
            {
                <div id="branding" class="tab-pane hidden">
                    <partial name="_BrandingSettings" model="Model" />
                </div>
            }

            @if (Model.CanManageSecurity)
            {
                <div id="signature" class="tab-pane hidden">
                    <!-- کدهای امضا همانطور که بود -->
                    <div class="space-y-3">
                        <div><h2 class="flex items-center gap-2 text-sm font-black text-slate-900 dark:text-white"><i class="bi bi-pen-fill text-teal-600 dark:text-teal-400"></i>مدیریت امضای کاربر</h2><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">ثبت، بارگذاری یا به‌روزرسانی امضای دیجیتال برای اسناد سامانه</p></div>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"><div class="space-y-3 lg:col-span-2"><div class="overflow-hidden rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-950"><canvas id="signature-canvas" class="h-44 w-full" aria-label="Signature Canvas"></canvas></div><div class="border-t border-slate-100 dark:border-slate-800 pt-3 mt-3 flex flex-wrap items-center gap-2"><button type="button" id="signature-save-btn" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-2.5 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-teal-700"><i class="bi bi-check2-circle"></i>ذخیره تغییرات</button><button type="button" id="signature-clear-btn" class="inline-flex items-center gap-2 rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-2.5 text-xs font-bold text-rose-700 transition hover:bg-rose-100 dark:border-rose-800 dark:bg-rose-950/30 dark:text-rose-300"><i class="bi bi-eraser"></i>پاک‌سازی</button><label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-2.5 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300"><i class="bi bi-upload"></i>آپلود<input type="file" id="signature-upload-input" accept="image/*" class="hidden" /></label></div></div><div class="space-y-3"><h3 class="text-xs font-black text-slate-700 dark:text-slate-300">پیش‌نمایش امضای فعلی</h3>@if (!string.IsNullOrWhiteSpace(Model.CurrentUserSignaturePath)){
                        <div class="flex min-h-36 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-700 dark:bg-slate-950"><img src="@Model.CurrentUserSignaturePath" alt="Current Signature" id="signature-current-preview" class="max-h-28 object-contain" /></div>
                    }
                    else
                    {

                        <div id="signature-current-preview-empty" class="flex min-h-36 flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-slate-200 text-slate-400 dark:border-slate-700 dark:text-slate-600"><i class="bi bi-pen text-xl"></i><span class="text-xs font-bold">هنوز امضایی ثبت نشده است</span></div>
                    }
</div></div>
                </div>
            </div>
            <div id="users" class="tab-pane hidden"><div class="space-y-3"><div><h2 class="flex items-center gap-2 text-sm font-black text-slate-900 dark:text-white"><i class="bi bi-people text-teal-600 dark:text-teal-400"></i>افزودن کاربر جدید</h2><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">ایجاد حساب کاربری از مسیر مدیریت کاربران انجام می‌شود.</p></div><div class="rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-3 text-xs font-bold text-sky-700 dark:border-sky-800 dark:bg-sky-950/30 dark:text-sky-300"><i class="bi bi-shield-check ml-1"></i>برای ثبت کاربر جدید به فرم اختصاصی مدیریت کاربران منتقل شوید.</div><div class="border-t border-slate-100 pt-3 mt-3 dark:border-slate-800"><a asp-controller="Settings" asp-action="AddNewUser" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-2.5 py-2.5 text-xs font-black text-white no-underline shadow-sm transition hover:bg-teal-700"><i class="bi bi-person-plus-fill"></i>افزودن کاربر</a></div></div></div>
                        }

            <!-- دکمه ذخیره نهایی کل تنظیمات -->
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex justify-end">
                <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white font-bold py-2 px-3 rounded-lg transition-colors shadow-sm">
                    <i class="bi bi-save ml-2"></i> ذخیره کل تغییرات
                </button>
            </div>

        </form>
    </section>
</div>

@section Scripts {
    <script src="~/lib/signature-pad/signature_pad.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/settings-hub.js" asp-append-version="true"></script>
    <script src="~/js/settings-index-script.js" asp-append-version="true"></script>
}