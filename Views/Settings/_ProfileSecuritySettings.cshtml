@model OfficeAutomation.Models.SettingsIndexViewModel
<div class="space-y-4">
    <div><h2 class="flex items-center gap-2 text-sm font-black text-slate-900 dark:text-white"><i class="bi bi-shield-check text-teal-600 dark:text-teal-400"></i>پروفایل و امنیت</h2><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">اطلاعات حساب کاربری، رمز عبور و خروج از نشست فعلی</p></div>
    <form asp-action="UpdateProfile" asp-controller="Settings" method="post" class="settings-form space-y-3">@Html.AntiForgeryToken()<h3 class="text-xs font-black text-slate-700 dark:text-slate-300">پروفایل کاربر</h3><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="flex flex-col gap-1.5"><label asp-for="Profile.FullName" class="text-xs font-black text-slate-700 dark:text-slate-300">نام کامل</label><input asp-for="Profile.FullName" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" /><span asp-validation-for="Profile.FullName" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span></div>
        <div class="flex flex-col gap-1.5"><label asp-for="Profile.Email" class="text-xs font-black text-slate-700 dark:text-slate-300">ایمیل</label><input asp-for="Profile.Email" dir="ltr" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-left font-mono text-xs tabular-nums text-slate-900 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" /><span asp-validation-for="Profile.Email" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span></div>
        <div class="flex flex-col gap-1.5"><label asp-for="Profile.JobTitle" class="text-xs font-black text-slate-700 dark:text-slate-300">سمت سازمانی</label><input asp-for="Profile.JobTitle" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" /><span asp-validation-for="Profile.JobTitle" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span></div>
        <div class="flex flex-col gap-1.5"><label asp-for="Profile.PhoneNumber" class="text-xs font-black text-slate-700 dark:text-slate-300">شماره تماس</label><input asp-for="Profile.PhoneNumber" dir="ltr" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-left font-mono text-xs tabular-nums text-slate-900 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" /><span asp-validation-for="Profile.PhoneNumber" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span></div>
        <div class="flex flex-col gap-1.5 md:col-span-2"><label asp-for="Profile.ServiceLocation" class="text-xs font-black text-slate-700 dark:text-slate-300">محل خدمت</label><input asp-for="Profile.ServiceLocation" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" /><span asp-validation-for="Profile.ServiceLocation" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span></div>
    </div><div class="border-t border-slate-100 dark:border-slate-800 pt-3 mt-3"><button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-3 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-teal-700"><i class="bi bi-person-check"></i>ذخیره تغییرات</button></div></form>
    <form asp-action="ChangePassword" asp-controller="Settings" method="post" class="settings-form space-y-3 border-t border-slate-100 pt-3 dark:border-slate-800">@Html.AntiForgeryToken()<h3 class="text-xs font-black text-slate-700 dark:text-slate-300">تغییر رمز عبور</h3><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="flex flex-col gap-1.5"><label asp-for="Password.CurrentPassword" class="text-xs font-black text-slate-700 dark:text-slate-300">رمز عبور فعلی</label><input asp-for="Password.CurrentPassword" dir="ltr" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-left font-mono text-xs text-slate-900 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" /><span asp-validation-for="Password.CurrentPassword" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span></div>
        <div class="flex flex-col gap-1.5"><label asp-for="Password.NewPassword" class="text-xs font-black text-slate-700 dark:text-slate-300">رمز عبور جدید</label><input asp-for="Password.NewPassword" dir="ltr" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-left font-mono text-xs text-slate-900 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" /><span asp-validation-for="Password.NewPassword" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span></div>
        <div class="flex flex-col gap-1.5"><label asp-for="Password.ConfirmPassword" class="text-xs font-black text-slate-700 dark:text-slate-300">تکرار رمز عبور</label><input asp-for="Password.ConfirmPassword" dir="ltr" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-left font-mono text-xs text-slate-900 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" /><span asp-validation-for="Password.ConfirmPassword" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span></div>
    </div><div class="border-t border-slate-100 dark:border-slate-800 pt-3 mt-3"><button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2.5 text-xs font-black text-rose-700 transition hover:bg-rose-100 dark:border-rose-800 dark:bg-rose-950/30 dark:text-rose-300"><i class="bi bi-shield-lock"></i>ذخیره تغییرات</button></div></form>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity" })" method="post" class="settings-form border-t border-slate-100 pt-3 dark:border-slate-800"><div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between"><div><h3 class="text-xs font-black text-slate-700 dark:text-slate-300">خروج از حساب کاربری</h3><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">نشست فعلی پایان می‌یابد و به صفحه ورود منتقل می‌شوید.</p></div><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2.5 text-xs font-black text-rose-700 transition hover:bg-rose-100 dark:border-rose-800 dark:bg-rose-950/30 dark:text-rose-300"><i class="bi bi-box-arrow-right"></i>خروج</button></div></form>
</div>
