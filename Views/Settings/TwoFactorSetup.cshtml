@model OfficeAutomation.Models.TwoFactorSetupVM
@{
    ViewData["Title"] = "فعال‌سازی احراز هویت دو مرحله‌ای";
}

<div class="container mx-auto px-4 py-6 max-w-2xl">
    <div class="mb-6">
        <a asp-action="Index" class="text-teal-600 hover:text-teal-700 transition-colors">
            <i class="bi bi-arrow-right"></i> بازگشت به تنظیمات
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="bg-gradient-to-r from-indigo-50 to-purple-50 px-6 py-5 border-b border-gray-200">
            <h1 class="text-xl font-bold text-gray-900">
                <i class="bi bi-shield-lock"></i> فعال‌سازی احراز هویت دو مرحله‌ای
            </h1>
            <p class="text-sm text-gray-500 mt-1">
                امنیت حساب خود را با فعال‌سازی تایید دو مرحله‌ای افزایش دهید.
            </p>
        </div>

        @if (TempData["SettingsError"] != null)
        {
            <div class="px-6 py-3 bg-red-50 border-b border-red-200">
                <p class="text-red-700 text-sm"><i class="bi bi-exclamation-triangle"></i> @TempData["SettingsError"]</p>
            </div>
        }

        <div class="p-6 space-y-6">
            <div class="bg-gray-50 rounded-lg p-4">
                <h2 class="text-base font-semibold text-gray-800 mb-2">مرحله ۱: اسکن QR Code</h2>
                <p class="text-sm text-gray-600 mb-4">
                    کد QR زیر را با اپلیکیشن Authenticator خود (Google Authenticator، Microsoft Authenticator یا Authy) اسکن کنید.
                </p>
                <div class="flex justify-center mb-4">
                    <div id="qrCode" class="bg-white p-4 rounded-lg border border-gray-200 inline-block"></div>
                </div>
                <div class="text-center">
                    <p class="text-xs text-gray-500 mb-1">یا کلید زیر را به صورت دستی وارد کنید:</p>
                    <code class="bg-white border border-gray-300 rounded px-3 py-1.5 text-sm font-mono text-gray-700 select-all">@Model.SecretKey</code>
                </div>
            </div>

            <div class="bg-gray-50 rounded-lg p-4">
                <h2 class="text-base font-semibold text-gray-800 mb-2">مرحله ۲: تایید کد</h2>
                <p class="text-sm text-gray-600 mb-4">
                    کد ۶ رقمی نمایش داده شده در اپلیکیشن Authenticator خود را وارد کنید.
                </p>
                <form asp-action="VerifyAndEnableTwoFactor" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="recoveryCodes" value="@string.Join("|", Model.RecoveryCodes)" />
                    <div class="flex gap-3 items-end">
                        <div class="flex-1">
                            <label class="block text-sm font-medium text-gray-700 mb-1">کد تایید</label>
                            <input type="text" name="code" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code"
                                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-center text-2xl tracking-widest font-mono focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                   placeholder="000000" required />
                        </div>
                        <button type="submit"
                                class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-lg text-sm font-medium transition-colors shadow-sm">
                            تایید و فعال‌سازی
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-amber-50 rounded-lg p-4 border border-amber-200">
                <h2 class="text-base font-semibold text-gray-800 mb-2">
                    <i class="bi bi-exclamation-triangle text-amber-600"></i> کدهای ریکاوری
                </h2>
                <p class="text-sm text-gray-600 mb-3">
                    در صورت گم شدن دستگاه یا عدم دسترسی به اپلیکیشن، می‌توانید از کدهای زیر استفاده کنید.
                    این کدها را در جای امنی ذخیره کنید.
                </p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                    @foreach (var code in Model.RecoveryCodes)
                    {
                        <code class="bg-white border border-amber-200 rounded px-2 py-1.5 text-xs text-center font-mono text-gray-700 select-all">@code</code>
                    }
                </div>
                <p class="text-xs text-amber-700 mt-2">
                    <i class="bi bi-info-circle"></i> هر کد فقط یک‌بار قابل استفاده است.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script id="qrData" type="application/json">@Model.QrCodeUri</script>
    <script src="~/lib/qrcodejs/qrcode.min.js" asp-append-version="true"></script>
    <script src="~/js/settings-two-factor-setup-script.js" asp-append-version="true"></script>
}