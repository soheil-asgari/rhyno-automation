@model OfficeAutomation.Models.SettingsIndexViewModel
<div class="space-y-3"><div><h2 class="flex items-center gap-2 text-sm font-black text-slate-900 dark:text-white"><i class="bi bi-window-stack text-teal-600 dark:text-teal-400"></i>تنظیمات ظاهری</h2><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">کنترل رفتار سایدبار و تم پیش‌فرض محیط کاربری</p></div><form asp-action="UpdateUi" asp-controller="Settings" method="post" class="settings-form">@Html.AntiForgeryToken()<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"><label class="flex min-h-32 cursor-pointer items-center justify-between gap-4 rounded-lg border border-slate-200 bg-slate-50 p-2.5 dark:border-slate-800 dark:bg-slate-950"><span><span class="block text-xs font-black text-slate-800 dark:text-slate-200">سایدبار جمع‌شده</span><span class="mt-1 block text-xs leading-6 text-slate-500 dark:text-slate-400">سایدبار هنگام ورود به صورت جمع‌شده نمایش داده شود.</span></span><span class="relative inline-flex h-7 w-12 shrink-0 items-center"><input asp-for="Ui.SidebarCollapsedByDefault" type="checkbox" role="switch" class="peer sr-only" /><span class="absolute inset-0 rounded-full bg-slate-300 transition peer-checked:bg-teal-600 dark:bg-slate-700"></span><span class="absolute right-1 h-5 w-5 rounded-full bg-white shadow-sm transition peer-checked:-translate-x-5"></span></span></label><div class="flex flex-col gap-1.5"><label asp-for="Ui.ThemePreference" class="text-xs font-black text-slate-700 dark:text-slate-300">انتخاب تم</label><select asp-for="Ui.ThemePreference" asp-items="Model.Themes" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs text-slate-900 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"></select><span asp-validation-for="Ui.ThemePreference" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span></div></div><div class="border-t border-slate-100 dark:border-slate-800 pt-3 mt-3"><button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-3 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-teal-700"><i class="bi bi-palette"></i>ذخیره تغییرات</button></div></form></div>
