@using System.Globalization
@model OfficeAutomation.Models.UserViewModel

@{
    PersianCalendar pc = new PersianCalendar();
    DateTime dt = DateTime.Now;
    string persianDate = $"{pc.GetYear(dt)}/{pc.GetMonth(dt).ToString("00")}/{pc.GetDayOfMonth(dt).ToString("00")}";
}

<div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
    <h5 class="mb-0 text-primary fw-bold" style="font-size: 13px;">
        <i class="bi bi-person-check-fill ms-2"></i> اطلاعات و امنیت حساب
    </h5>
    <span class="badge bg-body-tertiary text-body border p-2" style="font-family: 'Tahoma', sans-serif; font-size: 10px;">امروز: @persianDate</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label class="form-label small fw-bold text-muted" style="font-size: 11px;">نام و نام خانوادگی</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-body-tertiary border-0"><i class="bi bi-person text-secondary"></i></span>
            <input type="text" class="form-control bg-body-tertiary border-0 fw-bold" style="height: 28px; font-size: 11px;" value="@(string.IsNullOrEmpty(Model.FullName) ? "نامشخص" : Model.FullName)" readonly>
        </div>
    </div>
    
    <div class="col-md-6">
        <label class="form-label small fw-bold text-muted" style="font-size: 11px;">سمت شغلی</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-body-tertiary border-0"><i class="bi bi-briefcase text-secondary"></i></span>
            <input type="text" class="form-control bg-body-tertiary border-0" style="height: 28px; font-size: 11px;" value="@(string.IsNullOrEmpty(Model.JobTitle) ? "ثبت نشده" : Model.JobTitle)" readonly>
        </div>
    </div>

    @using System.Reflection
@using System.ComponentModel.DataAnnotations

    <div class="col-md-6">
        <label class="form-label small fw-bold text-muted" style="font-size: 11px;">واحد سازمانی</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-body-tertiary border-0"><i class="bi bi-diagram-3 text-secondary"></i></span>
            @{
                var departmentName = Model.Department?.Name ?? "نامشخص";
            }

            <input type="text" class="form-control bg-body-tertiary border-0" style="height: 28px; font-size: 11px;" value="@departmentName" readonly>
        </div>
    </div>

    <div class="col-md-6">
        <label class="form-label small fw-bold text-muted" style="font-size: 11px;">محل خدمت</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-body-tertiary border-0"><i class="bi bi-geo-alt text-secondary"></i></span>
            <input type="text" class="form-control bg-body-tertiary border-0" style="height: 28px; font-size: 11px;" value="@(string.IsNullOrEmpty(Model.ServiceLocation) ? "مرکز اصلی" : Model.ServiceLocation)" readonly>
        </div>
    </div>
</div>

<hr class="my-4 opacity-25">

<div class="card border-0 shadow-sm" style="background-color: var(--bs-secondary-bg); border-right: 4px solid #ffc107 !important;">
    <div class="card-body p-3">
        <h6 class="card-title fw-bold mb-3 text-body" style="font-size: 12px;">
            <i class="bi bi-shield-lock-fill ms-2 text-warning"></i> تغییر رمز عبور امنیتی
        </h6>
        <div class="row g-2">
            <div class="col-md-5">
                <label class="form-label small fw-bold mb-1" style="font-size: 11px;">رمز عبور جدید</label>
                <div class="input-group input-group-sm">
                    <input type="password" class="form-control border-0 shadow-sm" style="height: 28px; font-size: 11px; border-radius: 3px;" id="u_new_password" placeholder="******">
                </div>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-bold mb-1" style="font-size: 11px;">تکرار رمز عبور</label>
                <div class="input-group input-group-sm">
                    <input type="password" class="form-control border-0 shadow-sm" style="height: 28px; font-size: 11px; border-radius: 3px;" id="u_confirm_password" placeholder="******">
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-warning w-100 shadow-sm fw-bold" style="height: 28px; font-size: 11px; border-radius: 3px;" onclick="updatePassword()">
                    <i class="bi bi-check-circle ms-1"></i> ثبت
                </button>
            </div>
        </div>
        <div class="mt-3">
            <small class="text-muted" style="font-size: 10px;">
                <i class="bi bi-info-circle ms-1"></i> رمز عبور باید حداقل ۶ کاراکتر باشد.
            </small>
        </div>
    </div>
</div>