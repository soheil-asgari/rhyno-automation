@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Antiforgery
@using OfficeAutomation.Models
@using OfficeAutomation.Services
@using OfficeAutomation.Services.Security
@using OfficeAutomation.Services.Tenancy
@inject IUserContextService UserContextService
@inject IAntiforgery Antiforgery
@inject ITenantSettingsService TenantSettingsService
@{
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    
    var userId = User?.FindFirstValue(ClaimTypes.NameIdentifier);
    var userContext = !string.IsNullOrWhiteSpace(userId) && User != null
        ? await UserContextService.GetUserContextAsync(userId, User)
        : new UserContextModel();

    var displayName = userContext.DisplayName;
    var userRoleLabel = userContext.UserRoleLabel;
    var themePreference = userContext.ThemePreference;
    var rootThemeClass = string.Equals(themePreference, "Dark", StringComparison.OrdinalIgnoreCase) ? "theme-dark dark" : "theme-light";
    
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    
    var userCanAccessFinance = userContext.CanAccessFinance;
    var userCanAccessWarehouse = userContext.CanAccessWarehouse;
    var userCanAccessHumanCapital = userContext.CanAccessHumanCapital;
    var userCanAccessSystemSettings = userContext.CanAccessSystemSettings;
    var userCanAccessProcessAnalytics = userContext.CanAccessProcessAnalytics;

    var headerNotifications = userContext.Notifications;
    var headerNotificationCount = headerNotifications.Count;

    string NavClass(string controller, string? action = null)
    {
        var active = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) && (string.IsNullOrWhiteSpace(action) || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));
        return active ? "sidebar-link z-50 flex items-center gap-1.5 rounded-md border border-teal-200 bg-teal-50 px-2 py-1 text-[12px] font-semibold text-teal-700 dark:border-teal-500/30 dark:bg-teal-500/10 dark:text-teal-200" : "sidebar-link z-50 flex items-center gap-1.5 rounded-md border border-transparent px-2 py-1 text-[12px] font-medium text-slate-600 transition hover:border-slate-200 hover:bg-slate-100 hover:text-slate-950 dark:text-slate-300 dark:hover:border-slate-700 dark:hover:bg-slate-800 dark:hover:text-white";
    }
    var moduleButtonClass = "flex w-full items-center justify-between rounded-md px-2 py-1 text-[11px] font-bold text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100";

    // ── White-labeling / Branding ─────────────────────────────────────────────
    // Load branding once per request from the already-cached TenantSettingsService.
    // This does NOT cause an extra DB round-trip when the service is scoped and the
    // settings are cached within the same HTTP request scope.
    SystemSetting? brandingSettings = null;
    try { brandingSettings = await TenantSettingsService.GetSystemSettingsAsync(); } catch { }
    var brandPrimary = brandingSettings?.PrimaryColor;
    var brandAccent  = brandingSettings?.AccentColor;
    var brandLogo    = brandingSettings?.LogoUrl;
    var brandFavicon = brandingSettings?.FaviconUrl;
    var brandLoginBg = brandingSettings?.LoginBackgroundUrl;
    var appTitle     = brandingSettings?.ApplicationTitle ?? "راینو ERP";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="@themePreference.ToLowerInvariant()" class="@rootThemeClass">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@antiforgeryTokens.RequestToken" />
    <title>@ViewData["Title"] - @appTitle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true">
    @if (!string.IsNullOrWhiteSpace(brandFavicon))
    {
        <link rel="icon" href="@brandFavicon" />
    }
    @if (!string.IsNullOrWhiteSpace(brandPrimary) || !string.IsNullOrWhiteSpace(brandAccent))
    {
        <style>
            /* ── Tenant White-labeling: CSS Variables override ── */
            :root {
                @if (!string.IsNullOrWhiteSpace(brandPrimary)) { <text>--brand-primary: @brandPrimary;</text> }
                @if (!string.IsNullOrWhiteSpace(brandAccent))  { <text>--brand-accent: @brandAccent;</text> }
            }
            /* Override the teal-based primary colours used throughout the design system */
            @if (!string.IsNullOrWhiteSpace(brandPrimary))
            {
                <text>
                .bg-teal-600, .hover\:bg-teal-700:hover  { background-color: var(--brand-primary) !important; }
                .text-teal-600, .text-teal-700            { color: var(--brand-primary) !important; }
                .border-teal-500, .border-teal-200        { border-color: color-mix(in srgb, var(--brand-primary) 40%, transparent) !important; }
                .focus\:border-teal-500:focus             { border-color: var(--brand-primary) !important; }
                .focus\:ring-teal-500\/10:focus           { --tw-ring-color: color-mix(in srgb, var(--brand-primary) 10%, transparent) !important; }
                .bg-teal-50                               { background-color: color-mix(in srgb, var(--brand-primary) 8%, white) !important; }
                .dark .bg-teal-500\/10                    { background-color: color-mix(in srgb, var(--brand-primary) 10%, transparent) !important; }
                .dark .text-teal-200, .dark .text-teal-300 { color: color-mix(in srgb, var(--brand-primary) 80%, white) !important; }
                </text>
            }
            @if (!string.IsNullOrWhiteSpace(brandAccent))
            {
                <text>
                .text-purple-600, .text-purple-700       { color: var(--brand-accent) !important; }
                .bg-purple-600, .hover\:bg-purple-700:hover { background-color: var(--brand-accent) !important; }
                </text>
            }
        </style>
    }
    @await RenderSectionAsync("Styles", required: false)
    <style>
        /* Force desktop static positioning & width to prevent overlapping in RTL */
        @@media (min-width: 1024px) {
            #appSidebar.sidebar-right {
                position: static !important;
                display: flex !important;
                flex-direction: column !important;
                width: 14rem !important;
                min-width: 14rem !important;
                max-width: 14rem !important;
                transform: none !important;
                box-shadow: none !important;
                z-index: 40 !important;
            }
        }

        /* Prevent accordion / submenu clipping */
        #appSidebar .accordion-item,
        #appSidebar .accordion-collapse,
        #appSidebar .sidebar-module,
        #sidebarAccordion {
            overflow: visible !important;
        }

        /* Allow inner scrollable container to overflow correctly */
        #sidebarScrollContainer {
            overflow-y: auto !important;
            overflow-x: visible !important;
        }

        /* Style for sub-menu links to avoid legacy color locks and clipping */
        #appSidebar .accordion-collapse a.sidebar-link {
            display: flex !important;
            align-items: center !important;
            gap: 6px !important;
            width: 100% !important;
            padding: 5px 18px !important; /* py-1 px-4.5 */
            background: transparent !important;
            color: #334155 !important; /* text-slate-700 */
            border: 0 !important;
            font-size: 11px !important;
            font-weight: 500 !important;
            min-height: auto !important;
            opacity: 1 !important;
            visibility: visible !important;
            transition: background-color 0.2s, color 0.2s !important;
        }
        #appSidebar .accordion-collapse a.sidebar-link i {
            margin-left: 4px !important;
        }

        #appSidebar .accordion-collapse a.sidebar-link:hover {
            background-color: #f1f5f9 !important; /* hover:bg-slate-100 */
            color: #0f172a !important; /* hover:text-slate-900 */
        }

        /* Dark mode overrides for sub-menu links */
        html.theme-dark #appSidebar .accordion-collapse a.sidebar-link,
        html[data-theme="dark"] #appSidebar .accordion-collapse a.sidebar-link,
        body[data-theme="dark"] #appSidebar .accordion-collapse a.sidebar-link {
            color: #cbd5e1 !important; /* dark:text-slate-300 */
            background: transparent !important;
        }

        html.theme-dark #appSidebar .accordion-collapse a.sidebar-link:hover,
        html[data-theme="dark"] #appSidebar .accordion-collapse a.sidebar-link:hover,
        body[data-theme="dark"] #appSidebar .accordion-collapse a.sidebar-link:hover {
            background-color: #1e293b !important; /* dark:hover:bg-slate-800 */
            color: #ffffff !important;
        }
    </style>
</head>
<body data-theme="@themePreference.ToLowerInvariant()" class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-200 font-sans antialiased min-h-screen flex flex-col md:flex-row">
    <div id="sidebarOverlay" class="sidebar-overlay fixed inset-0 z-40 hidden bg-slate-950/40 backdrop-blur-sm lg:hidden"></div>
    <form id="rhGlobalAntiForgery" class="d-none">@Html.AntiForgeryToken()</form>
    <div class="flex h-screen overflow-hidden bg-slate-50 dark:bg-slate-900 w-full">
        <aside id="appSidebar" class="sidebar-right print:hidden fixed inset-y-0 right-0 z-50 flex w-52 translate-x-full flex-col border-l border-slate-200 bg-white/95 shadow-xl backdrop-blur transition-transform duration-200 lg:static lg:flex lg:w-56 lg:flex-shrink-0 lg:translate-x-0 lg:shadow-none dark:border-slate-800 dark:bg-slate-955/95 flex flex-col z-40">
            <div class="flex h-12 items-center gap-2 border-b border-slate-200 px-2.5 dark:border-slate-800">
                <a asp-controller="Home" asp-action="Index" class="flex min-w-0 flex-1 items-center gap-2 text-decoration-none">
                    @if (!string.IsNullOrWhiteSpace(brandLogo))
                    {
                        <img src="@brandLogo" alt="@appTitle" class="h-8 w-8 rounded-lg object-contain border border-slate-200 dark:border-slate-700 bg-white p-0.5" onerror="this.parentElement.querySelector('.brand-fallback').style.display='flex'; this.style.display='none'" />
                        <span class="brand-fallback hidden h-8 w-8 place-items-center rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-950"><i class="bi bi-grid-1x2-fill text-sm"></i></span>
                    }
                    else
                    {
                        <span class="grid h-8 w-8 place-items-center rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-950"><i class="bi bi-grid-1x2-fill text-sm"></i></span>
                    }
                    <span class="min-w-0"><span class="block truncate text-sm font-black text-slate-900 dark:text-white">@appTitle</span><span class="block truncate text-[10px] font-medium text-slate-500 dark:text-slate-400">سیستم جامع سازمانی</span></span>
                </a>
                <button id="btnCloseSidebar" type="button" class="grid h-8 w-8 place-items-center rounded-md text-slate-500 hover:bg-slate-100 lg:hidden dark:text-slate-400 dark:hover:bg-slate-800" aria-label="بستن منو"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="border-b border-slate-200 p-2 dark:border-slate-800">
                <label class="relative block"><i class="bi bi-search pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i><input id="sidebarMenuSearch" type="search" autocomplete="off" placeholder="جستجوی منو" aria-label="جستجوی منو" class="h-8 w-full rounded-md border border-slate-200 bg-slate-50 pr-7 pl-2 text-[12px] text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100" /></label>
                <div class="mt-1 flex items-center justify-between px-1 text-[10px] text-slate-500 dark:text-slate-400"><span id="sidebarSearchCount">همه بخش‌ها</span><button id="sidebarSearchClear" type="button" class="hidden font-bold text-teal-700 dark:text-teal-300">پاک کردن</button></div>
            </div>
            <nav id="sidebarScrollContainer" class="min-h-0 flex-1 space-y-3 overflow-y-auto px-2 py-3">
                <div id="sidebarSearchNoResults" class="sidebar-search-no-results hidden rounded-md border border-amber-200 bg-amber-50 px-2 py-2 text-[11px] text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">نتیجه‌ای در منو پیدا نشد.</div>
                <section><div class="mb-1 px-2 text-[10px] font-black uppercase tracking-wide text-slate-400 dark:text-slate-500">دسترسی سریع</div><div class="space-y-1">
                    <a class='@NavClass("Home")' data-nav-id="home-index" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 w-4 text-sky-500 me-2"></i><span class="link-text truncate">میز کار</span></a>
                    <a class='@NavClass("WorkInbox")' data-nav-id="workinbox-index" asp-controller="WorkInbox" asp-action="Index"><i class="bi bi-inboxes w-4 text-indigo-500 me-2"></i><span class="link-text truncate">کارتابل</span></a>
                    @if (userCanAccessFinance) { <a class='@NavClass("Financial", "GetTrialBalance")' data-nav-id="financial-trialbalance" asp-controller="Financial" asp-action="GetTrialBalance"><i class="bi bi-table w-4 text-teal-500 me-2"></i><span class="link-text truncate">تراز آزمایشی</span></a> }
                </div></section>
                <div id="sidebarAccordion" class="space-y-2">
                    @if (userCanAccessHumanCapital)
                    {
                        <section class="accordion-item sidebar-module">
                            <button class="@moduleButtonClass" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHumanCapital"><span>سرمایه انسانی</span><i class="bi bi-chevron-down text-[10px]"></i></button>
                            <div id="collapseHumanCapital" class="accordion-collapse collapse @((currentController == "HumanCapital" || currentController == "Leaves" || currentController == "Letters") ? "show" : "")"><div class="mt-1 space-y-1">
                                <a class='@NavClass("HumanCapital")' data-nav-id="humancapital-index" asp-controller="HumanCapital" asp-action="Index"><i class="bi bi-person-badge w-4 text-amber-500 me-2"></i><span class="link-text truncate">منابع انسانی</span></a>
                                <a class='@NavClass("Leaves")' data-nav-id="leaves-index" asp-controller="Leaves" asp-action="Index"><i class="bi bi-calendar2-week w-4 text-sky-500 me-2"></i><span class="link-text truncate">مرخصی‌ها</span></a>
                                <a class='@NavClass("Letters")' data-nav-id="letters-index" asp-controller="Letters" asp-action="Index"><i class="bi bi-envelope w-4 text-purple-500 me-2"></i><span class="link-text truncate">نامه‌ها</span></a>
                            </div></div>
                        </section>
                    }
                    @if (userCanAccessFinance)
                    {
                        <section class="accordion-item sidebar-module">
                            <button class="@moduleButtonClass" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFinancial"><span>مالی و حسابداری</span><i class="bi bi-chevron-down text-[10px]"></i></button>
                            <div id="collapseFinancial" class="accordion-collapse collapse @((currentController == "Payroll" || currentController == "Bimeh" || currentController == "Financial") ? "show" : "")"><div class="mt-1 space-y-1">
                                <a class='@NavClass("Financial", "Dashboard")' data-nav-id="financial-dashboard" asp-controller="Financial" asp-action="Dashboard"><i class="bi bi-grid-3x3-gap w-4 text-emerald-500 me-2"></i><span class="link-text truncate">داشبورد مالی</span></a>
                                <a class='@NavClass("Financial", "Invoices")' data-nav-id="financial-invoices" asp-controller="Financial" asp-action="Invoices"><i class="bi bi-receipt w-4 text-teal-500 me-2"></i><span class="link-text truncate">فاکتورها</span></a>
                                <a class='@NavClass("Financial", "LedgerOperations")' data-nav-id="financial-ledger" asp-controller="Financial" asp-action="LedgerOperations"><i class="bi bi-journal-richtext w-4 text-cyan-500 me-2"></i><span class="link-text truncate">دفتر کل</span></a>
                                <a class='@NavClass("Financial", "GetTrialBalance")' data-nav-id="financial-trialbalance" asp-controller="Financial" asp-action="GetTrialBalance"><i class="bi bi-table w-4 text-indigo-500 me-2"></i><span class="link-text truncate">تراز آزمایشی</span></a>
                                <a class='@NavClass("Financial", "VatDashboard")' data-nav-id="financial-vat" asp-controller="Financial" asp-action="VatDashboard"><i class="bi bi-percent w-4 text-pink-500 me-2"></i><span class="link-text truncate">ارزش افزوده</span></a>
                                <a class='@NavClass("Financial", "SeasonalTax")' data-nav-id="financial-seasonaltax" asp-controller="Financial" asp-action="SeasonalTax"><i class="bi bi-file-earmark-bar-graph w-4 text-indigo-600 me-2"></i><span class="link-text truncate">گزارشات فصلی ۱۶۹</span></a>
                                <a class='@NavClass("Financial", "ReportingHub")' data-nav-id="financial-reporting" asp-controller="Financial" asp-action="ReportingHub"><i class="bi bi-bar-chart-line w-4 text-rose-500 me-2"></i><span class="link-text truncate">گزارش‌ها</span></a>
                                <a class='@NavClass("Payroll")' data-nav-id="payroll-index" asp-controller="Payroll" asp-action="Index"><i class="bi bi-wallet2 w-4 text-violet-500 me-2"></i><span class="link-text truncate">حقوق</span></a>
                                <a class='@NavClass("Bimeh")' data-nav-id="bimeh-index" asp-controller="Bimeh" asp-action="Index"><i class="bi bi-shield-check w-4 text-blue-500 me-2"></i><span class="link-text truncate">بیمه</span></a>
                            </div></div>
                        </section>
                    }
                    @if (userCanAccessWarehouse)
                    {
                        <section class="accordion-item sidebar-module">
                            <button class="@moduleButtonClass" type="button" data-bs-toggle="collapse" data-bs-target="#collapseWarehouse"><span>انبار و عملیات</span><i class="bi bi-chevron-down text-[10px]"></i></button>
                            <div id="collapseWarehouse" class="accordion-collapse collapse @((currentController == "Warehouse" || currentController == "WarehouseInventory" || currentController == "WarehouseReceipts" || currentController == "WarehouseIssuances" || currentController == "WarehouseTransfer" || currentController == "Vendors" || currentController == "Waybill") ? "show" : "")"><div class="mt-1 space-y-1">
                                <a class='@NavClass("Warehouse")' data-nav-id="warehouse-index" asp-controller="Warehouse" asp-action="Index"><i class="bi bi-box-seam w-4 text-orange-500 me-2"></i><span class="link-text truncate">داشبورد انبار</span></a>
                                <a class='@NavClass("Warehouse", "Products")' data-nav-id="warehouse-products" asp-controller="Warehouse" asp-action="Products"><i class="bi bi-box w-4 text-yellow-500 me-2"></i><span class="link-text truncate">کالاها</span></a>
                                <a class='@NavClass("WarehouseInventory", "Stock")' data-nav-id="warehouse-stock" asp-controller="WarehouseInventory" asp-action="Stock"><i class="bi bi-layers w-4 text-lime-500 me-2"></i><span class="link-text truncate">موجودی</span></a>
                                <a class='@NavClass("WarehouseReceipts", "Receipts")' data-nav-id="warehouse-receipts" asp-controller="WarehouseReceipts" asp-action="Receipts"><i class="bi bi-box-arrow-in-down w-4 text-emerald-500 me-2"></i><span class="link-text truncate">رسیدها</span></a>
                                <a class='@NavClass("WarehouseIssuances", "Issuances")' data-nav-id="warehouse-issuances" asp-controller="WarehouseIssuances" asp-action="Issuances"><i class="bi bi-box-arrow-up w-4 text-red-500 me-2"></i><span class="link-text truncate">حواله‌ها</span></a>
                                <a class='@NavClass("Vendors")' data-nav-id="vendors-index" asp-controller="Vendors" asp-action="Index"><i class="bi bi-building w-4 text-blue-500 me-2"></i><span class="link-text truncate">تامین‌کنندگان</span></a>
                                <a class='@NavClass("Waybill")' data-nav-id="waybill-index" asp-controller="Waybill" asp-action="Index"><i class="bi bi-truck w-4 text-indigo-500 me-2"></i><span class="link-text truncate">بارنامه</span></a>
                            </div></div>
                        </section>
                    }
                    @if (userCanAccessSystemSettings || userCanAccessProcessAnalytics)
                    {
                        <section class="accordion-item sidebar-module">
                            <button class="@moduleButtonClass" type="button" data-bs-toggle="collapse" data-bs-target="#collapseManagement"><span>مدیریت سیستم</span><i class="bi bi-chevron-down text-[10px]"></i></button>
                            <div id="collapseManagement" class="accordion-collapse collapse @((currentController == "Settings" || currentController == "Security" || currentController == "AuditDashboard" || currentController == "ProcessAnalysis" || currentController == "Reports" || currentController == "ManagementDashboard") ? "show" : "")"><div class="mt-1 space-y-1">
                                @if (userCanAccessSystemSettings)
                                {
                                    <a class='@NavClass("ManagementDashboard", "Overview")' data-nav-id="management-overview" asp-controller="ManagementDashboard" asp-action="Overview"><i class="bi bi-grid-1x2 w-4 text-emerald-500 me-2"></i><span class="link-text truncate">داشبورد مدیریتی</span></a>
                                    <a class='@NavClass("ManagementDashboard", "Index")' data-nav-id="management-dashboard" asp-controller="ManagementDashboard" asp-action="Index"><i class="bi bi-stars w-4 text-indigo-500 me-2"></i><span class="link-text truncate">گزارش‌ساز هوشمند</span></a>
                                    <a class='@NavClass("Settings")' data-nav-id="settings-index" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear w-4 text-slate-500 dark:text-slate-400 me-2"></i><span class="link-text truncate">تنظیمات</span></a>
                                    <a class='@NavClass("Security")' data-nav-id="security-index" asp-controller="Security" asp-action="Index"><i class="bi bi-shield-lock w-4 text-rose-500 me-2"></i><span class="link-text truncate">امنیت</span></a>
                                    <a class='@NavClass("Security", "WorkflowBuilder")' data-nav-id="security-workflowbuilder" asp-controller="Security" asp-action="WorkflowBuilder"><i class="bi bi-diagram-3 w-4 text-teal-500 me-2"></i><span class="link-text truncate">طراح گردش کار</span></a>
                                    <a class='@NavClass("AuditDashboard")' data-nav-id="audit-index" asp-controller="AuditDashboard" asp-action="Index"><i class="bi bi-activity w-4 text-cyan-500 me-2"></i><span class="link-text truncate">ممیزی</span></a>
                                }
                                @if (userCanAccessProcessAnalytics)
                                {
                                    <a class='@NavClass("ProcessAnalysis")' data-nav-id="process-index" asp-controller="ProcessAnalysis" asp-action="Index"><i class="bi bi-diagram-3 w-4 text-purple-500 me-2"></i><span class="link-text truncate">تحلیل فرایند</span></a>
                                }
                                <a class='@NavClass("Reports")' data-nav-id="reports-index" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-bar-graph w-4 text-indigo-500 me-2"></i><span class="link-text truncate">گزارشات</span></a>
                            </div></div>
                        </section>
                    }
                </div>
            </nav>
            <div class="border-t border-slate-200 p-2 dark:border-slate-800"><a class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2 py-2 text-decoration-none dark:border-slate-800 dark:bg-slate-900" asp-controller="Settings" asp-action="Index"><span class="grid h-8 w-8 place-items-center rounded-md bg-white text-slate-600 dark:bg-slate-800 dark:text-slate-300"><i class="bi bi-person"></i></span><span class="min-w-0 flex-1"><span class="block truncate text-[12px] font-bold text-slate-800 dark:text-slate-100">@displayName</span><span class="block truncate text-[10px] text-slate-500 dark:text-slate-400">@userRoleLabel</span></span></a></div>
        </aside>
        <div class="flex-1 flex flex-col min-w-0 h-full overflow-hidden z-10">
            <header class="print:hidden sticky top-0 z-30 flex h-12 items-center gap-2 border-b border-slate-200 bg-slate-100/85 px-2.5 backdrop-blur dark:border-slate-800 dark:bg-slate-955/85">
                <button id="btnOpenSidebar" type="button" class="grid h-8 w-8 place-items-center rounded-md border border-slate-200 bg-white text-slate-600 lg:hidden dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300" aria-label="باز کردن منو"><i class="bi bi-list text-lg"></i></button>
                <form asp-controller="Search" asp-action="Index" method="get" role="search" class="relative hidden min-w-0 flex-1 md:block"><i class="bi bi-search pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i><input name="q" value="@(Context.Request.Query["q"].ToString())" autocomplete="off" placeholder="جستجو در سیستم..." class="h-8 w-full rounded-md border border-slate-200 bg-white pr-9 pl-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100" /></form>
                <div class="mr-auto flex items-center gap-2">
                    <div class="hidden items-center gap-2 rounded-md border border-slate-200 bg-white px-2 py-0.5 text-[11px] text-slate-500 md:flex dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400"><i class="bi bi-clock-history"></i><span id="topbarDate">--/--/--</span><span class="text-slate-300 dark:text-slate-700">|</span><span id="topbarTime">--:--</span></div>
                    <div class="dropdown"><button class="relative grid h-8 w-8 place-items-center rounded-md border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="اعلان‌ها"><i class="bi bi-bell"></i>@if (headerNotificationCount > 0){<span class="absolute -left-1 -top-1 min-w-5 rounded-full bg-rose-600 px-1 text-[10px] font-black leading-5 text-white">@headerNotificationCount.ToString("N0")</span>}</button>
                        <div class="dropdown-menu dropdown-menu-start mt-2 w-80 overflow-hidden rounded-xl border border-slate-200 bg-white p-0 shadow-xl dark:border-slate-800 dark:bg-slate-900"><div class="flex items-center justify-between border-b border-slate-200 px-3 py-2 dark:border-slate-800"><strong class="text-sm text-slate-900 dark:text-white">اعلان‌ها</strong><span class="text-[11px] text-slate-500 dark:text-slate-400">@headerNotificationCount.ToString("N0") مورد</span></div>
                            @if (headerNotifications.Count == 0){<div class="px-3 py-4 text-center text-[12px] text-slate-500 dark:text-slate-400">اعلان مهمی برای نمایش وجود ندارد.</div>}else{foreach (var notification in headerNotifications.Take(8)){<a class="flex gap-2 border-b border-slate-100 px-3 py-2 text-decoration-none transition hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800" href="@notification.Url"><i class="bi @notification.Icon mt-0.5 text-slate-500 dark:text-slate-400"></i><span class="min-w-0"><strong class="block truncate text-[12px] text-slate-900 dark:text-white">@notification.Title</strong><small class="block truncate text-[11px] text-slate-500 dark:text-slate-400">@notification.Message</small></span></a>}}
                            <a class="block px-3 py-2 text-center text-[12px] font-bold text-teal-700 text-decoration-none hover:bg-slate-50 dark:text-teal-300 dark:hover:bg-slate-800" href="/Notifications">مشاهده همه اعلان‌ها</a></div>
                    </div>
                    <partial name="_LoginPartial" />
                </div>
            </header>
            <main id="main-content-wrapper" class="flex-1 flex flex-col w-full overflow-hidden">
                <div class="p-2.5 md:p-3.5 lg:p-4.5 overflow-y-auto w-full flex-1 print:w-full print:m-0 print:p-0 print:block">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <div class="modal fade" id="appConfirmDialog" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900"><div class="modal-header border-slate-200 dark:border-slate-800"><h5 class="modal-title text-sm font-bold text-slate-900 dark:text-white">تایید عملیات</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p id="appConfirmMessage" class="mb-0 text-sm text-slate-700 dark:text-slate-300">آیا مطمئن هستید؟</p></div><div class="modal-footer border-slate-200 dark:border-slate-800"><button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">لغو</button><button type="button" class="btn btn-danger btn-sm" id="appConfirmOk">تایید</button></div></div></div></div>
    <div class="modal fade" id="appCommandPalette" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content command-palette overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900"><div class="command-palette-head flex items-center gap-2 border-b border-slate-200 p-3 dark:border-slate-800"><i class="bi bi-command text-slate-400"></i><input id="appCommandInput" type="search" autocomplete="off" placeholder="جستجوی فرمان، صفحه یا گزارش..." aria-label="جستجوی فرمان" class="min-w-0 flex-1 bg-transparent text-sm text-slate-900 outline-none dark:text-white"><kbd class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-[10px] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Ctrl K</kbd></div><div id="appCommandList" class="command-palette-list max-h-96 overflow-y-auto p-2"></div><div class="command-palette-foot border-t border-slate-200 px-3 py-2 text-[11px] text-slate-500 dark:border-slate-800 dark:text-slate-400">Enter برای اجرا، Esc برای بستن</div></div></div></div>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/professional-table.js" asp-append-version="true"></script>
    <script>
        (() => {
            const html = document.documentElement;
            const storedPreference = localStorage.getItem('rhyno.theme.preference');
            const activePreference = storedPreference || '@themePreference';
            const normalized = (activePreference || 'System').toLowerCase();
            html.classList.remove('theme-light', 'theme-dark', 'dark');
            html.setAttribute('data-theme', normalized);
            document.body?.setAttribute('data-theme', normalized);
            if (normalized === 'dark') { html.classList.add('theme-dark', 'dark'); window.dispatchEvent(new Event('themechange')); return; }
            if (normalized === 'light') { html.classList.add('theme-light'); window.dispatchEvent(new Event('themechange')); return; }
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            html.classList.add(prefersDark ? 'theme-dark' : 'theme-light');
            if (prefersDark) html.classList.add('dark');
            window.dispatchEvent(new Event('themechange'));
        })();
    </script>
    <script>
        (() => {
            const timeElem = document.getElementById('topbarTime');
            const dateElem = document.getElementById('topbarDate');
            if (!timeElem || !dateElem) return;
            const updateClockAndDate = () => {
                const now = new Date();
                timeElem.textContent = now.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', hour12: false });
                dateElem.textContent = new Intl.DateTimeFormat('fa-IR-u-ca-persian', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
            };
            updateClockAndDate();
            setInterval(updateClockAndDate, 30000);
        })();
    </script>
    <script>
        (() => {
            const input = document.getElementById('sidebarMenuSearch');
            const clearButton = document.getElementById('sidebarSearchClear');
            const countLabel = document.getElementById('sidebarSearchCount');
            const noResults = document.getElementById('sidebarSearchNoResults');
            const sidebarContainer = document.getElementById('sidebarScrollContainer');
            if (!input || !clearButton || !countLabel || !noResults || !sidebarContainer) return;
            
            const normalize = (value) => String(value || '').replace(/[ي]/g, 'ی').replace(/[ك]/g, 'ک').replace(/\s+/g, ' ').trim().toLowerCase();
            
            const links = Array.from(sidebarContainer.querySelectorAll('a.sidebar-link'));
            const groups = Array.from(sidebarContainer.querySelectorAll('.sidebar-module'));
            
            // Store initial collapse state of each module to restore when search is cleared
            const initialCollapseStates = new Map();
            groups.forEach(group => {
                const collapseDiv = group.querySelector('.accordion-collapse');
                if (collapseDiv) {
                    initialCollapseStates.set(collapseDiv, collapseDiv.classList.contains('show'));
                }
            });
            
            const resetSearch = () => {
                links.forEach((link) => link.classList.remove('hidden'));
                groups.forEach((group) => {
                    group.classList.remove('hidden');
                    const collapseDiv = group.querySelector('.accordion-collapse');
                    if (collapseDiv) {
                        const wasInitiallyShown = initialCollapseStates.get(collapseDiv);
                        if (wasInitiallyShown) {
                            collapseDiv.classList.add('show');
                        } else {
                            collapseDiv.classList.remove('show');
                        }
                    }
                });
                noResults.classList.add('hidden');
                noResults.classList.remove('is-visible');
                clearButton.classList.add('hidden');
                countLabel.textContent = 'همه بخش‌ها';
            };
            
            const applySearch = () => {
                const query = normalize(input.value);
                if (!query) { resetSearch(); return; }
                let matchCount = 0;
                
                // Filter sidebar links
                links.forEach((link) => {
                    const matches = normalize(link.textContent).includes(query);
                    link.classList.toggle('hidden', !matches);
                    if (matches) matchCount += 1;
                });
                
                // Show/hide modules and expand collapses if they contain matching links
                groups.forEach((group) => {
                    const groupLinks = Array.from(group.querySelectorAll('a.sidebar-link'));
                    const hasVisibleLink = groupLinks.some((link) => !link.classList.contains('hidden'));
                    const headerMatches = normalize(group.querySelector('button')?.textContent).includes(query);
                    
                    const isVisible = hasVisibleLink || headerMatches;
                    group.classList.toggle('hidden', !isVisible);
                    
                    const collapseDiv = group.querySelector('.accordion-collapse');
                    if (collapseDiv) {
                        if (isVisible) {
                            collapseDiv.classList.add('show');
                            if (headerMatches) {
                                // If group header matched, show all links within this group
                                groupLinks.forEach((link) => link.classList.remove('hidden'));
                            }
                        } else {
                            collapseDiv.classList.remove('show');
                        }
                    }
                });
                
                noResults.classList.toggle('hidden', matchCount !== 0);
                noResults.classList.toggle('is-visible', matchCount === 0);
                clearButton.classList.remove('hidden');
                countLabel.textContent = matchCount === 0 ? 'بدون نتیجه' : `${matchCount.toLocaleString('fa-IR')} نتیجه`;
            };
            
            input.addEventListener('input', applySearch);
            clearButton.addEventListener('click', () => { input.value = ''; input.focus(); resetSearch(); });
        })();
    </script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script>
        (function() {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/automationHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveNewTaskNotification", function (data) {
                // Show standard toast/alert
                alert(`[کار جدید] \n${data.message}`);

                // Dynamically update count badge on the WorkInbox sidebar menu
                const sidebarItem = document.querySelector('[data-nav-id="workinbox-index"]');
                if (sidebarItem) {
                    let badge = sidebarItem.querySelector('.inbox-badge-count');
                    if (!badge) {
                        badge = document.createElement('span');
                        badge.className = 'inbox-badge-count inline-flex items-center justify-center px-1.5 py-0.5 rounded-full bg-teal-600 text-white text-[9px] font-black mr-auto';
                        sidebarItem.appendChild(badge);
                    }
                    const currentCount = parseInt(badge.textContent) || 0;
                    badge.textContent = currentCount + 1;
                }
            });

            connection.start()
                .then(() => console.log("SignalR Connection established."))
                .catch(err => console.error("SignalR Connection failed: ", err));
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/app-ui.js" asp-append-version="true"></script>
</body>
</html>

