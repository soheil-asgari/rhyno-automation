                                                            class="bi bi-journal-arrow-down menu-icon"></i> دفاتر حسابداری</a></li>
                                                    <li><a class='menu-item @(currentController == "Financial" && currentAction == "Invoices" ? "active" : "")'
                                                           asp-controller="Financial" asp-action="Invoices"><i class="bi bi-receipt menu-icon"></i>
                                                        فاکتورها</a></li>
                                                        <li><a class='menu-item @(currentController == "Financial" && currentAction == "LedgerOperations" ? "active" : "")'
                                                               asp-controller="Financial" asp-action="LedgerOperations"><i
                                                            class="bi bi-journal-richtext menu-icon"></i> دفتر کل</a></li>
                                                            <li><a class='menu-item @(currentController == "Financial" && currentAction == "GetTrialBalance" ? "active" : "")'
