                                                                                                                        <!-- زیرگروه ۲: بازرگانی و فروش (سبز روشن با متن مشکی) -->
                                                                                                                        <div class="sub-menu-group" style="margin-bottom: 6px;">
                                                                                                                            <button type="button" onclick="toggleSubgroup(this)"
                                                                                                                                    style="display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 8px 12px; background: #d1fae5; border-right: 4px solid #10b981; color: #000; font-size: 11.5px; font-weight: 700; border-radius: 4px; cursor: pointer; border-left: none; border-top: none; border-bottom: none;">
                                                                                                                                <span><i class="bi bi-cart-check ml-1 text-emerald-600"></i> بازرگانی و فروش</span>
                                                                                                                                <i class="bi bi-chevron-down chevron text-xs"
                                                                                                                                   style="transform: rotate(-90deg); transition: transform 0.3s;"></i>
                                                                                                                            </button>
                                                                                                                            <ul class="sub-menu-list"
                                                                                                                                style="max-height: 0px; overflow: hidden; transition: max-height 0.3s ease; padding-right: 8px; margin-top: 2px; list-style: none;">
                                                                                                                                <li><a class='menu-item @(currentController == "Commercial" && currentAction == "Sales" ? "active" : "")'
                                                                                                                                       asp-controller="Commercial" asp-action="Sales"><i
                                                                                                                                    class="bi bi-graph-up-arrow menu-icon"></i> فروش (بازرگانی)</a></li>
                                                                                                                                    <li><a class='menu-item @(currentController == "Commercial" && currentAction == "Purchases" ? "active" : "")'
