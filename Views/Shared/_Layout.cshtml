                                                                                                                                                <li><a class='menu-item @(currentController == "Commercial" && currentAction == "Quotations" ? "active" : "")'
                                                                                                                                                       asp-controller="Commercial" asp-action="Quotations" asp-route-type="Sale"><i
                                                                                                                                                    class="bi bi-file-earmark-text menu-icon"></i> پیش‌فاکتورها</a></li>
