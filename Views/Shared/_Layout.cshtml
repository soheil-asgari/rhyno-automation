                                                                                                                    <li><a class='menu-item @(currentController == "Financial" && currentAction == "GetTrialBalance" ? "active" : "")'
                                                                                                                           asp-controller="Financial" asp-action="GetTrialBalance"><i
                                                                                                                        class="bi bi-table menu-icon"></i> تراز آزمایشی</a></li>
                                                                                                                        <li><a class='menu-item @(currentController == "Financial" && currentAction == "Invoices" ? "active" : "")'
                                                                                                                               asp-controller="Financial" asp-action="Invoices"><i
                                                                                                                            class="bi bi-receipt menu-icon"></i> فاکتورها</a></li>
                                                                                                                            <li><a class='menu-item @(currentController == "Financial" && currentAction == "ReportingHub" ? "active" : "")'
