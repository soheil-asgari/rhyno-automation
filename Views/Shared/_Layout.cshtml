                                                                                                                                                                                <script>
                                                                                                                                                                                    function toggleSubgroup(btn) {
                                                                                                                                                                                    const list = btn.nextElementSibling;
                                                                                                                                                                                    const chevron = btn.querySelector('.chevron');
                                                                                                                                                                                    const isOpen = list.style.maxHeight && list.style.maxHeight !== '0px';
                                                                                                                                                                                    if (isOpen) {
                                                                                                                                                                                    list.style.maxHeight = '0px';
                                                                                                                                                                                    if (chevron) chevron.style.transform = 'rotate(-90deg)';
                                                                                                                                                                                    } else {
                                                                                                                                                                                    const items = list.querySelectorAll('li').length;
                                                                                                                                                                                    list.style.maxHeight = (items * 34 + 10) + 'px';
                                                                                                                                                                                    if (chevron) chevron.style.transform = 'rotate(0deg)';
                                                                                                                                                                                    const moduleChildren = btn.closest('.module-children');
                                                                                                                                                                                    if (moduleChildren) moduleChildren.style.maxHeight = '5000px';
                                                                                                                                                                                    }
                                                                                                                                                                                    }
                                                                                                                                                                                </script>
