                                                                                                                                                           asp-controller="Commercial" asp-action="Parties"><i
                                                                                                                                                        class="bi bi-people menu-icon"></i> طرف‌های حساب</a></li>
                                                                                                                                                    </ul>
                                                                                                                                                </div>

                                                                                                                                                <!-- زیرگروه ۳: مالیات و سامانه مؤدیان (نارنجی روشن با متن مشکی) -->
