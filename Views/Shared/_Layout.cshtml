                                                <li><a class='menu-item @(currentController == "Contracts" && currentAction == "Index" ? "active" : "")'
                                                       asp-controller="Contracts" asp-action="Index"><i
                                                    class="bi bi-file-earmark-text menu-icon"></i> فهرست قراردادها</a></li>
                                                <li><a class='menu-item @(currentController == "Contracts" && currentAction == "Create" ? "active" : "")'
