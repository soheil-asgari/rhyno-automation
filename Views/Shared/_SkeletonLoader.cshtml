@* 
    Skeleton Loading Components
  
    پارامترها (ViewData):
    Type: string - "card", "table", "table-rows", "form", "detail", "chart", "list", "stats"
    Count: int (اختیاری - تعداد تکرار برای table-rows و list، پیش‌فرض: 5)
*@

@{
    var type = (string)(ViewData["Type"] ?? "card");
    var count = (int)(ViewData["Count"] ?? 5);
}

@switch (type)
{
    case "card":
        @* Skeleton Card *@
        <div class="animate-pulse rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800/50">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
                <div class="flex-1 space-y-2">
                    <div class="h-4 w-1/3 rounded bg-slate-200 dark:bg-slate-700"></div>
                    <div class="h-3 w-2/3 rounded bg-slate-100 dark:bg-slate-700/50"></div>
                </div>
            </div>
        </div>
        break;

    case "table":
        @* Skeleton Table *@
        <div class="animate-pulse rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800/50">
            <div class="border-b border-slate-200 p-4 dark:border-slate-700">
                <div class="flex items-center gap-4">
                    <div class="h-5 w-1/4 rounded bg-slate-200 dark:bg-slate-700"></div>
                    <div class="h-5 w-1/6 rounded bg-slate-200 dark:bg-slate-700"></div>
                    <div class="h-5 w-1/6 rounded bg-slate-200 dark:bg-slate-700"></div>
                    <div class="h-5 w-1/6 rounded bg-slate-200 dark:bg-slate-700"></div>
                </div>
            </div>
            @for (int i = 0; i < count; i++)
            {
                <div class="border-b border-slate-100 p-4 dark:border-slate-800">
                    <div class="flex items-center gap-4">
                        <div class="h-4 w-1/4 rounded bg-slate-100 dark:bg-slate-700/50"></div>
                        <div class="h-4 w-1/6 rounded bg-slate-100 dark:bg-slate-700/50"></div>
                        <div class="h-4 w-1/6 rounded bg-slate-100 dark:bg-slate-700/50"></div>
                        <div class="h-8 w-16 rounded-lg bg-slate-100 dark:bg-slate-700/50"></div>
                    </div>
                </div>
            }
        </div>
        break;

    case "table-rows":
        @* Skeleton Table Rows (just rows, no table wrapper) *@
        @for (int i = 0; i < count; i++)
        {
            <div class="animate-pulse flex items-center gap-4 border-b border-slate-100 p-3 dark:border-slate-800">
                <div class="h-4 w-1/5 rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="h-4 w-1/5 rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="h-4 w-1/5 rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="h-4 w-1/6 rounded bg-slate-200 dark:bg-slate-700"></div>
            </div>
        }
        break;

    case "form":
        @* Skeleton Form *@
        <div class="animate-pulse space-y-5 rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800/50">
            <div class="space-y-2">
                <div class="h-4 w-1/6 rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="h-10 w-full rounded-lg bg-slate-200 dark:bg-slate-700"></div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-2">
                    <div class="h-4 w-1/3 rounded bg-slate-200 dark:bg-slate-700"></div>
                    <div class="h-10 w-full rounded-lg bg-slate-200 dark:bg-slate-700"></div>
                </div>
                <div class="space-y-2">
                    <div class="h-4 w-1/3 rounded bg-slate-200 dark:bg-slate-700"></div>
                    <div class="h-10 w-full rounded-lg bg-slate-200 dark:bg-slate-700"></div>
                </div>
            </div>
            <div class="space-y-2">
                <div class="h-4 w-1/6 rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="h-24 w-full rounded-lg bg-slate-200 dark:bg-slate-700"></div>
            </div>
            <div class="flex gap-3">
                <div class="h-10 w-24 rounded-lg bg-teal-200 dark:bg-teal-700/30"></div>
                <div class="h-10 w-24 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
            </div>
        </div>
        break;

    case "detail":
        @* Skeleton Detail View *@
        <div class="animate-pulse space-y-4 rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800/50">
            <div class="flex items-center gap-3 border-b border-slate-100 pb-4 dark:border-slate-800">
                <div class="h-12 w-12 rounded-xl bg-slate-200 dark:bg-slate-700"></div>
                <div class="space-y-2">
                    <div class="h-5 w-40 rounded bg-slate-200 dark:bg-slate-700"></div>
                    <div class="h-3 w-24 rounded bg-slate-100 dark:bg-slate-700/50"></div>
                </div>
                <div class="mr-auto h-8 w-8 rounded-full bg-slate-200 dark:bg-slate-700"></div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="space-y-1.5">
                        <div class="h-3 w-16 rounded bg-slate-100 dark:bg-slate-700/50"></div>
                        <div class="h-4 w-32 rounded bg-slate-200 dark:bg-slate-700"></div>
                    </div>
                }
            </div>
        </div>
        break;

    case "chart":
        @* Skeleton Chart Area *@
        <div class="animate-pulse rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800/50">
            <div class="mb-4 flex items-center justify-between">
                <div class="h-5 w-32 rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="h-8 w-20 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
            </div>
            <div class="flex items-end justify-between gap-2 h-40 px-4">
                @for (int i = 0; i < 7; i++)
                {
                    var height = new Random().Next(30, 100);
                    <div class="flex-1 flex flex-col items-center gap-2 justify-end" style="height: 100%">
                        <div class="w-full rounded-t-md bg-slate-200 dark:bg-slate-700" style="height: @(height)%"></div>
                        <div class="h-2 w-8 rounded bg-slate-100 dark:bg-slate-700/50"></div>
                    </div>
                }
            </div>
        </div>
        break;

    case "list":
        @* Skeleton List *@
        <div class="animate-pulse space-y-2">
            @for (int i = 0; i < count; i++)
            {
                <div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800/50">
                    <div class="h-9 w-9 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
                    <div class="flex-1 space-y-1.5">
                        <div class="h-4 w-1/3 rounded bg-slate-200 dark:bg-slate-700"></div>
                        <div class="h-3 w-1/2 rounded bg-slate-100 dark:bg-slate-700/50"></div>
                    </div>
                    <div class="h-6 w-16 rounded-full bg-slate-200 dark:bg-slate-700"></div>
                </div>
            }
        </div>
        break;

    case "stats":
        @* Skeleton Stats Cards *@
        <div class="animate-pulse grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            @for (int i = 0; i < 4; i++)
            {
                <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800/50">
                    <div class="flex items-center justify-between mb-3">
                        <div class="h-4 w-20 rounded bg-slate-200 dark:bg-slate-700"></div>
                        <div class="h-7 w-7 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
                    </div>
                    <div class="h-7 w-16 rounded bg-slate-200 dark:bg-slate-700 mb-2"></div>
                    <div class="h-3 w-32 rounded bg-slate-100 dark:bg-slate-700/50"></div>
                </div>
            }
        </div>
        break;
}