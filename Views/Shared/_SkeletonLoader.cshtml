@*
    Skeleton Loading Components

پارامترها (ViewData):
    Type: string - "card", "table", "table-rows", "form", "detail", "chart", "list", "stats"
    Count: int (اختیاری - تعداد تکرار برای table-rows و list، پیش‌فرض: 5)
*@

@{
    var type = (string)(ViewData["Type"] ?? "card");
    var count = (int)(ViewData["Count"] ?? 5);
}

@switch (type)
{
    case "card":
        @* Skeleton Card *@
        <div class="rhyno-card p-3">
            <div class="flex items-center gap-3">
                <div class="h-7 w-7 rounded-[3px] rhyno-skeleton"></div>
                <div class="flex-1 space-y-2">
                    <div class="h-[26px] w-1/3 rounded-[3px] rhyno-skeleton"></div>
                    <div class="h-[26px] w-2/3 rounded-[3px] rhyno-skeleton" style="animation-delay: 0.1s"></div>
                </div>
            </div>
        </div>
        break;

    case "table":
        @* Skeleton Table *@
        <div class="rhyno-card overflow-hidden">
            <div class="border-b border-slate-100/80 p-2 dark:border-slate-800/60">
                <div class="flex items-center gap-4">
                    <div class="h-[26px] w-1/4 rounded-[3px] rhyno-skeleton"></div>
                    <div class="h-[26px] w-1/6 rounded-[3px] rhyno-skeleton" style="animation-delay: 0.1s"></div>
                    <div class="h-[26px] w-1/6 rounded-[3px] rhyno-skeleton" style="animation-delay: 0.2s"></div>
                    <div class="h-[26px] w-1/6 rounded-[3px] rhyno-skeleton" style="animation-delay: 0.3s"></div>
                </div>
            </div>
            @for (int i = 0; i < count; i++)
            {
                <div class="border-b border-slate-100/60 p-2 dark:border-slate-800/40"
                     style="animation-delay: @((i * 0.1).ToString("F1"))s">
                    <div class="flex items-center gap-4">
                        <div class="h-[26px] w-1/4 rounded-[3px] rhyno-skeleton"></div>
                        <div class="h-[26px] w-1/6 rounded-[3px] rhyno-skeleton"></div>
                        <div class="h-[26px] w-1/6 rounded-[3px] rhyno-skeleton"></div>
                        <div class="h-7 w-16 rounded-[3px] rhyno-skeleton"></div>
                    </div>
                </div>
            }
        </div>
        break;

    case "table-rows":
        @* Skeleton Table Rows *@
        @for (int i = 0; i < count; i++)
        {
            <div class="flex items-center gap-4 border-b border-slate-100/60 p-2 dark:border-slate-800/40"
                 style="animation-delay: @((i * 0.08).ToString("F2"))s">
                <div class="h-[26px] w-1/5 rounded-[3px] rhyno-skeleton"></div>
                <div class="h-[26px] w-1/5 rounded-[3px] rhyno-skeleton"></div>
                <div class="h-[26px] w-1/5 rounded-[3px] rhyno-skeleton"></div>
                <div class="h-[26px] w-1/6 rounded-[3px] rhyno-skeleton"></div>
            </div>
        }
        break;

    case "form":
        @* Skeleton Form *@
        <div class="rhyno-card space-y-4 p-4">
            <div class="space-y-2">
                <div class="h-[26px] w-1/6 rounded-[3px] rhyno-skeleton"></div>
                <div class="h-7 w-full rounded-[3px] rhyno-skeleton" style="animation-delay: 0.1s"></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-2">
                    <div class="h-[26px] w-1/3 rounded-[3px] rhyno-skeleton"></div>
                    <div class="h-7 w-full rounded-[3px] rhyno-skeleton" style="animation-delay: 0.1s"></div>
                </div>
                <div class="space-y-2">
                    <div class="h-[26px] w-1/3 rounded-[3px] rhyno-skeleton"></div>
                    <div class="h-7 w-full rounded-[3px] rhyno-skeleton" style="animation-delay: 0.2s"></div>
                </div>
            </div>
            <div class="space-y-2">
                <div class="h-[26px] w-1/6 rounded-[3px] rhyno-skeleton"></div>
                <div class="h-[56px] w-full rounded-[3px] rhyno-skeleton" style="animation-delay: 0.1s"></div>
            </div>
            <div class="flex gap-3">
                <div class="h-7 w-24 rounded-[3px] rhyno-skeleton" style="animation-delay: 0.1s"></div>
                <div class="h-7 w-24 rounded-[3px] rhyno-skeleton" style="animation-delay: 0.2s"></div>
            </div>
        </div>
        break;

    case "detail":
        @* Skeleton Detail View *@
        <div class="rhyno-card space-y-3 p-4">
            <div class="flex items-center gap-3 border-b border-slate-100/80 pb-3 dark:border-slate-800/60">
                <div class="h-9 w-9 rounded-[3px] rhyno-skeleton"></div>
                <div class="space-y-2">
                    <div class="h-[26px] w-40 rounded-[3px] rhyno-skeleton"></div>
                    <div class="h-[26px] w-24 rounded-[3px] rhyno-skeleton" style="animation-delay: 0.1s"></div>
                </div>
                <div class="mr-auto h-7 w-7 rounded-full rhyno-skeleton" style="animation-delay: 0.2s"></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="space-y-1.5" style="animation-delay: @((i * 0.06).ToString("F2"))s">
                        <div class="h-[26px] w-16 rounded-[3px] rhyno-skeleton"></div>
                        <div class="h-[26px] w-32 rounded-[3px] rhyno-skeleton"></div>
                    </div>
                }
            </div>
        </div>
        break;

    case "chart":
        @* Skeleton Chart Area *@
        <div class="rhyno-card p-4">
            <div class="mb-4 flex items-center justify-between">
                <div class="h-[26px] w-32 rounded-[3px] rhyno-skeleton"></div>
                <div class="h-7 w-20 rounded-[3px] rhyno-skeleton" style="animation-delay: 0.1s"></div>
            </div>
            <div class="flex items-end justify-between gap-2 h-40 px-2">
                @for (int i = 0; i < 7; i++)
                {
                    var height = new Random().Next(30, 100);
                    <div class="flex-1 flex flex-col items-center gap-2 justify-end" style="height: 100%">
                        <div class="w-full rounded-t-[3px] rhyno-skeleton" style="height: @(height)%"></div>
                        <div class="h-[26px] w-8 rounded-[3px] rhyno-skeleton"></div>
                    </div>
                }
            </div>
        </div>
        break;

    case "list":
        @* Skeleton List *@
        <div class="space-y-2">
            @for (int i = 0; i < count; i++)
            {
                <div class="flex items-center gap-3 rhyno-card p-2" style="animation-delay: @((i * 0.08).ToString("F2"))s">
                    <div class="h-7 w-7 rounded-[3px] rhyno-skeleton"></div>
                    <div class="flex-1 space-y-1.5">
                        <div class="h-[26px] w-1/3 rounded-[3px] rhyno-skeleton"></div>
                        <div class="h-[26px] w-1/2 rounded-[3px] rhyno-skeleton"></div>
                    </div>
                    <div class="h-6 w-16 rounded-[3px] rhyno-skeleton"></div>
                </div>
            }
        </div>
        break;

    case "stats":
        @* Skeleton Stats Cards *@
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
            @for (int i = 0; i < 4; i++)
            {
                <div class="rhyno-card p-2.5" style="animation-delay: @((i * 0.06).ToString("F2"))s">
                    <div class="flex items-center justify-between mb-2">
                        <div class="h-[26px] w-20 rounded-[3px] rhyno-skeleton"></div>
                        <div class="h-7 w-7 rounded-[3px] rhyno-skeleton"></div>
                    </div>
                    <div class="h-7 w-16 rounded-[3px] rhyno-skeleton mb-2"></div>
                    <div class="h-[26px] w-32 rounded-[3px] rhyno-skeleton"></div>
                </div>
            }
        </div>
        break;
}