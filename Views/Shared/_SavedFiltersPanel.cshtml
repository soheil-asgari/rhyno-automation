@{
    var panelTitle = ViewData["SavedFiltersTitle"] as string ?? "فیلترهای ذخیره‌شده";
    var panelSubtitle = ViewData["SavedFiltersSubtitle"] as string ?? string.Empty;
    var saveButtonId = ViewData["SavedFiltersSaveButtonId"] as string ?? string.Empty;
    var clearButtonId = ViewData["SavedFiltersClearButtonId"] as string ?? string.Empty;
    var containerId = ViewData["SavedFiltersContainerId"] as string ?? string.Empty;
}

<div class="saved-filters-panel">
    <div class="flex flex-wrap gap-2 justify-between items-start mb-3">
        <div>
            <h5 class="text-xs font-black text-slate-800 dark:text-slate-200 mb-1">@panelTitle</h5>
            @if (!string.IsNullOrWhiteSpace(panelSubtitle))
            {
                <p class="text-[10px] text-slate-400 dark:text-slate-500 m-0">@panelSubtitle</p>
            }
        </div>
        <div class="flex items-center gap-2">
            <input type="text"
                   id="@(saveButtonId)NameInput"
                   class="h-8 w-36 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 text-xs text-slate-700 dark:text-slate-200 outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 transition"
                   placeholder="نام فیلتر..."
                   style="display: none;" />
            <button type="button"
                    class="h-8 flex items-center gap-1.5 rounded-lg border border-teal-200 bg-teal-50 hover:bg-teal-100 px-3 text-xs font-bold text-teal-700 dark:border-teal-500/30 dark:bg-teal-500/10 dark:hover:bg-teal-500/20 dark:text-teal-200 transition"
                    id="@saveButtonId">
                <i class="bi bi-save"></i>
                <span>ذخیره فیلتر</span>
            </button>
            <button type="button"
                    class="h-8 flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-3 text-xs font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 transition"
                    id="@clearButtonId">
                <i class="bi bi-x-circle"></i>
                <span>پاک کردن</span>
            </button>
        </div>
    </div>
    <div class="flex flex-wrap gap-2" id="@containerId"></div>
</div>