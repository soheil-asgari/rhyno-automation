@model dynamic

<div class="audit-item erp-card p-2.5 rounded-[3px]">
    <div class="audit-meta flex items-center justify-between gap-2">
        <strong class="text-[11px]">@Model.Title</strong>
        <span class="text-[10px] text-muted">@Model.When</span>
    </div>
    <div class="text-[11px] mt-1">@Model.Detail</div>
    <div class="text-[10px] text-muted">@Model.Source</div>
</div>
