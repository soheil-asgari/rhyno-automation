@{
    Layout = null;
    ViewData["Title"] = "در حال به‌روزرسانی";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl" class="theme-light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>در حال به‌روزرسانی - راینو ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true">
    <style>
        .maintenance-bg {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        }
        .pulse-ring {
            animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
        @@keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.8; }
            50% { transform: scale(1.1); opacity: 0.4; }
            100% { transform: scale(0.8); opacity: 0.8; }
        }
    </style>
</head>
<body class="maintenance-bg min-h-screen flex items-center justify-center px-4 font-sans antialiased">
    <div class="w-full max-w-lg text-center">
        <div class="relative mx-auto mb-8 grid h-28 w-28 place-items-center">
            <div class="absolute inset-0 rounded-full border-4 border-teal-500/20 pulse-ring"></div>
            <div class="relative z-10 grid h-20 w-20 place-items-center rounded-full bg-teal-500/10 border border-teal-500/30">
                <i class="bi bi-gear text-teal-400 text-4xl"></i>
            </div>
        </div>

        <h1 class="mb-3 text-3xl font-black text-white">در حال به‌روزرسانی</h1>
        <p class="mx-auto mb-8 max-w-md text-sm leading-relaxed text-slate-400">
            سیستم در حال به‌روزرسانی و نگهداری دوره‌ای است. این فرایند معمولاً چند دقیقه طول می‌کشد.
            لطفاً چند دقیقه دیگر مجدداً مراجعه کنید.
        </p>

        <div class="mx-auto mb-8 max-w-sm rounded-xl border border-slate-700/50 bg-slate-800/50 p-5 text-right backdrop-blur">
            <h4 class="mb-3 flex items-center gap-2 text-sm font-bold text-slate-300">
                <i class="bi bi-clock-history text-teal-400"></i> زمان تخمینی
            </h4>
            <div class="space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-400">پایگاه داده</span>
                    <span class="flex items-center gap-1 text-emerald-400">
                        <i class="bi bi-check-circle"></i> تکمیل شد
                    </span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-400">به‌روزرسانی ساختار</span>
                    <span class="flex items-center gap-1 text-teal-400">
                        <span class="animate-pulse">در حال اجرا...</span>
                    </span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-400">راه‌اندازی مجدد</span>
                    <span class="text-slate-500">در انتظار</span>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-center gap-6 text-xs text-slate-500">
            <span class="flex items-center gap-1"><i class="bi bi-shield-check"></i> امنیت اطلاعات حفظ می‌شود</span>
            <span class="flex items-center gap-1"><i class="bi bi-database-check"></i> داده‌ها پابرجا هستند</span>
        </div>

        <p class="mt-8 text-[11px] text-slate-600">
            © @DateTime.Now.Year راینو ERP - تمامی حقوق محفوظ است
        </p>
    </div>

    <script>
        // Auto-refresh every 30 seconds
        setTimeout(() => { location.reload(); }, 30000);
    </script>
</body>
</html>