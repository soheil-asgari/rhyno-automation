@{
    ViewData["Title"] = "دسترسی غیرمجاز";
    var isTabContent = Context.Request.Query.ContainsKey("_tab");
    Layout = isTabContent ? "_TabLayout" : "_Layout";
}

<div class="flex min-h-[80vh] items-center justify-center px-4">
    <div class="w-full max-w-xl text-center">
        <div class="mx-auto mb-6 grid h-24 w-24 place-items-center rounded-full bg-rose-50 dark:bg-rose-500/10">
            <i class="bi bi-shield-lock text-rose-600 dark:text-rose-400 text-5xl"></i>
        </div>

        <h1 class="mb-2 text-6xl font-black tracking-tight text-slate-200 dark:text-slate-800">۴۰۳</h1>

        <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-white">دسترسی غیرمجاز</h2>

        <p class="mx-auto mb-8 max-w-md text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            شما مجوز دسترسی به این بخش را ندارید. در صورت نیاز به این دسترسی، لطفاً با مدیر سیستم تماس بگیرید.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3">
            <a asp-controller="Home" asp-action="Index"
               class="erp-btn-primary h-8 px-4 text-[12px] rounded-[3px] no-underline">
                <i class="bi bi-house"></i>
                بازگشت به صفحه اصلی
            </a>
            <button onclick="history.back()"
                    class="erp-btn h-8 px-4 text-[12px] rounded-[3px]">
                <i class="bi bi-arrow-right"></i>
                بازگشت به صفحه قبل
            </button>
        </div>

        <div class="mx-auto mt-10 max-w-md rounded-xl border border-slate-200 bg-white p-5 text-right dark:border-slate-700 dark:bg-slate-800/50">
            <h3 class="mb-3 text-sm font-bold text-slate-900 dark:text-white">بخش‌های در دسترس:</h3>
            <div class="grid grid-cols-2 gap-2 text-xs">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-1.5 rounded-md border border-slate-100 p-2 text-slate-700 transition hover:border-teal-200 hover:bg-teal-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-teal-500/10 no-underline">
                    <i class="bi bi-speedometer2 text-teal-500"></i> میز کار
                </a>
                <a asp-controller="WorkInbox" asp-action="Index" class="flex items-center gap-1.5 rounded-md border border-slate-100 p-2 text-slate-700 transition hover:border-teal-200 hover:bg-teal-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-teal-500/10 no-underline">
                    <i class="bi bi-inboxes text-indigo-500"></i> کارتابل
                </a>
                <a asp-controller="Settings" asp-action="Index" class="flex items-center gap-1.5 rounded-md border border-slate-100 p-2 text-slate-700 transition hover:border-teal-200 hover:bg-teal-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-teal-500/10 no-underline">
                    <i class="bi bi-gear text-slate-500"></i> تنظیمات
                </a>
                <a asp-controller="Search" asp-action="Index" class="flex items-center gap-1.5 rounded-md border border-slate-100 p-2 text-slate-700 transition hover:border-teal-200 hover:bg-teal-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-teal-500/10 no-underline">
                    <i class="bi bi-search text-cyan-500"></i> جستجو
                </a>
            </div>
        </div>
    </div>
</div>