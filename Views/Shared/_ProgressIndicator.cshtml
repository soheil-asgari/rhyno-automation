@* 
    Progress Indicator / Stepper Component
  
    پارامترها (ViewData):
    Steps: List<string> (لیست اسامی مراحل - از ViewData["Steps"] به صورت string array یا comma-separated)
    CurrentStep: int (شماره مرحله فعلی - شروع از 1)
    Size: string (اختیاری - "sm", "md", "lg" - پیش‌فرض "md")
*@

@{
    var rawSteps = ViewData["Steps"] as string ?? "";
    var steps = rawSteps.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var currentStep = (int)(ViewData["CurrentStep"] ?? 1);
    var size = (string)(ViewData["Size"] ?? "md");

    if (steps.Length == 0)
    {
        steps = new[] { "شروع", "در حال بررسی", "تایید", "اتمام" };
    }

    var stepSize = size switch
    {
        "sm" => "h-6 w-6 text-[10px]",
        "lg" => "h-10 w-10 text-sm",
        _ => "h-8 w-8 text-xs"
    };

    var fontSize = size switch
    {
        "sm" => "text-[10px]",
        "lg" => "text-sm",
        _ => "text-xs"
    };

    var lineHeight = size switch
    {
        "sm" => "h-0.5",
        "lg" => "h-1",
        _ => "h-0.5"
    };
}

<div class="progress-indicator w-full py-4">
    <div class="flex items-center justify-between">
        @for (int i = 0; i < steps.Length; i++)
        {
            var stepNumber = i + 1;
            var isCompleted = stepNumber < currentStep;
            var isActive = stepNumber == currentStep;
            var isPending = stepNumber > currentStep;

            <div class="flex items-center @(i < steps.Length - 1 ? "flex-1" : "")">
                <div class="flex flex-col items-center">
                    @* Step Circle *@
                    <div class="@stepSize grid place-items-center rounded-full border-2 transition-all duration-300
                        @(isCompleted ? "border-teal-500 bg-teal-500 text-white" : "")
                        @(isActive ? "border-teal-500 bg-white dark:bg-slate-800 text-teal-600 dark:text-teal-400 shadow-[0_0_0_3px_rgba(20,184,166,0.15)]" : "")
                        @(isPending ? "border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-400 dark:text-slate-500" : "")">
                        @if (isCompleted)
                        {
                            <i class="bi bi-check-lg"></i>
                        }
                        else
                        {
                            <span class="font-bold">@stepNumber</span>
                        }
                    </div>
                    @* Step Label *@
                    <span class="mt-1.5 @fontSize font-medium text-center whitespace-nowrap
                        @(isActive ? "text-teal-700 dark:text-teal-300 font-bold" : "")
                        @(isCompleted ? "text-teal-600 dark:text-teal-400" : "")
                        @(isPending ? "text-slate-400 dark:text-slate-500" : "")">
                        @steps[i]
                    </span>
                </div>

                @* Connector Line *@
                @if (i < steps.Length - 1)
                {
                    <div class="flex-1 mx-2 @lineHeight rounded-full transition-all duration-300
                        @(stepNumber < currentStep ? "bg-teal-500" : "bg-slate-200 dark:bg-slate-700")"></div>
                }
            </div>
        }
    </div>
</div>