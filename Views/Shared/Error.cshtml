@model ErrorViewModel
@{
    ViewData["Title"] = "خطای سرور";
    var requestId = Model?.RequestId ?? (Context.Items["OriginalPath"]?.ToString() ?? "");
    var statusCode = Context.Response.StatusCode;
    var is404 = statusCode == 404;
    var is403 = statusCode == 403;
    var is429 = statusCode == 429;
    var is500 = statusCode >= 500 && !is403 && !is404 && !is429;

    // Determine color scheme based on error type
    var bgClass = is404 ? "bg-amber-50 dark:bg-amber-500/10" : is429 ? "bg-amber-50 dark:bg-amber-500/10" : is403 ? "bg-rose-50 dark:bg-rose-500/10" : "bg-rose-50 dark:bg-rose-500/10";
    var iconClass = is404 ? "bi-question-lg text-amber-600 dark:text-amber-400" : is429 ? "bi-hourglass-split text-amber-600 dark:text-amber-400" : is403 ? "bi-shield-lock text-rose-600 dark:text-rose-400" : "bi-exclamation-triangle text-rose-600 dark:text-rose-400";
    var codeText = is404 ? "۴۰۴" : is429 ? "۴۲۹" : is403 ? "۴۰۳" : "۵۰۰";
    var titleText = is404 ? "صفحه مورد نظر یافت نشد" : is429 ? "تعداد درخواست‌های بیش از حد مجاز" : is403 ? "دسترسی غیرمجاز" : "خطای سرور";
}

<div class="flex min-h-[80vh] items-center justify-center px-4">
    <div class="w-full max-w-xl text-center">
        <div class="mx-auto mb-6 grid h-24 w-24 place-items-center rounded-full @bgClass">
            <i class="bi @iconClass text-5xl"></i>
        </div>

        <h1 class="mb-2 text-6xl font-black tracking-tight text-slate-200 dark:text-slate-800">
            @codeText
        </h1>

        <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-white">
            @titleText
        </h2>

        <p class="mx-auto mb-8 max-w-md text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            @if (is404)
            {
                <text>صفحه‌ای که به دنبال آن هستید وجود ندارد، حذف شده یا آدرس آن تغییر کرده است. لطفاً آدرس را بررسی کنید یا به صفحه اصلی بازگردید.</text>
            }
            else if (is429)
            {
                <text>تعداد درخواست‌های شما بیش از حد مجاز است. لطفاً کمی صبر کرده و پس از یک دقیقه مجدداً تلاش نمایید.</text>
            }
            else if (is403)
            {
                <text>شما مجوز دسترسی به این بخش را ندارید. در صورت نیاز به این دسترسی، لطفاً با مدیر سیستم تماس بگیرید.</text>
            }
            else
            {
                <text>متأسفانه خطایی در سرور رخ داده است. تیم فنی در جریان قرار گرفته و در حال بررسی است. لطفاً چند دقیقه دیگر مجدداً تلاش کنید.</text>
            }
        </p>

        @if (!string.IsNullOrWhiteSpace(requestId) && !is404)
        {
            <div class="mx-auto mb-6 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 dark:border-slate-700 dark:bg-slate-800/50">
                <i class="bi bi-fingerprint text-slate-400"></i>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-mono" dir="ltr">شناسه خطا: @requestId</span>
                <button class="ml-1 text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300" onclick="navigator.clipboard.writeText('@requestId')" title="کپی شناسه خطا">
                    <i class="bi bi-copy text-sm"></i>
                </button>
            </div>
        }

        <div class="flex flex-wrap items-center justify-center gap-3">
            <a asp-controller="Home" asp-action="Index"
               class="erp-btn-primary h-8 px-4 text-[12px] rounded-[3px] no-underline">
                <i class="bi bi-house"></i>
                بازگشت به صفحه اصلی
            </a>
            <button onclick="history.back()"
                    class="erp-btn h-8 px-4 text-[12px] rounded-[3px]">
                <i class="bi bi-arrow-right"></i>
                بازگشت به صفحه قبل
            </button>
            @if (!is404)
            {
                <button onclick="location.reload()"
                        class="erp-btn h-8 px-4 text-[12px] rounded-[3px]">
                    <i class="bi bi-arrow-clockwise"></i>
                    تلاش مجدد
                </button>
            }
        </div>

        @if (is404)
        {
            <div class="mx-auto mt-10 max-w-md rounded-xl border border-slate-200 bg-white p-5 text-right dark:border-slate-700 dark:bg-slate-800/50">
                <h3 class="mb-3 text-sm font-bold text-slate-900 dark:text-white">بخش‌های پرکاربرد:</h3>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-1.5 rounded-md border border-slate-100 p-2 text-slate-700 transition hover:border-teal-200 hover:bg-teal-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-teal-500/10 no-underline">
                        <i class="bi bi-speedometer2 text-teal-500"></i> میز کار
                    </a>
                    <a asp-controller="WorkInbox" asp-action="Index" class="flex items-center gap-1.5 rounded-md border border-slate-100 p-2 text-slate-700 transition hover:border-teal-200 hover:bg-teal-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-teal-500/10 no-underline">
                        <i class="bi bi-inboxes text-indigo-500"></i> کارتابل
                    </a>
                    <a asp-controller="Financial" asp-action="Invoices" class="flex items-center gap-1.5 rounded-md border border-slate-100 p-2 text-slate-700 transition hover:border-teal-200 hover:bg-teal-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-teal-500/10 no-underline">
                        <i class="bi bi-receipt text-emerald-500"></i> فاکتورها
                    </a>
                    <a asp-controller="Warehouse" asp-action="Products" class="flex items-center gap-1.5 rounded-md border border-slate-100 p-2 text-slate-700 transition hover:border-teal-200 hover:bg-teal-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-teal-500/10 no-underline">
                        <i class="bi bi-box text-yellow-500"></i> کالاها
                    </a>
                </div>
            </div>
        }
    </div>
</div>