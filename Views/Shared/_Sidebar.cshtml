                        <a class='@ChildLinkClass("Financial", "Invoices")' asp-controller="Financial" asp-action="Invoices"><i class="bi bi-receipt w-4 text-teal-500"></i><span class="link-text truncate">فاکتورها</span></a>
                        <a class='@ChildLinkClass("Financial", "LedgerOperations")' asp-controller="Financial" asp-action="LedgerOperations"><i class="bi bi-journal-richtext w-4 text-cyan-500"></i><span class="link-text truncate">دفتر کل</span></a>
                        <a class='@ChildLinkClass("Financial", "GetTrialBalance")' asp-controller="Financial" asp-action="GetTrialBalance"><i class="bi bi-table w-4 text-indigo-500"></i><span class="link-text truncate">تراز آزمایشی</span></a>
                        <a class='@ChildLinkClass("Financial", "VatDashboard")' asp-controller="Financial" asp-action="VatDashboard"><i class="bi bi-percent w-4 text-pink-500"></i><span class="link-text truncate">ارزش افزوده</span></a>
                        <a class='@ChildLinkClass("Financial", "SeasonalTax")' asp-controller="Financial" asp-action="SeasonalTax"><i class="bi bi-file-earmark-bar-graph w-4 text-indigo-500"></i><span class="link-text truncate">گزارشات فصلی ۱۶۹</span></a>
                        <a class='@ChildLinkClass("Financial", "ReportingHub")' asp-controller="Financial" asp-action="ReportingHub"><i class="bi bi-bar-chart-line w-4 text-rose-500"></i><span class="link-text truncate">گزارش‌ها</span></a>
                        <a class='@ChildLinkClass("Payroll")' asp-controller="Payroll" asp-action="Index"><i class="bi bi-wallet2 w-4 text-violet-500"></i><span class="link-text truncate">حقوق</span></a>
                        <a class='@ChildLinkClass("Bimeh")' asp-controller="Bimeh" asp-action="Index"><i class="bi bi-shield-check w-4 text-blue-500"></i><span class="link-text truncate">بیمه</span></a>
                    </div>
                </div>
            </section>

            @* ── 3. Warehouse & Operations ── *@
            <section class="sidebar-module-reusable">
                <button class="@moduleButtonClass" type="button" data-sidebar-toggle="#collapseWarehouseReusable">
                    <span>انبار و عملیات</span>
                    <svg class="sidebar-chevron h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform duration-300" viewBox="0 0 12 12" fill="none">
                        <path d="M4 2L8 6L4 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <div id="collapseWarehouseReusable" class="sidebar-collapse-reusable overflow-hidden transition-[max-height] duration-350 ease-in-out @(IsModuleOpen("Warehouse","WarehouseInventory","WarehouseReceipts","WarehouseIssuances","WarehouseTransfer","Vendors","Waybill") ? "max-h-[600px]" : "max-h-0")">
                    <div class="mt-1 space-y-0.5 px-1">
                        <a class='@ChildLinkClass("Warehouse")' asp-controller="Warehouse" asp-action="Index"><i class="bi bi-box-seam w-4 text-orange-500"></i><span class="link-text truncate">داشبورد انبار</span></a>
                        <a class='@ChildLinkClass("Warehouse", "Products")' asp-controller="Warehouse" asp-action="Products"><i class="bi bi-box w-4 text-yellow-500"></i><span class="link-text truncate">کالاها</span></a>
                        <a class='@ChildLinkClass("WarehouseInventory", "Stock")' asp-controller="WarehouseInventory" asp-action="Stock"><i class="bi bi-layers w-4 text-lime-500"></i><span class="link-text truncate">موجودی</span></a>
                        <a class='@ChildLinkClass("WarehouseReceipts", "Receipts")' asp-controller="WarehouseReceipts" asp-action="Receipts"><i class="bi bi-box-arrow-in-down w-4 text-emerald-500"></i><span class="link-text truncate">رسیدها</span></a>
                        <a class='@ChildLinkClass("WarehouseIssuances", "Issuances")' asp-controller="WarehouseIssuances" asp-action="Issuances"><i class="bi bi-box-arrow-up w-4 text-red-500"></i><span class="link-text truncate">حواله‌ها</span></a>
                        <a class='@ChildLinkClass("Vendors")' asp-controller="Vendors" asp-action="Index"><i class="bi bi-building w-4 text-blue-500"></i><span class="link-text truncate">تامین‌کنندگان</span></a>
                        <a class='@ChildLinkClass("Waybill")' asp-controller="Waybill" asp-action="Index"><i class="bi bi-truck w-4 text-rose-500"></i><span class="link-text truncate">بارنامه</span></a>
                    </div>
                </div>
            </section>

            @* ── 4. System Management ── *@
            <section class="sidebar-module-reusable">
                <button class="@moduleButtonClass" type="button" data-sidebar-toggle="#collapseManagementReusable">
                    <span>مدیریت سیستم</span>
                    <svg class="sidebar-chevron h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform duration-300" viewBox="0 0 12 12" fill="none">
                        <path d="M4 2L8 6L4 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                 <div id="collapseManagementReusable" class="sidebar-collapse-reusable overflow-hidden transition-[max-height] duration-350 ease-in-out @(IsModuleOpen("Settings","Security","AuditDashboard","ProcessAnalysis","Reports","ManagementDashboard","DocumentArchive") ? "max-h-[600px]" : "max-h-0")">
                    <div class="mt-1 space-y-0.5 px-1">
                        <a class='@ChildLinkClass("ManagementDashboard", "Overview")' asp-controller="ManagementDashboard" asp-action="Overview"><i class="bi bi-grid-1x2 w-4 text-emerald-500"></i><span class="link-text truncate">داشبورد مدیریتی</span></a>
                        <a class='@ChildLinkClass("ManagementDashboard", "Index")' asp-controller="ManagementDashboard" asp-action="Index"><i class="bi bi-stars w-4 text-indigo-500"></i><span class="link-text truncate">گزارش‌ساز هوشمند</span></a>
                        <a class='@ChildLinkClass("Settings")' asp-controller="Settings" asp-action="Index"><i class="bi bi-gear w-4 text-slate-500 dark:text-slate-400"></i><span class="link-text truncate">تنظیمات</span></a>
                        <a class='@ChildLinkClass("Security")' asp-controller="Security" asp-action="Index"><i class="bi bi-shield-lock w-4 text-rose-500"></i><span class="link-text truncate">امنیت</span></a>
                        <a class='@ChildLinkClass("Security", "WorkflowBuilder")' asp-controller="Security" asp-action="WorkflowBuilder"><i class="bi bi-diagram-3 w-4 text-teal-500"></i><span class="link-text truncate">طراح گردش کار</span></a>
                        <a class='@ChildLinkClass("DocumentArchive")' asp-controller="DocumentArchive" asp-action="Index"><i class="bi bi-archive w-4 text-amber-500"></i><span class="link-text truncate">بایگانی اسناد</span></a>
                        <a class='@ChildLinkClass("AuditDashboard")' asp-controller="AuditDashboard" asp-action="Index"><i class="bi bi-activity w-4 text-cyan-500"></i><span class="link-text truncate">ممیزی</span></a>
                        <a class='@ChildLinkClass("ProcessAnalysis")' asp-controller="ProcessAnalysis" asp-action="Index"><i class="bi bi-diagram-3 w-4 text-purple-500"></i><span class="link-text truncate">تحلیل فرایند</span></a>
                        <a class='@ChildLinkClass("Reports")' asp-controller="Reports" asp-action="Index"><i class="bi bi-file-bar-graph w-4 text-indigo-500"></i><span class="link-text truncate">گزارشات</span></a>
                    </div>
                </div>
            </section>

        </div>
    </nav>

    @* ── Footer / User Area ── *@
    <div class="border-t border-slate-200/60 p-2.5 dark:border-slate-800/60">
        <a asp-controller="Settings" asp-action="Index"
           class="flex items-center gap-2.5 rounded-xl border border-slate-200/60 bg-slate-50/70 px-2.5 py-2 no-underline transition-all hover:bg-white hover:shadow-sm dark:border-slate-700/60 dark:bg-slate-800/60 dark:hover:bg-slate-800">
            <span class="grid h-8 w-8 place-items-center rounded-lg bg-white text-slate-600 shadow-sm dark:bg-slate-700 dark:text-slate-300">
                <i class="bi bi-person"></i>
            </span>
            <span class="min-w-0 flex-1">
                <span class="block truncate text-[12px] font-bold text-slate-800 dark:text-slate-200">@userName</span>
                <span class="block truncate text-[10px] text-slate-500 dark:text-slate-400">@userRole</span>
            </span>
        </a>
    </div>

    @* ═══════════════════════════════════════════════════════════════
       Inline Styles (custom scrollbar + collapse transitions)
       Keep these minimal — Tailwind handles the rest.
       ═══════════════════════════════════════════════════════════════ *@
    <style>
        /* ── Custom Scrollbar (Webkit) ── */
        #sidebarScrollContainerReusable.custom-sidebar-scroll::-webkit-scrollbar {
            width: 4px;
        }
        #sidebarScrollContainerReusable.custom-sidebar-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        #sidebarScrollContainerReusable.custom-sidebar-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .dark #sidebarScrollContainerReusable.custom-sidebar-scroll::-webkit-scrollbar-thumb {
            background: #475569;
        }

        /* ── Firefox ── */
        #sidebarScrollContainerReusable.custom-sidebar-scroll {
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 transparent;
        }
        .dark #sidebarScrollContainerReusable.custom-sidebar-scroll {
            scrollbar-color: #475569 transparent;
        }

        /* ── Collapse transition ── */
        .sidebar-collapse-reusable {
            transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .sidebar-collapse-reusable.max-h-0 {
            max-height: 0 !important;
        }
        .sidebar-collapse-reusable[class*="max-h-["] {
            /* handled by Tailwind utility */;
        }

        /* ── Chevron rotation (RTL-corrected) ── */
        .sidebar-chevron {
            transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .sidebar-module-btn.expanded .sidebar-chevron {
            transform: rotate(180deg);
        }

        /* ── Active link indicator bar (right side in RTL) ── */
        .sidebar-link.bg-indigo-600\/5::before,
        .sidebar-link.dark\:bg-indigo-500\/15::before {
            content: '';
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 60%;
            border-radius: 0 3px 3px 0;
            background-color: #4f46e5;
        }
        .dark .sidebar-link.dark\:bg-indigo-500\/15::before {
            background-color: #818cf8;
        }

        /* ── Shadow glow for active items ── */
        .shadow-glow-sm {
            box-shadow: 0 0 0 1px rgba(99, 102, 241, 0.08);
        }
    </style>

</aside>

@* ═══════════════════════════════════════════════════════════════
   Vanilla JavaScript  —  Accordion + Search
   Self‑contained · No external dependencies
   ═══════════════════════════════════════════════════════════════ *@
<script>
    (function () {
        'use strict';

        // ── DOM references ──────────────────────────────────────────────
        var container   = document.getElementById('appSidebarReusable');
        if (!container) return;  // not present on this page — exit silently

        var searchInput      = container.querySelector('#sidebarMenuSearchReusable');
        var searchClearBtn   = container.querySelector('#sidebarSearchClearReusable');
        var searchCountLbl   = container.querySelector('#sidebarSearchCountReusable');
        var noResultsMsg     = container.querySelector('#sidebarSearchNoResultsReusable');
        var scrollContainer  = container.querySelector('#sidebarScrollContainerReusable');

        // ── 1. Accordion expand / collapse ──────────────────────────────
        container.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-sidebar-toggle]');
            if (!btn) return;
            e.preventDefault();

            var targetSelector = btn.getAttribute('data-sidebar-toggle');
            var target = container.querySelector(targetSelector);
            if (!target) return;

            var isOpen = !target.classList.contains('max-h-0');
            if (isOpen) {
                // Collapse
                target.classList.add('max-h-0');
                target.classList.remove('max-h-[400px]', 'max-h-[600px]');
                btn.classList.remove('expanded');
            } else {
                // Expand
                target.classList.remove('max-h-0');
                // Determine max-height based on number of child links
                var linkCount = target.querySelectorAll('a.sidebar-link').length;
                var desiredH  = linkCount > 8 ? '600px' : '400px';
                target.style.maxHeight = desiredH;
                // Also set the class for consistency
                target.classList.remove('max-h-[400px]', 'max-h-[600px]');
                target.classList.add('max-h-[' + desiredH + ']');
                btn.classList.add('expanded');
            }
        });

        // ── 2. Search / filter ──────────────────────────────────────────
        if (!searchInput || !searchClearBtn || !searchCountLbl || !scrollContainer) return;

        var allLinks  = Array.from(scrollContainer.querySelectorAll('a.sidebar-link'));
        var allGroups = Array.from(scrollContainer.querySelectorAll('.sidebar-module-reusable'));

        // Remember initial collapse state of each module
        var initialCollapseStates = new Map();
        allGroups.forEach(function (group) {
            var collapseDiv = group.querySelector('.sidebar-collapse-reusable');
            if (collapseDiv) {
                initialCollapseStates.set(collapseDiv, !collapseDiv.classList.contains('max-h-0'));
            }
        });

        function normalizeText(val) {
            return String(val || '')
                .replace(/[ي]/g, 'ی')
                .replace(/[ك]/g, 'ک')
                .replace(/\s+/g, ' ')
                .trim()
                .toLowerCase();
        }

        function resetSearch() {
            allLinks.forEach(function (link) { link.classList.remove('hidden'); });
            allGroups.forEach(function (group) {
                group.classList.remove('hidden');
                var collapseDiv = group.querySelector('.sidebar-collapse-reusable');
                var btn         = group.querySelector('.sidebar-module-btn');
                if (collapseDiv) {
                    var wasInitiallyOpen = initialCollapseStates.get(collapseDiv);
                    if (wasInitiallyOpen) {
                        collapseDiv.classList.remove('max-h-0');
                        collapseDiv.classList.add('max-h-[600px]');
                        if (btn) btn.classList.add('expanded');
                    } else {
                        collapseDiv.classList.add('max-h-0');
                        collapseDiv.classList.remove('max-h-[400px]', 'max-h-[600px]');
                        if (btn) btn.classList.remove('expanded');
                    }
                }
            });
            if (noResultsMsg) noResultsMsg.classList.add('hidden');
            searchClearBtn.classList.add('hidden');
            searchCountLbl.textContent = 'همه بخش‌ها';
            searchInput.value = '';
        }

        function applySearch() {
            var query = normalizeText(searchInput.value);
            if (!query) { resetSearch(); return; }

            var matchCount = 0;

            allLinks.forEach(function (link) {
                var matches = normalizeText(link.textContent).indexOf(query) !== -1;
                link.classList.toggle('hidden', !matches);
                if (matches) matchCount++;
            });

            allGroups.forEach(function (group) {
                var groupLinks  = Array.from(group.querySelectorAll('a.sidebar-link'));
                var hasVisible  = groupLinks.some(function (l) { return !l.classList.contains('hidden'); });
                var headerMatch = normalizeText((group.querySelector('.sidebar-module-btn')?.textContent || '')).indexOf(query) !== -1;
                var isVisible   = hasVisible || headerMatch;

                group.classList.toggle('hidden', !isVisible);

                var collapseDiv = group.querySelector('.sidebar-collapse-reusable');
                var btn         = group.querySelector('.sidebar-module-btn');
                if (collapseDiv) {
                    if (isVisible) {
                        collapseDiv.classList.remove('max-h-0');
                        collapseDiv.classList.add('max-h-[600px]');
                        if (btn) btn.classList.add('expanded');
                        if (headerMatch) {
                            groupLinks.forEach(function (l) { l.classList.remove('hidden'); });
                        }
                    } else {
                        collapseDiv.classList.add('max-h-0');
                        collapseDiv.classList.remove('max-h-[400px]', 'max-h-[600px]');
                        if (btn) btn.classList.remove('expanded');
                    }
                }
            });

            if (noResultsMsg) noResultsMsg.classList.toggle('hidden', matchCount !== 0);
            searchClearBtn.classList.remove('hidden');
            searchCountLbl.textContent = matchCount === 0 ? 'بدون نتیجه' : matchCount.toLocaleString('fa-IR') + ' نتیجه';
        }

        searchInput.addEventListener('input', applySearch);
        searchClearBtn.addEventListener('click', function () { searchInput.value = ''; searchInput.focus(); resetSearch(); });
    })();
</script>