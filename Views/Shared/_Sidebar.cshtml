            <div class="mb-1.5 px-2 text-[10px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500">دسترسی سریع</div>
            <div class="space-y-0.5">
                <a class='@NavClass("Home")' asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 w-4 text-sky-500"></i><span class="link-text truncate">میز کار</span></a>
                <a class='@NavClass("WorkInbox")' asp-controller="WorkInbox" asp-action="Index"><i class="bi bi-inboxes w-4 text-indigo-500"></i><span class="link-text truncate">کارتابل</span></a>
                <a class='@NavClass("Financial", "GetTrialBalance")' asp-controller="Financial" asp-action="GetTrialBalance"><i class="bi bi-table w-4 text-emerald-500"></i><span class="link-text truncate">تراز آزمایشی</span></a>
            </div>
        </section>

        @* ── Accordion Modules ── *@
        <div id="sidebarAccordionReusable" class="space-y-2">

            @* ── 1. Human Capital ── *@
            <section class="sidebar-module-reusable">
                <button class="@moduleButtonClass" type="button" data-sidebar-toggle="#collapseHumanCapitalReusable">
                    <span>سرمایه انسانی</span>
                    <svg class="sidebar-chevron h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform duration-300" viewBox="0 0 12 12" fill="none">
                        <path d="M4 2L8 6L4 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <div id="collapseHumanCapitalReusable" class="sidebar-collapse-reusable overflow-hidden transition-[max-height] duration-350 ease-in-out @(IsModuleOpen("HumanCapital","Leaves","Letters") ? "max-h-[400px]" : "max-h-0")">
                    <div class="mt-1 space-y-0.5 px-1">
                        <a class='@ChildLinkClass("HumanCapital")' asp-controller="HumanCapital" asp-action="Index"><i class="bi bi-person-badge w-4 text-amber-500"></i><span class="link-text truncate">منابع انسانی</span></a>
                        <a class='@ChildLinkClass("Leaves")' asp-controller="Leaves" asp-action="Index"><i class="bi bi-calendar2-week w-4 text-sky-500"></i><span class="link-text truncate">مرخصی‌ها</span></a>
                        <a class='@ChildLinkClass("Letters")' asp-controller="Letters" asp-action="Index"><i class="bi bi-envelope w-4 text-purple-500"></i><span class="link-text truncate">نامه‌ها</span></a>
                    </div>
                </div>
            </section>

            @* ── 2. Financial & Accounting ── *@
