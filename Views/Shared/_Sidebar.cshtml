@* ────────────────────────────────────────────────────────────
   _Sidebar.cshtml  —  RTL Sidebar Partial View
   Enterprise ERP Navigation  ·  Rahkaran-inspired design
   Pure HTML + Tailwind CSS + Vanilla JavaScript
   ────────────────────────────────────────────────────────────
   Usage:  <partial name="_Sidebar" />
   Or pass custom data via ViewData / Model as needed.
   ──────────────────────────────────────────────────────────── *@
@{
    // ── You can pass these from the parent view / layout ──
    var appTitle       = ViewData["SidebarAppTitle"]       as string ?? "راینو ERP";
    var appSubtitle    = ViewData["SidebarAppSubtitle"]    as string ?? "سیستم جامع سازمانی";
    var brandLogo      = ViewData["SidebarBrandLogo"]      as string;
    var userName       = ViewData["SidebarUserName"]       as string ?? "کاربر سیستم";
    var userRole       = ViewData["SidebarUserRole"]       as string ?? "مدیر";
    var activeController = ViewContext?.RouteData.Values["controller"]?.ToString() ?? "";
    var activeAction    = ViewContext?.RouteData.Values["action"]?.ToString() ?? "";
}

@* ── NavClass helper (re‑used from _Layout pattern) ── *@
@{
    string NavClass(string controller, string? action = null)
    {
        var isActive = string.Equals(activeController, controller, StringComparison.OrdinalIgnoreCase)
                       && (string.IsNullOrWhiteSpace(action) || string.Equals(activeAction, action, StringComparison.OrdinalIgnoreCase));
        return isActive
            ? "sidebar-link group relative flex items-center gap-2.5 rounded-xl border border-indigo-200/40 bg-indigo-600/5 px-3 py-2.5 text-[13px] font-semibold text-indigo-700 shadow-glow-sm dark:border-indigo-500/30 dark:bg-indigo-500/15 dark:text-indigo-300 transition-all duration-300"
            : "sidebar-link group relative flex items-center gap-2.5 rounded-xl border border-transparent px-3 py-2.5 text-[13px] font-medium text-slate-600 transition-all duration-300 hover:border-slate-200/70 hover:bg-slate-100/70 hover:text-slate-900 dark:text-slate-400 dark:hover:border-slate-700/50 dark:hover:bg-slate-800/50 dark:hover:text-white";
    }

    string ChildLinkClass(string controller, string? action = null)
    {
        var isActive = string.Equals(activeController, controller, StringComparison.OrdinalIgnoreCase)
                       && (string.IsNullOrWhiteSpace(action) || string.Equals(activeAction, action, StringComparison.OrdinalIgnoreCase));
        return isActive
            ? "sidebar-link group relative flex items-center gap-2 rounded-lg border-0 bg-indigo-50/80 px-3 py-1.5 text-[12px] font-semibold text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-300 transition-all duration-300"
            : "sidebar-link group relative flex items-center gap-2 rounded-lg border-0 bg-transparent px-3 py-1.5 text-[12px] font-medium text-slate-600 transition-all duration-300 hover:bg-slate-100/70 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/50 dark:hover:text-white";
    }

    var moduleButtonClass = "sidebar-module-btn flex w-full items-center justify-between rounded-xl px-3 py-2.5 text-[12px] font-bold text-slate-500 transition-all duration-300 hover:bg-slate-100/60 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/50 dark:hover:text-slate-200";

    // Helper to determine if a module section should start expanded
    bool IsModuleOpen(params string[] controllers)
    {
        return controllers.Any(c => string.Equals(activeController, c, StringComparison.OrdinalIgnoreCase));
    }
}

@* ═══════════════════════════════════════════════════════════
   Sidebar HTML
   ═══════════════════════════════════════════════════════════ *@
<aside id="appSidebarReusable"
       dir="rtl"
       style="font-family: 'Vazirmatn', 'Tahoma', 'Segoe UI', sans-serif;"
       class="flex flex-col min-h-0 h-full w-60 flex-shrink-0 border-l border-slate-200/50 bg-white/80 backdrop-blur-xl font-['Vazirmatn',Tahoma] dark:border-slate-800/40 dark:bg-slate-950/85 print:hidden">

    @* ── Header / Brand Area ── *@
    <div class="flex h-12 items-center gap-2 border-b border-slate-200/60 px-3 dark:border-slate-800/60">
        <a asp-controller="Home" asp-action="Index" class="flex min-w-0 flex-1 items-center gap-2 no-underline">
            @if (!string.IsNullOrWhiteSpace(brandLogo))
            {
                <img src="@brandLogo" alt="@appTitle" class="h-8 w-8 rounded-lg border border-slate-200/60 bg-white object-contain p-0.5 dark:border-slate-700" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" />
                <span class="hidden h-8 w-8 place-items-center rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-950"><i class="bi bi-grid-1x2-fill text-sm"></i></span>
            }
            else
            {
                <span class="grid h-8 w-8 place-items-center rounded-lg bg-indigo-600 text-white dark:bg-indigo-500 dark:text-white"><i class="bi bi-grid-1x2-fill text-sm"></i></span>
            }
            <span class="min-w-0">
                <span class="block truncate text-sm font-black text-slate-900 dark:text-white">@appTitle</span>
                <span class="block truncate text-[10px] font-medium text-slate-500 dark:text-slate-400">@appSubtitle</span>
            </span>
        </a>
    </div>

    @* ── Search Bar ── *@
    <div class="border-b border-slate-200/60 p-2.5 dark:border-slate-800/60">
        <label class="relative block">
            <i class="bi bi-search pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>
            <input id="sidebarMenuSearchReusable"
                   type="search"
                   autocomplete="off"
                   placeholder="جستجوی منو"
                   aria-label="جستجوی منو"
                   class="h-9 w-full rounded-xl border border-slate-200/80 bg-slate-50/70 pr-10 pl-2 text-[12px] text-slate-800 outline-none transition-all placeholder:text-slate-400 focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:bg-slate-900/70 dark:text-slate-200 dark:placeholder:text-slate-500 dark:focus:border-indigo-400 dark:focus:bg-slate-900 dark:focus:ring-indigo-500/20" />
        </label>
        <div class="mt-1.5 flex items-center justify-between px-1 text-[10px] text-slate-500 dark:text-slate-400">
            <span id="sidebarSearchCountReusable">همه بخش‌ها</span>
            <button id="sidebarSearchClearReusable" type="button" class="hidden font-bold text-indigo-600 dark:text-indigo-400 hover:underline">پاک کردن</button>
        </div>
    </div>

    @* ── Scrollable Navigation ── *@
    <nav id="sidebarScrollContainerReusable" class="min-h-0 flex-1 space-y-4 overflow-y-auto overflow-x-visible px-2.5 py-3 custom-sidebar-scroll">

        @* No‑results message (hidden by default) *@
        <div id="sidebarSearchNoResultsReusable" class="hidden rounded-xl border border-amber-200/60 bg-amber-50/70 px-3 py-2.5 text-[11px] text-amber-800 dark:border-amber-500/20 dark:bg-amber-500/10 dark:text-amber-300">نتیجه‌ای در منو پیدا نشد.</div>

        @* ── Quick Access ── *@
