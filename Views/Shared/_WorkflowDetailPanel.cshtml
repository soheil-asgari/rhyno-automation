@model OfficeAutomation.Models.WorkflowDetailPanelVM
@using System.Globalization
@{
    var pc = new PersianCalendar();
    string ToPersian(DateTimeOffset? value)
    {
        if (!value.HasValue) return "-";
        var local = value.Value.ToLocalTime().DateTime;
        return $"{pc.GetYear(local):0000}/{pc.GetMonth(local):00}/{pc.GetDayOfMonth(local):00} {local:HH:mm}";
    }

    string StatusBadgeCss(string status) => OfficeAutomation.Models.WorkflowStatus.Normalize(status) switch
    {
        "Approved" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200/60 dark:border-emerald-800/40",
        "Completed" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200/60 dark:border-emerald-800/40",
        "Rejected" => "bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400 border-rose-200/60 dark:border-rose-800/40",
        "Canceled" => "bg-slate-100 text-slate-600 dark:bg-slate-800/60 dark:text-slate-400 border-slate-200/60 dark:border-slate-700/40",
        "Draft" => "bg-slate-100 text-slate-600 dark:bg-slate-800/60 dark:text-slate-400 border-slate-200/60 dark:border-slate-700/40",
        "Returned" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200/60 dark:border-amber-800/40",
        "NeedsRevision" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200/60 dark:border-amber-800/40",
        "PendingApproval" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200/60 dark:border-amber-800/40",
        "PendingManager" => "bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-400 border-sky-200/60 dark:border-sky-800/40",
        "Sent" => "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400 border-indigo-200/60 dark:border-indigo-800/40",
        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800/60 dark:text-slate-400 border-slate-200/60 dark:border-slate-700/40"
    };
}

<section class="w-full erp-card p-3.5 flex flex-col gap-4">
    <!-- Header -->
    <div class="flex flex-col gap-1.5">
        <h5 class="m-0 text-[12px] font-black text-slate-900 dark:text-white">جزئیات گردش کار</h5>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">@Model.Title</div>
        <div class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">@Model.Summary</div>
    </div>

    <!-- Status Summary Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
        <div class="flex flex-col gap-1 p-2.5 rounded-[4px] bg-slate-50 dark:bg-slate-950/40 border border-slate-100 dark:border-slate-800">
            <span class="text-[10px] text-slate-500 dark:text-slate-400">وضعیت</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-[3px] text-[10px] font-bold border w-max @StatusBadgeCss(Model.CurrentStatus)">
                @OfficeAutomation.Models.WorkflowStatus.Label(Model.CurrentStatus)
            </span>
        </div>
        <div class="flex flex-col gap-1 p-2.5 rounded-[4px] bg-slate-50 dark:bg-slate-950/40 border border-slate-100 dark:border-slate-800">
            <span class="text-[10px] text-slate-500 dark:text-slate-400">مسئول فعلی</span>
            <span class="text-[11px] font-bold text-slate-800 dark:text-slate-200">@(Model.CurrentAssigneeName ?? "-")</span>
        </div>
        <div class="flex flex-col gap-1 p-2.5 rounded-[4px] bg-slate-50 dark:bg-slate-950/40 border border-slate-100 dark:border-slate-800">
            <span class="text-[10px] text-slate-500 dark:text-slate-400">مهلت</span>
            <span class="text-[11px] font-bold text-slate-800 dark:text-slate-200 font-mono tabular-nums">@ToPersian(Model.Deadline)</span>
        </div>
        <div class="flex flex-col gap-1 p-2.5 rounded-[4px] bg-slate-50 dark:bg-slate-950/40 border border-slate-100 dark:border-slate-800">
            <span class="text-[10px] text-slate-500 dark:text-slate-400">سطح خدمت</span>
            <span class="text-[11px] font-bold text-slate-800 dark:text-slate-200">@Model.SlaState</span>
        </div>
    </div>

    <!-- Timeline & Decisions -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Timeline -->
        <div class="flex flex-col gap-2.5">
            <h6 class="m-0 text-[11px] font-black text-slate-900 dark:text-white">خط زمانی</h6>
            <div class="flex flex-col gap-1.5">
                @foreach (var item in Model.Timeline)
                {
                    <div class="p-2.5 border border-slate-100 dark:border-slate-800 rounded-[4px] bg-slate-50/60 dark:bg-slate-950/30">
                        <div class="flex justify-between items-center gap-2 min-h-[26px]">
                            <strong class="text-[11px] font-bold text-slate-800 dark:text-slate-200">@item.ActionType</strong>
                            <small class="text-[10px] text-slate-500 dark:text-slate-500 font-mono">@ToPersian(item.OccurredAt)</small>
                        </div>
                        <div class="text-[10px] text-slate-500 dark:text-slate-400">@((item.ActorUser?.FullName) ?? item.ActorUserId)</div>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">@item.Description</div>
                        }
                    </div>
                }
                @if (Model.Timeline.Count == 0)
                {
                    <div class="p-3 text-center text-[11px] text-slate-400 dark:text-slate-600">رویدادی ثبت نشده است.</div>
                }
            </div>
        </div>

        <!-- Decisions -->
        <div class="flex flex-col gap-2.5">
            <h6 class="m-0 text-[11px] font-black text-slate-900 dark:text-white">تصمیم‌ها</h6>
            <div class="flex flex-col gap-1.5">
                @foreach (var item in Model.Decisions)
                {
                    <div class="p-2.5 border border-slate-100 dark:border-slate-800 rounded-[4px] bg-slate-50/60 dark:bg-slate-950/30">
                        <div class="flex justify-between items-center gap-2 min-h-[26px]">
                            <strong class="text-[11px] font-bold text-slate-800 dark:text-slate-200">@item.DecisionType</strong>
                            <small class="text-[10px] text-slate-500 dark:text-slate-500 font-mono">@ToPersian(item.DecidedAt)</small>
                        </div>
                        <div class="text-[10px] text-slate-500 dark:text-slate-400">@((item.DecidedByUser?.FullName) ?? item.DecidedByUserId)</div>
                        @if (!string.IsNullOrWhiteSpace(item.Comment))
                        {
                            <div class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">@item.Comment</div>
                        }
                    </div>
                }
                @if (Model.Decisions.Count == 0)
                {
                    <div class="p-3 text-center text-[11px] text-slate-400 dark:text-slate-600">تصمیمی ثبت نشده است.</div>
                }
            </div>
        </div>
    </div>

    <!-- Comments & Attachments -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Comments -->
        <div class="flex flex-col gap-2.5">
            <h6 class="m-0 text-[11px] font-black text-slate-900 dark:text-white">نظرها</h6>
            <div class="flex flex-col gap-1.5">
                @foreach (var item in Model.Comments)
                {
                    <div class="p-2.5 border border-slate-100 dark:border-slate-800 rounded-[4px] bg-slate-50/60 dark:bg-slate-950/30">
                        <div class="flex justify-between items-center gap-2 min-h-[26px]">
                            <strong class="text-[11px] font-bold text-slate-800 dark:text-slate-200">@((item.AuthorUser?.FullName) ?? item.AuthorUserId)</strong>
                            <small class="text-[10px] text-slate-500 dark:text-slate-500 font-mono">@ToPersian(item.CreatedAt)</small>
                        </div>
                        <div class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">@item.Body</div>
                    </div>
                }
                @if (Model.Comments.Count == 0)
                {
                    <div class="p-3 text-center text-[11px] text-slate-400 dark:text-slate-600">نظری ثبت نشده است.</div>
                }
            </div>
            <form asp-controller="WorkInbox" asp-action="AddComment" method="post" class="flex flex-col gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="documentType" value="@Model.DocumentType" />
                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                <input type="hidden" name="workflowStepId" value="@Model.CurrentWorkflowStepId" />
                <textarea name="body" rows="3" class="w-full erp-textarea" placeholder="ثبت نظر جدید"></textarea>
                <button type="submit" class="self-end erp-btn-primary h-7 px-3 rounded-[3px] text-[11px]">
                    <i class="bi bi-chat-left-dots"></i>
                    <span>ثبت نظر</span>
                </button>
            </form>
        </div>

        <!-- Attachments -->
        <div class="flex flex-col gap-2.5">
            <h6 class="m-0 text-[11px] font-black text-slate-900 dark:text-white">پیوست‌ها</h6>
            <div class="flex flex-col gap-1.5">
                @foreach (var item in Model.Attachments)
                {
                    <a class="p-2.5 border border-slate-100 dark:border-slate-800 rounded-[4px] bg-slate-50/60 dark:bg-slate-950/30 no-underline transition hover:border-teal-300 dark:hover:border-teal-700" href="@Url.Action("DownloadAttachment", "WorkInbox", new { id = item.Id })" target="_blank">
                        <div class="flex justify-between items-center gap-2 min-h-[26px]">
                            <strong class="text-[11px] font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                                <i class="bi bi-paperclip text-teal-600 dark:text-teal-400"></i>
                                @item.FileName
                            </strong>
                            <small class="text-[10px] text-slate-500 dark:text-slate-500 font-mono">@ToPersian(item.UploadedAt)</small>
                        </div>
                        <div class="text-[10px] text-slate-500 dark:text-slate-400">@((item.UploadedByUser?.FullName) ?? item.UploadedByUserId)</div>
                    </a>
                }
                @if (Model.Attachments.Count == 0)
                {
                    <div class="p-3 text-center text-[11px] text-slate-400 dark:text-slate-600">پیوستی ثبت نشده است.</div>
                }
            </div>
            <form asp-controller="WorkInbox" asp-action="Decide" method="post" enctype="multipart/form-data" class="flex flex-col gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="documentType" value="@Model.DocumentType" />
                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                <input type="hidden" name="stepNumber" value="@Model.CurrentStepNumber" />
                <input type="hidden" name="decisionType" value="Comment" />
                <input type="file" name="attachments" class="w-full text-[11px] file:mr-3 file:py-1.5 file:px-2.5 file:rounded-[3px] file:border-0 file:bg-slate-100 dark:file:bg-slate-800 file:text-[11px] file:font-bold text-slate-500 dark:text-slate-400" />
                <button type="submit" class="self-end erp-btn h-7 px-3 rounded-[3px] text-[11px]">
                    <i class="bi bi-upload"></i>
                    <span>بارگذاری پیوست</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Actions -->
    @if (Model.CanApprove || Model.CanReject || Model.CanReturn || Model.CanRequestChanges || Model.CanForward || Model.CanDelegate)
    {
        <div class="flex flex-col gap-2.5 border-t border-slate-100 dark:border-slate-800 pt-3">
            <h6 class="m-0 text-[11px] font-black text-slate-900 dark:text-white">اقدام‌ها</h6>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2.5">
                @if (Model.CanApprove)
                {
                    <div class="flex flex-col gap-2 p-2.5 rounded-[4px] bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40">
                        <form asp-controller="WorkInbox" asp-action="Decide" method="post" class="flex flex-col gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="documentType" value="@Model.DocumentType" />
                            <input type="hidden" name="documentId" value="@Model.DocumentId" />
                            <input type="hidden" name="stepNumber" value="@Model.CurrentStepNumber" />
                            <input type="hidden" name="decisionType" value="Approve" />
                            <textarea name="note" rows="2" class="w-full erp-textarea" placeholder="توضیح تایید"></textarea>
                            <button type="submit" class="erp-btn h-7 px-3 rounded-[3px] text-[11px] bg-emerald-600 border-transparent text-white hover:bg-emerald-700">
                                <i class="bi bi-check2-circle"></i>
                                <span>تایید</span>
                            </button>
                        </form>
                    </div>
                }
                @if (Model.CanReject)
                {
                    <div class="flex flex-col gap-2 p-2.5 rounded-[4px] bg-rose-50/50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/40">
                        <form asp-controller="WorkInbox" asp-action="Decide" method="post" class="flex flex-col gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="documentType" value="@Model.DocumentType" />
                            <input type="hidden" name="documentId" value="@Model.DocumentId" />
                            <input type="hidden" name="stepNumber" value="@Model.CurrentStepNumber" />
                            <input type="hidden" name="decisionType" value="Reject" />
                            <textarea name="note" rows="2" class="w-full erp-textarea" placeholder="دلیل رد"></textarea>
                            <button type="submit" class="erp-btn h-7 px-3 rounded-[3px] text-[11px] bg-rose-600 border-transparent text-white hover:bg-rose-700">
                                <i class="bi bi-x-circle"></i>
                                <span>رد</span>
                            </button>
                        </form>
                    </div>
                }
                @if (Model.CanReturn)
                {
                    <div class="flex flex-col gap-2 p-2.5 rounded-[4px] bg-slate-50/60 dark:bg-slate-950/30 border border-slate-100 dark:border-slate-800">
                        <form asp-controller="WorkInbox" asp-action="Decide" method="post" class="flex flex-col gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="documentType" value="@Model.DocumentType" />
                            <input type="hidden" name="documentId" value="@Model.DocumentId" />
                            <input type="hidden" name="stepNumber" value="@Model.CurrentStepNumber" />
                            <input type="hidden" name="decisionType" value="Return" />
                            <textarea name="note" rows="2" class="w-full erp-textarea" placeholder="علت بازگشت"></textarea>
                            <button type="submit" class="erp-btn h-7 px-3 rounded-[3px] text-[11px]">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span>بازگشت</span>
                            </button>
                        </form>
                    </div>
                }
                @if (Model.CanRequestChanges)
                {
                    <div class="flex flex-col gap-2 p-2.5 rounded-[4px] bg-amber-50/50 dark:bg-amber-950/20 border border-amber-100 dark:border-amber-900/40">
                        <form asp-controller="WorkInbox" asp-action="Decide" method="post" class="flex flex-col gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="documentType" value="@Model.DocumentType" />
                            <input type="hidden" name="documentId" value="@Model.DocumentId" />
                            <input type="hidden" name="stepNumber" value="@Model.CurrentStepNumber" />
                            <input type="hidden" name="decisionType" value="RequestChanges" />
                            <textarea name="note" rows="2" class="w-full erp-textarea" placeholder="درخواست اصلاح"></textarea>
                            <button type="submit" class="erp-btn h-7 px-3 rounded-[3px] text-[11px] bg-amber-500 border-transparent text-white hover:bg-amber-600">
                                <i class="bi bi-pencil-square"></i>
                                <span>درخواست اصلاح</span>
                            </button>
                        </form>
                    </div>
                }
                @if (Model.CanForward)
                {
                    <div class="flex flex-col gap-2 p-2.5 rounded-[4px] bg-sky-50/50 dark:bg-sky-950/20 border border-sky-100 dark:border-sky-900/40">
                        <form asp-controller="WorkInbox" asp-action="Decide" method="post" class="flex flex-col gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="documentType" value="@Model.DocumentType" />
                            <input type="hidden" name="documentId" value="@Model.DocumentId" />
                            <input type="hidden" name="stepNumber" value="@Model.CurrentStepNumber" />
                            <input type="hidden" name="decisionType" value="Forward" />
                            <select name="forwardToUserId" class="erp-select w-full h-7">
                                @foreach (var user in Model.UserOptions)
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            </select>
                            <textarea name="note" rows="2" class="w-full erp-textarea" placeholder="توضیح ارجاع"></textarea>
                            <button type="submit" class="erp-btn h-7 px-3 rounded-[3px] text-[11px] bg-sky-600 border-transparent text-white hover:bg-sky-700">
                                <i class="bi bi-forward"></i>
                                <span>ارجاع</span>
                            </button>
                        </form>
                    </div>
                }
                @if (Model.CanDelegate && Model.CurrentWorkflowStepId.HasValue)
                {
                    <div class="flex flex-col gap-2 p-2.5 rounded-[4px] bg-slate-50/60 dark:bg-slate-950/30 border border-slate-100 dark:border-slate-800">
                        <form asp-controller="WorkInbox" asp-action="Delegate" method="post" class="flex flex-col gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="workflowStepId" value="@Model.CurrentWorkflowStepId" />
                            <select name="toUserId" class="erp-select w-full h-7">
                                @foreach (var user in Model.UserOptions)
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            </select>
                            <textarea name="note" rows="2" class="w-full erp-textarea" placeholder="توضیح واگذاری"></textarea>
                            <button type="submit" class="erp-btn h-7 px-3 rounded-[3px] text-[11px]">
                                <i class="bi bi-person-fill-gear"></i>
                                <span>واگذاری</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</section>