@model OfficeAutomation.Models.DashboardIndexViewModel
@using System.Globalization
@using System.Security.Claims

@{
    ViewData["Title"] = "میز کار راینو";
    var fa = CultureInfo.GetCultureInfo("fa-IR");
    string ToFa(int value) => value.ToString("N0", fa);

    var displayName = User?.FindFirst("name")?.Value ?? User?.FindFirst(ClaimTypes.Name)?.Value ?? User?.Identity?.Name ?? "کاربر";
    var userRole = User?.FindFirst(ClaimTypes.Role)?.Value ?? "کاربر سیستم";

    var shortcuts = new List<(string Title, string Description, string Url, string Icon)>
    {
        ("نامه‌ها", "مکاتبات و گردش نامه", "/Letters", "bi-envelope-paper"),
        ("فاکتورها", "فروش، خرید و پیگیری", "/Financial/Invoices", "bi-receipt"),
        ("کارتابل", "اقدام‌ها و تاییدها", "/WorkInbox", "bi-inboxes"),
        ("انبار", "موجودی و رسید کالا", "/Warehouse", "bi-box-seam"),
        ("گزارش‌ها", "نمای مدیریتی", "/Reports", "bi-file-bar-graph"),
        ("جستجو", "دسترسی سریع", "/Search", "bi-search")
    };
}

@section Styles {
    <style>
        /* Drag & Drop layout and visual properties */
        .executive-dashboard {
            transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .drag-mode .dashboard-panel {
            border: 2px dashed #0d9488 !important;
            opacity: 0.85;
            position: relative;
            cursor: move;
        }

        .drag-mode .dashboard-panel::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(13, 148, 136, 0.03);
            z-index: 10;
        }

        .drag-mode .dashboard-panel * {
            pointer-events: none !important;
        }

        .drag-mode .dashboard-panel .drag-handle,
        .drag-mode .dashboard-panel .drag-handle * {
            pointer-events: auto !important;
        }

        .drag-handle {
            display: none;
        }
        
        .drag-mode .drag-handle {
            display: inline-flex;
        }

        /* Preset swatches styling */
        .bg-swatch {
            width: 28px;
            height: 28px;
            border-radius: 9999px;
            border: 1.5px solid rgba(156, 163, 175, 0.4);
            cursor: pointer;
            transition: transform 0.2s ease;
        }
        
        .bg-swatch:hover {
            transform: scale(1.15);
        }

        .bg-swatch-gradient-1 { background: linear-gradient(135deg, #0f172a, #1e293b); }
        .bg-swatch-gradient-2 { background: linear-gradient(135deg, #1e1b4b, #311042); }
        .bg-swatch-gradient-3 { background: linear-gradient(135deg, #064e3b, #022c22); }
        .bg-swatch-gradient-4 { background: linear-gradient(135deg, #1c1917, #0c0a09); }
        .bg-swatch-gradient-5 { background: linear-gradient(135deg, #172554, #0f172a); }
        .bg-swatch-default { background: transparent; }

        /* Days Grid styling (calendar helper) */
        .days-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 3px;
        }

        .days-grid span {
            display: flex;
            align-items: center;
            justify-content: center;
            aspect-ratio: 1;
            font-size: 11px;
            font-weight: 600;
            border-radius: 9999px;
            transition: all 0.15s ease;
            user-select: none;
            cursor: pointer;
        }

        .days-grid span:not(.off):not(.today):hover {
            background-color: rgba(13, 148, 136, 0.12);
            color: #0d9488;
        }

        .days-grid span.today {
            background-color: #0d9488;
            color: #ffffff;
            font-weight: 800;
            box-shadow: 0 2px 8px rgba(13, 148, 136, 0.4);
        }

        .days-grid span.holiday {
            color: #e11d48;
        }

        .days-grid span.off {
            opacity: 0.25;
            cursor: default;
        }

        /* Weekly activity custom bar chart */
        .weekly-activity-chart-bar {
            background-color: #0d9488;
            transition: height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .dark .weekly-activity-chart-bar,
        .theme-dark .weekly-activity-chart-bar,
        [data-theme="dark"] .weekly-activity-chart-bar {
            background-color: #2dd4bf;
        }
    </style>
}

<div class="executive-dashboard w-full h-full min-h-full flex-1 flex flex-col gap-3 p-2.5 md:p-3 border border-slate-200 dark:border-slate-800/80 rounded-[2rem] transition-all duration-300 bg-transparent">
    <!-- Header Card -->
    <header class="flex items-center justify-between gap-3 px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm">
        <div class="min-w-0 flex items-center gap-3">
            <div class="min-w-0">
                <div class="flex items-center gap-2">
                    <h1 class="m-0 text-sm font-black text-slate-900 dark:text-white tracking-tight">داشبورد راینو</h1>
                    <span class="text-[10px] font-bold text-teal-600 dark:text-teal-400 hidden sm:block">@Model.TodayText</span>
                </div>
                <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 truncate">@displayName · @userRole</p>
            </div>
        </div>
        <div class="flex items-center gap-1.5 flex-shrink-0">
            <button id="btnToggleCustomization" type="button" class="flex items-center gap-1 px-2 py-1 border border-slate-200 dark:border-slate-700 rounded-lg text-[11px] font-bold bg-transparent hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-400 transition">
                <i class="bi bi-sliders text-teal-600 dark:text-teal-400 text-xs"></i>
                <span class="hidden sm:inline">سفارشی‌سازی</span>
            </button>
            <button id="btnToggleDragMode" type="button" class="flex items-center gap-1 px-2 py-1 border border-slate-200 dark:border-slate-700 rounded-lg text-[11px] font-bold bg-transparent hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-400 transition">
                <i class="bi bi-grid text-teal-600 dark:text-teal-400 text-xs"></i>
                <span class="hidden sm:inline">چیدمان</span>
            </button>
        </div>
    </header>

    <!-- Customization Config Panel -->
    <div id="customizationPanel" class="p-3 border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 shadow-md rounded-2xl hidden transition-all duration-300">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3 mb-4">
            <h3 class="text-sm font-black text-slate-900 dark:text-white flex items-center gap-2">
                <i class="bi bi-palette text-teal-600 dark:text-teal-400"></i>
                تنظیمات ظاهر و چیدمان داشبورد
            </h3>
            <button type="button" id="btnCloseCustomization" class="w-6 h-6 flex items-center justify-center rounded-md text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-700 dark:hover:text-slate-200 border-0 bg-transparent cursor-pointer"><i class="bi bi-x-lg text-xs"></i></button>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Background Options -->
            <div class="flex flex-col gap-2">
                <span class="text-xs font-bold text-slate-700 dark:text-slate-300">پس‌زمینه داشبورد</span>
                <div class="preset-backgrounds mt-1 flex flex-wrap gap-1.5">
                    <button class="bg-swatch bg-swatch-default" data-bg="transparent" title="پیش‌فرض سیستم"></button>
                    <button class="bg-swatch bg-swatch-gradient-1" data-bg="linear-gradient(135deg, #0f172a, #1e293b)" title="سرمه‌ای تیره"></button>
                    <button class="bg-swatch bg-swatch-gradient-2" data-bg="linear-gradient(135deg, #1e1b4b, #311042)" title="بادمجانی"></button>
                    <button class="bg-swatch bg-swatch-gradient-3" data-bg="linear-gradient(135deg, #064e3b, #022c22)" title="سبز یشمی"></button>
                    <button class="bg-swatch bg-swatch-gradient-4" data-bg="linear-gradient(135deg, #1c1917, #0c0a09)" title="ذغالی"></button>
                    <button class="bg-swatch bg-swatch-gradient-5" data-bg="linear-gradient(135deg, #172554, #0f172a)" title="آبی عمیق"></button>
                </div>
                <div class="flex gap-2 items-center mt-2 w-full">
                    <input type="color" id="bgColorPicker" class="w-10 h-8 p-0.5 border border-slate-200 dark:border-slate-800 rounded cursor-pointer bg-white dark:bg-slate-900" title="انتخاب رنگ جامد" />
                    <input type="text" id="bgImgInput" class="flex-1 text-xs p-1.5 border border-slate-200 dark:border-slate-800 rounded-lg bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-teal-500/20" placeholder="آدرس تصویر پس‌زمینه (URL)..." />
                </div>
            </div>
            
            <!-- Metric switches -->
            <div class="flex flex-col gap-2">
                <span class="text-xs font-bold text-slate-700 dark:text-slate-300">نمایش کارت‌های آماری</span>
                <div class="flex flex-wrap gap-2 mt-1">
                    @foreach (var metric in Model.ExecutiveMetrics)
                    {
                        <label class="flex items-center gap-2 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-full bg-slate-50 dark:bg-slate-950 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer text-xs font-semibold select-none text-slate-700 dark:text-slate-300">
                            <input type="checkbox" checked class="metric-toggle w-3.5 h-3.5 accent-teal-600 dark:accent-teal-400" data-target-id="@metric.Title" />
                            <span>@metric.Title</span>
                        </label>
                    }
                </div>
            </div>
            
            <!-- Widget switches -->
            <div class="flex flex-col gap-2">
                <span class="text-xs font-bold text-slate-700 dark:text-slate-300">نمایش بخش‌ها (ویجت‌ها)</span>
                <div class="flex flex-wrap gap-2 mt-1">
                    <label class="flex items-center gap-2 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-full bg-slate-50 dark:bg-slate-950 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer text-xs font-semibold select-none text-slate-700 dark:text-slate-300">
                        <input type="checkbox" checked class="widget-toggle w-3.5 h-3.5 accent-teal-600 dark:accent-teal-400" data-target-id="pending-work" />
                        <span>کارهای در انتظار اقدام</span>
                    </label>
                    <label class="flex items-center gap-2 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-full bg-slate-50 dark:bg-slate-955 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer text-xs font-semibold select-none text-slate-700 dark:text-slate-300">
                        <input type="checkbox" checked class="widget-toggle w-3.5 h-3.5 accent-teal-600 dark:accent-teal-400" data-target-id="calendar" />
                        <span>تقویم و مناسبت‌ها</span>
                    </label>
                    <label class="flex items-center gap-2 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-full bg-slate-50 dark:bg-slate-955 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer text-xs font-semibold select-none text-slate-700 dark:text-slate-300">
                        <input type="checkbox" checked class="widget-toggle w-3.5 h-3.5 accent-teal-600 dark:accent-teal-400" data-target-id="system-alerts" />
                        <span>هشدارهای عملیاتی</span>
                    </label>
                    <label class="flex items-center gap-2 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-full bg-slate-50 dark:bg-slate-955 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer text-xs font-semibold select-none text-slate-700 dark:text-slate-300">
                        <input type="checkbox" checked class="widget-toggle w-3.5 h-3.5 accent-teal-600 dark:accent-teal-400" data-target-id="weekly-activity" />
                        <span>نمودار فعالیت هفتگی</span>
                    </label>
                    <label class="flex items-center gap-2 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-full bg-slate-50 dark:bg-slate-955 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer text-xs font-semibold select-none text-slate-700 dark:text-slate-300">
                        <input type="checkbox" checked class="widget-toggle w-3.5 h-3.5 accent-teal-600 dark:accent-teal-400" data-target-id="recent-activity" />
                        <span>آخرین فعالیت‌ها</span>
                    </label>
                    <label class="flex items-center gap-2 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-full bg-slate-50 dark:bg-slate-955 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer text-xs font-semibold select-none text-slate-700 dark:text-slate-300">
                        <input type="checkbox" checked class="widget-toggle w-3.5 h-3.5 accent-teal-600 dark:accent-teal-400" data-target-id="quick-shortcuts" />
                        <span>دسترسی سریع</span>
                    </label>
                </div>
            </div>
        </div>
        
        <div class="flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800 pt-3 mt-4">
            <button type="button" id="btnResetLayout" class="px-3 py-1.5 border border-rose-200 dark:border-rose-900/50 hover:bg-rose-50 dark:hover:bg-rose-955/20 text-rose-700 dark:text-rose-400 rounded-lg text-xs font-bold transition">حذف سفارشی‌سازی و بازنشانی چیدمان</button>
        </div>
    </div>

    <!-- Summary Statistics Grid (KPI Widgets) -->
    <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 w-full">
        @{
            var kpiColors = new[]
            {
                ("bg-teal-100 text-teal-600 dark:bg-teal-900/40 dark:text-teal-300"),
                ("bg-blue-100 text-blue-600 dark:bg-blue-900/40 dark:text-blue-300"),
                ("bg-rose-100 text-rose-600 dark:bg-rose-900/40 dark:text-rose-300"),
                ("bg-amber-100 text-amber-600 dark:bg-amber-900/40 dark:text-amber-300"),
                ("bg-violet-100 text-violet-600 dark:bg-violet-900/40 dark:text-violet-300"),
                ("bg-emerald-100 text-emerald-600 dark:bg-emerald-900/40 dark:text-emerald-300"),
                ("bg-sky-100 text-sky-600 dark:bg-sky-900/40 dark:text-sky-300"),
                ("bg-orange-100 text-orange-600 dark:bg-orange-900/40 dark:text-orange-300")
            };
            int kpiIndex = 0;
        }
        @foreach (var metric in Model.ExecutiveMetrics)
        {
            var iconColor = kpiColors[kpiIndex % kpiColors.Length];
            kpiIndex++;
            <a href="@metric.Url" class="group flex items-center gap-2.5 p-2.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm hover:shadow-md hover:scale-[1.015] active:scale-[0.99] transition-all duration-150 no-underline" data-metric-id="@metric.Title">
                <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center rounded-lg @iconColor text-sm transition group-hover:scale-110">
                    <i class="bi @metric.Icon"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <strong class="block text-lg font-black text-slate-800 dark:text-slate-100 font-mono tabular-nums leading-tight">@metric.Value</strong>
                    <span class="text-[10px] text-slate-400 dark:text-slate-500 font-medium block truncate leading-tight">@metric.Title</span>
                </div>
            </a>
        }
    </section>

    <!-- Bento Grid (Widgets Layout) -->
    <div id="widgetsGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 w-full">
        
        <!-- Widget 1: Pending Work -->
        <div class="dashboard-panel p-2.5 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col min-w-0" data-widget-id="pending-work">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2 mb-3">
                <div class="flex items-center gap-2">
                    <span class="drag-handle cursor-move w-6 h-6 flex items-center justify-center border border-slate-200 dark:border-slate-800 rounded bg-slate-50 dark:bg-slate-950 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i class="bi bi-grip-vertical"></i></span>
                    <h2 class="text-sm font-bold text-slate-700 dark:text-slate-300">کارهای در انتظار اقدام</h2>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 text-[10px] font-bold">@ToFa(Model.PendingWorkItems.Count) مورد</span>
                    <a href="/WorkInbox" class="px-2 py-0.5 border border-slate-200 dark:border-slate-800 rounded text-[10px] bg-slate-50 dark:bg-slate-950 hover:bg-slate-100 dark:hover:bg-slate-800 font-bold text-decoration-none text-slate-700 dark:text-slate-300 transition">کارتابل</a>
                </div>
            </div>
            
            <div class="flex-1 flex flex-col justify-between">
                @if (Model.PendingWorkItems.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center py-12 text-center text-slate-400 dark:text-slate-500">
                        <i class="bi bi-inbox text-3xl mb-2"></i>
                        <strong class="text-xs font-bold text-slate-700 dark:text-slate-300">موردی برای اقدام فوری وجود ندارد</strong>
                        <p class="text-[10px] mt-1 leading-normal">کارهای ارجاع‌شده در صندوق ورودی نمایش داده می‌شوند.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-1 max-h-[280px] overflow-y-auto pr-1">
                        @foreach (var item in Model.PendingWorkItems)
                        {
                            var wfBadge = item.Status?.ToLowerInvariant() switch
                            {
                                "draft" or "پیش‌نویس" => "bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-200",
                                "pending" or "در انتظار" or "waiting" => "bg-amber-500 text-white dark:bg-amber-600",
                                "approved" or "تایید شد" => "bg-emerald-500 text-white dark:bg-emerald-600",
                                "rejected" or "رد شد" => "bg-rose-500 text-white dark:bg-rose-600",
                                _ => "bg-blue-500 text-white dark:bg-blue-600"
                            };
                            <a href="@item.Url" class="flex items-center gap-2.5 px-2 py-1.5 border border-slate-100 dark:border-slate-800/80 bg-slate-50/40 dark:bg-slate-950/20 rounded-lg text-slate-700 dark:text-slate-300 text-decoration-none hover:bg-slate-50 dark:hover:bg-slate-900/40 hover:border-teal-500/20 transition-all duration-200">
                                <div class="w-7 h-7 flex items-center justify-center rounded-lg bg-white dark:bg-slate-900 border border-slate-150 dark:border-slate-800 text-teal-600 dark:text-teal-400 text-xs flex-shrink-0">
                                    <i class="bi @item.Icon"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <strong class="block text-xs font-bold text-slate-900 dark:text-white truncate leading-tight">@item.Title</strong>
                                    <small class="block text-[10px] text-slate-500 dark:text-slate-400 truncate font-mono">@item.Module · @item.DateText</small>
                                </div>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold @wfBadge whitespace-nowrap">
                                    @WorkflowStatus.Label(item.Status)
                                </span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Widget 2: Interactive Persian Calendar -->
        <div class="dashboard-panel p-2.5 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col min-w-0" data-widget-id="calendar">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2 mb-3">
                <div class="flex items-center gap-2">
                    <span class="drag-handle cursor-move w-6 h-6 flex items-center justify-center border border-slate-200 dark:border-slate-800 rounded bg-slate-50 dark:bg-slate-950 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i class="bi bi-grip-vertical"></i></span>
                    <h2 class="text-sm font-bold text-slate-700 dark:text-slate-300">تقویم و مناسبت‌ها</h2>
                </div>
                <div class="flex items-center gap-1">
                    <button id="prevMonth" type="button" class="w-6 h-6 flex items-center justify-center rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 cursor-pointer border-0 bg-transparent" title="ماه گذشته"><i class="bi bi-chevron-right text-[10px]"></i></button>
                    <span id="monthDisplay" class="text-xs font-bold text-slate-800 dark:text-white px-1">---</span>
                    <button id="nextMonth" type="button" class="w-6 h-6 flex items-center justify-center rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 cursor-pointer border-0 bg-transparent" title="ماه آینده"><i class="bi bi-chevron-left text-[10px]"></i></button>
                    <button class="btn-today px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-[10px] font-bold text-slate-600 dark:text-slate-300 cursor-pointer border-0">امروز</button>
                </div>
            </div>
            
            <div class="flex-1 flex flex-col justify-between">
                <div>
                    <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-bold text-slate-500 dark:text-slate-400 mb-1 bg-slate-50 dark:bg-slate-800/50 rounded-lg px-1 py-1.5">
                        <span>ش</span><span>ی</span><span>د</span><span>س</span><span>چ</span><span>پ</span><span class="text-rose-500 dark:text-rose-400">ج</span>
                    </div>
                    <div id="daysContainer" class="days-grid mt-1">
                        <!-- Rendered dynamically by JS -->
                    </div>
                </div>
                <div id="eventLoader" class="flex justify-center py-2 hidden">
                    <div class="h-4 w-4 animate-spin rounded-full border-2 border-slate-200 dark:border-slate-800 border-t-teal-650 dark:border-t-teal-400" role="status"></div>
                </div>
                <div id="eventContent" class="mt-3 rounded-xl bg-slate-50 dark:bg-slate-950 p-3 border border-slate-100 dark:border-slate-850">
                    <div class="flex items-start gap-2.5">
                        <i class="bi bi-info-circle text-teal-600 dark:text-teal-400 mt-0.5 text-sm"></i>
                        <p id="eventDisplay" class="m-0 text-[11px] leading-5 text-slate-600 dark:text-slate-400">در حال دریافت رویدادهای این روز...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Widget 3: System Alerts -->
        <div class="dashboard-panel p-2.5 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col min-w-0" data-widget-id="system-alerts">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2 mb-3">
                <div class="flex items-center gap-2">
                    <span class="drag-handle cursor-move w-6 h-6 flex items-center justify-center border border-slate-200 dark:border-slate-800 rounded bg-slate-50 dark:bg-slate-950 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i class="bi bi-grip-vertical"></i></span>
                    <h2 class="text-sm font-bold text-slate-700 dark:text-slate-300">هشدارهای عملیاتی</h2>
                </div>
                <span class="px-2 py-0.5 rounded-full bg-amber-500 text-white text-[10px] font-bold">@ToFa(Model.SystemWarnings) هشدار</span>
            </div>
            
            <div class="flex-1 flex flex-col justify-between">
                @if (Model.SystemAlerts.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center py-12 text-center text-slate-400 dark:text-slate-500">
                        <i class="bi bi-bell-slash text-3xl mb-2"></i>
                        <strong class="text-xs font-bold text-slate-700 dark:text-slate-300">هشدار فعالی وجود ندارد</strong>
                        <p class="text-[10px] mt-1">سیستم در وضعیت عادی و پایدار است.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-1.5 max-h-[280px] overflow-y-auto pr-1">
                        @foreach (var alert in Model.SystemAlerts)
                        {
                            var severityClass = alert.Severity?.ToLowerInvariant() switch
                            {
                                "danger" => "border-rose-200 dark:border-rose-800/60 bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-300 hover:bg-rose-100/70",
                                "warning" => "border-amber-200 dark:border-amber-800/60 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-300 hover:bg-amber-100/70",
                                "info" => "border-sky-200 dark:border-sky-800/60 bg-sky-50 dark:bg-sky-950/30 text-sky-700 dark:text-sky-300 hover:bg-sky-100/70",
                                "success" => "border-emerald-200 dark:border-emerald-800/60 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100/70",
                                _ => "border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/30 text-slate-700 dark:text-slate-300 hover:bg-slate-100/70"
                            };
                            <a href="@alert.Url" class="flex gap-2.5 p-2.5 rounded-xl border text-decoration-none transition duration-200 @severityClass">
                                <i class="bi @alert.Icon text-base flex-shrink-0 mt-0.5"></i>
                                <span>
                                    <strong class="text-xs font-bold block leading-tight">@alert.Title</strong>
                                    <small class="text-[10px] text-slate-500 dark:text-slate-400 leading-relaxed mt-0.5 block">@alert.Description</small>
                                </span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Widget 4: Weekly Activity -->
        <div class="dashboard-panel p-2.5 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col min-w-0" data-widget-id="weekly-activity">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2 mb-3">
                <div class="flex items-center gap-2">
                    <span class="drag-handle cursor-move w-6 h-6 flex items-center justify-center border border-slate-200 dark:border-slate-800 rounded bg-slate-50 dark:bg-slate-955 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i class="bi bi-grip-vertical"></i></span>
                    <h2 class="text-sm font-bold text-slate-700 dark:text-slate-300">فعالیت هفت روز اخیر</h2>
                </div>
                <span class="px-2 py-0.5 rounded-full bg-teal-500 text-white text-[10px] font-bold">@ToFa(Model.TotalAuditEvents) رخداد</span>
            </div>
            
            <div class="flex-1 flex flex-col justify-between">
                <div class="h-40 flex items-end gap-3 pt-4 justify-between">
                    @foreach (var point in Model.WeeklyActivity)
                    {
                        <div class="flex flex-col items-center gap-2 flex-1 min-w-0">
                            <div class="h-32 w-full flex items-end rounded-lg bg-slate-50 dark:bg-slate-955 p-1 border border-slate-200/50 dark:border-slate-800/50">
                                <div class="weekly-activity-chart-bar w-full rounded-md hover:bg-teal-500/80 dark:hover:bg-teal-400/80 transition-all duration-300 cursor-pointer" style="height: @(point.Percent)%" title="@point.Value رخداد سیستمی"></div>
                            </div>
                            <small class="truncate text-[9px] text-slate-500 dark:text-slate-400 font-bold font-mono">
                                @(point.Label.Length >= 2 ? point.Label[^2..] : point.Label)
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Widget 5: Recent Audit Activities -->
        <div class="dashboard-panel p-2.5 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col min-w-0" data-widget-id="recent-activity">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2 mb-3">
                <div class="flex items-center gap-2">
                    <span class="drag-handle cursor-move w-6 h-6 flex items-center justify-center border border-slate-200 dark:border-slate-800 rounded bg-slate-50 dark:bg-slate-955 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i class="bi bi-grip-vertical"></i></span>
                    <h2 class="text-sm font-bold text-slate-700 dark:text-slate-300">آخرین فعالیت‌های سیستم</h2>
                </div>
                <span class="text-[10px] text-slate-400 dark:text-slate-500 font-bold">تراکنش‌های اخیر</span>
            </div>
            
            <div class="flex-1 flex flex-col justify-between">
                @if (Model.RecentActivities.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center py-12 text-center text-slate-400 dark:text-slate-500">
                        <i class="bi bi-activity text-3xl mb-2"></i>
                        <strong class="text-xs font-bold text-slate-700 dark:text-slate-300">هنوز رخدادی ثبت نشده است</strong>
                    </div>
                }
                else
                {
                    <div class="space-y-1 max-h-[280px] overflow-y-auto pr-1">
                        @foreach (var item in Model.RecentActivities)
                        {
                            var statusBadgeClass = item.StatusCssClass?.ToLowerInvariant() switch
                            {
                                "success" => "bg-emerald-500 text-white",
                                "pending" => "bg-amber-500 text-white",
                                "danger" => "bg-rose-500 text-white",
                                _ => "bg-slate-400 text-white"
                            };
                            <div class="flex items-center justify-between gap-2 px-2 py-1.5 border border-slate-100 dark:border-slate-800/60 bg-slate-50/40 dark:bg-slate-950/20 rounded-lg">
                                <span class="min-w-0">
                                    <strong class="block text-xs font-bold text-slate-900 dark:text-white truncate leading-tight">@item.DocumentType</strong>
                                    <small class="block text-[10px] text-slate-500 dark:text-slate-400 font-mono">@item.DateText</small>
                                </span>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold min-w-max @statusBadgeClass">@item.StatusText</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Widget 6: Quick Shortcuts -->
        <div class="dashboard-panel p-2.5 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col min-w-0" data-widget-id="quick-shortcuts">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-1.5 mb-2">
                <div class="flex items-center gap-2">
                    <span class="drag-handle cursor-move w-6 h-6 flex items-center justify-center border border-slate-200 dark:border-slate-800 rounded bg-slate-50 dark:bg-slate-955 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i class="bi bi-grip-vertical"></i></span>
                    <h2 class="text-xs font-bold text-slate-700 dark:text-slate-300">دسترسی سریع</h2>
                </div>
                <span class="text-[10px] text-slate-400 dark:text-slate-500">پرکاربرد</span>
            </div>
            
            <div class="flex-1">
                <div class="grid grid-cols-2 gap-1.5">
                    @foreach (var shortcut in shortcuts)
                    {
                        <a href="@shortcut.Url" class="group flex items-center gap-2 px-2 py-1.5 border border-slate-100 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-950/20 rounded-lg text-slate-800 dark:text-slate-200 text-decoration-none hover:bg-slate-50 dark:hover:bg-slate-900/40 hover:border-teal-500/20 transition-all duration-150">
                            <i class="bi @shortcut.Icon text-xs text-slate-500 dark:text-slate-400 group-hover:text-teal-600 dark:group-hover:text-teal-400 flex-shrink-0"></i>
                            <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300 truncate">@shortcut.Title</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/jalali-moment.browser.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    
    <script>
        (function () {
            // DOM Elements
            const customizationPanel = document.getElementById('customizationPanel');
            const btnToggleCustomization = document.getElementById('btnToggleCustomization');
            const btnCloseCustomization = document.getElementById('btnCloseCustomization');
            const btnToggleDragMode = document.getElementById('btnToggleDragMode');
            const btnResetLayout = document.getElementById('btnResetLayout');
            
            const bgColorPicker = document.getElementById('bgColorPicker');
            const bgImgInput = document.getElementById('bgImgInput');
            const widgetsGrid = document.getElementById('widgetsGrid');
            
            // Toggle Customization Panel
            btnToggleCustomization?.addEventListener('click', () => {
                customizationPanel.classList.toggle('hidden');
                customizationPanel.classList.toggle('block');
            });
            
            btnCloseCustomization?.addEventListener('click', () => {
                customizationPanel.classList.add('hidden');
                customizationPanel.classList.remove('block');
            });
            
            // Toggle Drag Mode (widget reordering)
            let dragModeActive = false;
            btnToggleDragMode?.addEventListener('click', () => {
                dragModeActive = !dragModeActive;
                widgetsGrid.classList.toggle('drag-mode', dragModeActive);
                
                // Toggle active style on the button
                if (dragModeActive) {
                    btnToggleDragMode.classList.add('bg-slate-100', 'dark:bg-slate-800', 'border-teal-500/30');
                } else {
                    btnToggleDragMode.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'border-teal-500/30');
                }
                
                // Enable/disable HTML5 Draggable property
                const panels = widgetsGrid.querySelectorAll('.dashboard-panel');
                panels.forEach(panel => {
                    panel.setAttribute('draggable', dragModeActive ? 'true' : 'false');
                });
            });
            
            // Reset Layout & settings
            btnResetLayout?.addEventListener('click', () => {
                if (confirm('آیا مطمئن هستید که می‌خواهید ظاهر داشبورد را به حالت اولیه برگردانید؟')) {
                    localStorage.removeItem('rhyno.dashboard.background');
                    localStorage.removeItem('rhyno.dashboard.visibility');
                    localStorage.removeItem('rhyno.dashboard.layout');
                    window.location.reload();
                }
            });
            
            // Background Selection & Pickers
            document.querySelectorAll('.preset-backgrounds .bg-swatch').forEach(swatch => {
                swatch.addEventListener('click', () => {
                    const bg = swatch.dataset.bg;
                    applyBackground(bg);
                });
            });
            
            bgColorPicker?.addEventListener('input', (e) => {
                applyBackground(e.target.value);
            });
            
            bgImgInput?.addEventListener('input', (e) => {
                const val = e.target.value.trim();
                if (val) {
                    applyBackground(`url('${val}') center/cover no-repeat`);
                }
            });
            
            // Visibility Toggles
            document.querySelectorAll('.metric-toggle').forEach(chk => {
                chk.addEventListener('change', () => {
                    const id = chk.dataset.targetId;
                    const card = document.querySelector(`[data-metric-id="${id}"]`);
                    if (card) {
                        card.classList.toggle('hidden', !chk.checked);
                    }
                    saveVisibility();
                });
            });
            
            document.querySelectorAll('.widget-toggle').forEach(chk => {
                chk.addEventListener('change', () => {
                    const id = chk.dataset.targetId;
                    const panel = document.querySelector(`[data-widget-id="${id}"]`);
                    if (panel) {
                        panel.classList.toggle('hidden', !chk.checked);
                    }
                    saveVisibility();
                });
            });
            
            // Drag and Drop implementation
            let dragSourceEl = null;
            
            function handleDragStart(e) {
                if (!dragModeActive) return;
                this.classList.add('opacity-40');
                dragSourceEl = this;
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', this.getAttribute('data-widget-id'));
            }
            
            function handleDragOver(e) {
                if (e.preventDefault) e.preventDefault();
                return false;
            }
            
            function handleDragEnter(e) {
                if (!dragModeActive) return;
                this.classList.add('border-teal-500', 'dark:border-teal-400');
            }
            
            function handleDragLeave(e) {
                this.classList.remove('border-teal-500', 'dark:border-teal-400');
            }
            
            function handleDrop(e) {
                e.stopPropagation();
                if (dragSourceEl !== this && dragModeActive) {
                    const children = Array.from(widgetsGrid.children);
                    const sourceIndex = children.indexOf(dragSourceEl);
                    const targetIndex = children.indexOf(this);
                    
                    if (sourceIndex < targetIndex) {
                        widgetsGrid.insertBefore(dragSourceEl, this.nextSibling);
                    } else {
                        widgetsGrid.insertBefore(dragSourceEl, this);
                    }
                    saveLayout();
                }
                return false;
            }
            
            function handleDragEnd(e) {
                this.classList.remove('opacity-40');
                widgetsGrid.querySelectorAll('.dashboard-panel').forEach(p => {
                    p.classList.remove('border-teal-500', 'dark:border-teal-400');
                });
            }
            
            function setupDragAndDrop() {
                const panels = widgetsGrid.querySelectorAll('.dashboard-panel');
                panels.forEach(panel => {
                    panel.addEventListener('dragstart', handleDragStart, false);
                    panel.addEventListener('dragenter', handleDragEnter, false);
                    panel.addEventListener('dragover', handleDragOver, false);
                    panel.addEventListener('dragleave', handleDragLeave, false);
                    panel.addEventListener('drop', handleDrop, false);
                    panel.addEventListener('dragend', handleDragEnd, false);
                });
            }
            
            // Background control
            function applyBackground(bg) {
                const dash = document.querySelector('.executive-dashboard');
                if (!dash) return;
                dash.style.background = bg;
                if (bg !== 'transparent') {
                     dash.classList.remove('bg-transparent');
                     dash.classList.add('bg-opacity-95', 'backdrop-blur-md');
                } else {
                     dash.classList.add('bg-transparent');
                     dash.classList.remove('bg-opacity-95', 'backdrop-blur-md');
                }
                localStorage.setItem('rhyno.dashboard.background', bg);
            }
            
            function saveVisibility() {
                const vis = {};
                document.querySelectorAll('.metric-toggle').forEach(chk => {
                    vis['m_' + chk.dataset.targetId] = chk.checked;
                });
                document.querySelectorAll('.widget-toggle').forEach(chk => {
                    vis['w_' + chk.dataset.targetId] = chk.checked;
                });
                localStorage.setItem('rhyno.dashboard.visibility', JSON.stringify(vis));
            }
            
            function saveLayout() {
                const panels = Array.from(widgetsGrid.querySelectorAll('.dashboard-panel'));
                const layout = panels.map(p => p.getAttribute('data-widget-id'));
                localStorage.setItem('rhyno.dashboard.layout', JSON.stringify(layout));
            }
            
            function restoreDashboardState() {
                // Restore Background
                const bg = localStorage.getItem('rhyno.dashboard.background');
                if (bg) {
                    applyBackground(bg);
                    if (bgColorPicker && bg.startsWith('#')) bgColorPicker.value = bg;
                    if (bgImgInput && bg.startsWith('url')) {
                        const match = bg.match(/url\(['"]?([^'"]*)['"]?\)/);
                        if (match) bgImgInput.value = match[1];
                    }
                }
                
                // Restore Visibility
                const visStr = localStorage.getItem('rhyno.dashboard.visibility');
                if (visStr) {
                    try {
                        const vis = JSON.parse(visStr);
                        document.querySelectorAll('.metric-toggle').forEach(chk => {
                            const id = chk.dataset.targetId;
                            const state = vis['m_' + id];
                            if (state !== undefined) {
                                chk.checked = state;
                                const card = document.querySelector(`[data-metric-id="${id}"]`);
                                if (card) card.classList.toggle('hidden', !state);
                            }
                        });
                        document.querySelectorAll('.widget-toggle').forEach(chk => {
                            const id = chk.dataset.targetId;
                            const state = vis['w_' + id];
                            if (state !== undefined) {
                                chk.checked = state;
                                const panel = document.querySelector(`[data-widget-id="${id}"]`);
                                if (panel) panel.classList.toggle('hidden', !state);
                            }
                        });
                    } catch(e) {}
                }
                
                // Restore Layout
                const layoutStr = localStorage.getItem('rhyno.dashboard.layout');
                if (layoutStr) {
                    try {
                        const layout = JSON.parse(layoutStr);
                        layout.forEach(id => {
                            const panel = widgetsGrid.querySelector(`[data-widget-id="${id}"]`);
                            if (panel) {
                                widgetsGrid.appendChild(panel);
                            }
                        });
                    } catch(e) {}
                }
            }
            
            // Initialization
            restoreDashboardState();
            setupDragAndDrop();
        })();
    </script>
}
