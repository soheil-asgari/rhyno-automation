@model OfficeAutomation.Models.DashboardIndexViewModel
@using System.Globalization
@using System.Security.Claims
@using OfficeAutomation.Services.Tenancy
@inject ITenantSettingsService TenantSettingsService

@{
    ViewData["Title"] = "میز کار راینو";
    var fa = CultureInfo.GetCultureInfo("fa-IR");
    string ToFa(int value) => value.ToString("N0", fa);

    var displayName = User?.FindFirst("name")?.Value ?? User?.FindFirst(ClaimTypes.Name)?.Value ?? User?.Identity?.Name ??
"کاربر";
    var userRole = User?.FindFirst(ClaimTypes.Role)?.Value ?? "کاربر سیستم";

    // Read branding background for the home page fallback
    OfficeAutomation.Models.SystemSetting? homeBranding = null;
    try { homeBranding = await TenantSettingsService.GetSystemSettingsAsync(); } catch { }
    var homeBrandBgUrl = homeBranding?.LoginBackgroundUrl;

    var shortcuts = new List<(string Title, string Icon, string Url)>
    {
        ("تنظیم مشخصات مالی کارمند", "bi-person-gear", "/HumanCapital"),
        ("صدور سند حسابداری", "bi-journal-plus", "/Financial/LedgerOperations"),
        ("مرور حساب‌ها", "bi-graph-up-arrow", "/Financial/GetTrialBalance"),
        ("سند حسابداری", "bi-file-earmark-text", "/Financial/LedgerOperations"),
        ("ثبت مقادیر عوامل ورودی", "bi-calculator", "/Financial"),
        ("ایجاد فایل", "bi-file-earmark-plus", "/DocumentArchive"),
        ("حکم کارگزینی", "bi-file-earmark-person", "/HumanCapital"),
        ("ثبت حکم مالی", "bi-cash-stack", "/Payroll"),
        ("محاسبه حقوق", "bi-calculator-fill", "/Payroll"),
    };
}

@section Styles {
    <style>
        .dashboard-widget-icon {
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .rahkaran-widget-card:hover .dashboard-widget-icon {
            transform: scale(1.1);
        }

        /* KPI metric cards keep their solid icon color on hover */
        .rahkaran-widget-card:hover .dashboard-widget-icon[style*="background"] {
            background: inherit !important;
        }

        .kpi-value {
            font-variant-numeric: tabular-nums;
        }
    </style>
}

<!-- ═══════════════════════════════════════════════════════════
DESKTOP TOOLBAR
═══════════════════════════════════════════════════════════ -->
<div class="desktop-toolbar">
    <a href="@Url.Action("Index", "Settings")"><i class="bi bi-sliders"></i> تنظیمات ظاهری</a>
    <a href="#" onclick="changeBackground()"><i class="bi bi-image"></i> تغییر پس‌زمینه</a>
    <a href="#" onclick="addShortcut()"><i class="bi bi-star"></i> درج میانبر به صفحه</a>
    <a href="#" onclick="addWidget()"><i class="bi bi-puzzle"></i> درج ویجت</a>
    <a href="@Url.Action("Index", "Settings")"><i class="bi bi-tools"></i> مدیریت میز کار</a>
</div>

<!-- ═══════════════════════════════════════════════════════════
WIDGETS GRID — Shortcut Cards
═══════════════════════════════════════════════════════════ -->
<div class="rahkaran-widgets-grid">
    @foreach (var shortcut in shortcuts)
    {
        <a href="@shortcut.Url" class="rahkaran-widget-card">
            <div class="widget-icon dashboard-widget-icon">
                <i class="bi @shortcut.Icon"></i>
            </div>
            <div class="widget-title">@shortcut.Title</div>
        </a>
    }
</div>

<!-- ═══════════════════════════════════════════════════════════
KPI / STATISTICS CARD
═══════════════════════════════════════════════════════════ -->
<div class="rahkaran-kpi-card">
    <span>🌐</span>
    <span>تعداد کاربران آنلاین سیستم: </span>
    <strong id="onlineUsersCount">@ToFa(Model.TotalUsers > 0 ? Model.TotalUsers : 2) نفر</strong>
</div>

<!-- ═══════════════════════════════════════════════════════════
KPI METRICS GRID (from model) — clickable executive shortcuts
═══════════════════════════════════════════════════════════ -->
@if (Model.ExecutiveMetrics != null && Model.ExecutiveMetrics.Count > 0)
{
    <div class="rahkaran-widgets-grid" style="margin-top:5px;">
        @{
            var iconColors = new[] { "#007bb5", "#10b981", "#e11d48", "#f59e0b", "#8b5cf6", "#06b6d4", "#f97316", "#ec4899" };
            int colorIndex = 0;
        }
        @foreach (var metric in Model.ExecutiveMetrics)
        {
            var bgColor = iconColors[colorIndex % iconColors.Length];
            colorIndex++;
            <a href="@metric.Url"
               class="rahkaran-widget-card"
               style="cursor:pointer;height:auto;min-height:90px;padding:12px 10px;text-decoration:none;">
                <div class="widget-icon dashboard-widget-icon" style="background:@bgColor;color:#fff;">
                    <i class="bi @metric.Icon"></i>
                </div>
                <div class="widget-title" style="font-size:11px;color:#555;">@metric.Title</div>
                <strong class="kpi-value"
                        style="font-size:18px;font-weight:900;color:#1a1a2e;margin-top:4px;">@metric.Value</strong>
            </a>
        }
    </div>
}

<!-- ═══════════════════════════════════════════════════════════
PENDING WORK ITEMS (if any) — DimGray compact panel
═══════════════════════════════════════════════════════════ -->
@if (Model.PendingWorkItems != null && Model.PendingWorkItems.Count > 0)
{
    <div class="rk-dimgray-panel" style="margin-top:10px;">
        <div class="rk-panel-head">
            <h3 class="rk-panel-title"><i class="bi bi-inboxes" style="font-size:13px;"></i> کارهای در انتظار اقدام</h3>
            <span class="rk-panel-badge">@ToFa(Model.PendingWorkItems.Count) مورد</span>
        </div>
        <div class="rk-panel-list">
            @foreach (var item in Model.PendingWorkItems)
            {
                var statusColor = item.Status?.ToLowerInvariant() switch
                {
                    "draft" or "پیش‌نویس" => "#94a3b8",
                    "pending" or "در انتظار" => "#f59e0b",
                    "approved" or "تایید شد" => "#10b981",
                    "rejected" or "رد شد" => "#e11d48",
                    _ => "#007bb5"
                };
                <a href="@item.Url"
                   class="rk-list-item"
                   style="border-right:3px solid @statusColor;">
                    <span class="rk-item-icon">
                        <i class="bi @item.Icon"></i>
                    </span>
                    <span style="flex:1;min-width:0;">
                        <strong style="display:block;font-size:12px;font-weight:700;color:#2d3446;">@item.Title</strong>
                        <small style="display:block;font-size:10px;color:#777;">@item.Module · @item.DateText</small>
                    </span>
                    <span class="rk-item-status"
                          style="background:@statusColor;color:#fff;">@WorkflowStatus.Label(item.Status)</span>
                </a>
            }
        </div>
    </div>
}

<!-- ═══════════════════════════════════════════════════════════
SYSTEM ALERTS (if any) — DimGray compact panel
═══════════════════════════════════════════════════════════ -->
    @if (Model.SystemAlerts != null && Model.SystemAlerts.Count > 0)
    {
        <div class="rk-dimgray-panel" style="margin-top:10px;">
            <div class="rk-panel-head">
                <h3 class="rk-panel-title"><i class="bi bi-bell" style="font-size:13px;"></i> هشدارهای عملیاتی</h3>
                <span class="rk-panel-badge rk-panel-badge-amber">@ToFa(Model.SystemAlerts.Count) هشدار</span>
            </div>
            <div class="rk-panel-list">
                @foreach (var alert in Model.SystemAlerts)
                {
                    var alertBorder = alert.Severity?.ToLowerInvariant() switch
                    {
                        "danger" => "#ef404d",
                        "warning" => "#f08046",
                        "info" => "#4d99d0",
                        "success" => "#18af08",
                        _ => "#3e4756"
                    };
                    <a href="@alert.Url"
                       class="rk-list-item"
                       style="border-right:3px solid @alertBorder;">
                        <span class="rk-item-icon" style="color:@alertBorder;">
                            <i class="bi @alert.Icon"></i>
                        </span>
                        <span style="flex:1;min-width:0;">
                            <strong style="display:block;font-size:12px;font-weight:700;color:#2d3446;">@alert.Title</strong>
                            <small style="display:block;font-size:11px;color:#6b7280;line-height:1.5;">@alert.Description</small>
                        </span>
                    </a>
                }
            </div>
        </div>
    }

        <!-- ═══════════════════════════════════════════════════════════
RECENT ACTIVITIES (if any)
═══════════════════════════════════════════════════════════ -->
        @if (Model.RecentActivities != null && Model.RecentActivities.Count > 0)
        {
            <div class="rahkaran-page-content" style="margin-top:10px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                    <h3 style="margin:0;font-size:14px;font-weight:800;">آخرین فعالیت‌های سیستم</h3>
                    <span style="color:#9ca3af;font-size:11px;">تراکنش‌های اخیر</span>
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;">
                    @foreach (var item in Model.RecentActivities)
                    {
                        var statusColor = item.StatusCssClass?.ToLowerInvariant() switch
                        {
                            "success" => "#10b981",
                            "pending" => "#f59e0b",
                            "danger" => "#e11d48",
                            _ => "#94a3b8"
                        };
                        <div
                            style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border:1px solid #f3f4f6;border-radius:8px;background:#fafbfc;">
                            <span style="min-width:0;">
                                <strong style="display:block;font-size:12px;font-weight:700;color:#374151;">@item.DocumentType</strong>
                                <small style="display:block;font-size:10px;color:#9ca3af;">@item.DateText</small>
                            </span>
                            <span
                            style="background:@statusColor;color:#fff;padding:3px 8px;border-radius:12px;font-size:10px;font-weight:700;white-space:nowrap;">@item.StatusText</span>
                        </div>
                    }
                </div>
            </div>
        }

        @section Scripts {
            <script>
                // ── Background Change (upload file + URL) ──────────
                function changeBackground() {
                    const overlay = document.createElement('div');
                    overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);';
                    overlay.id = 'bgUploadModal';

                    const dialog = document.createElement('div');
                    dialog.style.cssText = 'background:#fff;border-radius:12px;padding:24px;max-width:480px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.4);direction:rtl;';
                    dialog.innerHTML = ''
                        + '<h3 style="margin:0 0 16px 0;font-size:16px;font-weight:800;color:#1f2937;">\uD83D\uDDBC\uFE0F \u062A\u063A\u06CC\u06CC\u0631 \u062A\u0635\u0648\u06CC\u0631 \u067E\u0633\u200C\u0632\u0645\u06CC\u0646\u0647</h3>'
                        + '<div style="margin-bottom:16px;">'
                        + '<label style="display:block;font-size:12px;font-weight:700;color:#4b5563;margin-bottom:8px;">\uD83D\uDCC1 \u0622\u067E\u0644\u0648\u062F \u0639\u06A9\u0633 \u0627\u0632 \u062F\u0633\u062A\u06AF\u0627\u0647:</label>'
                        + '<input type="file" id="bgFileInput" accept="image/*" style="display:block;width:100%;padding:8px;border:2px dashed #d1d5db;border-radius:8px;font-size:12px;cursor:pointer;background:#f9fafb;" />'
                        + '<div id="bgFilePreview" style="margin-top:8px;display:none;">'
                        + '<img id="bgPreviewImg" style="max-width:100%;max-height:120px;border-radius:8px;border:1px solid #e5e7eb;" />'
                        + '<button type="button" id="bgApplyFile" style="margin-top:8px;padding:8px 16px;background:#007bb5;color:#fff;border:none;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;">\u0627\u0639\u0645\u0627\u0644 \u0627\u06CC\u0646 \u0639\u06A9\u0633</button>'
                        + '</div></div>'
                        + '<div style="margin-bottom:16px;">'
                        + '<label style="display:block;font-size:12px;font-weight:700;color:#4b5563;margin-bottom:8px;">\uD83D\uDD17 \u06CC\u0627 \u0648\u0627\u0631\u062F \u06A9\u0631\u062F\u0646 \u0622\u062F\u0631\u0633 (URL):</label>'
                        + '<div style="display:flex;gap:8px;">'
                        + '<input type="text" id="bgUrlInput" placeholder="https://example.com/image.jpg" style="flex:1;padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;outline:none;" />'
                        + '<button type="button" id="bgApplyUrl" style="padding:8px 16px;background:#007bb5;color:#fff;border:none;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;">\u0627\u0639\u0645\u0627\u0644</button>'
                        + '</div></div>'
                        + '<div style="display:flex;gap:8px;justify-content:flex-end;">'
                        + '<button type="button" id="bgResetDefault" style="padding:8px 16px;background:#f3f4f6;color:#374151;border:1px solid #d1d5db;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;">\u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06CC \u0628\u0647 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636</button>'
                        + '<button type="button" id="bgCloseModal" style="padding:8px 16px;background:#e5e7eb;color:#374151;border:1px solid #d1d5db;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;">\u0628\u0633\u062A\u0646</button>'
                        + '</div>';
                    overlay.appendChild(dialog);
                    document.body.appendChild(overlay);

                    const close = () => overlay.remove();
                    document.getElementById('bgCloseModal').addEventListener('click', close);
                    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

                    let uploadedDataUrl = null;
                    document.getElementById('bgFileInput').addEventListener('change', (e) => {
                        const file = e.target.files[0];
                        if (!file || !file.type.startsWith('image/')) { Rhyno.toast('\u0644\u0637\u0641\u0627\u064B \u06CC\u06A9 \u0641\u0627\u06CC\u0644 \u062A\u0635\u0648\u06CC\u0631\u06CC \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u06CC\u062F.', 'error'); return; }
                        const reader = new FileReader();
                        reader.onload = (ev) => {
                            uploadedDataUrl = ev.target.result;
                            document.getElementById('bgPreviewImg').src = uploadedDataUrl;
                            document.getElementById('bgFilePreview').style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    });
                    document.getElementById('bgApplyFile').addEventListener('click', () => {
                        if (uploadedDataUrl) { applyBg(uploadedDataUrl); close(); }
                    });
                    document.getElementById('bgApplyUrl').addEventListener('click', () => {
                        const url = document.getElementById('bgUrlInput').value.trim();
                        if (url) { applyBg(url); close(); } else { Rhyno.toast('\u0644\u0637\u0641\u0627\u064B \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u0645\u0639\u062A\u0628\u0631 \u0648\u0627\u0631\u062F \u06A9\u0646\u06CC\u062F.', 'warning'); }
                    });
                    document.getElementById('bgResetDefault').addEventListener('click', () => {
                        localStorage.removeItem('rhyno.customBg');
                        var brandBg = '@(homeBrandBgUrl ?? "")';
                        if (brandBg) {
                            setBodyBg(brandBg);
                        } else {
                            document.body.style.background = '';
                            document.body.style.backgroundSize = '';
                        }
                        close();
                        Rhyno.toast('\u067E\u0633\u200C\u0632\u0645\u06CC\u0646\u0647 \u0628\u0647 \u062D\u0627\u0644\u062A \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06CC \u0634\u062F.', 'success');
                    });
                }

                function setBodyBg(src) {
                    document.body.style.setProperty('background', `url('${src}') no-repeat center center fixed`, 'important');
                    document.body.style.setProperty('background-size', 'cover', 'important');
                }

                function applyBg(src) {
                    setBodyBg(src);
                    localStorage.setItem('rhyno.customBg', src);
                    Rhyno.toast('\u067E\u0633\u200C\u0632\u0645\u06CC\u0646\u0647 \u0628\u0627 \u0645\u0648\u0641\u0642\u06CC\u062A \u062A\u063A\u06CC\u06CC\u0631 \u06A9\u0631\u062F.', 'success');
                }

                function addShortcut() {
                    Rhyno.toast('\u0628\u0631\u0627\u06CC \u0627\u0641\u0632\u0648\u062F\u0646 \u0645\u06CC\u0627\u0646\u0628\u0631 \u0628\u0647 \u0635\u0641\u062D\u0647 \u0645\u0648\u0631\u062F \u0646\u0638\u0631 \u0628\u0631\u0648\u06CC\u062F.', 'info');
                }

                function addWidget() {
                    Rhyno.toast('\u0648\u06CC\u062C\u062A\u200C\u0647\u0627\u06CC \u0628\u06CC\u0634\u062A\u0631\u06CC \u0628\u0647 \u0632\u0648\u062F\u06CC \u062F\u0631 \u062F\u0633\u062A\u0631\u0633 \u062E\u0648\u0627\u0647\u0646\u062F \u0628\u0648\u062F.', 'info');
                }

                // ── Restore custom background ────────────────────────
                (() => {
                    const savedBg = localStorage.getItem('rhyno.customBg');
                    if (savedBg) {
                        setBodyBg(savedBg);
                    }
                })();

                // ── Randomize online users count (demo) ──────────────
                (() => {
                    const el = document.getElementById('onlineUsersCount');
                    if (el) {
                        const base = parseInt(el.textContent.replace(/[^0-9]/g, '')) || 2;
                        setInterval(() => {
                            const delta = Math.floor(Math.random() * 3) - 1;
                            const newVal = Math.max(1, base + delta);
                            el.textContent = newVal.toLocaleString('fa-IR') + ' نفر';
                        }, 30000);
                    }
                })();
            </script>
        }