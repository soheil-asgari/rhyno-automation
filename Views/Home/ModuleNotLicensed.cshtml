@using OfficeAutomation.Services.Licensing
@inject ILicenseContext LicenseContext
@{
    ViewData["Title"] = "ماژول در لایسنس فعال نیست";
    var moduleDisplayName = ViewBag.ModuleNameDisplay as string ?? "ماژول درخواستی";
    var rawModuleName = ViewBag.RawModuleName as string ?? string.Empty;
    var currentLicense = LicenseContext.CurrentLicense;
    var activeModules = currentLicense?.Modules ?? new List<string>();
}

<div class="min-h-[75vh] flex items-center justify-center p-4 sm:p-6" dir="rtl">
    <div class="w-full max-w-2xl bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-10 text-center relative overflow-hidden">
        <!-- Top decorative banner accent -->
        <div class="absolute top-0 inset-x-0 h-2 bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500"></div>

        <!-- Warning Icon -->
        <div class="mx-auto mb-5 w-20 h-20 rounded-2xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-800/40 flex items-center justify-center shadow-sm">
            <i class="bi bi-shield-lock-fill text-4xl text-amber-600 dark:text-amber-400"></i>
        </div>

        <!-- Badge -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 mb-3 border border-amber-200 dark:border-amber-700/50">
            <i class="bi bi-exclamation-octagon"></i>
            <span>دسترسی ماژولار محدود شده</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white mb-2 tracking-tight">
            ماژول در لایسنس فعال شما موجود نیست
        </h1>

        <p class="text-base font-medium text-slate-600 dark:text-slate-300 mb-6">
            دسترسی به ماژول <span class="font-bold text-amber-600 dark:text-amber-400">«@moduleDisplayName»</span> تحت لایسنس فعلی این سازمان فعال نشده است.
        </p>

        <!-- Informational box -->
        <div class="bg-slate-50 dark:bg-slate-950/60 rounded-xl p-4 sm:p-5 border border-slate-200 dark:border-slate-800 text-right mb-6 space-y-3">
            <div class="flex items-center justify-between text-xs sm:text-sm border-b border-slate-200 dark:border-slate-800 pb-2.5">
                <span class="text-slate-500 dark:text-slate-400">ماژول درخواستی:</span>
                <span class="font-bold text-slate-800 dark:text-slate-200">@moduleDisplayName</span>
            </div>
            <div class="flex items-center justify-between text-xs sm:text-sm border-b border-slate-200 dark:border-slate-800 pb-2.5">
                <span class="text-slate-500 dark:text-slate-400">نام مشتری / سازمان:</span>
                <span class="font-semibold text-slate-800 dark:text-slate-200">@(currentLicense?.CustomerName ?? "ثبت نشده")</span>
            </div>
            <div class="flex items-center justify-between text-xs sm:text-sm border-b border-slate-200 dark:border-slate-800 pb-2.5">
                <span class="text-slate-500 dark:text-slate-400">نوع لایسنس فعلی:</span>
                <span class="font-semibold text-slate-800 dark:text-slate-200">@(currentLicense?.LicenseType ?? "نامشخص")</span>
            </div>
            <div class="flex items-start justify-between text-xs sm:text-sm pt-1">
                <span class="text-slate-500 dark:text-slate-400 shrink-0">ماژول‌های فعال شما:</span>
                <span class="font-medium text-slate-700 dark:text-slate-300 text-left">
                    @if (activeModules.Any())
                    {
                        <span class="inline-flex flex-wrap gap-1 justify-end">
                            @foreach (var mod in activeModules)
                            {
                                <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40 text-xs">
                                    @OfficeAutomation.Services.Licensing.RequiresModuleAttribute.GetModuleDisplayName(mod)
                                </span>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="text-rose-500">هیچ ماژولی فعال نیست</span>
                    }
                </span>
            </div>
        </div>

        <!-- Contact Support Information -->
        <div class="bg-blue-50/70 dark:bg-blue-950/30 rounded-xl p-4 sm:p-5 border border-blue-200/80 dark:border-blue-800/40 text-right mb-8">
            <div class="flex items-center gap-2 mb-2 text-blue-900 dark:text-blue-200 font-bold text-sm">
                <i class="bi bi-telephone-inbound text-blue-600 dark:text-blue-400 text-base"></i>
                <span>جهت فعال‌سازی و ارتقای لایسنس با ما تماس بگیرید:</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
                برای افزودن این ماژول به بسته سازمانی خود یا تمدید اشتراک، با کارشناسان پشتیبانی یا فروش راینو ERP ارتباط برقرار فرمایید یا به مدیر سیستم سازمان اطلاع دهید.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs text-slate-700 dark:text-slate-300 font-medium">
                <div class="flex items-center gap-2 bg-white/80 dark:bg-slate-900/80 p-2.5 rounded-lg border border-blue-100 dark:border-blue-900/30">
                    <i class="bi bi-envelope text-blue-600 dark:text-blue-400"></i>
                    <span>ایمیل پشتیبانی:</span>
                    <a href="mailto:support@rhyno.app" class="font-bold text-blue-700 dark:text-blue-300 hover:underline">support@rhyno.app</a>
                </div>
                <div class="flex items-center gap-2 bg-white/80 dark:bg-slate-900/80 p-2.5 rounded-lg border border-blue-100 dark:border-blue-900/30">
                    <i class="bi bi-headset text-blue-600 dark:text-blue-400"></i>
                    <span>مرکز تماس پشتیبانی:</span>
                    <span class="font-bold text-slate-800 dark:text-slate-200 dir-ltr">۰۲۱-۸۸۸۸۸۸۸۸</span>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-sm hover:bg-slate-800 dark:hover:bg-slate-100 transition shadow-sm">
                <i class="bi bi-house-door"></i>
                <span>بازگشت به میز کار</span>
            </a>
            <a href="/Settings#license" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-teal-600 text-white font-bold text-sm hover:bg-teal-700 transition shadow-sm">
                <i class="bi bi-award"></i>
                <span>مدیریت و ارتقای لایسنس</span>
            </a>
        </div>
    </div>
</div>
