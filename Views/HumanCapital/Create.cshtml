@model HumanCapitalCreateVM
@{
    ViewData["Title"] = "استخدام جدید";
}

<div class="w-full flex-1 flex flex-col gap-4 p-3 md:p-5" dir="rtl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-2 bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white">استخدام جدید</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">ثبت مشخصات پایه، قرارداد و رخداد اولیه پرسنل</p>
        </div>
        <a href="/HumanCapital" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-xl text-sm font-semibold transition-all shadow-sm whitespace-nowrap">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            بازگشت
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 dark:bg-rose-950/10 text-rose-800 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 rounded-xl text-xs font-semibold leading-relaxed"></div>
    }

    <!-- JS-driven general error banner -->
    <div id="hcCreateErrorBanner" class="hidden p-3 bg-rose-50 dark:bg-rose-950/10 text-rose-800 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 rounded-xl text-xs font-semibold leading-relaxed"></div>

    <form asp-action="Create" method="post" id="humanCapitalCreateForm" class="flex flex-col gap-5" data-guard-ignore>

        <!-- ═══════════════════════════════════════════════════════════════
             Section 1: 👤 اطلاعات فردی و پایه
             ═══════════════════════════════════════════════════════════════ -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3.5 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-700">
                <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 text-base">👤</span>
                <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">اطلاعات فردی و پایه</h3>
            </div>
            <div class="p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Personnel Code -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="PersonnelCode" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <input asp-for="PersonnelCode" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="مثلاً 1001" />
                    <span asp-validation-for="PersonnelCode" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Full Name -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="FullName" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <input asp-for="FullName" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="نام و نام خانوادگی" />
                    <span asp-validation-for="FullName" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- National Code -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="NationalCode" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <input asp-for="NationalCode" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-left font-mono tabular-nums" placeholder="0012345678" maxlength="20" />
                    <span asp-validation-for="NationalCode" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Birth Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="BirthDate" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <div class="jalali-datepicker-wrapper relative">
                        <input asp-for="BirthDate" type="text" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 pl-9 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 jalali-date-input" data-jalali="BirthDate" placeholder="1375/01/01" readonly />
                        <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-slate-400 pointer-events-none cursor-pointer"><i class="bi bi-calendar3 text-xs"></i></span>
                    </div>
                    <span asp-validation-for="BirthDate" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════
             Section 2: 💼 اطلاعات شغلی و سازمانی
             ═══════════════════════════════════════════════════════════════ -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3.5 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-700">
                <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 text-base">💼</span>
                <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">اطلاعات شغلی و سازمانی</h3>
            </div>
            <div class="p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Department -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="DepartmentId" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <select asp-for="DepartmentId" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" asp-items="Model.DepartmentOptions">
                        <option value="">بدون دپارتمان</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Position Title -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="PositionTitle" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <input asp-for="PositionTitle" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="مثلاً کارشناس فناوری اطلاعات" />
                    <span asp-validation-for="PositionTitle" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Employment Type -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="EmploymentType" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <select asp-for="EmploymentType" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" asp-items="Model.EmploymentTypeOptions"></select>
                    <span asp-validation-for="EmploymentType" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Base Salary -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="CurrentSalary" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <input asp-for="CurrentSalary" type="number" min="0" step="1000" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-left font-mono tabular-nums font-semibold" placeholder="0" />
                    <span asp-validation-for="CurrentSalary" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════
             Section 3: 📅 اطلاعات قرارداد و ورود
             ═══════════════════════════════════════════════════════════════ -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3.5 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-700">
                <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 text-base">📅</span>
                <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">اطلاعات قرارداد و ورود</h3>
            </div>
            <div class="p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Hire Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="HireDate" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <div class="jalali-datepicker-wrapper relative">
                        <input asp-for="HireDate" type="text" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 pl-9 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 jalali-date-input" data-jalali="HireDate" placeholder="1405/01/01" readonly />
                        <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-slate-400 pointer-events-none cursor-pointer"><i class="bi bi-calendar3 text-xs"></i></span>
                    </div>
                    <span asp-validation-for="HireDate" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Contract End Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="ContractEndDate" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <div class="jalali-datepicker-wrapper relative">
                        <input asp-for="ContractEndDate" type="text" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 pl-9 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 jalali-date-input" data-jalali="ContractEndDate" placeholder="1406/01/01" readonly />
                        <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-slate-400 pointer-events-none cursor-pointer"><i class="bi bi-calendar3 text-xs"></i></span>
                    </div>
                    <span asp-validation-for="ContractEndDate" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Initial Status Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="InitialStatusDate" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <div class="jalali-datepicker-wrapper relative">
                        <input asp-for="InitialStatusDate" type="text" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 pl-9 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 jalali-date-input" data-jalali="InitialStatusDate" placeholder="1405/01/01" readonly />
                        <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-slate-400 pointer-events-none cursor-pointer"><i class="bi bi-calendar3 text-xs"></i></span>
                    </div>
                    <span asp-validation-for="InitialStatusDate" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Initial Reference Number -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="InitialReferenceNumber" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <input asp-for="InitialReferenceNumber" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="شماره حکم یا نامه" />
                    <span asp-validation-for="InitialReferenceNumber" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Onboarding Completed Toggle -->
                <div class="flex items-center gap-2.5 h-9 mt-4">
                    <input asp-for="OnboardingCompleted" type="checkbox" class="w-4 h-4 text-emerald-600 border-slate-300 dark:border-slate-700 rounded focus:ring-emerald-500 focus:ring-2 bg-transparent" />
                    <label asp-for="OnboardingCompleted" class="text-xs font-bold text-slate-600 dark:text-slate-400 cursor-pointer select-none"></label>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════
             Section 4: 📞 ارتباطات و آدرس
             ═══════════════════════════════════════════════════════════════ -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3.5 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-700">
                <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-violet-100 dark:bg-violet-900/40 text-violet-600 dark:text-violet-400 text-base">📞</span>
                <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">ارتباطات و آدرس</h3>
            </div>
            <div class="p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Phone Number -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="PhoneNumber" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <input asp-for="PhoneNumber" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-left font-mono" placeholder="09121234567" dir="ltr" />
                    <span asp-validation-for="PhoneNumber" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Email -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Email" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <input asp-for="Email" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-left font-mono" placeholder="name@example.com" dir="ltr" />
                    <span asp-validation-for="Email" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Address -->
                <div class="flex flex-col gap-1.5 md:col-span-2 lg:col-span-3">
                    <label asp-for="Address" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <input asp-for="Address" class="h-9 w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="آدرس محل سکونت" />
                    <span asp-validation-for="Address" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Notes / Event Description -->
                <div class="flex flex-col gap-1.5 md:col-span-2 lg:col-span-3">
                    <label asp-for="Notes" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <textarea asp-for="Notes" class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 p-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 resize-none" rows="2" placeholder="توضیحات تکمیلی پرونده..."></textarea>
                    <span asp-validation-for="Notes" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>

                <!-- Initial Status Description -->
                <div class="flex flex-col gap-1.5 md:col-span-2 lg:col-span-3">
                    <label asp-for="InitialStatusDescription" class="text-xs font-bold text-slate-600 dark:text-slate-400"></label>
                    <textarea asp-for="InitialStatusDescription" class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 p-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 resize-none" rows="2" placeholder="توضیح رخداد استخدام..."></textarea>
                    <span asp-validation-for="InitialStatusDescription" class="text-xs text-rose-500 mt-0.5 block"></span>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════
             Action Bar
             ═══════════════════════════════════════════════════════════════ -->
        <div class="sticky bottom-0 z-20 flex items-center justify-end gap-3 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm border border-slate-200 dark:border-slate-800 rounded-xl px-5 py-3.5 shadow-lg">
            <a href="@Url.Action("Index", "HumanCapital")" class="flex items-center justify-center px-4 h-9 border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition no-underline">
                <i class="bi bi-x-lg ml-1.5 text-[10px]"></i>
                <span>انصراف</span>
            </a>
            <button type="submit" id="hcCreateSubmitBtn" class="flex items-center gap-2 px-5 h-9 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-lg text-xs font-bold transition shadow-md shadow-emerald-600/20">
                <i id="hcCreateSpinner" class="bi bi-arrow-repeat hidden animate-spin"></i>
                <i class="bi bi-check-circle text-sm"></i>
                <span id="hcCreateBtnLabel">ثبت پرونده پرسنلی</span>
            </button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")

@section Scripts {
    <link rel="stylesheet" href="~/css/persian-datepicker.min.css" />
    <script src="~/js/persian-date.min.js"></script>
    <script src="~/js/persian-datepicker.min.js"></script>
    <script>
        (() => {
            'use strict';

            // ════════════════════════════════════════════════════════════
            // Defensive Jalali Date Picker Initialization
            // Uses jQuery plugin API (persian-datepicker is a jQuery plugin).
            // Wrapped in try-catch so form handlers NEVER crash.
            // ════════════════════════════════════════════════════════════
            const initJalaliPickers = () => {
                const pickers = document.querySelectorAll('.jalali-date-input');
                if (!pickers.length) return;

                // Check if jQuery and the persianDatepicker plugin are available
                if (typeof jQuery === 'undefined' || typeof jQuery.fn.persianDatepicker === 'undefined') {
                    console.warn('[HC] persianDatepicker jQuery plugin not available — date inputs will accept manual text entry.');
                    return;
                }

                pickers.forEach((input) => {
                    try {
                        // Convert any existing ISO value (yyyy-MM-dd) to Jalali for display
                        const existing = input.value;
                        if (existing && typeof persianDate !== 'undefined') {
                            try {
                                const d = new Date(existing);
                                if (!isNaN(d.getTime())) {
                                    input.value = new persianDate(d).format('YYYY/MM/DD');
                                }
                            } catch (convErr) { /* leave as-is */ }
                        }

                        // Initialize via jQuery plugin API (NOT `new persianDatepicker(...)`)
                        const $input = jQuery(input);
                        $input.persianDatepicker({
                            format: 'YYYY/MM/DD',
                            autoClose: true,
                            observer: true,
                            initialValue: false
                        });

                        // Store instance reference for later access
                        input.persianDatepickerInstance = $input.data('datepicker');

                        // Attach click handler to the calendar icon
                        const wrapper = input.closest('.jalali-datepicker-wrapper');
                        if (wrapper) {
                            const icon = wrapper.querySelector('span.absolute');
                            if (icon) {
                                icon.addEventListener('click', (e) => {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    const inst = $input.data('datepicker');
                                    if (inst && typeof inst.show === 'function') inst.show();
                                });
                            }
                        }
                    } catch (err) {
                        console.warn('[HC] Failed to initialize datepicker for', input.name, err);
                    }
                });
            };

            // ════════════════════════════════════════════════════════════
            // Convert displayed Jalali dates to Gregorian ISO before submit
            // ════════════════════════════════════════════════════════════
            const convertJalaliDates = () => {
                const form = document.getElementById('humanCapitalCreateForm');
                if (!form) return;

                form.querySelectorAll('.jalali-date-input').forEach((input) => {
                    const jalaliText = (input.value || '').trim();
                    if (!jalaliText) return;

                    // Already ISO/gregorian?
                    if (/^\d{4}-\d{2}-\d{2}$/.test(jalaliText)) return;

                    const parts = jalaliText.split('/');
                    if (parts.length !== 3) return;

                    const jYear = parseInt(parts[0], 10);
                    const jMonth = parseInt(parts[1], 10);
                    const jDay = parseInt(parts[2], 10);
                    if (isNaN(jYear) || isNaN(jMonth) || isNaN(jDay)) return;

                    // Use persianDate library if available, otherwise use server-side PersianCalendar
                    if (typeof persianDate !== 'undefined') {
                        try {
                            const gregDate = new persianDate([jYear, jMonth, jDay]).toDate();
                            const iso = gregDate.getFullYear() + '-' +
                                String(gregDate.getMonth() + 1).padStart(2, '0') + '-' +
                                String(gregDate.getDate()).padStart(2, '0');
                            input.value = iso;
                            return;
                        } catch (err) {
                            console.warn('[HC] Jalali conversion via persianDate failed for', input.name, err);
                        }
                    }

                    // Fallback: manual Jalali-to-Gregorian conversion (algorithmic)
                    try {
                        const gDate = jalaliToGregorian(jYear, jMonth, jDay);
                        const iso = gDate[0] + '-' + String(gDate[1]).padStart(2, '0') + '-' + String(gDate[2]).padStart(2, '0');
                        input.value = iso;
                    } catch (fallbackErr) {
                        console.warn('[HC] Fallback Jalali conversion failed for', input.name, fallbackErr);
                    }
                });
            };

            // ════════════════════════════════════════════════════════════
            // Fallback Jalali → Gregorian converter (pure JS, no library)
            // Based on the algorithmic Persian calendar conversion.
            // ════════════════════════════════════════════════════════════
            function jalaliToGregorian(jy, jm, jd) {
                jy = parseInt(jy, 10); jm = parseInt(jm, 10); jd = parseInt(jd, 10);
                var gy = (jy <= 979) ? 621 : 1600;
                jy -= (jy <= 979) ? 0 : 979;
                var days = (365 * jy) + (parseInt(jy / 33) * 8) + parseInt(((jy % 33) + 3) / 4)
                    + 78 + jd + ((jm < 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186);
                gy += 400 * parseInt(days / 146097);
                days %= 146097;
                if (days > 36524) {
                    gy += 100 * parseInt(--days / 36524);
                    days %= 36524;
                    if (days >= 365) days++;
                }
                gy += 4 * parseInt(days / 1461);
                days %= 1461;
                if (days > 365) {
                    gy += parseInt((days - 1) / 365);
                    days = (days - 1) % 365;
                }
                var gd = days + 1;
                var sal_a = [0, 31, ((gy % 4 === 0 && gy % 100 !== 0) || (gy % 400 === 0)) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
                var gm = 0;
                for (gm = 0; gm < 13 && gd > sal_a[gm]; gm++) gd -= sal_a[gm];
                return [gy, gm, gd];
            }

            // ════════════════════════════════════════════════════════════
            // Form reference & elements
            // ════════════════════════════════════════════════════════════
            const form = document.getElementById('humanCapitalCreateForm');
            if (!form) return;

            const submitBtn = document.getElementById('hcCreateSubmitBtn');
            const spinner = document.getElementById('hcCreateSpinner');
            const btnLabel = document.getElementById('hcCreateBtnLabel');
            const errorBanner = document.getElementById('hcCreateErrorBanner');
            const originalLabel = btnLabel ? btnLabel.textContent : '';
            const originalClasses = submitBtn ? submitBtn.className : '';

            // ── Self-contained toast helper ──
            const colors = { success: '#18af08', error: '#ef404d', warning: '#f59e0b', info: '#118AB2' };
            const icons = { success: 'bi-check-circle', error: 'bi-x-circle', warning: 'bi-exclamation-triangle', info: 'bi-info-circle' };
            const toast = (message, type = 'info') => {
                const el = document.createElement('div');
                el.style.cssText = 'position:fixed;bottom:20px;right:20px;z-index:99999;display:flex;align-items:center;gap:8px;direction:rtl;background:' + (colors[type] || colors.info) + ';color:#fff;padding:10px 16px;border-radius:10px;font-size:13px;font-weight:700;box-shadow:0 8px 24px rgba(0,0,0,0.2);opacity:0;transform:translateY(16px);transition:all 0.3s ease;';
                el.innerHTML = '<i class="bi ' + (icons[type] || icons.info) + '"></i><span>' + message + '</span>';
                document.body.appendChild(el);
                requestAnimationFrame(() => { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; });
                setTimeout(() => {
                    el.style.opacity = '0'; el.style.transform = 'translateY(16px)';
                    setTimeout(() => el.remove(), 300);
                }, 5000);
            };

            // ── Anti-forgery token resolution ──
            const getToken = () => {
                const input = document.querySelector('input[name="__RequestVerificationToken"]');
                if (input && input.value) return input.value;
                const meta = document.querySelector('meta[name="request-verification-token"]');
                return meta ? meta.getAttribute('content') : '';
            };

            // ── Loading state (prevent double submit) ──
            const setLoading = (loading) => {
                if (!submitBtn) return;
                if (loading) {
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-60', 'cursor-not-allowed');
                    if (spinner) spinner.classList.remove('hidden');
                    if (btnLabel) btnLabel.textContent = 'در حال ثبت...';
                } else {
                    submitBtn.disabled = false;
                    submitBtn.className = originalClasses;
                    if (spinner) spinner.classList.add('hidden');
                    if (btnLabel) btnLabel.textContent = originalLabel;
                }
            };

            const showBanner = (message) => {
                if (!errorBanner) { toast(message, 'error'); return; }
                errorBanner.textContent = message;
                errorBanner.classList.remove('hidden');
                errorBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
            };

            const hideBanner = () => {
                if (!errorBanner) return;
                errorBanner.classList.add('hidden');
                errorBanner.textContent = '';
            };

            const clearFieldError = (fieldName) => {
                const span = document.querySelector('[data-valmsg-for="' + CSS.escape(fieldName) + '"]');
                if (span) { span.textContent = ''; span.classList.remove('text-rose-500'); }
            };

            const applyFieldError = (fieldName, message) => {
                const span = document.querySelector('[data-valmsg-for="' + CSS.escape(fieldName) + '"]');
                if (span) {
                    span.textContent = message;
                    span.classList.add('text-rose-500');
                }
            };

            const resetFields = () => form.querySelectorAll('[data-valmsg-for]').forEach(s => { s.textContent = ''; });

            // ── Success navigation (works inside tab iframe & full page) ──
            const navigateTo = (url) => {
                if (!url) { toast('پرونده با موفقیت ثبت شد.', 'success'); return; }
                try {
                    const fromIframe = window.self !== window.top;
                    const parentTabs = fromIframe ? window.parent : window;
                    if (parentTabs && parentTabs.RhynoTabs && typeof parentTabs.RhynoTabs.open === 'function') {
                        parentTabs.RhynoTabs.open(url, 'پرونده پرسنلی', 'bi-person-badge');
                        return;
                    }
                } catch (e) { /* cross-origin — fall through */ }
                const sep = url.indexOf('?') >= 0 ? '&' : '?';
                window.location.href = url + sep + '_tab=1';
            };

            // ════════════════════════════════════════════════════════════
            // Initialize date pickers (defensive — will NOT throw)
            // ════════════════════════════════════════════════════════════
            try {
                initJalaliPickers();
            } catch (initErr) {
                console.error('[HC] Datepicker initialization error (non-fatal):', initErr);
            }

            // ════════════════════════════════════════════════════════════
            // Form submission handler — ALWAYS attaches regardless of
            // datepicker status. The form will always be submittable.
            // ════════════════════════════════════════════════════════════
            form.addEventListener('submit', (e) => {
                e.preventDefault();

                hideBanner();
                resetFields();

                // Native HTML5 validation
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                const token = getToken();
                if (!token) {
                    showBanner('توکن امنیتی (Anti-Forgery) یافت نشد. صفحه را مجدداً بارگذاری کنید.');
                    return;
                }

                // Convert Jalali dates to Gregorian ISO before building FormData
                try {
                    convertJalaliDates();
                } catch (convErr) {
                    console.warn('[HC] Date conversion error (non-fatal):', convErr);
                }

                setLoading(true);

                fetch(form.action, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json, text/javascript',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    },
                    body: new FormData(form)
                })
                    .then(async (response) => {
                        if (response.ok) {
                            const data = await response.json().catch(() => ({}));
                            toast('پرونده پرسنلی با موفقیت ثبت شد.', 'success');
                            setTimeout(() => navigateTo(data.redirectUrl), 600);
                            return;
                        }

                        // 400 / validation failure — try to parse JSON errors
                        let payload = null;
                        try { payload = await response.json(); } catch (e) { payload = null; }

                        if (payload && payload.errors && typeof payload.errors === 'object') {
                            const entries = Object.entries(payload.errors);
                            const messages = [];
                            let hasInline = false;
                            entries.forEach(([field, msgs]) => {
                                const list = Array.isArray(msgs) ? msgs : [msgs];
                                list.forEach(m => {
                                    if (field && field !== '') {
                                        applyFieldError(field, m);
                                        hasInline = true;
                                    } else {
                                        messages.push(m);
                                    }
                                });
                            });
                            if (messages.length) {
                                showBanner(messages.join(' | '));
                            } else if (hasInline) {
                                toast('مشکلی در اطلاعات وارد شده وجود دارد. لطفاً خطاهای قرمز را بررسی کنید.', 'warning');
                            }
                            const firstField = entries.find(([field]) => field && field !== '');
                            if (firstField) {
                                const input = form.querySelector('[name="' + CSS.escape(firstField[0]) + '"]');
                                if (input) input.focus();
                            }
                            return;
                        }

                        if (payload && typeof payload === 'object' && payload.message) {
                            let serverMessage = String(payload.message);
                            if (payload.detail != null && String(payload.detail).trim() !== '') {
                                serverMessage = serverMessage + ' — ' + String(payload.detail);
                            }
                            showBanner(serverMessage);
                            return;
                        }

                        showBanner('خطا در ذخیره‌سازی. لطفاً دوباره تلاش کنید یا صفحه را بازنشانی کنید.');
                    })
                    .catch((err) => {
                        console.error('[HC] Create submit error:', err);
                        showBanner('ارتباط با سرور برقرار نشد. لطفاً اتصال اینترنت خود را بررسی و دوباره تلاش کنید.');
                    })
                    .finally(() => {
                        setLoading(false);
                    });
            });
        })();
    </script>
}