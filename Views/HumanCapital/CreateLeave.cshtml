@model HrLeaveCreateVM
@{
    ViewData["Title"] = "ثبت مرخصی جدید";
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4 bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div>
            <h1 class="text-lg font-bold text-slate-900 dark:text-white">ثبت مرخصی جدید</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">ثبت درخواست مرخصی یا مأموریت برای پرسنل</p>
        </div>
        <a href="@Url.Action("Leaves", "HumanCapital")" class="inline-flex items-center gap-1.5 px-3 h-8 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition no-underline">
            <i class="bi bi-arrow-right"></i> بازگشت
        </a>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm p-5">
        <form method="post" asp-action="CreateLeave">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="EmployeeId" class="text-xs font-bold text-slate-700 dark:text-slate-300">کارمند <span class="text-rose-500">*</span></label>
                    <select asp-for="EmployeeId" asp-items="Model.EmployeeOptions" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200">
                        <option value="">— انتخاب کارمند —</option>
                    </select>
                    <span asp-validation-for="EmployeeId" class="text-[10px] text-rose-500"></span>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="LeaveType" class="text-xs font-bold text-slate-700 dark:text-slate-300">نوع مرخصی <span class="text-rose-500">*</span></label>
                    <select asp-for="LeaveType" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200">
                        @foreach (var t in Model.LeaveTypeOptions) { <option value="@t">@t</option> }
                    </select>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="StartDate" class="text-xs font-bold text-slate-700 dark:text-slate-300">تاریخ شروع <span class="text-rose-500">*</span></label>
                    <input asp-for="StartDate" type="text" placeholder="1405/01/01" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200" />
                    <span asp-validation-for="StartDate" class="text-[10px] text-rose-500"></span>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="EndDate" class="text-xs font-bold text-slate-700 dark:text-slate-300">تاریخ پایان <span class="text-rose-500">*</span></label>
                    <input asp-for="EndDate" type="text" placeholder="1405/01/05" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200" />
                    <span asp-validation-for="EndDate" class="text-[10px] text-rose-500"></span>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Status" class="text-xs font-bold text-slate-700 dark:text-slate-300">وضعیت</label>
                    <select asp-for="Status" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200">
                        @foreach (var s in Model.StatusOptions) { <option value="@s">@s</option> }
                    </select>
                </div>
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label asp-for="Description" class="text-xs font-bold text-slate-700 dark:text-slate-300">توضیحات</label>
                    <textarea asp-for="Description" rows="3" class="rounded-lg border border-black/15 bg-white px-2.5 py-2 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200 resize-none"></textarea>
                </div>
            </div>
            <div class="flex items-center justify-end gap-2 mt-5 pt-4 border-t border-black/5">
                <a href="@Url.Action("Leaves", "HumanCapital")" class="inline-flex items-center gap-1.5 px-4 h-9 border border-black/20 bg-gradient-to-b from-white to-slate-100 text-slate-700 rounded-lg text-xs font-bold transition no-underline">انصراف</a>
                <button type="submit" class="inline-flex items-center gap-1.5 px-5 h-9 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition shadow-sm"><i class="bi bi-check-lg"></i> ذخیره مرخصی</button>
            </div>
        </form>
    </div>
</div>