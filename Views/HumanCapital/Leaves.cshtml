@model HrLeaveIndexVM
@using OfficeAutomation.Modules.InvoiceStructuring
@{
    ViewData["Title"] = "مدیریت مرخصی و مأموریت";
    string Jalali(DateTime date) => JalaliDateHelper.ToShamsiStringPersianDigits(date);
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4 bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div>
            <h1 class="text-lg font-bold text-slate-900 dark:text-white">مدیریت مرخصی و مأموریت</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">ثبت و پیگیری مرخصی‌ها و مأموریت‌های پرسنل</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/HumanCapital" onclick="event.preventDefault(); if (window.parent && window.parent.RhynoTabs) { window.parent.RhynoTabs.open('/HumanCapital', 'مدیریت سرمایه انسانی', 'bi-person-badge'); } else { window.location.href = '/HumanCapital'; }" class="inline-flex items-center gap-1.5 px-3 h-8 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition no-underline">
                <i class="bi bi-arrow-right"></i> بازگشت
            </a>
            <a href="@Url.Action("CreateLeave", "HumanCapital")" class="inline-flex items-center gap-1.5 px-4 h-8 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition shadow-sm no-underline">
                <i class="bi bi-plus-lg"></i> مرخصی جدید
            </a>
        </div>
    </div>

    <section class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white shadow-sm p-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 border border-indigo-100"><i class="bi bi-calendar3 text-lg"></i></div>
            <div><p class="m-0 text-[11px] font-bold text-slate-500">کل مرخصی‌ها</p><p class="m-0 text-lg font-black text-slate-800 tabular-nums">@Model.TotalCount</p></div>
        </div>
        <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white shadow-sm p-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-600 border border-amber-100"><i class="bi bi-hourglass-split text-lg"></i></div>
            <div><p class="m-0 text-[11px] font-bold text-slate-500">در انتظار تایید</p><p class="m-0 text-lg font-black text-amber-600 tabular-nums">@Model.PendingCount</p></div>
        </div>
        <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white shadow-sm p-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 border border-emerald-100"><i class="bi bi-check-circle text-lg"></i></div>
            <div><p class="m-0 text-[11px] font-bold text-slate-500">تایید شده</p><p class="m-0 text-lg font-black text-emerald-600 tabular-nums">@Model.ApprovedCount</p></div>
        </div>
    </section>

    <section class="rounded-lg border border-black/10 bg-white shadow-sm">
        <div class="flex items-center justify-between gap-2 border-b border-black/5 px-3 py-2.5">
            <h2 class="m-0 text-sm font-black text-slate-800">لیست مرخصی‌ها</h2>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-500">@Model.TotalCount رکورد</span>
        </div>
        <div class="overflow-x-auto w-full">
            <table class="w-full min-w-[800px] text-xs text-right border-collapse text-slate-700">
                <thead class="sticky top-0 z-10 bg-slate-50 border-b border-black/10">
                    <tr>
                        <th class="px-3 py-2.5 font-bold text-slate-600">کارمند</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">نوع مرخصی</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">از تاریخ</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">تا تاریخ</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">توضیحات</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">وضعیت</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-black/5">
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            var statusClass = item.Status == "تایید شده" ? "bg-emerald-50 text-emerald-700 border-emerald-200"
                                : item.Status == "رد شده" ? "bg-rose-50 text-rose-700 border-rose-200"
                                : "bg-amber-50 text-amber-700 border-amber-200";
                            var dotClass = item.Status == "تایید شده" ? "bg-emerald-500" : item.Status == "رد شده" ? "bg-rose-500" : "bg-amber-500";
                            <tr class="transition-colors hover:bg-slate-50">
                                <td class="px-3 py-2.5">
                                    <div class="font-bold text-slate-900">@item.EmployeeName</div>
                                    <div class="text-[10px] text-slate-500 font-mono">@item.PersonnelCode</div>
                                </td>
                                <td class="px-3 py-2.5"><span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-semibold text-slate-700">@item.LeaveType</span></td>
                                <td class="px-3 py-2.5 tabular-nums">@Jalali(item.StartDate)</td>
                                <td class="px-3 py-2.5 tabular-nums">@Jalali(item.EndDate)</td>
                                <td class="px-3 py-2.5 text-slate-500 max-w-[200px] truncate">@(item.Description ?? "—")</td>
                                <td class="px-3 py-2.5">
                                    <span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] font-bold @statusClass">
                                        <span class="h-1.5 w-1.5 rounded-full @dotClass"></span>@item.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="px-3 py-10 text-center"><div class="flex flex-col items-center gap-2 text-slate-400"><i class="bi bi-inbox text-3xl"></i><span class="text-xs font-semibold">مرخصی ثبت نشده است.</span><a href="@Url.Action("CreateLeave", "HumanCapital")" class="mt-2 inline-flex items-center gap-1.5 px-4 h-8 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition no-underline"><i class="bi bi-plus-lg"></i> ثبت مرخصی</a></div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>