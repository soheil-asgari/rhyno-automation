@model HumanCapitalIndexVM
@{
    ViewData["Title"] = "مدیریت سرمایه انسانی";
    ViewData["SectionTitle"] = "مدیریت سرمایه انسانی";
    ViewData["SectionSubtitle"] = "ثبت، جستجو، وضعیت‌های شغلی و تاریخچه حقوق در یک نمای عملیاتی";
    ViewData["SectionActionUrl"] = Url.Action("Create", "HumanCapital");
    ViewData["SectionActionText"] = "استخدام جدید";
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <!-- Header Partial View -->
    <partial name="_SectionHeader" />

    <!-- Numerical Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Stat 1 -->
        <a asp-action="Index" asp-route-workflowView="all" asp-route-searchTerm="@Model.SearchTerm" asp-route-status="@Model.Status" asp-route-departmentId="@Model.DepartmentId" class="no-underline flex flex-col items-start gap-1 p-2.5 bg-white dark:bg-slate-900 border @(string.IsNullOrWhiteSpace(Model.WorkflowView) || Model.WorkflowView == "all" ? "border-teal-600 dark:border-teal-500 ring-2 ring-teal-500/10" : "border-slate-200 dark:border-slate-800") rounded-lg shadow-sm transition hover:-translate-y-0.5 active:scale-98">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">کل پرسنل</span>
            <span class="text-lg font-black text-slate-800 dark:text-white mt-1">@Model.TotalCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">کل کارمندان ثبت شده</span>
        </a>
        <!-- Stat 2 -->
        <a asp-action="Index" asp-route-workflowView="active" asp-route-searchTerm="@Model.SearchTerm" asp-route-status="@Model.Status" asp-route-departmentId="@Model.DepartmentId" class="no-underline flex flex-col items-start gap-1 p-2.5 bg-white dark:bg-slate-900 border @(Model.WorkflowView == "active" ? "border-teal-600 dark:border-teal-500 ring-2 ring-teal-500/10" : "border-slate-200 dark:border-slate-800") rounded-lg shadow-sm transition hover:-translate-y-0.5 active:scale-98">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">پرسنل فعال</span>
            <span class="text-lg font-black text-emerald-600 mt-1">@Model.ActiveCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">مشغول به کار در سازمان</span>
        </a>
        <!-- Stat 3 -->
        <a asp-action="Index" asp-route-workflowView="separated" asp-route-searchTerm="@Model.SearchTerm" asp-route-status="@Model.Status" asp-route-departmentId="@Model.DepartmentId" class="no-underline flex flex-col items-start gap-1 p-2.5 bg-white dark:bg-slate-900 border @(Model.WorkflowView == "separated" ? "border-teal-600 dark:border-teal-500 ring-2 ring-teal-500/10" : "border-slate-200 dark:border-slate-800") rounded-lg shadow-sm transition hover:-translate-y-0.5 active:scale-98">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">خارج‌شده</span>
            <span class="text-lg font-black text-rose-600 mt-1">@Model.SeparatedCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">قطع همکاری یا تعلیق</span>
        </a>
        <!-- Stat 4 -->
        <div class="flex flex-col items-start gap-1 p-2.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">نتیجه فیلتر</span>
            <span class="text-lg font-black text-teal-600 dark:text-teal-400 mt-1">@Model.FilteredCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">رکورد فیلتر شده جاری</span>
        </div>
    </div>

    <!-- Content 2-Column Grid (Main Area & Sidebar) -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-3">
        <!-- Main: Filter panel & Table list (Col span 3) -->
        <div class="lg:col-span-3 flex flex-col gap-3">
            <!-- Filter panel -->
            <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm flex flex-col gap-3">
                <div>
                    <h2 class="m-0 text-sm font-black text-slate-900 dark:text-white">فیلتر و جستجو</h2>
                    <p class="m-0 text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">لیست پرسنل را بر اساس نام، وضعیت و دپارتمان محدود کنید.</p>
                </div>
                
                <partial name="_SavedFiltersPanel" />
                
                <form method="get" asp-action="Index" class="flex flex-col gap-3 sm:flex-row sm:items-end" id="hc-filter-form">
                    <input type="hidden" asp-for="WorkflowView" />
                    
                    <div class="flex-1 min-w-[200px] flex flex-col gap-1">
                        <label asp-for="SearchTerm" class="text-xs font-bold text-slate-500 dark:text-slate-400">جستجو</label>
                        <input asp-for="SearchTerm" class="h-8 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" placeholder="نام، کد پرسنلی، کد ملی یا عنوان شغلی..." />
                    </div>
                    
                    <div class="w-48 flex flex-col gap-1">
                        <label asp-for="Status" class="text-xs font-bold text-slate-500 dark:text-slate-400">وضعیت</label>
                        <select asp-for="Status" class="h-8 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800">
                            <option value="">همه وضعیت‌ها</option>
                            @foreach (var status in Model.StatusOptions)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    
                    <div class="w-48 flex flex-col gap-1">
                        <label asp-for="DepartmentId" class="text-xs font-bold text-slate-500 dark:text-slate-400">دپارتمان</label>
                        <select asp-for="DepartmentId" class="h-8 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" asp-items="Model.DepartmentOptions">
                            <option value="">همه دپارتمان‌ها</option>
                        </select>
                    </div>
                    
                    <div class="sm:w-32">
                        <button type="submit" class="h-8 w-full flex items-center justify-center gap-1.5 px-2.5 rounded-lg bg-teal-600 hover:bg-teal-700 dark:bg-teal-50 dark:hover:bg-teal-600 text-white text-xs font-bold transition shadow-sm">
                            <i class="bi bi-filter"></i>
                            <span>اعمال فیلتر</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- List Table Card -->
            <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm flex flex-col gap-3">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                    <div>
                        <h2 class="m-0 text-sm font-black text-slate-900 dark:text-white">لیست کارمندان</h2>
                        <p class="m-0 text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">نمای عملیاتی پرسنل با دسترسی سریع به جزئیات و ویرایش.</p>
                    </div>
                    <div class="text-[11px] font-bold text-teal-600 dark:text-teal-400">@Model.FilteredCount رکورد نمایش داده می‌شود</div>
                </div>

                <div class="border border-slate-200 dark:border-slate-800 rounded-lg overflow-hidden">
                    <div class="overflow-x-auto w-full">
                        <table class="w-full text-xs text-right border-collapse text-slate-700 dark:text-slate-300">
                            <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
                                <tr>
                                    <th class="px-3 py-2.5 font-bold">پرسنل</th>
                                    <th class="px-3 py-2.5 font-bold">سمت / دپارتمان</th>
                                    <th class="px-3 py-2.5 font-bold text-center">استخدام</th>
                                    <th class="px-3 py-2.5 font-bold text-left">حقوق فعلی</th>
                                    <th class="px-3 py-2.5 font-bold text-center">وضعیت</th>
                                    <th class="px-3 py-2.5 font-bold">سوابق</th>
                                    <th class="px-3 py-2.5 font-bold text-center w-1">عملیات</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                                @if (Model.Items.Any())
                                {
                                    foreach (var employee in Model.Items)
                                    {
                                        var statusBadgeClass = employee.CurrentStatus == "فعال" || employee.CurrentStatus == "مشغول به کار"
                                            ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200/40"
                                            : (employee.CurrentStatus == "قطع همکاری" || employee.CurrentStatus == "غیرفعال"
                                            ? "bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400 border-rose-200/40"
                                            : "bg-slate-100 text-slate-700 dark:bg-slate-800/40 dark:text-slate-400 border-slate-200/40");
                                            
                                        var nameInitials = string.IsNullOrWhiteSpace(employee.FullName) ? "?" : employee.FullName.Substring(0, 1);

                                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                                            <!-- Personnel Name and Avatar -->
                                            <td class="px-3 py-3">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-8 h-8 rounded-full bg-teal-50 dark:bg-teal-950/40 border border-teal-200/40 dark:border-teal-800/30 text-teal-700 dark:text-teal-400 flex items-center justify-center font-black text-xs">
                                                        @nameInitials
                                                    </div>
                                                    <div>
                                                        <div class="font-bold text-slate-900 dark:text-white">@employee.FullName</div>
                                                        <div class="text-[10px] text-slate-500 font-mono">کد پرسنلی: @employee.PersonnelCode</div>
                                                    </div>
                                                </div>
                                            </td>
                                            
                                            <!-- Title & Department -->
                                            <td class="px-3 py-3">
                                                <div class="font-medium text-slate-800 dark:text-slate-200">@employee.PositionTitle</div>
                                                <div class="text-[10px] text-slate-500">@(employee.DepartmentName ?? "-")</div>
                                            </td>
                                            
                                            <!-- Hire Date -->
                                            <td class="px-3 py-3 text-center font-mono text-slate-500">@employee.HireDate.ToString("yyyy/MM/dd")</td>
                                            
                                            <!-- Salary -->
                                            <td class="px-3 py-3 text-left font-mono tabular-nums font-bold text-slate-900 dark:text-white">@employee.CurrentSalary.ToString("N0")</td>
                                            
                                            <!-- Status badge -->
                                            <td class="px-3 py-3 text-center">
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border @statusBadgeClass">
                                                    @employee.CurrentStatus
                                                </span>
                                            </td>
                                            
                                            <!-- Records history -->
                                            <td class="px-3 py-3 text-[10px] text-slate-500 leading-normal">
                                                <div>افزایش حقوق: <span class="font-mono">@employee.SalaryChangeCount</span></div>
                                                <div>آخرین رخداد: <span class="font-mono">@(employee.LatestStatusDate?.ToString("yyyy/MM/dd") ?? "-")</span></div>
                                            </td>
                                            
                                            <!-- Minimal Actions -->
                                            <td class="px-3 py-3 text-center w-1">
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <a asp-action="Details" asp-route-id="@employee.Id" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition hc-track-visit" data-id="@employee.Id" data-name="@employee.FullName" data-url="@Url.Action("Details", "HumanCapital", new { id = employee.Id })" title="پروفایل/جزئیات">
                                                        <i class="bi bi-person-bounding-box text-sm"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@employee.Id" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition" title="ویرایش">
                                                        <i class="bi bi-pencil-square text-sm"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="px-3 py-4 text-center text-slate-400 dark:text-slate-500">موردی برای نمایش وجود ندارد.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar: Recent Views (Col span 1) -->
        <div class="flex flex-col gap-3">
            <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm flex flex-col gap-3">
                <div>
                    <h2 class="m-0 text-sm font-black text-slate-900 dark:text-white">آخرین بازدیدها</h2>
                    <p class="m-0 text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">افرادی که اخیراً باز کرده‌اید اینجا ذخیره می‌شوند.</p>
                </div>
                <div id="hc-recent-items" class="flex flex-col gap-3"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        const storageKey = "rhyno.humanCapital.filters";
        const recentKey = "rhyno.humanCapital.recent";
        const preferenceEndpoint = "/table-preferences/human-capital.filters";
        const form = document.getElementById("hc-filter-form");
        const savedContainer = document.getElementById("hc-saved-filters");
        const recentContainer = document.getElementById("hc-recent-items");
        const saveButton = document.getElementById("hc-save-filter");
        const clearButton = document.getElementById("hc-clear-filters");

        const readJson = (key, fallback) => {
            try {
                return JSON.parse(localStorage.getItem(key) || "null") || fallback;
            } catch {
                return fallback;
            }
        };

        const writeJson = (key, value) => localStorage.setItem(key, JSON.stringify(value));

        const loadSavedFilters = async () => {
            try {
                const response = await fetch(preferenceEndpoint, { credentials: "same-origin" });
                if (!response.ok) {
                    return readJson(storageKey, []);
                }

                const items = await response.json();
                const normalized = Array.isArray(items) ? items : [];
                if (normalized.length) {
                    writeJson(storageKey, normalized);
                }

                return normalized.length ? normalized : readJson(storageKey, []);
            } catch {
                return readJson(storageKey, []);
            }
        };

        const saveFilters = async (items) => {
            writeJson(storageKey, items);
            try {
                await fetch(preferenceEndpoint, {
                    method: "POST",
                    credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(items)
                });
            } catch {
            }
        };

        const currentFilter = () => ({
            searchTerm: form.querySelector('[name="SearchTerm"]')?.value?.trim() || "",
            status: form.querySelector('[name="Status"]')?.value || "",
            departmentId: form.querySelector('[name="DepartmentId"]')?.value || "",
            workflowView: form.querySelector('[name="WorkflowView"]')?.value || "all"
        });

        const filterLabel = (item) => {
            const parts = [];
            if (item.searchTerm) parts.push(`جستجو: ${item.searchTerm}`);
            if (item.status) parts.push(`وضعیت: ${item.status}`);
            if (item.departmentId) parts.push(`دپارتمان: ${item.departmentId}`);
            if (item.workflowView && item.workflowView !== "all") parts.push(`نما: ${item.workflowView}`);
            return parts.length ? parts.join(" | ") : "فیلتر بدون شرط";
        };

        const renderSaved = () => {
            const items = readJson(storageKey, []);
            savedContainer.innerHTML = "";
            if (!items.length) {
                savedContainer.innerHTML = '<span class="text-slate-400 dark:text-slate-500 text-xs">هنوز فیلتری ذخیره نشده است.</span>';
                return;
            }

            items.slice(0, 6).forEach((item, index) => {
                const chip = document.createElement("button");
                chip.type = "button";
                chip.className = "px-3 py-1 rounded-full text-xs font-bold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 dark:border-slate-800 dark:bg-slate-950 dark:hover:bg-slate-900 dark:text-slate-300 transition shadow-sm cursor-pointer";
                chip.textContent = item.name;
                chip.title = filterLabel(item);
                chip.addEventListener("click", () => {
                    form.querySelector('[name="SearchTerm"]').value = item.searchTerm || "";
                    form.querySelector('[name="Status"]').value = item.status || "";
                    form.querySelector('[name="DepartmentId"]').value = item.departmentId || "";
                    form.querySelector('[name="WorkflowView"]').value = item.workflowView || "all";
                    form.submit();
                });
                chip.dataset.index = index;
                savedContainer.appendChild(chip);
            });
        };

        const renderRecent = () => {
            const items = readJson(recentKey, []);
            recentContainer.innerHTML = "";
            if (!items.length) {
                recentContainer.innerHTML = '<div class="text-slate-450 dark:text-slate-500 text-xs">هنوز موردی باز نشده است.</div>';
                return;
            }

            items.slice(0, 6).forEach(item => {
                const row = document.createElement("div");
                row.className = "flex items-center justify-between p-3 border border-slate-100 dark:border-slate-800/80 rounded-xl bg-slate-50 dark:bg-slate-950/40 text-xs";
                row.innerHTML = `
                    <div>
                        <div class="font-bold text-slate-800 dark:text-slate-200">${item.name}</div>
                        <div class="text-[10px] text-slate-500 font-mono mt-0.5">${item.when}</div>
                    </div>
                    <a class="flex items-center justify-center px-2.5 py-1 border border-slate-200 bg-white hover:bg-slate-50 text-slate-750 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 rounded-md text-[11px] font-semibold transition shadow-sm no-underline" href="${item.url}">باز کردن</a>
                `;
                recentContainer.appendChild(row);
            });
        };

        saveButton?.addEventListener("click", () => {
            const next = currentFilter();
            const name = prompt("نام این فیلتر را وارد کنید:", "فیلتر ذخیره‌شده");
            if (!name) return;
            const items = readJson(storageKey, []);
            items.unshift({ name, ...next });
            saveFilters(items.slice(0, 8)).finally(renderSaved);
        });

        clearButton?.addEventListener("click", () => {
            form.querySelector('[name="SearchTerm"]').value = "";
            form.querySelector('[name="Status"]').value = "";
            form.querySelector('[name="DepartmentId"]').value = "";
            form.querySelector('[name="WorkflowView"]').value = "all";
            form.submit();
        });

        document.querySelectorAll(".hc-track-visit").forEach(link => {
            link.addEventListener("click", () => {
                const items = readJson(recentKey, []).filter(x => x.id !== link.dataset.id);
                items.unshift({
                    id: link.dataset.id,
                    name: link.dataset.name,
                    url: link.dataset.url,
                    when: new Date().toLocaleString("fa-IR")
                });
                writeJson(recentKey, items.slice(0, 8));
            });
        });

        loadSavedFilters().finally(renderSaved);
        renderRecent();
    })();
</script>
