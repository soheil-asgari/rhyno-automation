@model HumanCapitalIndexVM
@using OfficeAutomation.Modules.InvoiceStructuring
@{
    ViewData["Title"] = "مدیریت سرمایه انسانی";
    ViewData["SectionTitle"] = "مدیریت سرمایه انسانی";
    ViewData["SectionSubtitle"] = "ثبت، جستجو، وضعیت‌های شغلی و تاریخچه حقوق در یک نمای عملیاتی";
    ViewData["SectionActionUrl"] = Url.Action("Create", "HumanCapital");
    ViewData["SectionActionText"] = "استخدام جدید";

    string Jalali(DateTime date) => JalaliDateHelper.ToShamsiStringPersianDigits(date);
    string JalaliOrDash(DateTime? date) => date.HasValue ? JalaliDateHelper.ToShamsiStringPersianDigits(date.Value) : "—";
    string SalaryLabel(decimal value) => value > 0 ? value.ToString("N0") : "—";
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <!-- ═══════════════ ۱. Header ═══════════════ -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white">مدیریت سرمایه انسانی</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">ثبت، جستجو، وضعیت‌های شغلی و تاریخچه حقوق در یک نمای عملیاتی</p>
        </div>
        <a href="/HumanCapital/Create" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold transition-all shadow-sm shadow-emerald-500/20 whitespace-nowrap">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            استخدام جدید
        </a>
    </div>

    @{
        ViewData["SavedFiltersSaveButtonId"] = "hc-save-filter";
        ViewData["SavedFiltersClearButtonId"] = "hc-clear-filters";
        ViewData["SavedFiltersContainerId"] = "hc-saved-filters";
    }

    <!-- ═══════════════ ۲. KPI Summary Cards ═══════════════ -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
        <!-- کل پرسنل -->
        <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white shadow-sm p-3 transition hover:shadow-md hover:-translate-y-0.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 border border-indigo-100">
                <i class="bi bi-people-fill text-lg"></i>س
            </div>
            <div class="min-w-0">
                <p class="m-0 text-[11px] font-bold text-slate-500">👥 کل پرسنل</p>
                <p class="m-0 text-lg font-black text-slate-800 tabular-nums">@Model.TotalCount</p>
                <p class="m-0 text-[10px] text-slate-400">کل کارمندان ثبت‌شده</p>
            </div>
        </div>

        <!-- شاغلین فعال -->
        <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white shadow-sm p-3 transition hover:shadow-md hover:-translate-y-0.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 border border-emerald-100">
                <i class="bi bi-check2-circle text-lg"></i>
            </div>
            <div class="min-w-0">
                <p class="m-0 text-[11px] font-bold text-slate-500">✅ شاغلین فعال</p>
                <p class="m-0 text-lg font-black text-emerald-600 tabular-nums">@Model.ActiveCount</p>
                <p class="m-0 text-[10px] text-slate-400">مشغول به کار در سازمان</p>
            </div>
        </div>

        <!-- در انتظار تکمیل پرونده / مرخصی -->
        <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white shadow-sm p-3 transition hover:shadow-md hover:-translate-y-0.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600 border border-amber-100">
                <i class="bi bi-hourglass-split text-lg"></i>
            </div>
            <div class="min-w-0">
                <p class="m-0 text-[11px] font-bold text-slate-500">📋 در انتظار تکمیل پرونده / مرخصی</p>
                <p class="m-0 text-lg font-black text-amber-600 tabular-nums">@(Model.PendingOnboardingCount + Model.OnLeaveCount)</p>
                <p class="m-0 text-[10px] text-slate-400">پرونده ناتمام: @Model.PendingOnboardingCount • مرخصی: @Model.OnLeaveCount</p>
            </div>
        </div>

        <!-- مجموع حقوق ماهانه -->
        <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white shadow-sm p-3 transition hover:shadow-md hover:-translate-y-0.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-rose-50 text-rose-600 border border-rose-100">
                <i class="bi bi-cash-stack text-lg"></i>
            </div>
            <div class="min-w-0">
                <p class="m-0 text-[11px] font-bold text-slate-500">💰 مجموع حقوق ماهانه</p>
                <p class="m-0 text-lg font-black text-rose-600 tabular-nums">@SalaryLabel(Model.TotalMonthlyPayroll)</p>
                <p class="m-0 text-[10px] text-slate-400">میانگین: @SalaryLabel(Model.AverageSalary)</p>
            </div>
        </div>
    </section>

    <!-- ═══════════════ ۳. Tabs Navigation ═══════════════ -->
    <nav class="flex flex-wrap items-center gap-1 rounded-lg border border-black/10 bg-white p-1 shadow-sm" aria-label="نمای‌ها">
        <button type="button" data-hc-tab="all" class="hc-tab-btn flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-bold text-slate-600 transition hover:bg-slate-100 active">
            <i class="bi bi-person-badge"></i>📁 همه پرسنل
        </button>
        <button type="button" data-hc-tab="status" class="hc-tab-btn flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-bold text-slate-600 transition hover:bg-slate-100">
            <i class="bi bi-arrow-repeat"></i>🔄 وضعیت‌های شغلی
        </button>
        <button type="button" data-hc-tab="salary" class="hc-tab-btn flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-bold text-slate-600 transition hover:bg-slate-100">
            <i class="bi bi-credit-card"></i>💳 تاریخچه حقوق و مزایا
        </button>
        <button type="button" data-hc-tab="directives" class="hc-tab-btn flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-bold text-slate-600 transition hover:bg-slate-100">
            <i class="bi bi-gear"></i>⚙️ تنظیمات و احکام
        </button>
    </nav>

    <!-- ═══════════════ ۴. Advanced Search & Filter Bar (Sticky) ═══════════════ -->
    <section class="sticky top-0 z-20 rounded-lg border border-black/10 bg-white shadow-md">
        <form method="get" asp-action="Index" id="hc-filter-form" class="flex flex-col gap-2.5 p-2.5">
            <input type="hidden" asp-for="WorkflowView" />

            <div class="flex flex-col gap-2.5 md:flex-row md:items-center">
                <!-- Instant Search -->
                <div class="relative flex-1 min-w-[220px]">
                    <span class="pointer-events-none absolute inset-y-0 right-2.5 flex items-center text-slate-400">
                        <i class="bi bi-search text-sm"></i>
                    </span>
                    <input asp-for="SearchTerm" id="hc-instant-search"
                           class="h-9 w-full rounded-lg border border-black/15 bg-white pr-8 pl-3 text-xs text-slate-800 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200"
                           placeholder="جستجوی فوری: نام، کد ملی یا کد پرسنلی..." autocomplete="off" />
                </div>

                <!-- Department -->
                <div class="flex flex-col gap-1 min-w-[150px]">
                    <label asp-for="DepartmentId" class="text-[10px] font-bold text-slate-500">دپارتمان</label>
                    <select asp-for="DepartmentId" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200">
                        <option value="">همه دپارتمان‌ها</option>
                        @foreach (var dept in Model.DepartmentOptions)
                        {
                            <option value="@dept.Value" selected="@dept.Selected">@dept.Text</option>
                        }
                    </select>
                </div>

                <!-- Status -->
                <div class="flex flex-col gap-1 min-w-[150px]">
                    <label asp-for="Status" class="text-[10px] font-bold text-slate-500">وضعیت شغلی</label>
                    <select asp-for="Status" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="فعال">فعال</option>
                        <option value="در انتظار تایید">در انتظار تایید</option>
                        <option value="مرخصی موقت">مرخصی موقت</option>
                        <option value="اخراج شده">اخراج شده</option>
                    </select>
                </div>

                <!-- Employment Type -->
                <div class="flex flex-col gap-1 min-w-[150px]">
                    <label asp-for="EmploymentType" class="text-[10px] font-bold text-slate-500">نوع همکاری</label>
                    <select asp-for="EmploymentType" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200">
                        <option value="">همه انواع همکاری</option>
                        @foreach (var type in Model.EmploymentTypeOptions)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col gap-2 sm:flex-row sm:items-end md:flex-col lg:flex-row">
                    <a asp-action="Create"
                       class="inline-flex h-9 items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-3.5 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-700 no-underline whitespace-nowrap">
                        <i class="bi bi-plus-lg text-sm"></i> استخدام کارمند جدید
                    </a>
                    <a href="/HumanCapital/ExportExcel" id="hc-export-btn"
                       class="inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-black/20 bg-gradient-to-b from-white to-slate-100 px-3.5 text-xs font-bold text-slate-700 shadow-sm transition hover:bg-white no-underline whitespace-nowrap">
                        <i class="bi bi-file-earmark-spreadsheet text-sm"></i> خروجی اکسل
                    </a>
                    <button type="button" id="hc-reset-btn"
                            class="inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-black/20 bg-gradient-to-b from-white to-slate-100 px-3.5 text-xs font-bold text-slate-600 shadow-sm transition hover:bg-white whitespace-nowrap">
                        <i class="bi bi-eraser text-sm"></i> پاک‌سازی فیلترها
                    </button>
                </div>
            </div>

            <!-- Saved Filters Row -->
            <div class="border-t border-black/5 pt-2">
                <partial name="_SavedFiltersPanel" />
            </div>
        </form>
    </section>

    <!-- ═══════════════ ۵. Tab Panels ═══════════════ -->
    <section id="hc-panel-status" class="hidden">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <div class="rounded-lg border border-black/10 bg-white p-3 shadow-sm">
                <p class="m-0 text-[11px] font-bold text-slate-500">فعال</p>
                <p class="m-0 text-lg font-black text-emerald-600">@Model.ActiveCount</p>
            </div>
            <div class="rounded-lg border border-black/10 bg-white p-3 shadow-sm">
                <p class="m-0 text-[11px] font-bold text-slate-500">مرخصی موقت</p>
                <p class="m-0 text-lg font-black text-amber-600">@Model.OnLeaveCount</p>
            </div>
            <div class="rounded-lg border border-black/10 bg-white p-3 shadow-sm">
                <p class="m-0 text-[11px] font-bold text-slate-500">در انتظار تکمیل پرونده</p>
                <p class="m-0 text-lg font-black text-amber-600">@Model.PendingOnboardingCount</p>
            </div>
            <div class="rounded-lg border border-black/10 bg-white p-3 shadow-sm">
                <p class="m-0 text-[11px] font-bold text-slate-500">خارج‌شده / غیرفعال</p>
                <p class="m-0 text-lg font-black text-rose-600">@Model.SeparatedCount</p>
            </div>
        </div>
        <p class="mt-2.5 text-[11px] text-slate-500">برای مشاهده و ویرایش جزئیات وضعیت هر پرسنل، از منوی عملیات ردیف مربوطه گزینه «تغییر وضعیت» را انتخاب کنید.</p>
    </section>

    <section id="hc-panel-salary" class="hidden">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white p-3 shadow-sm">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-rose-50 text-rose-600"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <p class="m-0 text-[11px] font-bold text-slate-500">مجموع حقوق ماهانه</p>
                    <p class="m-0 text-base font-black text-slate-800">@SalaryLabel(Model.TotalMonthlyPayroll)</p>
                </div>
            </div>
            <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white p-3 shadow-sm">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600"><i class="bi bi-bar-chart"></i></div>
                <div>
                    <p class="m-0 text-[11px] font-bold text-slate-500">میانگین حقوق</p>
                    <p class="m-0 text-base font-black text-slate-800">@SalaryLabel(Model.AverageSalary)</p>
                </div>
            </div>
            <div class="flex items-center gap-3 rounded-lg border border-black/10 bg-white p-3 shadow-sm">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600"><i class="bi bi-people"></i></div>
                <div>
                    <p class="m-0 text-[11px] font-bold text-slate-500">تعداد پرسنل مشمول</p>
                    <p class="m-0 text-base font-black text-slate-800">@Model.TotalCount</p>
                </div>
            </div>
        </div>
        <p class="mt-2.5 text-[11px] text-slate-500">جزئیات کامل افزایش حقوق و مزایای هر پرسنل از گزینه «تاریخچه حقوق» در منوی عملیات ردیف مربوطه قابل مشاهده است.</p>
    </section>

    <section id="hc-panel-directives" class="hidden">
        <div class="rounded-lg border border-black/10 bg-white p-4 shadow-sm">
            <div class="flex items-start gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500"><i class="bi bi-file-earmark-text"></i></div>
                <div>
                    <p class="m-0 text-sm font-black text-slate-800">احکام و تنظیمات پرسنلی</p>
                    <p class="m-0 mt-1 text-[11px] text-slate-500">احکام (تغییر وضعیت، تعدیل، مرخصی) و تاریخچه حقوق هر کارمند از طریق پرونده پرسنلی قابل ثبت و پیگیری است.</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <a asp-action="Create" class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white no-underline transition hover:bg-emerald-700">
                            <i class="bi bi-person-plus"></i> استخدام جدید
                        </a>
                        <a href="@Url.Action("Index", "Leaves")" class="inline-flex items-center gap-1.5 rounded-lg border border-black/20 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 no-underline transition hover:bg-slate-50">
                            <i class="bi bi-calendar2-week"></i> مدیریت مرخصی‌ها
                        </a>
                        <a href="@Url.Action("Index", "Letters")" class="inline-flex items-center gap-1.5 rounded-lg border border-black/20 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 no-underline transition hover:bg-slate-50">
                            <i class="bi bi-envelope"></i> نامه‌ها
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════ ۶. Enterprise Operational Data Table ═══════════════ -->
    <section id="hc-panel-table" class="rounded-lg border border-black/10 bg-white shadow-sm">
        <!-- Table Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-black/5 px-3 py-2.5">
            <div class="flex items-center gap-2">
                <h2 class="m-0 text-sm font-black text-slate-800">لیست کارمندان</h2>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-500">@Model.FilteredCount رکورد</span>
            </div>
            <div class="flex items-center gap-1.5 text-[11px] text-slate-500">
                <span>نمایش</span>
                <select id="hc-page-size" class="h-7 rounded-md border border-black/15 bg-white px-1.5 text-[11px] font-bold text-slate-600 outline-none">
                    <option value="10">۱۰</option>
                    <option value="20">۲۰</option>
                    <option value="50">۵۰</option>
                    <option value="100">۱۰۰</option>
                </select>
                <span>رکورد در هر صفحه</span>
            </div>
        </div>

        <!-- Data Grid -->
        <div class="overflow-x-auto w-full">
            <table class="w-full min-w-[960px] text-xs text-right border-collapse text-slate-700">
                <thead class="sticky top-0 z-10 bg-slate-50 border-b border-black/10">
                    <tr>
                        <th class="px-3 py-2.5 font-bold text-slate-600">پرسنل</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">دپارتمان و عنوان شغلی</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">کد ملی و شماره تماس</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">تاریخ استخدام</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">وضعیت شغلی</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600 w-1">عملیات</th>
                    </tr>
                </thead>
                <tbody id="hc-table-body" class="divide-y divide-black/5">
                    @if (Model.Items.Any())
                    {
                        foreach (var employee in Model.Items)
                        {
                            var isActive = employee.CurrentStatus == "فعال";
                            var isLeave = employee.CurrentStatus == "مرخصی موقت";
                            var isTerminated = employee.CurrentStatus == "اخراج شده";

                            var badgeClass = isActive
                                ? "bg-emerald-50 text-emerald-700 border-emerald-200"
                                : (isLeave
                                ? "bg-amber-50 text-amber-700 border-amber-200"
                                : (isTerminated
                                ? "bg-rose-50 text-rose-700 border-rose-200"
                                : "bg-slate-100 text-slate-600 border-slate-200"));

                            var badgeDot = isActive ? "bg-emerald-500" : (isLeave ? "bg-amber-500" : (isTerminated ? "bg-rose-500" : "bg-slate-400"));
                            var avatarClass = isActive
                                ? "bg-emerald-50 text-emerald-700 border-emerald-200"
                                : (isLeave
                                ? "bg-amber-50 text-amber-700 border-amber-200"
                                : (isTerminated
                                ? "bg-rose-50 text-rose-700 border-rose-200"
                                : "bg-slate-100 text-slate-600 border-slate-200"));

                            var initials = string.IsNullOrWhiteSpace(employee.FullName) ? "؟" : employee.FullName.Substring(0, 1);
                            var showOnboardingDot = !employee.OnboardingCompleted;

                            <tr class="hc-data-row transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/50" data-name="@employee.FullName" data-status="@employee.CurrentStatus">
                                <!-- پرسنل -->
                                <td class="px-3 py-2.5">
                                    <div class="flex items-center gap-2.5">
                                        <div class="relative">
                                            <div class="flex h-9 w-9 items-center justify-center rounded-full border text-xs font-black @avatarClass">@initials</div>
                                            @if (showOnboardingDot)
                                            {
                                                <span class="absolute -bottom-0.5 -left-0.5 h-3 w-3 rounded-full border-2 border-white bg-amber-400" title="پرونده ناتمام"></span>
                                            }
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-bold text-slate-900 whitespace-nowrap">@employee.FullName</div>
                                            <div class="text-[10px] text-slate-500 font-mono">کد پرسنلی: @employee.PersonnelCode</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- دپارتمان و عنوان شغلی -->
                                <td class="px-3 py-2.5">
                                    <div class="font-medium text-slate-800">@employee.PositionTitle</div>
                                    <div class="mt-0.5 flex items-center gap-1.5">
                                        <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600">
                                            <i class="bi bi-building ml-1"></i>@(employee.DepartmentName ?? "—")
                                        </span>
                                        <span class="inline-flex items-center rounded-md border border-indigo-100 bg-indigo-50 px-1.5 py-0.5 text-[10px] font-semibold text-indigo-600">
                                            @(string.IsNullOrWhiteSpace(employee.EmploymentType) ? "همکاری" : employee.EmploymentType)
                                        </span>
                                    </div>
                                </td>

                                <!-- کد ملی و شماره تماس -->
                                <td class="px-3 py-2.5">
                                    <div class="flex items-center gap-1.5 text-[11px] font-mono text-slate-600">
                                        <i class="bi bi-credit-card-2-front text-slate-400"></i>@(string.IsNullOrWhiteSpace(employee.NationalCode) ? "—" : employee.NationalCode)
                                    </div>
                                    <div class="mt-0.5 flex items-center gap-1.5 text-[11px] font-mono text-slate-500" dir="ltr">
                                        <i class="bi bi-telephone text-slate-400"></i>@(string.IsNullOrWhiteSpace(employee.PhoneNumber) ? "—" : employee.PhoneNumber)
                                    </div>
                                </td>

                                <!-- تاریخ استخدام -->
                                <td class="px-3 py-2.5">
                                    <div class="flex items-center gap-1.5 text-slate-700 tabular-nums">
                                        <i class="bi bi-calendar3 text-slate-400"></i>@Jalali(employee.HireDate)
                                    </div>
                                    <div class="mt-0.5 text-[10px] text-slate-400">آخرین رخداد: @JalaliOrDash(employee.LatestStatusDate)</div>
                                </td>

                                <!-- وضعیت شغلی -->
                                <td class="px-3 py-2.5">
                                    <span class="inline-flex items-center gap-1.5 rounded-full border px-2 py-1 text-[10px] font-bold @badgeClass">
                                        <span class="h-1.5 w-1.5 rounded-full @badgeDot"></span>
                                        @employee.CurrentStatus
                                    </span>
                                </td>

                                <!-- عملیات -->
                                <td class="px-3 py-2.5 text-center w-1">
                                    <div class="relative inline-block hc-action-wrap">
                                        <button type="button"
                                                class="hc-action-toggle flex h-8 w-8 items-center justify-center rounded-lg border border-black/10 bg-white text-slate-500 shadow-sm transition hover:bg-slate-50 hover:text-slate-700"
                                                data-id="@employee.Id" data-name="@employee.FullName"
                                                data-view-url="@Url.Action("Details", "HumanCapital", new { id = employee.Id })"
                                                data-edit-url="@Url.Action("Edit", "HumanCapital", new { id = employee.Id })"
                                                aria-haspopup="true" aria-expanded="false" title="عملیات">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <div class="hc-action-menu hidden absolute left-0 top-full z-30 mt-1 w-48 rounded-lg border border-black/10 bg-white p-1 shadow-xl">
                                            <a href="@Url.Action("Details", "HumanCapital", new { id = employee.Id })"
                                               class="hc-track-visit flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 no-underline transition hover:bg-slate-100"
                                               data-id="@employee.Id" data-name="@employee.FullName" data-url="@Url.Action("Details", "HumanCapital", new { id = employee.Id })">
                                                <i class="bi bi-person-bounding-box text-slate-400"></i> مشاهده پرونده
                                            </a>
                                            <a href="@Url.Action("Edit", "HumanCapital", new { id = employee.Id })"
                                               class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 no-underline transition hover:bg-slate-100">
                                                <i class="bi bi-pencil-square text-slate-400"></i> ویرایش
                                            </a>
                                            <a href="@Url.Action("Details", "HumanCapital", new { id = employee.Id })#salary-history"
                                               class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 no-underline transition hover:bg-slate-100">
                                                <i class="bi bi-cash-coin text-slate-400"></i> تاریخچه حقوق
                                            </a>
                                            <a href="@Url.Action("Edit", "HumanCapital", new { id = employee.Id })"
                                               class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 no-underline transition hover:bg-slate-100">
                                                <i class="bi bi-arrow-repeat text-slate-400"></i> تغییر وضعیت
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-3 py-10 text-center">
                                <div class="flex flex-col items-center gap-2 text-slate-400">
                                    <i class="bi bi-inbox text-3xl"></i>
                                    <span class="text-xs font-semibold">موردی برای نمایش وجود ندارد.</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-black/5 px-3 py-2.5">
            <div class="text-[11px] text-slate-500" id="hc-pagination-info">نمایش ۰ تا ۰ از @Model.FilteredCount رکورد</div>
            <div class="flex items-center gap-1" id="hc-pagination-controls"></div>
        </div>
    </section>
</div>

<script src="~/js/human-capital-index-script.js" asp-append-version="true"></script>