@model HrAttendanceCreateVM
@{
    ViewData["Title"] = "ثبت کارکرد";
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4 bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div>
            <h1 class="text-lg font-bold text-slate-900 dark:text-white">ثبت کارکرد ماهانه</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">ثبت حضور و غیاب و اضافه‌کار پرسنل</p>
        </div>
        <a href="@Url.Action("Attendance", "HumanCapital")" class="inline-flex items-center gap-1.5 px-3 h-8 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition no-underline">
            <i class="bi bi-arrow-right"></i> بازگشت
        </a>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm p-5">
        <form method="post" asp-action="CreateAttendance">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="EmployeeId" class="text-xs font-bold text-slate-700 dark:text-slate-300">کارمند <span class="text-rose-500">*</span></label>
                    <select asp-for="EmployeeId" asp-items="Model.EmployeeOptions" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200">
                        <option value="">— انتخاب کارمند —</option>
                    </select>
                    <span asp-validation-for="EmployeeId" class="text-[10px] text-rose-500"></span>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Year" class="text-xs font-bold text-slate-700 dark:text-slate-300">سال <span class="text-rose-500">*</span></label>
                    <input asp-for="Year" type="number" min="1390" max="1420" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200 tabular-nums" dir="ltr" />
                    <span asp-validation-for="Year" class="text-[10px] text-rose-500"></span>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Month" class="text-xs font-bold text-slate-700 dark:text-slate-300">ماه <span class="text-rose-500">*</span></label>
                    <select asp-for="Month" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200">
                        @for (int i = 0; i < Model.MonthOptions.Count; i++)
                        {
                            <option value="@(i + 1)">@Model.MonthOptions[i]</option>
                        }
                    </select>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="PresentDays" class="text-xs font-bold text-slate-700 dark:text-slate-300">روزهای حضور</label>
                    <input asp-for="PresentDays" type="number" min="0" max="31" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200 tabular-nums" dir="ltr" />
                    <span asp-validation-for="PresentDays" class="text-[10px] text-rose-500"></span>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="AbsentDays" class="text-xs font-bold text-slate-700 dark:text-slate-300">روزهای غیبت</label>
                    <input asp-for="AbsentDays" type="number" min="0" max="31" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200 tabular-nums" dir="ltr" />
                    <span asp-validation-for="AbsentDays" class="text-[10px] text-rose-500"></span>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="OvertimeHours" class="text-xs font-bold text-slate-700 dark:text-slate-300">ساعات اضافه‌کار</label>
                    <input asp-for="OvertimeHours" type="number" min="0" max="200" step="0.5" class="h-9 rounded-lg border border-black/15 bg-white px-2.5 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200 tabular-nums" dir="ltr" />
                    <span asp-validation-for="OvertimeHours" class="text-[10px] text-rose-500"></span>
                </div>
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label asp-for="Notes" class="text-xs font-bold text-slate-700 dark:text-slate-300">توضیحات</label>
                    <textarea asp-for="Notes" rows="3" class="rounded-lg border border-black/15 bg-white px-2.5 py-2 text-xs text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:bg-slate-950 dark:text-slate-200 resize-none"></textarea>
                </div>
            </div>
            <div class="flex items-center justify-end gap-2 mt-5 pt-4 border-t border-black/5">
                <a href="@Url.Action("Attendance", "HumanCapital")" class="inline-flex items-center gap-1.5 px-4 h-9 border border-black/20 bg-gradient-to-b from-white to-slate-100 text-slate-700 rounded-lg text-xs font-bold transition no-underline">انصراف</a>
                <button type="submit" class="inline-flex items-center gap-1.5 px-5 h-9 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition shadow-sm"><i class="bi bi-check-lg"></i> ذخیره کارکرد</button>
            </div>
        </form>
    </div>
</div>