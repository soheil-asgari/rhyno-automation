@model HumanCapitalEditVM
@{
    ViewData["Title"] = "ویرایش پرونده پرسنلی";
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    @{ 
        ViewData["SectionTitle"] = "ویرایش پرونده پرسنلی"; 
        ViewData["SectionSubtitle"] = "اطلاعات پایه، وضعیت فعلی و سوابق پرسنل"; 
        ViewData["SectionActionUrl"] = Url.Action("Details", "HumanCapital", new { id = Model.Id }); 
        ViewData["SectionActionText"] = "بازگشت به جزئیات"; 
        ViewData["SectionActionCss"] = "flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm bg-transparent no-underline"; 
    }
    <partial name="_SectionHeader" />

    <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
        <form asp-action="Edit" method="post" class="flex flex-col gap-3">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 dark:bg-rose-950/10 text-rose-800 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 rounded-lg text-xs font-semibold leading-relaxed"></div>
            }
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                <!-- Personnel Code -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="PersonnelCode" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="PersonnelCode" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
                    <span asp-validation-for="PersonnelCode" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- National Code -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="NationalCode" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="NationalCode" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
                    <span asp-validation-for="NationalCode" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Full Name -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="FullName" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="FullName" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
                    <span asp-validation-for="FullName" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Birth Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="BirthDate" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="BirthDate" type="date" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
                    <span asp-validation-for="BirthDate" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Hire Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="HireDate" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="HireDate" type="date" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
                    <span asp-validation-for="HireDate" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Contract End Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="ContractEndDate" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="ContractEndDate" type="date" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
                    <span asp-validation-for="ContractEndDate" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Employment Type -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="EmploymentType" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <select asp-for="EmploymentType" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" asp-items="Model.EmploymentTypeOptions"></select>
                    <span asp-validation-for="EmploymentType" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Department -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="DepartmentId" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <select asp-for="DepartmentId" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" asp-items="Model.DepartmentOptions">
                        <option value="">بدون دپارتمان</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Position Title -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="PositionTitle" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="PositionTitle" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
                    <span asp-validation-for="PositionTitle" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Current Salary -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="CurrentSalary" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="CurrentSalary" type="number" min="0" step="0.01" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 text-left font-mono tabular-nums font-semibold" />
                    <span asp-validation-for="CurrentSalary" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Current Status -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="CurrentStatus" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="CurrentStatus" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
                    <span asp-validation-for="CurrentStatus" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Onboarding Completed Switch -->
                <div class="flex items-center gap-2 h-8 mt-3">
                    <input asp-for="OnboardingCompleted" type="checkbox" class="w-4 h-4 text-teal-600 border-slate-300 dark:border-slate-700 rounded focus:ring-teal-500 focus:ring-2 bg-transparent" />
                    <label asp-for="OnboardingCompleted" class="text-xs font-bold text-slate-700 dark:text-slate-300 cursor-pointer"></label>
                </div>

                <!-- Phone Number -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="PhoneNumber" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="PhoneNumber" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 text-left font-mono" />
                    <span asp-validation-for="PhoneNumber" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Email -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Email" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="Email" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 text-left font-mono" />
                    <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Address -->
                <div class="flex flex-col gap-1.5 md:col-span-2 lg:col-span-3">
                    <label asp-for="Address" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="Address" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-905 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
                    <span asp-validation-for="Address" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Notes -->
                <div class="flex flex-col gap-1.5 md:col-span-2 lg:col-span-3">
                    <label asp-for="Notes" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <textarea asp-for="Notes" rows="3" class="w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 p-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800"></textarea>
                    <span asp-validation-for="Notes" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Form Actions Setup -->
            @{ 
                ViewData["SecondaryActionUrl"] = Url.Action("Details", "HumanCapital", new { id = Model.Id }); 
                ViewData["SecondaryActionText"] = "انصراف"; 
                ViewData["PrimaryActionText"] = "ذخیره تغییرات"; 
            }
            <div class="flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800 pt-2 mt-2">
                <a href="@ViewData["SecondaryActionUrl"]" class="flex items-center justify-center px-2.5 h-8 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm no-underline">
                    <span>@ViewData["SecondaryActionText"]</span>
                </a>
                <button type="submit" class="flex items-center gap-1.5 px-3 h-8 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm">
                    <span>@ViewData["PrimaryActionText"]</span>
                </button>
            </div>
        </form>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
