@model string
@{
    ViewData["Title"] = Model;
    var moduleTitle = Model ?? "ماژول سرمایه انسانی";
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <!-- Header -->
    <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
        <div>
            <h1 class="m-0 text-sm font-black text-slate-900 dark:text-white tracking-tight">@moduleTitle</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">بخش سرمایه انسانی - راینو ERP</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <a href="/HumanCapital" onclick="event.preventDefault(); if (window.parent && window.parent.RhynoTabs) { window.parent.RhynoTabs.open('/HumanCapital', 'مدیریت سرمایه انسانی', 'bi-person-badge'); } else { window.location.href = '/HumanCapital'; }" class="flex items-center justify-center px-3 h-8 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm bg-transparent no-underline">
                <span>بازگشت به پرونده پرسنلی</span>
            </a>
        </div>
    </header>

    <!-- Placeholder Card -->
    <div class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm flex flex-col items-center justify-center gap-3 text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400">
            <i class="bi bi-tools text-2xl"></i>
        </div>
        <h2 class="m-0 text-base font-black text-slate-800 dark:text-white">@moduleTitle</h2>
        <p class="m-0 text-xs text-slate-500 dark:text-slate-400 max-w-md leading-relaxed">
            این ماژول در حال توسعه است. برای دسترسی به امکانات کامل، از منوی سرمایه انسانی گزینه «پرونده پرسنلی» را انتخاب کنید.
        </p>
        <a href="/HumanCapital" onclick="event.preventDefault(); if (window.parent && window.parent.RhynoTabs) { window.parent.RhynoTabs.open('/HumanCapital', 'مدیریت سرمایه انسانی', 'bi-person-badge'); } else { window.location.href = '/HumanCapital'; }" class="inline-flex items-center gap-1.5 px-4 h-9 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm no-underline">
            <i class="bi bi-person-badge"></i>
            <span>مشاهده پرونده پرسنلی</span>
        </a>
    </div>
</div>