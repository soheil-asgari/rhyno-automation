@model HrAttendanceIndexVM
@{
    ViewData["Title"] = "کارکرد و حضور غیاب";
    string[] MonthNames = { "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند" };
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4 bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div>
            <h1 class="text-lg font-bold text-slate-900 dark:text-white">کارکرد و حضور غیاب</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">ثبت و مدیریت کارکرد ماهانه پرسنل</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/HumanCapital" onclick="event.preventDefault(); if (window.parent && window.parent.RhynoTabs) { window.parent.RhynoTabs.open('/HumanCapital', 'مدیریت سرمایه انسانی', 'bi-person-badge'); } else { window.location.href = '/HumanCapital'; }" class="inline-flex items-center gap-1.5 px-3 h-8 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition no-underline">
                <i class="bi bi-arrow-right"></i> بازگشت
            </a>
            <a href="@Url.Action("CreateAttendance", "HumanCapital")" class="inline-flex items-center gap-1.5 px-4 h-8 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition shadow-sm no-underline">
                <i class="bi bi-plus-lg"></i> ثبت کارکرد
            </a>
        </div>
    </div>

    <section class="rounded-lg border border-black/10 bg-white shadow-sm">
        <div class="flex items-center justify-between gap-2 border-b border-black/5 px-3 py-2.5">
            <h2 class="m-0 text-sm font-black text-slate-800">لیست کارکرد</h2>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-500">@Model.TotalCount رکورد</span>
        </div>
        <div class="overflow-x-auto w-full">
            <table class="w-full min-w-[800px] text-xs text-right border-collapse text-slate-700">
                <thead class="sticky top-0 z-10 bg-slate-50 border-b border-black/10">
                    <tr>
                        <th class="px-3 py-2.5 font-bold text-slate-600">کارمند</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">سال</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">ماه</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">روزهای حضور</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">روزهای غیبت</th>
                        <th class="px-3 py-2.5 font-bold text-slate-600">اضافه‌کار (ساعت)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-black/5">
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            var monthName = item.Month >= 1 && item.Month <= 12 ? MonthNames[item.Month - 1] : item.Month.ToString();
                            <tr class="transition-colors hover:bg-slate-50">
                                <td class="px-3 py-2.5">
                                    <div class="font-bold text-slate-900">@item.EmployeeName</div>
                                    <div class="text-[10px] text-slate-500 font-mono">@item.PersonnelCode</div>
                                </td>
                                <td class="px-3 py-2.5 tabular-nums">@item.Year</td>
                                <td class="px-3 py-2.5">@monthName</td>
                                <td class="px-3 py-2.5 tabular-nums">
                                    <span class="inline-flex items-center rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">@item.PresentDays</span>
                                </td>
                                <td class="px-3 py-2.5 tabular-nums">
                                    <span class="inline-flex items-center rounded-md border border-rose-200 bg-rose-50 px-2 py-0.5 text-[11px] font-semibold text-rose-700">@item.AbsentDays</span>
                                </td>
                                <td class="px-3 py-2.5 tabular-nums font-mono">@item.OvertimeHours</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="px-3 py-10 text-center"><div class="flex flex-col items-center gap-2 text-slate-400"><i class="bi bi-inbox text-3xl"></i><span class="text-xs font-semibold">کارکردی ثبت نشده است.</span><a href="@Url.Action("CreateAttendance", "HumanCapital")" class="mt-2 inline-flex items-center gap-1.5 px-4 h-8 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition no-underline"><i class="bi bi-plus-lg"></i> ثبت کارکرد</a></div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>