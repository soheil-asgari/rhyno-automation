@model IEnumerable<OfficeAutomation.Models.User>
@{
    ViewData["Title"] = "مدیریت کاربران";
    string PermissionBadgeClass(string key) => key switch
    {
        "Finance.View" => "bg-blue-50 text-blue-700 dark:bg-blue-955/20 dark:text-blue-400 border-blue-200/30",
        "Warehouse.View" => "bg-cyan-50 text-cyan-700 dark:bg-cyan-955/20 dark:text-cyan-400 border-cyan-200/30",
        "HR.View" => "bg-amber-50 text-amber-700 dark:bg-amber-955/20 dark:text-amber-400 border-amber-200/30",
        "SystemSettings.View" => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-350 border-slate-200/30",
        _ => "bg-slate-50 text-slate-600 dark:bg-slate-850 dark:text-slate-400 border-slate-200/20"
    };
    string PermissionLabel(string key) => key switch
    {
        "Finance.View" => "دسترسی مالی",
        "Warehouse.View" => "دسترسی انبار",
        "HR.View" => "دسترسی منابع انسانی",
        "SystemSettings.View" => "دسترسی تنظیمات",
        _ => key
    };
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <!-- Header Section -->
    <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-teal-50 dark:bg-teal-950/30 text-teal-600 dark:text-teal-400 text-sm border border-teal-200/30">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h1 class="m-0 text-sm font-black text-slate-900 dark:text-white tracking-tight">مدیریت همکاران</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">نمایش وضعیت کاربران، سطوح دسترسی و کنترل‌های حساب کاربری</p>
            </div>
        </div>
        <a asp-action="Create" class="flex items-center gap-1.5 px-2.5 h-8 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm no-underline self-start sm:self-auto">
            <i class="bi bi-person-plus-fill"></i>
            <span>افزودن کاربر جدید</span>
        </a>
    </header>

    <!-- Data Grid Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-xs text-right border-collapse text-slate-700 dark:text-slate-300">
                <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="px-3 py-2.5 font-bold">نام و نام خانوادگی</th>
                        <th class="px-3 py-2.5 font-bold text-center">کد پرسنلی</th>
                        <th class="px-3 py-2.5 font-bold">مدیر مستقیم</th>
                        <th class="px-3 py-2.5 font-bold">دسترسی‌ها</th>
                        <th class="px-3 py-2.5 font-bold text-center">وضعیت</th>
                        <th class="px-3 py-2.5 font-bold text-center w-1">عملیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                    @foreach (var user in Model)
                    {
                        var fullName = user.FullName ?? user.UserName ?? "کاربر";
                        var initial = !string.IsNullOrWhiteSpace(fullName) ? fullName.Substring(0, 1) : "؟";
                        
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                            <!-- Requester Info & Avatar -->
                            <td class="px-3 py-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-teal-50 dark:bg-teal-955/40 border border-teal-200/40 dark:border-teal-800/30 text-teal-700 dark:text-teal-400 flex items-center justify-center font-black text-xs">
                                        @initial
                                    </div>
                                    <div class="flex flex-col gap-0.5">
                                        <span class="font-bold text-slate-900 dark:text-white">@fullName</span>
                                        <span class="text-[10px] text-slate-450 font-mono text-left leading-normal">@user.Email</span>
                                    </div>
                                </div>
                            </td>

                            <!-- Personnel Code -->
                            <td class="px-3 py-3 text-center font-mono tabular-nums text-slate-600 dark:text-slate-400">
                                @(user.Employee?.PersonnelCode ?? "-")
                            </td>

                            <!-- Direct Manager -->
                            <td class="px-3 py-3 text-slate-800 dark:text-slate-200 font-medium">
                                @(user.ParentManagerUser?.FullName ?? "-")
                            </td>

                            <!-- Access Permissions -->
                            <td class="px-3 py-3">
                                <div class="flex flex-wrap gap-1 max-w-[280px]">
                                    @if (user.CanAccessFinance)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold border @PermissionBadgeClass("Finance.View")">
                                            @PermissionLabel("Finance.View")
                                        </span>
                                    }
                                    @if (user.CanAccessWarehouse)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold border @PermissionBadgeClass("Warehouse.View")">
                                            @PermissionLabel("Warehouse.View")
                                        </span>
                                    }
                                    @if (user.CanAccessHumanCapital)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold border @PermissionBadgeClass("HR.View")">
                                            @PermissionLabel("HR.View")
                                        </span>
                                    }
                                    @if (user.CanAccessSystemSettings)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold border @PermissionBadgeClass("SystemSettings.View")">
                                            @PermissionLabel("SystemSettings.View")
                                        </span>
                                    }
                                </div>
                            </td>

                            <!-- Account Status -->
                            <td class="px-3 py-3 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border border-emerald-200/40">
                                    فعال
                                </span>
                            </td>

                            <!-- Actions -->
                            <td class="px-3 py-3 text-center w-1">
                                <div class="flex items-center justify-center gap-1.5">
                                    <a href="#" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition" title="ویرایش">
                                        <i class="bi bi-pencil-square text-sm"></i>
                                    </a>
                                    <a href="#" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition" title="تغییر رمز عبور">
                                        <i class="bi bi-key text-sm"></i>
                                    </a>
                                    <a href="#" class="p-1 text-slate-500 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition" title="مسدود/فعال سازی">
                                        <i class="bi bi-shield-slash text-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
