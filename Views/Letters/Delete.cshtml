@model OfficeAutomation.Models.Letter

@{
    ViewData["Title"] = "حذف نامه";
    var sender = Model.Sender?.FullName ?? Model.Sender?.UserName ?? "نامشخص";
    var receiver = Model.Receiver?.FullName ?? Model.Receiver?.UserName ?? "نامشخص";
    var pc = new System.Globalization.PersianCalendar();
    string shamsiDate = Model.SentDate != default
        ? $"{pc.GetYear(Model.SentDate)}/{pc.GetMonth(Model.SentDate):D2}/{pc.GetDayOfMonth(Model.SentDate):D2} {Model.SentDate:HH:mm}"
        : Model.SentDate.ToString("yyyy/MM/dd HH:mm");
}

<div class="w-full flex-1 flex flex-col gap-4 p-2.5 md:p-4 letters-delete-shell" dir="rtl">
    <!-- ═══════ PAGE HEADER ═══════ -->
    <div class="lts-page-header">
        <div class="flex flex-wrap items-center gap-3 justify-between">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 flex items-center justify-center rounded-2xl" style="background:var(--lts-danger-soft);color:var(--lts-danger);">
                    <i class="bi bi-trash3"></i>
                </div>
                <div>
                    <h1 style="margin:0;font-weight:700;color:var(--lts-text-primary);font-size:1.25rem;">حذف نامه</h1>
                    <p style="margin:0;font-size:0.75rem;color:var(--lts-text-muted)">این عملیات برگشت‌پذیر نیست.</p>
                </div>
            </div>
            <a asp-action="Index" class="lts-btn-primary" style="background:var(--lts-surface-raised);color:var(--lts-text-secondary);border:1px solid var(--lts-border-color);box-shadow:none;">
                <i class="bi bi-arrow-right"></i>
                <span>بازگشت</span>
            </a>
        </div>
    </div>

    <!-- ═══════ CONFIRMATION CARD ═══════ -->
    <div class="rounded-2xl overflow-hidden" style="background:var(--lts-surface);border:1px solid var(--lts-border-color);box-shadow:var(--lts-shadow-sm);">
        <!-- Alert bar -->
        <div class="p-4 border-b" style="background:var(--lts-danger-soft);border-color:var(--lts-danger-soft);">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 flex items-center justify-center rounded-full" style="background:var(--lts-danger-soft);border:1px solid rgba(239,68,68,0.2);">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size:0.875rem;color:var(--lts-danger)"></i>
                </div>
                <div>
                    <h4 style="margin:0;font-size:0.875rem;font-weight:700;color:var(--lts-danger);">آیا مطمئن هستید؟</h4>
                    <p style="margin:0;font-size:0.75rem;color:var(--lts-text-muted);">با حذف این نامه، هیچ راهی برای بازیابی آن وجود نخواهد داشت.</p>
                </div>
            </div>
        </div>

        <!-- Details -->
        <div class="p-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="flex flex-col gap-1 p-3 rounded-xl" style="background:var(--lts-surface-raised);border:1px solid var(--lts-border-color);">
                    <span class="lts-filter-label"><i class="bi bi-type" style="color:var(--lts-accent)"></i> موضوع نامه</span>
                    <strong class="text-sm" style="color:var(--lts-text-primary);word-break:break-word;">@Model.Title</strong>
                </div>
                <div class="flex flex-col gap-1 p-3 rounded-xl" style="background:var(--lts-surface-raised);border:1px solid var(--lts-border-color);">
                    <span class="lts-filter-label"><i class="bi bi-person-up" style="color:var(--lts-accent)"></i> فرستنده</span>
                    <strong class="text-sm" style="color:var(--lts-text-primary);">@sender</strong>
                </div>
                <div class="flex flex-col gap-1 p-3 rounded-xl" style="background:var(--lts-surface-raised);border:1px solid var(--lts-border-color);">
                    <span class="lts-filter-label"><i class="bi bi-person-down" style="color:var(--lts-success)"></i> گیرنده</span>
                    <strong class="text-sm" style="color:var(--lts-text-primary);">@receiver</strong>
                </div>
                <div class="flex flex-col gap-1 p-3 rounded-xl" style="background:var(--lts-surface-raised);border:1px solid var(--lts-border-color);">
                    <span class="lts-filter-label"><i class="bi bi-calendar3" style="color:var(--lts-warning)"></i> تاریخ ارسال</span>
                    <strong class="text-sm font-mono tabular-nums" style="color:var(--lts-text-primary);">@shamsiDate</strong>
                </div>
                <div class="flex flex-col gap-1 p-3 rounded-xl sm:col-span-2" style="background:var(--lts-surface-raised);border:1px solid var(--lts-border-color);">
                    <span class="lts-filter-label"><i class="bi bi-diagram-3" style="color:var(--lts-accent)"></i> وضعیت گردش</span>
                    <div class="flex items-center gap-2">
                        <span class="lts-status-chip @(Model.IsWorkflowCompleted ? "completed" : "in-progress")">
                            <span class="dot"></span>@OfficeAutomation.Models.WorkflowStatus.Label(Model.WorkflowStatus)
                        </span>
                        @if (!Model.IsWorkflowCompleted)
                        {
                            <span class="text-[0.6875rem] text-slate-400">مرحله @Model.CurrentWorkflowStep از گردش</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 mt-5 pt-4" style="border-top:1px solid var(--lts-border-color);">
                <a asp-action="Index" class="lts-btn-primary" style="background:var(--lts-surface-raised);color:var(--lts-text-secondary);border:1px solid var(--lts-border-color);box-shadow:none;">
                    <i class="bi bi-x-lg"></i>
                    <span>انصراف</span>
                </a>
                <form asp-action="Delete" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="lts-btn-primary" style="background:var(--lts-danger);box-shadow:0 2px 8px rgba(239,68,68,0.25);">
                        <i class="bi bi-trash3-fill"></i>
                        <span>حذف نهایی نامه</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/letters-index.css" asp-append-version="true" />
}