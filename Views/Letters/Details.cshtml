@model OfficeAutomation.Models.Letter
@using OfficeAutomation.Utilities
@{
    ViewData["Title"] = $"نامه شماره {Model.Id}";
    var workflowDecisions = ViewBag.WorkflowDecisions as List<OfficeAutomation.Models.WorkflowDecision> ?? new List<OfficeAutomation.Models.WorkflowDecision>();
    var workflowDetail = ViewBag.WorkflowDetail as OfficeAutomation.Models.WorkflowDetailPanelVM;

    string receiverPrefix = ViewBag.Prefix ?? "جناب آقای / سرکار خانم";
    string senderName = Model.Sender?.FullName ?? "نامشخص";
    string senderJob = Model.Sender?.JobTitle ?? "سمت نامشخص";
    string? currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool canApprove = !Model.IsWorkflowCompleted && Model.ReceiverId == currentUserId;

    var pc = new System.Globalization.PersianCalendar();
    string shamsiDate = Model.SentDate != default
        ? $"{pc.GetYear(Model.SentDate)}/{pc.GetMonth(Model.SentDate):D2}/{pc.GetDayOfMonth(Model.SentDate):D2}"
        : "نامشخص";
    string shamsiDateTime = Model.SentDate != default
        ? $"{shamsiDate} {Model.SentDate:HH:mm}"
        : "نامشخص";

    var readDateText = Model.ReadDate.HasValue
        ? $"{pc.GetYear(Model.ReadDate.Value)}/{pc.GetMonth(Model.ReadDate.Value):D2}/{pc.GetDayOfMonth(Model.ReadDate.Value):D2} {Model.ReadDate.Value:HH:mm}"
        : "هنوز خوانده نشده";

    // Status badge classes
    string StatusBadgeCss(string status) => OfficeAutomation.Models.WorkflowStatus.Normalize(status) switch
    {
        "Approved" or "Completed" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-400 border-emerald-200/60 dark:border-emerald-800/50",
        "Rejected" => "bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-400 border-rose-200/60 dark:border-rose-800/50",
        "PendingApproval" or "PendingManager" or "NeedsRevision" or "Returned" => "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-400 border-amber-200/60 dark:border-amber-800/50",
        "Sent" => "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-400 border-indigo-200/60 dark:border-indigo-800/50",
        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800/60 dark:text-slate-400 border-slate-200/60 dark:border-slate-700/50"
    };

    var timeline = new[]
    {
        new { Title = "ایجاد شد", State = "created", Active = true, Description = $"نامه توسط {senderName} ثبت شد." },
        new { Title = "در مسیر", State = "routing", Active = Model.CurrentWorkflowStep > 0 || Model.IsWorkflowCompleted, Description = Model.IsWorkflowCompleted ? "فرآیند به پایان رسیده است." : $"مرحله فعلی: {Model.CurrentWorkflowStep}" },
        new { Title = "خوانده شد", State = "read", Active = Model.IsRead, Description = readDateText },
        new { Title = "تایید نهایی", State = "approved", Active = Model.IsWorkflowCompleted, Description = Model.IsWorkflowCompleted ? "Workflow تکمیل شده است." : "در انتظار اقدام مرحله بعد." }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/letters-details-style.css" asp-append-version="true" />
}

<div class="w-full flex-1 flex flex-col gap-4 p-2.5 md:p-4" dir="rtl">
    @Html.AntiForgeryToken()

    <!-- ═══ Page Header ═══ -->
    <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 border border-indigo-200/30 dark:border-indigo-800/30">
                <i class="bi bi-envelope-paper"></i>
            </div>
            <div>
                <h1 class="m-0 text-sm md:text-base font-black text-slate-900 dark:text-white tracking-tight">نامه شماره @Model.Id.ToString("0000")</h1>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1.5">
                    <span>@shamsiDateTime</span>
                    <span class="text-slate-300 dark:text-slate-600">•</span>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold border @StatusBadgeCss(Model.WorkflowStatus)">
                        @WorkflowStatus.Label(Model.WorkflowStatus)
                    </span>
                </p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="Create" asp-route-replyToId="@Model.Id" class="flex items-center gap-1.5 px-3.5 h-9 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-xl text-xs font-bold transition shadow-sm no-underline">
                <i class="bi bi-reply-fill"></i>
                <span class="hidden sm:inline">پاسخ به نامه</span>
            </a>
            <button type="button" onclick="window.print()" class="flex items-center gap-1.5 px-3.5 h-9 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-sm">
                <i class="bi bi-printer"></i>
                <span class="hidden sm:inline">چاپ</span>
            </button>
            <a asp-action="Index" class="flex items-center gap-1.5 px-3.5 h-9 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-bold transition shadow-sm no-underline">
                <i class="bi bi-arrow-right text-sm"></i>
                <span class="hidden sm:inline">بازگشت</span>
            </a>
        </div>
    </header>

    <!-- ═══ Body: Paper + Sidebar ═══ -->
    <div class="flex flex-col xl:flex-row gap-4 items-start">
        <!-- ═══ Letter Paper ═══ -->
        <main class="letter-paper w-full xl:flex-1 min-h-[600px] p-6 md:p-10 xl:p-12 flex flex-col gap-6 relative" style="font-family: IRANSans, Tahoma, sans-serif;">
            <!-- Header meta -->
            <header class="flex justify-between items-start gap-4 border-b border-slate-200/70 pb-4">
                <div class="letter-meta text-[11px] text-slate-500 flex flex-col gap-1 font-mono tabular-nums leading-relaxed">
                    <div><strong class="text-slate-700">شماره:</strong> @Model.Id.ToString("0000")</div>
                    <div><strong class="text-slate-700">تاریخ:</strong> @shamsiDate</div>
                    <div><strong class="text-slate-700">وضعیت:</strong> @WorkflowStatus.Label(Model.WorkflowStatus)</div>
                </div>
                <div class="text-center flex-1">
                    <h5 class="m-0 text-sm font-black text-slate-800">بسمه تعالی</h5>
                    <h4 class="text-[11px] font-bold text-slate-600 mt-1.5">پورتال سازمانی راینو</h4>
                </div>
                <img src="/images/logo.png" class="w-14 h-14 md:w-16 md:h-16 object-contain" alt="لوگو سازمان" onerror="this.style.display='none'">
            </header>

            <!-- Letter body -->
            <article class="flex-1 flex flex-col gap-5 text-right">
                <h5 class="letter-receiver text-[13px] font-black text-slate-800 m-0">@receiverPrefix @(Model.Receiver?.FullName ?? "....................")</h5>
                <h6 class="letter-title text-[13px] font-bold text-slate-700 m-0">موضوع: @Model.Title</h6>
                <div class="letter-body-content text-slate-800 mt-1">
                    @Html.Raw(HtmlSanitizer.Sanitize(Model.Body))
                </div>
            </article>

            <!-- Signature -->
            <footer class="flex justify-end border-t border-slate-100 pt-5 mt-4">
                <div class="letter-signature w-48 flex flex-col gap-1 text-center">
                    <p class="text-xs text-slate-600 m-0">با احترام</p>
                    <p class="text-xs font-black text-slate-900 m-0 mt-1">@senderName</p>
                    <p class="text-[10px] text-slate-400 m-0">@senderJob</p>
                    @if (!string.IsNullOrEmpty(Model.Sender?.SignaturePath))
                    {
                        <img src="@Model.Sender.SignaturePath" class="w-32 h-16 object-contain mx-auto mt-2" alt="امضای @senderName" />
                    }
                </div>
            </footer>
        </main>

        <!-- ═══ Sidebar ═══ -->
        <aside class="w-full xl:w-[340px] flex flex-col gap-4 print:hidden">
            <!-- Summary -->
            <section class="p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm flex flex-col gap-3">
                <h3 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-800 pb-2 flex items-center gap-1.5">
                    <i class="bi bi-info-circle"></i>
                    خلاصه وضعیت
                </h3>
                <div class="flex flex-col gap-2.5 text-xs text-slate-700 dark:text-slate-300 leading-relaxed">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-500 dark:text-slate-400">خوانده شده</span>
                        <span class="inline-flex items-center gap-1.5">
                            @if (Model.IsRead)
                            {
                                <i class="bi bi-check2-circle text-emerald-500"></i>
                                <span class="text-emerald-600 dark:text-emerald-400 font-bold">بله</span>
                            }
                            else
                            {
                                <i class="bi bi-circle text-slate-300 dark:text-slate-600"></i>
                                <span class="text-rose-500 dark:text-rose-400 font-bold">خیر</span>
                            }
                        </span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-500 dark:text-slate-400">مرحله گردش</span>
                        <span class="font-bold">@(Model.IsWorkflowCompleted ? "تکمیل شده" : $"مرحله {Model.CurrentWorkflowStep}")</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-500 dark:text-slate-400">گیرنده فعلی</span>
                        <span class="font-bold">@(Model.Receiver?.FullName ?? "نامشخص")</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-500 dark:text-slate-400">گیرنده نهایی</span>
                        <span class="font-bold">@(Model.FinalReceiver?.FullName ?? "نامشخص")</span>
                    </div>
                    @if (Model.ReadDate.HasValue)
                    {
                        <div class="flex justify-between items-center">
                            <span class="text-slate-500 dark:text-slate-400">زمان مطالعه</span>
                            <span class="font-bold font-mono text-[10px]">@readDateText</span>
                        </div>
                    }
                </div>
            </section>

            <!-- Timeline -->
            <section class="p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm flex flex-col gap-3">
                <h3 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-800 pb-2 flex items-center gap-1.5">
                    <i class="bi bi-arrow-repeat"></i>
                    گردش نامه
                </h3>
                <div class="flex flex-col gap-3.5">
                    @foreach (var step in timeline)
                    {
                        <div class="flex gap-3 items-start">
                            <div class="flex flex-col items-center self-stretch">
                                <div class="w-2.5 h-2.5 rounded-full mt-1 flex-shrink-0 @(step.Active ? "bg-teal-500 dark:bg-teal-400 ring-4 ring-teal-500/20" : "bg-slate-200 dark:bg-slate-700")"></div>
                                @if (step != timeline.Last())
                                {
                                    <div class="w-px flex-1 @(step.Active ? "bg-teal-200 dark:bg-teal-900/50" : "bg-slate-200 dark:bg-slate-800") my-0.5"></div>
                                }
                            </div>
                            <div class="flex-1 flex flex-col gap-0.5 text-xs">
                                <strong class="font-bold text-slate-800 dark:text-white">@step.Title</strong>
                                <p class="text-[10px] text-slate-500 dark:text-slate-400 leading-relaxed">@step.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- Decision History -->
            @if (workflowDecisions.Count > 0)
            {
                <section class="p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm flex flex-col gap-3">
                    <h3 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-800 pb-2 flex items-center gap-1.5">
                        <i class="bi bi-clock-history"></i>
                        تاریخچه تصمیم‌ها
                    </h3>
                    <div class="flex flex-col gap-3">
                        @foreach (var decision in workflowDecisions.Take(5))
                        {
                            <div class="flex gap-3 items-start">
                                <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0 @StatusBadgeCss(decision.Decision) ring-2 ring-slate-100 dark:ring-slate-800"></div>
                                <div class="flex-1 flex flex-col gap-1 text-xs min-w-0">
                                    <div class="flex items-center justify-between gap-2 flex-wrap">
                                        <strong class="font-bold text-slate-800 dark:text-white">@WorkflowStatus.Label(decision.Decision)</strong>
                                        <span class="text-[9px] text-slate-400 font-mono">@decision.DecidedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                    </div>
                                    <span class="text-[10px] text-slate-500 dark:text-slate-400">@((decision.DecidedByUser?.FullName) ?? decision.DecidedByUserId)</span>
                                    @if (!string.IsNullOrWhiteSpace(decision.Comment))
                                    {
                                        <p class="text-[10px] text-slate-600 dark:text-slate-300 leading-relaxed m-0 p-2 bg-slate-50 dark:bg-slate-950/50 rounded-lg border border-slate-100 dark:border-slate-800/80">@decision.Comment</p>
                                    }
                                </div>
                            </div>
                        }
                        @if (workflowDecisions.Count > 5)
                        {
                            <button type="button" onclick="document.getElementById('workflowDetailPanel')?.scrollIntoView({ behavior: 'smooth' })" class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 transition bg-transparent border-0 cursor-pointer">
                                مشاهده همه @workflowDecisions.Count تصمیم...
                            </button>
                        }
                    </div>
                </section>
            }

            <!-- AI Reply Panel -->
            <section class="p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm flex flex-col gap-4">
                <div class="flex items-center gap-2 text-teal-600 dark:text-teal-400">
                    <i class="bi bi-stars"></i>
                    <span class="text-xs font-bold">پاسخ با دستیار هوش مصنوعی</span>
                </div>
                <div class="flex flex-col gap-2.5">
                    <input id="aiReplyIntent" class="h-9 w-full rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:focus:border-teal-400 dark:focus:ring-teal-500/20" value="این نامه از نظر من تایید است" placeholder="نظر خود را بنویسید..." />
                    <button id="btnGenerateLetterReply" type="button" class="h-9 w-full flex items-center justify-center gap-1.5 px-4 rounded-xl bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white text-xs font-bold transition shadow-sm" data-letter-id="@Model.Id">
                        <i class="bi bi-magic"></i>
                        <span>تولید پاسخ</span>
                    </button>
                    <textarea id="aiLetterReplyResult" class="w-full rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 p-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:focus:border-teal-400 dark:focus:ring-teal-500/20" rows="3" placeholder="متن پیشنهادی هوش مصنوعی اینجا نمایش داده می‌شود."></textarea>
                </div>
                <div class="flex flex-col gap-2.5 border-t border-slate-100 dark:border-slate-800 pt-3">
                    <small class="text-[10px] text-slate-500 leading-normal">ارسال نهایی باید بعد از بازبینی کاربر انجام شود.</small>
                    @if (canApprove)
                    {
                        <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full flex items-center justify-center gap-1.5 px-4 h-9 bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 text-white rounded-xl text-xs font-bold transition shadow-sm">
                                <i class="bi bi-check2-circle"></i>
                                <span>تایید و ارجاع نامه</span>
                            </button>
                        </form>
                    }
                </div>
            </section>
        </aside>
    </div>

    <!-- ═══ Full Workflow Detail Panel ═══ -->
    @if (workflowDetail != null)
    {
        <div id="workflowDetailPanel" class="print:hidden">
            <partial name="_WorkflowDetailPanel" model="workflowDetail" />
        </div>
    }
</div>

@section Scripts {
    <script id="lettersUsersData" type="application/json">@Html.Raw(ViewBag.UsersData ?? "[]")</script>
    <script src="~/js/letters-details-script.js" asp-append-version="true"></script>
    <script src="~/js/letter-form.js"></script>
    <script src="~/js/letters-ai.js"></script>
}
