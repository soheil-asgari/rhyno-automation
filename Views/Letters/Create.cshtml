@model OfficeAutomation.Models.Letter
@{
    var isTabContent = Context.Request.Query.ContainsKey("_tab");
    Layout = isTabContent ? "_TabLayout" : "_Layout";
    ViewData["Title"] = "نگارش نامه اداری جدید";

    var pc = new System.Globalization.PersianCalendar();
    var now = DateTime.Now;
    string persianDate = $"{pc.GetYear(now)}/{pc.GetMonth(now):D2}/{pc.GetDayOfMonth(now):D2}";
    bool isReplyMode = ViewBag.IsReplyMode == true;
    string replySubject = (ViewBag.ReplyToSubject as string) ?? string.Empty;
    string replyReceiverId = (ViewBag.ReplyToReceiverId as string) ?? string.Empty;
}

<script src="~/lib/ckeditor/ckeditor.js" asp-append-version="true"></script>

<div class="letters-create-shell" dir="rtl">
    @Html.AntiForgeryToken()

    <!-- ═══════════ ۱. ENTERPRISE ACTION HEADER ═══════════ -->
    <header class="lts-create-header">
        <div class="flex items-center gap-3">
            <span class="lts-brand-mark"><i class="bi bi-pencil-square"></i></span>
            <div class="leading-tight">
                <h1 class="lts-create-title">نگارش نامه اداری جدید</h1>
                <p class="lts-create-subtitle mt-0.5 flex items-center gap-1.5">
                    <span id="draftStatus" class="lts-save-status saving" style="display:none;">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <span>پیش‌نویس خودکار ذخیره شد</span>
                    </span>
                    <span class="text-slate-300 dark:text-slate-600">•</span>
                    <span>۱۴۰۵/۰۸/۰۵</span>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <a asp-action="Index" class="lts-btn-ghost">
                <i class="bi bi-arrow-right"></i>
                <span>بازگشت</span>
            </a>
            <button class="lts-btn-secondary" id="btnPreviewLetter" type="button">
                <i class="bi bi-eye"></i>
                <span>پیش‌نمایش و چاپ</span>
            </button>
            <button class="lts-btn-secondary" id="btnSaveDraft" type="button">
                <i class="bi bi-save"></i>
                <span>ذخیره پیش‌نویس</span>
            </button>
            <button class="lts-btn-primary" id="btnSendLetter" type="button">
                <i class="bi bi-send-fill"></i>
                <span>ارسال نهایی / صدور نامه</span>
            </button>
        </div>
    </header>

    @if (isReplyMode)
    {
        <div class="flex items-center gap-2 px-3 py-2 rounded-lg border border-amber-200/70 dark:border-amber-900/40 bg-amber-50 dark:bg-amber-950/30 text-[11px] font-semibold text-amber-700 dark:text-amber-400">
            <i class="bi bi-reply-fill"></i>
            <span>حالت پاسخ به نامه فعال است — گیرنده به‌صورت خودکار تنظیم شده.</span>
        </div>
    }

    <!-- ═══════════ ۲. SPLIT CANVAS + INSPECTOR ═══════════ -->
    <div class="lts-compose-grid">

        <!-- ═══ MAIN AREA: OFFICIAL LETTER CANVAS (65%) ═══ -->
        <div class="lts-paper-panel">
            <div class="lts-letter-paper" id="paper">

                <!-- Letterhead -->
                <div class="lts-letter-head">
                    <div class="lts-letter-meta">
                        <span><i class="bi bi-calendar3"></i>تاریخ: <b id="letterDate">@persianDate</b></span>
                        <span><i class="bi bi-hash"></i>شماره: <b>پیش‌نویس</b></span>
                        <span><i class="bi bi-paperclip"></i>پیوست: <b>ندارد</b></span>
                    </div>
                    <div class="lts-letter-org">
                        <div class="lts-letter-bismillah">بسمه تعالی</div>
                        <div class="lts-letter-orgname">شرکت فنی مهندسی راینو</div>
                    </div>
                    <div class="lts-letter-logo">ر</div>
                </div>

                <!-- Addressing & subject (formal, no pills) -->
                <div class="lts-letter-address">
                    <div class="addr-row">
                        <b>به:</b>
                        <span id="gender-prefix" class="font-bold">جناب آقای / سرکار خانم</span>
                        <span id="display-receiver" class="lts-addr-dash">....................</span>
                    </div>
                    <div class="addr-row">
                        <b>از:</b>
                        <span class="font-bold">@ViewBag.SenderFullName</span>
                        <span class="text-[10px] text-slate-400">@ViewBag.SenderRole</span>
                    </div>
                    <div class="addr-row">
                        <b>موضوع:</b>
                        <span id="display-subject" class="lts-addr-dash">....................</span>
                    </div>
                </div>

                <!-- Editor workspace -->
                <div class="lts-letter-editor" id="editor-container">
                    <div id="editor" class="leading-relaxed font-normal text-sm text-slate-800 dark:text-slate-200">
                        <p>با سلام و احترام،</p>
                        <p>به استحضار می‌رساند...</p>
                    </div>
                </div>

                <!-- Sign-off footer -->
                <div class="lts-letter-sign">
                    <div class="lts-sign-block">
                        <p class="m-0 text-[11px] font-bold text-slate-500">با تقدیم احترام</p>
                        <p class="lts-sign-name mt-1 mb-0">@ViewBag.SenderFullName</p>
                        <p class="lts-sign-role m-0">@ViewBag.SenderRole</p>
                        @if (ViewBag.UserSignature != null)
                        {
                            <img src="@ViewBag.UserSignature" class="lts-sign-image" alt="امضا">
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ SIDEBAR: SETTINGS + AI (35%) ═══ -->
        <aside class="lts-inspector">

            <!-- کارت ۱: مشخصات نامه -->
            <div class="lts-inspector-card">
                <div class="lts-inspector-head" data-accordion-toggle>
                    <i class="bi bi-info-circle text-indigo-500"></i>
                    <h3>مشخصات نامه</h3>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div class="lts-inspector-body">
                    <div class="lts-field">
                        <label for="receiverSelect"><i class="bi bi-person-down"></i> گیرنده</label>
                        <select id="receiverSelect" class="lts-select" asp-items="ViewBag.ReceiverId">
                            <option value="">انتخاب گیرنده...</option>
                        </select>
                    </div>
                    <div class="lts-field">
                        <label for="subjectInput"><i class="bi bi-type"></i> موضوع نامه</label>
                        <input type="text" id="subjectInput" class="lts-input" value="@replySubject" placeholder="موضوع نامه اداری..." />
                    </div>

                    <div class="lts-field">
                        <label><i class="bi bi-bell"></i> نوع و اولویت نامه</label>
                        <div class="lts-picker" id="priorityPicker">
                            <button type="button" class="lts-picker-opt active" data-priority="Normal"><i class="bi bi-circle"></i> عادی</button>
                            <button type="button" class="lts-picker-opt" data-priority="Urgent"><i class="bi bi-exclamation-circle"></i> فوری</button>
                            <button type="button" class="lts-picker-opt" data-priority="Immediate"><i class="bi bi-lightning-charge"></i> آنی</button>
                        </div>
                    </div>

                    <div class="lts-field">
                        <label><i class="bi bi-shield-lock"></i> طبقه‌بندی محرمانگی</label>
                        <div class="lts-picker" id="classificationPicker">
                            <button type="button" class="lts-picker-opt active" data-classification="Normal"><i class="bi bi-unlock"></i> عادی</button>
                            <button type="button" class="lts-picker-opt" data-classification="Confidential"><i class="bi bi-lock"></i> محرمانه</button>
                            <button type="button" class="lts-picker-opt" data-classification="Secret"><i class="bi bi-lock-fill"></i> سری</button>
                        </div>
                    </div>

                    <div class="lts-field">
                        <label><i class="bi bi-paperclip"></i> پیوست‌ها</label>
                        <div class="lts-upload-zone" id="attachmentZone">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <p>فایل را اینجا رها کنید یا کلیک کنید</p>
                            <small>حداکثر ۵ مگابایت • PDF, DOCX, JPG, PNG</small>
                        </div>
                        <input type="file" id="attachmentInput" class="hidden" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                        <div class="lts-cc-list" id="attachmentList"></div>
                    </div>

                    <div class="lts-field">
                        <label><i class="bi bi-people"></i> رونوشت‌ها (CC)</label>
                        <div class="lts-cc-row">
                            <select id="ccSelect" class="lts-select" asp-items="ViewBag.ReceiverId">
                                <option value="">انتخاب واحد / فرد...</option>
                            </select>
                            <button type="button" class="lts-cc-add" id="ccAddBtn" title="افزودن رونوشت"><i class="bi bi-plus-lg"></i></button>
                        </div>
                        <div class="lts-cc-list" id="ccList"></div>
                    </div>
                </div>
            </div>

            <!-- کارت ۲: دستیار هوش مصنوعی -->
            <div class="lts-inspector-card lts-ai-card">
                <div class="lts-inspector-head" data-accordion-toggle>
                    <span class="lts-ai-spark"><i class="bi bi-stars"></i></span>
                    <h3>دستیار هوش مصنوعی</h3>
                    <span class="lts-ai-badge">AI</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div class="lts-inspector-body">
                    <div class="lts-field">
                        <label for="aiLetterInstruction"><i class="bi bi-chat-square-text"></i> راهنمای نگارش</label>
                        <textarea id="aiLetterInstruction" class="lts-textarea lts-ai-prompt" placeholder="مثلاً: نامه‌ای رسمی جهت درخواست مرخصی یا تأیید صورت‌وضعیت بنویس..."></textarea>
                    </div>
                    <div class="lts-ai-actions">
                        <button type="button" class="lts-ai-action active" data-ai-action="draft"><i class="bi bi-magic"></i> پیشنهاد متن رسمی</button>
                        <button type="button" class="lts-ai-action" data-ai-action="tone"><i class="bi bi-spellcheck"></i> بهبود لحن اداری</button>
                        <button type="button" class="lts-ai-action" data-ai-action="summary"><i class="bi bi-text-paragraph"></i> خلاصه‌سازی</button>
                    </div>
                    <div class="lts-field">
                        <label><i class="bi bi-file-earmark-text"></i> خروجی هوش مصنوعی</label>
                        <div class="lts-ai-output" id="aiLetterOutput">متن پیشنهادی پس از تولید در اینجا نمایش داده می‌شود.</div>
                    </div>
                    <button type="button" class="lts-ai-insert" id="btnInsertAiText" disabled>
                        <i class="bi bi-box-arrow-in-down"></i>
                        <span>درج مستقیم در نامه</span>
                    </button>
                    <div id="aiLetterStatus" class="text-[0.625rem] text-slate-400"></div>
                </div>
            </div>
        </aside>
    </div>
</div>

<!-- ═══════════ PREVIEW MODAL ═══════════ -->
<div id="letterPreviewModal" class="fixed inset-0 bg-slate-950/80 z-[2000] p-6 overflow-auto flex items-center justify-center hidden" aria-hidden="true">
    <div class="w-full max-w-[900px] bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-2xl flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
            <div>
                <h5 class="text-sm font-black text-slate-900 dark:text-white">پیش‌نمایش قبل از ارسال</h5>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">این نسخه همان چیزی است که گیرنده دریافت می‌کند.</p>
            </div>
            <button type="button" id="btnClosePreview" class="flex items-center justify-center px-2.5 py-1 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md text-[10px] font-bold transition">بستن</button>
        </div>
        <div id="letterPreviewBody" class="max-h-[60vh] overflow-y-auto border border-slate-100 dark:border-slate-800 rounded-xl p-4 bg-slate-50 dark:bg-slate-950/40"></div>
    </div>
</div>

<!-- Hidden preview-sync spans (JS compatibility) -->
<span id="previewReceiver" class="hidden"></span>
<span id="previewSubject" class="hidden"></span>
<span id="previewStatus" class="hidden"></span>

<!-- Hidden action form -->
<form id="finalForm" asp-action="Create" method="post" class="hidden">
    <input type="hidden" id="hTitle" name="Title">
    <input type="hidden" id="hContent" name="Body">
    <input type="hidden" id="hReceiver" name="ReceiverId">
    <input type="hidden" id="hReplyToLetterId" name="ReplyToLetterId" value="@(ViewBag.ReplyToLetterId)">
    @Html.AntiForgeryToken()
</form>

<script id="letterUsersData" type="application/json">@Html.Raw(ViewBag.UsersData ?? "[]")</script>
<script id="letterReplyConfig" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        isReplyMode = isReplyMode,
        replyToLetterId = ViewBag.ReplyToLetterId,
        defaultSubject = replySubject,
        defaultReceiverId = replyReceiverId
    }))</script>

@section Styles {
    <link rel="stylesheet" href="~/css/letters-index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/letters-create-script.js" asp-append-version="true"></script>
    <script src="~/js/letter.js" asp-append-version="true"></script>
    <script src="~/js/letters-ai.js" asp-append-version="true"></script>
}