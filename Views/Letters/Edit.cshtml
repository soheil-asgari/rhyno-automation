@model OfficeAutomation.Models.Letter
@{
    ViewData["Title"] = "ویرایش نامه";
}

<div class="w-full flex-1 flex flex-col gap-6 p-4 md:p-6" dir="rtl">
    <!-- Header Card -->
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <div>
            <h1 class="m-0 text-lg font-black text-slate-900 dark:text-white tracking-tight">ویرایش نامه</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">اطلاعات اصلی نامه را اصلاح و ذخیره کنید.</p>
        </div>
        <a asp-action="Index" class="flex items-center justify-center px-3 h-9 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm bg-transparent no-underline">
            <span>بازگشت</span>
        </a>
    </header>

    <!-- Form Card -->
    <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <form asp-action="Edit" method="post" class="flex flex-col gap-6">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 dark:bg-rose-955/10 text-rose-800 dark:text-rose-450 border border-rose-200 dark:border-rose-900/50 rounded-xl text-xs font-semibold leading-relaxed"></div>
            }
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Title -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label asp-for="Title" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="Title" class="h-9 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 font-bold" />
                    <span asp-validation-for="Title" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Sent Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="SentDate" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="SentDate" class="h-9 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-955 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 text-left font-mono tabular-nums" />
                    <span asp-validation-for="SentDate" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Read Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="ReadDate" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="ReadDate" class="h-9 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 text-left font-mono tabular-nums" />
                    <span asp-validation-for="ReadDate" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Sender -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="SenderId" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <select asp-for="SenderId" class="h-9 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" asp-items="ViewBag.SenderId"></select>
                    <span asp-validation-for="SenderId" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Receiver -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="ReceiverId" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <select asp-for="ReceiverId" class="h-9 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" asp-items="ViewBag.ReceiverId"></select>
                    <span asp-validation-for="ReceiverId" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Is Read -->
                <div class="flex items-center gap-2 h-9 mt-4">
                    <input asp-for="IsRead" type="checkbox" class="w-4 h-4 text-teal-600 border-slate-300 dark:border-slate-700 rounded focus:ring-teal-500 focus:ring-2 bg-transparent" />
                    <label asp-for="IsRead" class="text-xs font-bold text-slate-700 dark:text-slate-300 cursor-pointer"></label>
                </div>

                <!-- Body / Letter text area -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label asp-for="Body" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <textarea asp-for="Body" class="w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-905 p-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" rows="8"></textarea>
                    <span asp-validation-for="Body" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800 pt-4 mt-2">
                <a asp-action="Index" class="flex items-center justify-center px-4 h-9 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm no-underline">
                    <span>انصراف</span>
                </a>
                <button type="submit" class="flex items-center gap-1.5 px-5 h-9 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm">
                    <span>ذخیره تغییرات</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
