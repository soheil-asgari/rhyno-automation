@model OfficeAutomation.Models.Letter
@{
    ViewData["Title"] = "ویرایش نامه";
}

<div class="w-full flex-1 flex flex-col gap-4 p-2.5 md:p-4 letters-edit-shell" dir="rtl">
    <!-- ═══════ PAGE HEADER ═══════ -->
    <div class="lts-page-header">
        <div class="flex flex-wrap items-center gap-3 justify-between">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 flex items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500/20 to-violet-500/20 text-indigo-600 dark:text-indigo-400 text-xl" style="backdrop-filter:blur(4px);">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h1 style="margin:0;font-weight:700;color:var(--lts-text-primary);font-size:1.25rem;">ویرایش نامه</h1>
                    <p style="margin:0;font-size:0.75rem;color:var(--lts-text-muted)">اطلاعات اصلی نامه را اصلاح و ذخیره کنید.</p>
                </div>
            </div>
            <a asp-action="Index" class="lts-btn-primary" style="background:var(--lts-surface-raised);color:var(--lts-text-secondary);border:1px solid var(--lts-border-color);box-shadow:none;">
                <i class="bi bi-arrow-right"></i>
                <span>بازگشت</span>
            </a>
        </div>
    </div>

    <!-- ═══════ FORM CARD ═══════ -->
    <div class="rounded-2xl p-5 md:p-6" style="background:var(--lts-surface);border:1px solid var(--lts-border-color);box-shadow:var(--lts-shadow-sm);">
        <form asp-action="Edit" method="post" class="flex flex-col gap-5">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="rounded-xl p-3 flex items-start gap-2" style="background:var(--lts-danger-soft);color:var(--lts-danger);border:1px solid var(--lts-danger-soft);font-size:0.75rem;">
                    <i class="bi bi-exclamation-triangle-fill" style="margin-top:0.125rem;"></i>
                    <span style="flex:1;"></span>
                </div>
            }
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- Title -->
                <div class="flex flex-col gap-1.5" style="grid-column:span 2;">
                    <label asp-for="Title" class="lts-filter-label">
                        <i class="bi bi-type" style="color:var(--lts-accent)"></i>
                        <span>@Html.DisplayNameFor(m => m.Title)</span>
                    </label>
                    <input asp-for="Title" class="lts-filter-input" style="height:44px;" />
                    <span asp-validation-for="Title" class="text-[0.6875rem]" style="color:var(--lts-danger);"></span>
                </div>

                <!-- Sent Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="SentDate" class="lts-filter-label">
                        <i class="bi bi-calendar3" style="color:var(--lts-info)"></i>
                        <span>@Html.DisplayNameFor(m => m.SentDate)</span>
                    </label>
                    <input asp-for="SentDate" class="lts-filter-input" style="height:44px;font-family:var(--lts-font-mono);font-variant-numeric:tabular-nums;text-align:start;" />
                    <span asp-validation-for="SentDate" class="text-[0.6875rem]" style="color:var(--lts-danger);"></span>
                </div>

                <!-- Read Date -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="ReadDate" class="lts-filter-label">
                        <i class="bi bi-eye" style="color:var(--lts-success)"></i>
                        <span>@Html.DisplayNameFor(m => m.ReadDate)</span>
                    </label>
                    <input asp-for="ReadDate" class="lts-filter-input" style="height:44px;font-family:var(--lts-font-mono);text-align:start;" />
                    <span asp-validation-for="ReadDate" class="text-[0.6875rem]" style="color:var(--lts-danger);"></span>
                </div>

                <!-- Sender -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="SenderId" class="lts-filter-label">
                        <i class="bi bi-person-up" style="color:var(--lts-accent)"></i>
                        <span>@Html.DisplayNameFor(m => m.SenderId)</span>
                    </label>
                    <select asp-for="SenderId" class="lts-filter-select" style="height:44px;" asp-items="ViewBag.SenderId"></select>
                    <span asp-validation-for="SenderId" class="text-[0.6875rem]" style="color:var(--lts-danger);"></span>
                </div>

                <!-- Receiver -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="ReceiverId" class="lts-filter-label">
                        <i class="bi bi-person-down" style="color:var(--lts-success)"></i>
                        <span>@Html.DisplayNameFor(m => m.ReceiverId)</span>
                    </label>
                    <select asp-for="ReceiverId" class="lts-filter-select" style="height:44px;" asp-items="ViewBag.ReceiverId"></select>
                    <span asp-validation-for="ReceiverId" class="text-[0.6875rem]" style="color:var(--lts-danger);"></span>
                </div>

                <!-- Is Read -->
                <div class="flex items-center gap-2.5 h-11 px-3 rounded-xl" style="border:1px solid var(--lts-border-color);background:var(--lts-surface-raised);">
                    <input asp-for="IsRead" type="checkbox" style="width:17px;height:17px;border-radius:5px;accent-color:var(--lts-accent);" />
                    <label asp-for="IsRead" class="lts-filter-label m-0 cursor-pointer">
                        <span>خوانده شده</span>
                    </label>
                </div>

                <!-- Body -->
                <div class="flex flex-col gap-1.5" style="grid-column:span 2;">
                    <label asp-for="Body" class="lts-filter-label">
                        <i class="bi bi-file-earmark-text" style="color:var(--lts-accent)"></i>
                        <span>@Html.DisplayNameFor(m => m.Body)</span>
                    </label>
                    <textarea asp-for="Body" class="lts-filter-input" rows="8" style="height:auto;min-height:140px;padding:0.75rem;line-height:1.7;resize:vertical;"></textarea>
                    <span asp-validation-for="Body" class="text-[0.6875rem]" style="color:var(--lts-danger);"></span>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4" style="border-top:1px solid var(--lts-border-color);">
                <a asp-action="Index" class="lts-btn-primary" style="background:var(--lts-surface-raised);color:var(--lts-text-secondary);border:1px solid var(--lts-border-color);box-shadow:none;">
                    <i class="bi bi-x-lg"></i>
                    <span>انصراف</span>
                </a>
                <button type="submit" class="lts-btn-primary">
                    <i class="bi bi-check2-circle"></i>
                    <span>ذخیره تغییرات</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/letters-index.css" asp-append-version="true" />
}