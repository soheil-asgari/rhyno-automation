@model IEnumerable<OfficeAutomation.Models.Letter>
@{
    ViewData["Title"] = "کارتابل نامه‌ها";
    var pc = new System.Globalization.PersianCalendar();
    var list = Model?.ToList() ?? new List<OfficeAutomation.Models.Letter>();
    var currentUserId = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var unreadCount = list.Count(item => !item.IsRead && (item.ReceiverId == currentUserId || item.FinalReceiverId == currentUserId));
    var sentCount = list.Count(item => item.SenderId == currentUserId);
    var inboxCount = list.Count(item => (item.ReceiverId == currentUserId || item.FinalReceiverId == currentUserId));
}

<div class="w-full flex-1 flex flex-col gap-6 p-4 md:p-6" dir="rtl">
    @Html.AntiForgeryToken()

    <!-- Header Section -->
    <header class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-teal-50 dark:bg-teal-950/30 text-teal-600 dark:text-teal-400 text-lg border border-teal-200/30">
                <i class="bi bi-stack"></i>
            </div>
            <div>
                <h1 class="m-0 text-lg font-black text-slate-900 dark:text-white tracking-tight">کارتابل نامه‌ها</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">مدیریت و پیگیری هوشمند مکاتبات اداری</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <!-- Modern Search Box -->
            <div class="relative min-w-[240px]">
                <i class="bi bi-search absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="lettersSearch" type="text" placeholder="جستجوی شماره، عنوان یا فرستنده..." class="h-9 w-full rounded-lg border border-slate-200 bg-slate-50 dark:bg-slate-950 pr-8 pl-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
            </div>
            <!-- Create Letter Button -->
            <a asp-action="Create" class="flex items-center gap-1.5 px-4 h-9 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm no-underline">
                <i class="bi bi-plus-circle-fill"></i>
                <span>ایجاد نامه جدید</span>
            </a>
        </div>
    </header>

    <!-- Quick Filters Row -->
    <div class="flex flex-wrap gap-2 items-center">
        <button type="button" class="letter-filter-btn flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-lg text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition active" data-letter-filter="all">
            <i class="bi bi-folder2-open"></i> همه (@list.Count)
        </button>
        <button type="button" class="letter-filter-btn flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-lg text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition" data-letter-filter="unread">
            <i class="bi bi-envelope-open"></i> خوانده‌نشده (@unreadCount)
        </button>
        <button type="button" class="letter-filter-btn flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-lg text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition" data-letter-filter="sent">
            <i class="bi bi-send"></i> ارسالی (@sentCount)
        </button>
        <button type="button" class="letter-filter-btn flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-lg text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition" data-letter-filter="received">
            <i class="bi bi-inbox"></i> دریافتی (@inboxCount)
        </button>
        <button type="button" id="clearLetterFilters" class="mr-auto flex items-center gap-1.5 px-3 py-1.5 border border-rose-200 dark:border-rose-900/50 hover:bg-rose-50 dark:hover:bg-rose-950/20 text-rose-700 dark:text-rose-400 rounded-lg text-xs font-bold transition">
            <i class="bi bi-x-circle"></i> پاک کردن فیلترها
        </button>
    </div>

    <!-- Numeric Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <button type="button" class="letters-stat-card active flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm transition hover:-translate-y-0.5" data-letter-filter="all">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">کل نامه‌ها</span>
            <span class="text-2xl font-black text-slate-800 dark:text-white mt-1">@list.Count</span>
            <span class="text-[9px] text-slate-400 mt-0.5">نمایش همه مکاتبات</span>
        </button>
        <button type="button" class="letters-stat-card flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm transition hover:-translate-y-0.5" data-letter-filter="unread">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">خوانده‌نشده</span>
            <span class="text-2xl font-black text-amber-600 mt-1">@unreadCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">اقدام فوری مورد نیاز</span>
        </button>
        <button type="button" class="letters-stat-card flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm transition hover:-translate-y-0.5" data-letter-filter="sent">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">نامه‌های ارسالی</span>
            <span class="text-2xl font-black text-emerald-600 mt-1">@sentCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">مکاتبات صادر شده توسط من</span>
        </button>
        <button type="button" class="letters-stat-card flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm transition hover:-translate-y-0.5" data-letter-filter="received">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">نامه‌های دریافتی</span>
            <span class="text-2xl font-black text-sky-600 mt-1">@inboxCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">ارجاعات و نامه‌های وارده</span>
        </button>
    </div>

    <!-- Shortcut Controls -->
    <div class="flex flex-wrap gap-2 items-center">
        <button type="button" class="flex items-center gap-1.5 px-3 py-1 border border-slate-200 dark:border-slate-800 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition shadow-sm" data-open-palette>
            <i class="bi bi-command"></i> جستجوی سریع
        </button>
        <button type="button" class="flex items-center gap-1.5 px-3 py-1 border border-slate-200 dark:border-slate-800 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition shadow-sm" onclick="window.AppUI?.toast('میانبرها', 'Ctrl+K برای فرمان‌ها و دکمه نشانک برای ذخیره نامه.', 'primary')">
            <i class="bi bi-lightning"></i> راهنمای میانبر
        </button>
    </div>

    <!-- Saved Filters Panel -->
    @{ 
        ViewData["SavedFiltersTitle"] = "فیلترهای ذخیره‌شده"; 
        ViewData["SavedFiltersSubtitle"] = "فیلترها را ذخیره کن تا بعداً سریع برگردی."; 
        ViewData["SavedFiltersSaveButtonId"] = "lettersSaveFilter"; 
        ViewData["SavedFiltersClearButtonId"] = "lettersClearSaved"; 
        ViewData["SavedFiltersContainerId"] = "lettersSavedFilters"; 
    }
    <partial name="_SavedFiltersPanel" />

    <!-- Advanced Filters Panel -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <select id="letterSenderFilter" class="h-9 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800">
            <option value="">همه فرستنده‌ها</option>
            @foreach (var sender in list.Where(item => item.Sender != null).Select(item => item.Sender!.FullName).Distinct().OrderBy(item => item))
            {
                <option value="@sender">@sender</option>
            }
        </select>
        <select id="letterReceiverFilter" class="h-9 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800">
            <option value="">همه گیرنده‌ها</option>
            @foreach (var receiver in list.Where(item => item.Receiver != null).Select(item => item.Receiver!.FullName).Distinct().OrderBy(item => item))
            {
                <option value="@receiver">@receiver</option>
            }
        </select>
        <select id="letterStatusFilter" class="h-9 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800">
            <option value="">همه وضعیت‌ها</option>
            @foreach (var status in list.Select(item => item.WorkflowStatus).Distinct().OrderBy(item => item))
            {
                <option value="@status">@OfficeAutomation.Models.WorkflowStatus.Label(status)</option>
            }
        </select>
        <input id="letterDateFrom" type="date" class="h-9 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
        <input id="letterDateTo" type="date" class="h-9 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" />
    </div>

    <!-- AI Smart Summary Block -->
    <div class="flex flex-col gap-4 p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <div class="flex items-center gap-2">
            <i class="bi bi-stars text-teal-600 dark:text-teal-400"></i>
            <div>
                <h5 class="m-0 text-sm font-bold text-slate-900 dark:text-white">خلاصه هوشمند نامه‌ها</h5>
                <p class="m-0 text-[11px] text-slate-500 dark:text-slate-400">خلاصه نامه‌های دریافتی، خوانده‌نشده، ارسالی یا گردش یک نامه مشخص را با هوش مصنوعی ببینید.</p>
            </div>
        </div>
        <div class="flex flex-col md:flex-row gap-3">
            <select id="letterSummaryMode" class="h-9 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 md:w-64">
                <option value="week">خلاصه نامه‌های دریافتی هفته اخیر</option>
                <option value="unread">خلاصه نامه‌های خوانده‌نشده</option>
                <option value="sent">خلاصه نامه‌های ارسالی من</option>
                <option value="selected">خلاصه و گردش نامه انتخاب‌شده</option>
            </select>
            <select id="letterSummaryId" class="h-9 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 flex-1">
                <option value="">انتخاب موضوع نامه...</option>
                @foreach (var item in list.OrderByDescending(item => item.SentDate))
                {
                    <option value="@item.Id">@item.Title</option>
                }
            </select>
            <button id="btnSummarizeLetters" type="button" class="h-9 flex items-center justify-center gap-1.5 px-4 rounded-lg bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white text-xs font-bold transition shadow-sm">
                <i class="bi bi-card-text"></i>
                <span>نمایش خلاصه</span>
            </button>
        </div>
        <div id="letterSummaryResult" class="p-4 rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-xs text-slate-700 dark:text-slate-300 leading-7 min-h-[50px] whitespace-pre-wrap">
            یک گزینه را انتخاب کنید و دکمه نمایش خلاصه را بزنید.
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-xs text-right border-collapse text-slate-700 dark:text-slate-300" id="lettersTable">
                <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="px-3 py-2.5 font-bold">موضوع نامه</th>
                        <th class="px-3 py-2.5 font-bold">فرستنده</th>
                        <th class="px-3 py-2.5 font-bold">گیرنده</th>
                        <th class="px-3 py-2.5 font-bold text-center">تاریخ ارسال</th>
                        <th class="px-3 py-2.5 font-bold text-center">وضعیت گردش</th>
                        <th class="px-3 py-2.5 font-bold text-center">وضعیت</th>
                        <th class="px-3 py-2.5 font-bold text-center w-1">عملیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60" id="lettersBody">
                    @foreach (var item in list)
                    {
                        var shamsiDate = $"{pc.GetYear(item.SentDate)}/{pc.GetMonth(item.SentDate):D2}/{pc.GetDayOfMonth(item.SentDate):D2}";
                        var isUnread = !item.IsRead && (item.ReceiverId == currentUserId || item.FinalReceiverId == currentUserId);
                        var isSentByCurrentUser = item.SenderId == currentUserId;
                        var isReceivedByCurrentUser = item.ReceiverId == currentUserId || item.FinalReceiverId == currentUserId;

                        <tr class="letter-row-card hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors" 
                            data-letter-id="@item.Id" 
                            data-unread="@(isUnread ? "1" : "0")" 
                            data-sent="@(isSentByCurrentUser ? "1" : "0")" 
                            data-received="@(isReceivedByCurrentUser ? "1" : "0")" 
                            data-sent-at="@item.SentDate.ToString("o")" 
                            data-sender="@item.Sender?.FullName" 
                            data-receiver="@item.Receiver?.FullName" 
                            data-status="@item.WorkflowStatus">
                            
                            <!-- Title / Subject -->
                            <td class="px-3 py-3 font-medium text-slate-900 dark:text-white min-w-[220px]">
                                <a href="@Url.Action("Details", new { id = item.Id })" class="hover:text-teal-600 dark:hover:text-teal-400 font-bold transition no-underline">
                                    @item.Title
                                </a>
                            </td>
                            
                            <!-- Sender -->
                            <td class="px-3 py-3 font-medium text-slate-800 dark:text-slate-200">@item.Sender?.FullName</td>
                            
                            <!-- Receiver -->
                            <td class="px-3 py-3 text-slate-600 dark:text-slate-400">@item.Receiver?.FullName</td>
                            
                            <!-- Sent Date -->
                            <td class="px-3 py-3 text-center font-mono text-slate-500">@shamsiDate</td>
                            
                            <!-- Workflow Step -->
                            <td class="px-3 py-3 text-center">
                                @if (item.IsWorkflowCompleted)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border border-emerald-200/40 dark:border-emerald-800/30">تایید نهایی</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border border-amber-200/40 dark:border-amber-800/30">در گردش - مرحله @item.CurrentWorkflowStep</span>
                                }
                            </td>
                            
                            <!-- Read Status -->
                            <td class="px-3 py-3 text-center">
                                @if (isUnread)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400 border border-rose-200/40 dark:border-rose-800/30">خوانده‌نشده</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 dark:bg-slate-800/40 dark:text-slate-400 border border-slate-200/40 dark:border-slate-700/30">خوانده‌شده</span>
                                }
                            </td>
                            
                            <!-- Minimal Actions -->
                            <td class="px-3 py-3 text-center w-1">
                                <div class="flex items-center justify-center gap-1.5">
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition" title="مشاهده">
                                        <i class="bi bi-eye text-sm"></i>
                                    </a>
                                    <button type="button" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition pin-letter" data-letter-id="@item.Id" title="ذخیره در علاقه‌مندی">
                                        <i class="bi bi-bookmark-plus text-sm"></i>
                                    </button>
                                    @if (!item.IsWorkflowCompleted && item.ReceiverId == currentUserId)
                                    {
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-1 text-slate-500 hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400 transition" title="تایید و ارجاع مرحله بعد">
                                                <i class="bi bi-check2-circle text-sm"></i>
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition print" title="چاپ">
                                        <i class="bi bi-printer text-sm"></i>
                                    </button>
                                    <a href="@Url.Action("Create", new { replyToId = item.Id })" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition" title="پاسخ">
                                        <i class="bi bi-reply-fill text-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <!-- Overriding active filters and stats styles to match Tailwind design -->
    <style>
        .letter-filter-btn.active {
            background-color: var(--primary) !important;
            color: #ffffff !important;
            border-color: var(--primary) !important;
        }
        .dark .letter-filter-btn.active {
            background-color: var(--primary) !important;
            color: #0f172a !important;
            border-color: var(--primary) !important;
        }

        .letters-stat-card.active {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 20%, transparent), 0 10px 15px -3px rgba(0, 0, 0, 0.1) !important;
        }
        .dark .letters-stat-card.active {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 20%, transparent), 0 10px 15px -3px rgba(0, 0, 0, 0.1) !important;
        }

        #lettersTable th, #lettersTable td {
            border-bottom: 1px solid var(--letters-tbl-border, #f1f5f9) !important;
        }
        #lettersTable {
            --letters-tbl-border: #f1f5f9;
        }
        .dark #lettersTable {
            --letters-tbl-border: #334155;
        }
    </style>
}

@section Scripts {
    <script src="~/js/letters-index.js"></script>
    <script src="~/js/letters-ai.js"></script>
    <script>
        (() => {
            const preferenceEndpoint = "/table-preferences/letters.filters";
            const storageKey = "rhyno.letters.filters";
            const antiForgeryToken = document.querySelector('meta[name="request-verification-token"]')?.content || "";
            const savedContainer = document.getElementById("lettersSavedFilters");
            const saveButton = document.getElementById("lettersSaveFilter");
            const clearButton = document.getElementById("lettersClearSaved");
            const searchInput = document.getElementById("lettersSearch");
            const senderFilter = document.getElementById("letterSenderFilter");
            const receiverFilter = document.getElementById("letterReceiverFilter");
            const statusFilter = document.getElementById("letterStatusFilter");
            const dateFrom = document.getElementById("letterDateFrom");
            const dateTo = document.getElementById("letterDateTo");

            const readJson = (key, fallback) => {
                try { return JSON.parse(localStorage.getItem(key) || "null") || fallback; } catch { return fallback; }
            };
            const writeJson = (key, value) => localStorage.setItem(key, JSON.stringify(value));
            const currentFilter = () => ({
                search: searchInput?.value || "",
                sender: senderFilter?.value || "",
                receiver: receiverFilter?.value || "",
                status: statusFilter?.value || "",
                from: dateFrom?.value || "",
                to: dateTo?.value || ""
            });
            const loadSaved = async () => {
                try {
                    const res = await fetch(preferenceEndpoint, { credentials: "same-origin" });
                    const items = res.ok ? await res.json() : [];
                    const list = Array.isArray(items) ? items : [];
                    if (list.length) writeJson(storageKey, list);
                    return list.length ? list : readJson(storageKey, []);
                } catch { return readJson(storageKey, []); }
            };
            const saveSaved = async (items) => {
                writeJson(storageKey, items);
                try {
                    await fetch(preferenceEndpoint, {
                        method: "POST",
                        credentials: "same-origin",
                        headers: {
                            "Content-Type": "application/json",
                            ...(antiForgeryToken ? { RequestVerificationToken: antiForgeryToken } : {})
                        },
                        body: JSON.stringify(items)
                    });
                } catch { }
            };
            const renderSaved = () => {
                const items = readJson(storageKey, []);
                if (!savedContainer) return;
                savedContainer.innerHTML = "";
                if (!items.length) {
                    savedContainer.innerHTML = '<span class="text-muted small">هنوز فیلتر ذخیره نشده است.</span>';
                    return;
                }
                items.slice(0, 8).forEach(item => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "btn btn-sm btn-outline-secondary rounded-pill";
                    btn.textContent = item.name;
                    btn.addEventListener("click", () => {
                        if (searchInput) searchInput.value = item.search || "";
                        if (senderFilter) senderFilter.value = item.sender || "";
                        if (receiverFilter) receiverFilter.value = item.receiver || "";
                        if (statusFilter) statusFilter.value = item.status || "";
                        if (dateFrom) dateFrom.value = item.from || "";
                        if (dateTo) dateTo.value = item.to || "";
                        searchInput?.dispatchEvent(new Event("input", { bubbles: true }));
                    });
                    savedContainer.appendChild(btn);
                });
            };
            saveButton?.addEventListener("click", () => {
                const name = prompt("نام فیلتر را وارد کن:", "فیلتر ذخیره‌شده");
                if (!name) return;
                const items = readJson(storageKey, []);
                items.unshift({ name, ...currentFilter() });
                saveSaved(items.slice(0, 10)).finally(renderSaved);
            });
            clearButton?.addEventListener("click", () => {
                localStorage.removeItem(storageKey);
                renderSaved();
            });
            loadSaved().finally(renderSaved);
        })();
    </script>
}
