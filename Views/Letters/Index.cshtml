@model IEnumerable<OfficeAutomation.Models.Letter>
@{
    ViewData["Title"] = "کارتابل نامه‌ها";
    var pc = new System.Globalization.PersianCalendar();
    var list = Model?.ToList() ?? new List<OfficeAutomation.Models.Letter>();
    var currentUserId = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var unreadCount = list.Count(item => !item.IsRead && (item.ReceiverId == currentUserId || item.FinalReceiverId == currentUserId));
    var sentCount = list.Count(item => item.SenderId == currentUserId);
    var inboxCount = list.Count(item => (item.ReceiverId == currentUserId || item.FinalReceiverId == currentUserId));
}

<div class="w-full flex-1 flex flex-col gap-5 p-3 md:p-4" dir="rtl">
    @Html.AntiForgeryToken()

    <!-- Header Card -->
    <header class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-11 h-11 flex items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-950/30 text-indigo-600 dark:text-indigo-400 text-lg border border-indigo-200/30 dark:border-indigo-800/30">
                <i class="bi bi-stack"></i>
            </div>
            <div>
                <h1 class="m-0 text-lg font-black text-slate-900 dark:text-white tracking-tight">کارتابل نامه‌ها</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">مدیریت و پیگیری هوشمند مکاتبات اداری</p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <div class="relative min-w-[240px]">
                <i class="bi bi-search absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="lettersSearch" type="text" placeholder="جستجوی شماره، عنوان یا فرستنده..." class="h-9 w-full rounded-xl border border-slate-200/80 bg-slate-50/60 pr-10 pl-3 text-xs text-slate-800 outline-none transition-all placeholder:text-slate-400 focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:placeholder:text-slate-500 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20" />
            </div>
            <a asp-action="Create" class="flex items-center gap-1.5 px-4 h-9 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition shadow-sm shadow-indigo-500/20 no-underline">
                <i class="bi bi-plus-circle-fill"></i>
                <span>ایجاد نامه جدید</span>
            </a>
        </div>
    </header>

    <!-- Quick Filters Row -->
    <div class="flex flex-wrap gap-2 items-center">
        <button type="button" class="letter-filter-btn flex items-center gap-1.5 px-3.5 py-2 border border-slate-200/80 dark:border-slate-700/60 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition-all hover:border-indigo-200 hover:bg-indigo-50/50 dark:hover:border-indigo-500/20 dark:hover:bg-indigo-500/5 active" data-letter-filter="all">
            <i class="bi bi-folder2-open"></i> همه (@list.Count)
        </button>
        <button type="button" class="letter-filter-btn flex items-center gap-1.5 px-3.5 py-2 border border-slate-200/80 dark:border-slate-700/60 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition-all hover:border-indigo-200 hover:bg-indigo-50/50 dark:hover:border-indigo-500/20 dark:hover:bg-indigo-500/5" data-letter-filter="unread">
            <i class="bi bi-envelope-open"></i> خوانده‌نشده (@unreadCount)
        </button>
        <button type="button" class="letter-filter-btn flex items-center gap-1.5 px-3.5 py-2 border border-slate-200/80 dark:border-slate-700/60 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition-all hover:border-indigo-200 hover:bg-indigo-50/50 dark:hover:border-indigo-500/20 dark:hover:bg-indigo-500/5" data-letter-filter="sent">
            <i class="bi bi-send"></i> ارسالی (@sentCount)
        </button>
        <button type="button" class="letter-filter-btn flex items-center gap-1.5 px-3.5 py-2 border border-slate-200/80 dark:border-slate-700/60 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition-all hover:border-indigo-200 hover:bg-indigo-50/50 dark:hover:border-indigo-500/20 dark:hover:bg-indigo-500/5" data-letter-filter="received">
            <i class="bi bi-inbox"></i> دریافتی (@inboxCount)
        </button>
        <button type="button" id="clearLetterFilters" class="mr-auto flex items-center gap-1.5 px-3.5 py-2 border border-rose-200/60 dark:border-rose-800/40 hover:bg-rose-50 dark:hover:bg-rose-950/20 text-rose-600 dark:text-rose-400 rounded-xl text-xs font-bold transition">
            <i class="bi bi-x-circle"></i> پاک کردن فیلترها
        </button>
    </div>

    <!-- Numeric Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <button type="button" class="letters-stat-card active flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" data-letter-filter="all">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">کل نامه‌ها</span>
            <span class="text-2xl font-black text-slate-800 dark:text-white mt-1">@list.Count</span>
            <span class="text-[9px] text-slate-400 mt-0.5">نمایش همه مکاتبات</span>
        </button>
        <button type="button" class="letters-stat-card flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" data-letter-filter="unread">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">خوانده‌نشده</span>
            <span class="text-2xl font-black text-amber-600 mt-1">@unreadCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">اقدام فوری مورد نیاز</span>
        </button>
        <button type="button" class="letters-stat-card flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" data-letter-filter="sent">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">نامه‌های ارسالی</span>
            <span class="text-2xl font-black text-emerald-600 mt-1">@sentCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">مکاتبات صادر شده توسط من</span>
        </button>
        <button type="button" class="letters-stat-card flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" data-letter-filter="received">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">نامه‌های دریافتی</span>
            <span class="text-2xl font-black text-sky-600 mt-1">@inboxCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5">ارجاعات و نامه‌های وارده</span>
        </button>
    </div>

    <!-- Shortcut Controls -->
    <div class="flex flex-wrap gap-2 items-center">
        <button type="button" class="flex items-center gap-1.5 px-3.5 py-2 border border-slate-200/80 dark:border-slate-700/60 rounded-xl text-xs font-semibold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800 shadow-sm" data-open-palette>
            <i class="bi bi-command"></i> جستجوی سریع
        </button>
        <button type="button" id="btnOpenShortcutsDrawer" data-open-shortcuts class="flex items-center gap-1.5 px-3.5 py-2 border border-slate-200/80 dark:border-slate-700/60 rounded-xl text-xs font-semibold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800 shadow-sm">
            <i class="bi bi-lightning"></i> راهنمای میانبر
        </button>
    </div>

    <!-- Saved Filters Panel -->
    @{ 
        ViewData["SavedFiltersTitle"] = "فیلترهای ذخیره‌شده"; 
        ViewData["SavedFiltersSubtitle"] = "فیلترها را ذخیره کن تا بعداً سریع برگردی."; 
        ViewData["SavedFiltersSaveButtonId"] = "lettersSaveFilter"; 
        ViewData["SavedFiltersClearButtonId"] = "lettersClearSaved"; 
        ViewData["SavedFiltersContainerId"] = "lettersSavedFilters"; 
    }
    <partial name="_SavedFiltersPanel" />

    <!-- Advanced Filters Panel -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 p-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
        <select id="letterSenderFilter" class="h-9 rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20">
            <option value="">همه فرستنده‌ها</option>
            @foreach (var sender in list.Where(item => item.Sender != null).Select(item => item.Sender!.FullName).Distinct().OrderBy(item => item))
            {
                <option value="@sender">@sender</option>
            }
        </select>
        <select id="letterReceiverFilter" class="h-9 rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20">
            <option value="">همه گیرنده‌ها</option>
            @foreach (var receiver in list.Where(item => item.Receiver != null).Select(item => item.Receiver!.FullName).Distinct().OrderBy(item => item))
            {
                <option value="@receiver">@receiver</option>
            }
        </select>
        <select id="letterStatusFilter" class="h-9 rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20">
            <option value="">همه وضعیت‌ها</option>
            @foreach (var status in list.Select(item => item.WorkflowStatus).Distinct().OrderBy(item => item))
            {
                <option value="@status">@OfficeAutomation.Models.WorkflowStatus.Label(status)</option>
            }
        </select>
        <input id="letterDateFrom" type="date" class="h-9 rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20" />
        <input id="letterDateTo" type="date" class="h-9 rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20" />
    </div>

    <!-- AI Smart Summary Block -->
    <div class="flex flex-col gap-4 p-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
        <div class="flex items-center gap-2">
            <i class="bi bi-stars text-indigo-600 dark:text-indigo-400"></i>
            <div>
                <h5 class="m-0 text-sm font-bold text-slate-900 dark:text-white">خلاصه هوشمند نامه‌ها</h5>
                <p class="m-0 text-[11px] text-slate-500 dark:text-slate-400">خلاصه نامه‌های دریافتی، خوانده‌نشده، ارسالی یا گردش یک نامه مشخص را با هوش مصنوعی ببینید.</p>
            </div>
        </div>
        <div class="flex flex-col md:flex-row gap-3">
            <select id="letterSummaryMode" class="h-9 rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20 md:w-64">
                <option value="week">خلاصه نامه‌های دریافتی هفته اخیر</option>
                <option value="unread">خلاصه نامه‌های خوانده‌نشده</option>
                <option value="sent">خلاصه نامه‌های ارسالی من</option>
                <option value="selected">خلاصه و گردش نامه انتخاب‌شده</option>
            </select>
            <select id="letterSummaryId" class="h-9 rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20 flex-1">
                <option value="">انتخاب موضوع نامه...</option>
                @foreach (var item in list.OrderByDescending(item => item.SentDate))
                {
                    <option value="@item.Id">@item.Title</option>
                }
            </select>
            <button id="btnSummarizeLetters" type="button" class="h-9 flex items-center justify-center gap-1.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition shadow-sm shadow-indigo-500/20">
                <i class="bi bi-card-text"></i>
                <span>نمایش خلاصه</span>
            </button>
        </div>
        <div id="letterSummaryResult" class="p-4 rounded-xl border border-slate-100/80 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-950 text-xs text-slate-700 dark:text-slate-300 leading-7 min-h-[50px] whitespace-pre-wrap">
            یک گزینه را انتخاب کنید و دکمه نمایش خلاصه را بزنید.
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-xs text-right border-collapse text-slate-700 dark:text-slate-300" id="lettersTable">
                <thead class="sticky top-0 z-10 bg-slate-50/80 dark:bg-slate-800/60 backdrop-blur-sm border-b border-slate-100 dark:border-slate-800/60">
                    <tr>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">موضوع نامه</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">فرستنده</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">گیرنده</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center">تاریخ ارسال</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center">وضعیت گردش</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center">وضعیت</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center w-1">عملیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60" id="lettersBody">
                    @foreach (var item in list)
                    {
                        var shamsiDate = $"{pc.GetYear(item.SentDate)}/{pc.GetMonth(item.SentDate):D2}/{pc.GetDayOfMonth(item.SentDate):D2}";
                        var isUnread = !item.IsRead && (item.ReceiverId == currentUserId || item.FinalReceiverId == currentUserId);
                        var isSentByCurrentUser = item.SenderId == currentUserId;
                        var isReceivedByCurrentUser = item.ReceiverId == currentUserId || item.FinalReceiverId == currentUserId;

                        <tr class="letter-row-card hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors" 
                            data-letter-id="@item.Id" 
                            data-unread="@(isUnread ? "1" : "0")" 
                            data-sent="@(isSentByCurrentUser ? "1" : "0")" 
                            data-received="@(isReceivedByCurrentUser ? "1" : "0")" 
                            data-sent-at="@item.SentDate.ToString("o")" 
                            data-sender="@item.Sender?.FullName" 
                            data-receiver="@item.Receiver?.FullName" 
                            data-status="@item.WorkflowStatus">
                            
                            <!-- Title / Subject -->
                            <td class="px-4 py-3.5 font-medium text-slate-900 dark:text-white min-w-[220px]">
                                <a href="@Url.Action("Details", new { id = item.Id })" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-bold transition no-underline">
                                    @item.Title
                                </a>
                            </td>
                            
                            <!-- Sender -->
                            <td class="px-4 py-3.5 font-medium text-slate-800 dark:text-slate-200">@item.Sender?.FullName</td>
                            
                            <!-- Receiver -->
                            <td class="px-4 py-3.5 text-slate-600 dark:text-slate-400">@item.Receiver?.FullName</td>
                            
                            <!-- Sent Date -->
                            <td class="px-4 py-3.5 text-center font-mono text-slate-500">@shamsiDate</td>
                            
                            <!-- Workflow Step -->
                            <td class="px-4 py-3.5 text-center">
                                @if (item.IsWorkflowCompleted)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/60 dark:bg-emerald-950/40 dark:text-emerald-400 dark:border-emerald-800/40">
                                        <span class="status-dot status-dot-pulse bg-emerald-500"></span>تایید نهایی
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-medium bg-amber-50 text-amber-700 border border-amber-200/60 dark:bg-amber-950/40 dark:text-amber-400 dark:border-amber-800/40">
                                        <span class="status-dot status-dot-pulse bg-amber-500"></span>در گردش - مرحله @item.CurrentWorkflowStep
                                    </span>
                                }
                            </td>
                            
                            <!-- Read Status -->
                            <td class="px-4 py-3.5 text-center">
                                @if (isUnread)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-medium bg-rose-50 text-rose-700 border border-rose-200/60 dark:bg-rose-950/40 dark:text-rose-400 dark:border-rose-800/40">
                                        <span class="status-dot status-dot-pulse bg-rose-500"></span>خوانده‌نشده
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-medium bg-slate-100 text-slate-600 border border-slate-200/60 dark:bg-slate-800/40 dark:text-slate-400 dark:border-slate-700/40">
                                        <span class="status-dot bg-slate-400"></span>خوانده‌شده
                                    </span>
                                }
                            </td>
                            
                            <!-- Minimal Actions -->
                            <td class="px-4 py-3.5 text-center w-1">
                                <div class="flex items-center justify-center gap-1">
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="p-1.5 text-slate-400 hover:text-indigo-600 dark:text-slate-500 dark:hover:text-indigo-400 transition-colors" title="مشاهده">
                                        <i class="bi bi-eye text-sm"></i>
                                    </a>
                                    <button type="button" class="p-1.5 text-slate-400 hover:text-indigo-600 dark:text-slate-500 dark:hover:text-indigo-400 transition-colors pin-letter" data-letter-id="@item.Id" title="ذخیره در علاقه‌مندی">
                                        <i class="bi bi-bookmark-plus text-sm"></i>
                                    </button>
                                    @if (!item.IsWorkflowCompleted && item.ReceiverId == currentUserId)
                                    {
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-1.5 text-slate-400 hover:text-emerald-600 dark:text-slate-500 dark:hover:text-emerald-400 transition-colors" title="تایید و ارجاع مرحله بعد">
                                                <i class="bi bi-check2-circle text-sm"></i>
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="p-1.5 text-slate-400 hover:text-indigo-600 dark:text-slate-500 dark:hover:text-indigo-400 transition-colors print" title="چاپ">
                                        <i class="bi bi-printer text-sm"></i>
                                    </button>
                                    <a href="@Url.Action("Create", new { replyToId = item.Id })" class="p-1.5 text-slate-400 hover:text-indigo-600 dark:text-slate-500 dark:hover:text-indigo-400 transition-colors" title="پاسخ">
                                        <i class="bi bi-reply-fill text-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/letters-index-style.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/letters-index.js"></script>
    <script src="~/js/letters-ai.js"></script>
    <script src="~/js/letters-index-script.js" asp-append-version="true"></script>
}