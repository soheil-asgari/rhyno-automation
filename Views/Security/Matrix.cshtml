@model SecurityMatrixVM
@{
    ViewData["Title"] = "ماتریس دسترسی";
    var permissionMap = ViewBag.PermissionMap as Dictionary<string, bool> ?? new();
}

<div class="flex flex-col gap-4 w-full" data-toggle-url="@Url.Action("TogglePermission", "Security")">
    @Html.AntiForgeryToken()

    <!-- Page Header -->
    <div class="flex items-center justify-between gap-3 px-1">
        <div>
            <h1 class="text-base font-black text-slate-900 dark:text-white tracking-tight">ماتریس دسترسی نقش‌ها</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">فعال یا غیرفعال‌سازی دسترسی‌های هر نقش به صورت تعاملی</p>
        </div>
        <a asp-action="Index" class="flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition no-underline">
            <i class="bi bi-arrow-right"></i>
            <span>بازگشت</span>
        </a>
    </div>

    <!-- Toast notification -->
    <div id="permissionToast"
         class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 hidden px-4 py-2.5 rounded-xl border shadow-lg text-xs font-bold transition-all duration-200"
         aria-live="polite">
    </div>

    <!-- Matrix Card -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800">
            <h2 class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-2">
                <i class="bi bi-grid-3x3-gap text-teal-600 dark:text-teal-400"></i>
                جدول دسترسی‌ها
            </h2>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-xs text-right">
                <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800/70 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="px-4 py-3 text-right font-bold text-slate-600 dark:text-slate-400 min-w-[140px]">نقش / دسترسی</th>
                        @foreach (var feature in Model.Features)
                        {
                            <th class="px-2 py-3 text-center font-bold text-slate-600 dark:text-slate-400 min-w-[90px]" title="@feature.Title">
                                <span class="block truncate max-w-[80px] mx-auto">@feature.Title</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @{int rowIdx = 0;}
                    @foreach (var role in Model.Roles)
                    {
                        <tr class="@(rowIdx++ % 2 == 0 ? "" : "bg-slate-50/40 dark:bg-slate-950/20") hover:bg-teal-50/20 dark:hover:bg-teal-950/10 transition-colors">
                            <td class="px-4 py-2.5">
                                <span class="flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-full bg-teal-100 dark:bg-teal-900/40 text-teal-700 dark:text-teal-300 flex items-center justify-center text-[10px] font-black flex-shrink-0">
                                        @(role.Name?.Length > 0 ? role.Name[0].ToString().ToUpper() : "?")
                                    </span>
                                    <strong class="font-bold text-slate-800 dark:text-white">@role.Name</strong>
                                </span>
                            </td>
                            @foreach (var feature in Model.Features)
                            {
                                var key = $"{role.Id}:{feature.Key}";
                                var isAllowed = permissionMap.TryGetValue(key, out var allowed) && allowed;
                                <td class="px-2 py-2.5 text-center">
                                    <button type="button"
                                            class="permission-toggle-btn inline-flex items-center justify-center px-2.5 py-1 rounded-lg text-[10px] font-bold border transition-all duration-150 @(isAllowed ? "bg-emerald-500 border-emerald-600 text-white hover:bg-emerald-600" : "bg-slate-100 dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700")"
                                            data-role-id="@role.Id"
                                            data-permission-key="@feature.Key"
                                            data-is-allowed="@(isAllowed ? "true" : "false")">
                                        @if (isAllowed)
                                        {
                                            <i class="bi bi-check-lg me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x me-1"></i>
                                        }
                                        @(isAllowed ? "فعال" : "غیر")
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const toast = document.getElementById('permissionToast');

            const showToast = (message, isSuccess = true) => {
                if (!toast) return;

                if (toast._timer) clearTimeout(toast._timer);

                toast.textContent = message;
                toast.className = [
                    'fixed bottom-5 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-xl border shadow-lg text-xs font-bold transition-all duration-200',
                    isSuccess
                        ? 'bg-emerald-50 border-emerald-300 text-emerald-700 dark:bg-emerald-950/60 dark:border-emerald-700 dark:text-emerald-300'
                        : 'bg-rose-50 border-rose-300 text-rose-700 dark:bg-rose-950/60 dark:border-rose-700 dark:text-rose-300'
                ].join(' ');

                toast._timer = setTimeout(() => {
                    toast.classList.add('hidden');
                }, 2000);
            };

            const paintButton = (button, isAllowed) => {
                button.dataset.isAllowed = isAllowed ? 'true' : 'false';
                button.innerHTML = isAllowed
                    ? '<i class="bi bi-check-lg me-1"></i>فعال'
                    : '<i class="bi bi-x me-1"></i>غیر';

                const on  = 'bg-emerald-500 border-emerald-600 text-white hover:bg-emerald-600';
                const off = 'bg-slate-100 dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700';

                on.split(' ').forEach(c => button.classList.toggle(c, isAllowed));
                off.split(' ').forEach(c => button.classList.toggle(c, !isAllowed));
            };

            const container = document.querySelector('[data-toggle-url]');
            if (!container) return;

            container.addEventListener('click', async (e) => {
                const button = e.target.closest('.permission-toggle-btn');
                if (!button) return;

                e.preventDefault();
                const toggleUrl = container.dataset.toggleUrl;
                const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const previousState = button.dataset.isAllowed === 'true';
                const nextState = !previousState;

                button.disabled = true;
                paintButton(button, nextState);

                const payload = new URLSearchParams();
                payload.append('RoleId', button.dataset.roleId);
                payload.append('PermissionKey', button.dataset.permissionKey);
                payload.append('IsAllowed', String(nextState));

                try {
                    const response = await fetch(toggleUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'RequestVerificationToken': antiForgeryToken,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: payload.toString()
                    });

                    if (!response.ok) throw new Error('save_failed');

                    const result = await response.json();
                    if (!result?.success) throw new Error('invalid_result');

                    showToast(result.message || 'دسترسی با موفقیت ذخیره شد.', true);
                } catch {
                    paintButton(button, previousState);
                    showToast('ذخیره تغییرات ناموفق بود. دوباره تلاش کنید.', false);
                } finally {
                    button.disabled = false;
                }
            });
        })();
    </script>
}
