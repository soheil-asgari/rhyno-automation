@model WarehouseDashboardVM
@{
    ViewData["Title"] = "انبارداری";
    var maxTrend = Math.Max(1m, Model.MovementTrends.Any() ? Model.MovementTrends.Max(item => Math.Max(item.Inputs, item.Outputs)) : 1m);
}

<div class="page-shell wh-page">
    <div class="section-header section-header-toned section-tone-info mb-3">
        <div class="section-header-copy">
            <h1 class="section-title">داشبورد انبار</h1>
            <p class="section-subtitle">وضعیت عملیاتی انبار، اسناد باز، کالاهای بحرانی و روند ورود و خروج در یک نگاه</p>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-4">
        <a asp-action="Products" class="no-underline">
            <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-3 hover:shadow transition text-center">
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">کالاها</div>
                <div class="text-lg font-black text-slate-900 dark:text-white mt-0.5">@Model.ProductCount</div>
                <div class="text-[9px] text-slate-450 dark:text-slate-500 mt-1">فهرست کالاهای فعال</div>
            </div>
        </a>
        <a asp-action="Warehouses" class="no-underline">
            <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-3 hover:shadow transition text-center">
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">انبارها</div>
                <div class="text-lg font-black text-slate-900 dark:text-white mt-0.5">@Model.WarehouseCount</div>
                <div class="text-[9px] text-slate-450 dark:text-slate-500 mt-1">مراکز فعال</div>
            </div>
        </a>
        <a asp-action="Receipts" class="no-underline">
            <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-3 hover:shadow transition text-center">
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">رسیدها</div>
                <div class="text-lg font-black text-slate-900 dark:text-white mt-0.5">@Model.ReceiptCount</div>
                <div class="text-[9px] text-slate-450 dark:text-slate-500 mt-1">ورودهای ثبت‌شده</div>
            </div>
        </a>
        <a asp-action="Issuances" class="no-underline">
            <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-3 hover:shadow transition text-center">
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">خروجی‌ها</div>
                <div class="text-lg font-black text-slate-900 dark:text-white mt-0.5">@Model.IssuanceCount</div>
                <div class="text-[9px] text-slate-450 dark:text-slate-500 mt-1">خروجی‌های ثبت‌شده</div>
            </div>
        </a>
        <a asp-action="Countings" class="no-underline">
            <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-3 hover:shadow transition text-center">
                <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400">پیش‌نویس‌ها</div>
                <div class="text-lg font-black text-slate-900 dark:text-white mt-0.5">@Model.CountingDraftCount</div>
                <div class="text-[9px] text-slate-450 dark:text-slate-500 mt-1">انبارگردانی‌های نیمه‌تمام</div>
            </div>
        </a>
        <a asp-action="Stock" class="no-underline">
            <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-rose-200 dark:border-rose-900/50 p-3 hover:shadow transition text-center">
                <div class="text-[10px] font-bold text-rose-600 dark:text-rose-450">هشدار</div>
                <div class="text-lg font-black text-rose-600 dark:text-rose-400 mt-0.5">@Model.LowStockCount</div>
                <div class="text-[9px] text-rose-450 mt-1">کالای زیر حداقل</div>
            </div>
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-4">
        <!-- ستون اول -->
        <div class="space-y-4">
            <!-- عملیات امروز -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h5 class="text-[12px] font-black text-slate-900 dark:text-white mb-3">عملیات امروز</h5>
                <div class="grid grid-cols-2 gap-2">
                    <a asp-action="CreateReceipt" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-colors no-underline">ثبت رسید جدید</a>
                    <a asp-action="CreateIssuance" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-colors no-underline">ثبت خروج جدید</a>
                    <a asp-action="CreateCounting" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-colors no-underline">ثبت انبارگردانی</a>
                    <a asp-action="Closing" class="inline-flex items-center justify-center bg-rose-50 border border-rose-200 text-rose-700 hover:bg-rose-100 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-colors no-underline">بستن سال انبار</a>
                    <a asp-action="TransferRequests" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-colors no-underline">بررسی انتقال‌ها</a>
                    <a asp-action="Stock" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-colors no-underline">بررسی موجودی</a>
                </div>
            </div>

            <!-- اسناد معلق -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex items-center justify-between gap-3 mb-3">
                    <div>
                        <h5 class="text-[12px] font-black text-slate-900 dark:text-white mb-0">اسناد معلق</h5>
                        <div class="text-[9px] text-slate-400 dark:text-slate-500 mt-0.5">رسیدها، خروجی‌ها و انتقال‌های در انتظار اقدام</div>
                    </div>
                    <a asp-action="TransferRequests" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline">جزئیات</a>
                </div>
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-[11px] text-right mt-2 border-collapse">
                        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">نوع</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">شماره</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">انبار</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">وضعیت</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                            @foreach (var item in Model.PendingTransfers)
                            {
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">انتقال</td>
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center font-mono font-semibold">#@item.Id</td>
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50">@item.SourceWarehouseName → @item.DestinationWarehouseName</td>
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center"><span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-bold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border border-amber-200/30">@item.Status</span></td>
                                </tr>
                            }
                            @if (!Model.PendingTransfers.Any())
                            {
                                <tr><td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center text-slate-400 py-3" colspan="4">درخواستی در انتظار بررسی نیست.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- مغایرت‌های انبارگردانی -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex items-center justify-between gap-3 mb-3">
                    <h5 class="text-[12px] font-black text-slate-900 dark:text-white mb-0">مغایرت‌های انبارگردانی</h5>
                    <a asp-action="Countings" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline">همه</a>
                </div>
                <div class="grid grid-cols-1 gap-2">
                    @foreach (var item in Model.CountingIssues)
                    {
                        <a asp-action="CountingDetails" asp-route-id="@item.Id" class="flex items-center justify-between p-2.5 bg-slate-50 dark:bg-slate-955 hover:bg-slate-100 dark:hover:bg-slate-900 border border-slate-100 dark:border-slate-800/80 rounded-lg transition no-underline">
                            <div>
                                <strong class="text-[11px] text-slate-800 dark:text-white">@item.DocumentNumber</strong>
                                <div class="text-[9px] text-slate-400 mt-0.5">@item.WarehouseName</div>
                            </div>
                            <div class="text-end">
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-bold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border border-amber-200/35">@item.Status</span>
                                <div class="text-[9px] font-mono tabular-nums text-slate-500 mt-0.5 text-left">@item.TotalDiscrepancy.ToString("N3")</div>
                            </div>
                        </a>
                    }
                    @if (!Model.CountingIssues.Any())
                    {
                        <div class="text-center text-slate-400 py-3 text-[11px]">مغایرت ثبت‌شده‌ای وجود ندارد.</div>
                    }
                </div>
            </div>

            <!-- میان‌برها -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex items-center justify-between gap-3 mb-3">
                    <h5 class="text-[12px] font-black text-slate-900 dark:text-white mb-0">میان‌برها</h5>
                    <span class="text-[9px] text-slate-400 dark:text-slate-500 font-bold">اقدام سریع</span>
                </div>
                <div class="flex flex-wrap gap-1.5">
                    <a class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline" asp-action="Products">کالاها</a>
                    <a class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline" asp-action="Warehouses">انبارها</a>
                    <a class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline" asp-action="Receipts">رسید انبار</a>
                    <a class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline" asp-action="Issuances">خروج انبار</a>
                    <a class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline" asp-action="Stock">موجودی</a>
                    <a class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline" asp-action="TransferRequests">درخواست انتقال</a>
                    <a class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline" asp-action="Countings">انبارگردانی</a>
                    <a class="inline-flex items-center justify-center bg-rose-50 border border-rose-200 text-rose-700 hover:bg-rose-100 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline" asp-action="Closing">بستن پایان سال</a>
                </div>
            </div>
        </div>

        <!-- ستون دوم -->
        <div class="space-y-4">
            <!-- روند ورود و خروج -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex justify-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 class="text-[12px] font-black text-slate-900 dark:text-white mb-0">روند ورود و خروج</h5>
                        <div class="text-[9px] text-slate-400 dark:text-slate-500 mt-0.5">هفت روز اخیر</div>
                    </div>
                </div>
                @if (Model.MovementTrends.Any())
                {
                    <div class="trend-list space-y-3">
                        @foreach (var item in Model.MovementTrends)
                        {
                            var inputWidth = Math.Max(5m, (item.Inputs / maxTrend) * 100m);
                            var outputWidth = Math.Max(5m, (item.Outputs / maxTrend) * 100m);
                            <div class="trend-row flex flex-col gap-1">
                                <div class="trend-label text-[11px] font-bold text-slate-700 dark:text-slate-300">@item.Label</div>
                                <div class="trend-bars h-2 bg-slate-100 dark:bg-slate-850 rounded-full overflow-hidden flex">
                                    <div class="trend-bar bg-emerald-500 h-full transition-all duration-500" style="width: @(inputWidth.ToString("0.##"))%"></div>
                                    <div class="trend-bar bg-blue-500 h-full transition-all duration-500" style="width: @(outputWidth.ToString("0.##"))%"></div>
                                </div>
                                <div class="trend-values flex justify-between text-[9px] text-slate-400 font-mono">
                                    <span>ورود: @item.Inputs.ToString("N0")</span>
                                    <span>خروج: @item.Outputs.ToString("N0")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-slate-400 py-3 text-[11px]">هنوز داده‌ای برای نمایش روند ثبت نشده است.</div>
                }
            </div>

            <!-- کالاهای بحرانی -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex justify-between items-center mb-3">
                    <div>
                        <h5 class="text-[12px] font-black text-slate-900 dark:text-white mb-0">کالاهای بحرانی</h5>
                        <div class="text-[9px] text-slate-400 dark:text-slate-500 mt-0.5">زیر حداقل یا نزدیک به حداقل</div>
                    </div>
                    <a asp-action="Stock" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline">مشاهده همه</a>
                </div>
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-[11px] text-right mt-2 border-collapse">
                        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">کالا</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">انبار</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">موجودی</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-left">حداقل</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                            @foreach (var item in Model.CriticalStocks)
                            {
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">@item.ProductName<div class="text-[9px] text-slate-400 dark:text-slate-500 font-mono mt-0.5">@item.ProductCode</div></td>
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-slate-600 dark:text-slate-450">@item.WarehouseName</td>
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums"><span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-bold bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400">@item.CurrentQuantity.ToString("N3")</span></td>
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-left font-mono tabular-nums text-slate-500">@item.MinimumStock</td>
                                </tr>
                            }
                            @if (!Model.CriticalStocks.Any())
                            {
                                <tr><td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center text-slate-400 py-3" colspan="4">مورد بحرانی یافت نشد.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- آخرین رسیدها -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex justify-between items-center mb-3">
                    <h5 class="text-[12px] font-black text-slate-900 dark:text-white mb-0">آخرین رسیدها</h5>
                    <a asp-action="Receipts" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline">همه</a>
                </div>
                <div class="grid grid-cols-1 gap-2">
                    @foreach (var item in Model.RecentReceipts)
                    {
                        <a asp-action="ReceiptDetails" asp-route-id="@item.Id" class="flex items-center justify-between p-2.5 bg-slate-50 dark:bg-slate-955 hover:bg-slate-100 dark:hover:bg-slate-900 border border-slate-100 dark:border-slate-800/80 rounded-lg transition no-underline">
                            <div>
                                <strong class="text-[11px] text-slate-800 dark:text-white">@item.Number</strong>
                                <div class="text-[9px] text-slate-400 mt-0.5">@item.WarehouseName - @item.DateShamsi</div>
                            </div>
                            <div class="text-end">
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-bold @WorkflowStatus.BadgeCss(item.Status)">@WorkflowStatus.Label(item.Status)</span>
                                <div class="text-[9px] font-mono tabular-nums text-slate-500 mt-0.5 text-left">@item.TotalQuantity.ToString("N3")</div>
                            </div>
                        </a>
                    }
                    @if (!Model.RecentReceipts.Any())
                    {
                        <div class="text-center text-slate-400 py-3 text-[11px]">رسیدی برای نمایش وجود ندارد.</div>
                    }
                </div>
            </div>

            <!-- آخرین خروجی‌ها -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex justify-between items-center mb-3">
                    <h5 class="text-[12px] font-black text-slate-900 dark:text-white mb-0">آخرین خروجی‌ها</h5>
                    <a asp-action="Issuances" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline">همه</a>
                </div>
                <div class="grid grid-cols-1 gap-2">
                    @foreach (var item in Model.RecentIssuances)
                    {
                        <a asp-action="IssuanceDetails" asp-route-id="@item.Id" class="flex items-center justify-between p-2.5 bg-slate-50 dark:bg-slate-955 hover:bg-slate-100 dark:hover:bg-slate-900 border border-slate-100 dark:border-slate-800/80 rounded-lg transition no-underline">
                            <div>
                                <strong class="text-[11px] text-slate-800 dark:text-white">@item.Number</strong>
                                <div class="text-[9px] text-slate-400 mt-0.5">@item.WarehouseName - @item.DateShamsi</div>
                            </div>
                            <div class="text-end">
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-bold @WorkflowStatus.BadgeCss(item.Status)">@WorkflowStatus.Label(item.Status)</span>
                                <div class="text-[9px] font-mono tabular-nums text-slate-500 mt-0.5 text-left">@item.TotalQuantity.ToString("N3")</div>
                            </div>
                        </a>
                    }
                    @if (!Model.RecentIssuances.Any())
                    {
                        <div class="text-center text-slate-400 py-3 text-[11px]">خروجی‌ای برای نمایش وجود ندارد.</div>
                    }
                </div>
            </div>

            <!-- انبارهای پرریسک -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-3.5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex justify-between items-center mb-3">
                    <h5 class="text-[12px] font-black text-slate-900 dark:text-white mb-0">انبارهای پرریسک</h5>
                    <a asp-action="Warehouses" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors no-underline">مدیریت</a>
                </div>
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-[11px] text-right mt-2 border-collapse">
                        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">انبار</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">اسناد باز</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">کمبود</th>
                                <th class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">منفی</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                            @foreach (var item in Model.RiskWarehouses)
                            {
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 font-bold">@item.WarehouseName</td>
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center font-mono tabular-nums">@item.OpenDocuments</td>
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center font-mono tabular-nums text-amber-600">@item.LowStockCount</td>
                                    <td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center font-mono tabular-nums text-rose-600">@item.NegativeStockCount</td>
                                </tr>
                            }
                            @if (!Model.RiskWarehouses.Any())
                            {
                                <tr><td class="p-2 border-b border-slate-100 dark:border-slate-800/50 text-center text-slate-400 py-3" colspan="4">مورد پرریسکی یافت نشد.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
</div>


@section Styles {
}
@section Scripts {
    <script>
        (() => {
            document.querySelectorAll('[data-trend-width]').forEach((bar) => {
                const value = Number(String(bar.getAttribute('data-trend-width')).replace(',', '.'));
                if (Number.isFinite(value)) {
                    bar.style.setProperty('--trend-width', `${Math.max(0, Math.min(100, value))}%`);
                }
            });
        })();
    </script>
}