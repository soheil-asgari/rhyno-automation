@model List<Warehouse>
@{
    ViewData["Title"] = "انبارها";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">فهرست انبارها</h6>
        <div class="d-flex gap-2">
            <a asp-action="Closing" class="btn btn-sm btn-outline-danger">بستن انبار پایان سال</a>
            <a asp-action="CreateWarehouse" class="btn btn-sm btn-primary">انبار جدید</a>
        </div>
    </div>

    @if (TempData["WarehouseMessage"] is string message)
    {
        <div class="alert alert-info py-2 small">@message</div>
    }

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-4 mb-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-8 col-lg-4">
                <label class="form-label small text-muted mb-1">جستجو</label>
                <input name="searchTerm" value="@ViewBag.SearchTerm" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="نام/کد/موقعیت" />
            </div>
            <div class="col-auto">
                <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-sm">اعمال</button>
            </div>
        </form>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto">
        <div class="table-responsive">
            <table class="w-full text-xs text-right border-collapse"  >
                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  ead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-300 text-xs font-bold border-b border-slate-200 dark:border-slate-700"><tr><th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >کد</th><th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >نام</th><th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >موقعیت</th><th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >وضعیت</th><th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center"  >عملیات</th></tr></thead>
                <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >@item.Code</td>
                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >@item.Name</td>
                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >@(string.IsNullOrWhiteSpace(item.Location) ? "-" : item.Location)</td>
                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >
                                <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "فعال" : "غیرفعال")</span>
                                <span class="badge @(item.IsClosed ? "text-bg-danger" : "text-bg-primary")">@(item.IsClosed ? "بسته" : "باز")</span>
                            </td>
                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 text-center"  >
                                <a asp-action="EditWarehouse" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">ویرایش</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "   colspan="5" class="text-center text-muted py-3">انباری یافت نشد.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
