@model List<WarehouseReceipt>
@{
    ViewData["Title"] = "رسیدهای انبار";
    var warehouseOptions = ViewBag.WarehouseOptions as List<SelectListItem> ?? new();
    var vendorOptions = ViewBag.VendorOptions as List<SelectListItem> ?? new();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h5 class="fw-bold mb-1">رسیدهای انبار</h5>
            <div class="text-muted small">با فیلترهای وضعیت، تاریخ، انبار و تامین‌کننده سریع‌تر بررسی کن.</div>
        </div>
        <a asp-action="CreateReceipt" class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-sm  btn-sm">ثبت رسید جدید</a>
    </div>

    @if (TempData["WarehouseMessage"] is string message)
    {
        <div class="alert alert-info border-0 shadow-sm small">@message</div>
    }

    @{ ViewData["SavedFiltersTitle"] = "فیلترهای ذخیره‌شده"; ViewData["SavedFiltersSubtitle"] = "فیلترهای رسید را ذخیره کن."; ViewData["SavedFiltersSaveButtonId"] = "receiptSaveFilter"; ViewData["SavedFiltersClearButtonId"] = "receiptClearFilter"; ViewData["SavedFiltersContainerId"] = "receiptSavedFilters"; }
    <partial name="_SavedFiltersPanel" />

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto  mb-3" >
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto -body p-3" >
            <form method="get" class="row g-3 align-items-end" data-warehouse-filter-form data-filters-key="warehouse-receipts" data-save-button-id="receiptSaveFilter" data-clear-button-id="receiptClearFilter" data-presets-container-id="receiptSavedFilters">
                <div class="col-12 col-md-3">
                    <label class="form-label small mb-1">جستجو</label>
                    <input name="searchTerm" value="@ViewBag.SearchTerm" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" data-filter-key="searchTerm" placeholder="شماره رسید، منبع یا توضیح" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1">وضعیت</label>
                    <select name="status" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" data-filter-key="status">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="@WorkflowStatus.Draft" selected="@(ViewBag.Status as string == WorkflowStatus.Draft ? "selected" : null)">پیش‌نویس</option>
                        <option value="@WorkflowStatus.PendingApproval" selected="@(ViewBag.Status as string == WorkflowStatus.PendingApproval ? "selected" : null)">در انتظار تایید</option>
                        <option value="@WorkflowStatus.Approved" selected="@(ViewBag.Status as string == WorkflowStatus.Approved ? "selected" : null)">تایید شده</option>
                        <option value="@WorkflowStatus.Rejected" selected="@(ViewBag.Status as string == WorkflowStatus.Rejected ? "selected" : null)">رد شده</option>
                        <option value="@WorkflowStatus.Canceled" selected="@(ViewBag.Status as string == WorkflowStatus.Canceled ? "selected" : null)">ابطال شده</option>
                        <option value="@WorkflowStatus.Completed" selected="@(ViewBag.Status as string == WorkflowStatus.Completed ? "selected" : null)">انجام شده</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1">انبار</label>
                    <select name="warehouseId" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" data-filter-key="warehouseId">
                        <option value="">همه انبارها</option>
                        @foreach (var option in warehouseOptions)
                        {
                            <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1">تامین‌کننده</label>
                    <select name="vendorId" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" data-filter-key="vendorId">
                        <option value="">همه تامین‌کنندگان</option>
                        @foreach (var option in vendorOptions)
                        {
                            <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-1">
                    <label class="form-label small mb-1">از</label>
                    <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" data-filter-key="dateFrom" />
                </div>
                <div class="col-6 col-md-1">
                    <label class="form-label small mb-1">تا</label>
                    <input type="date" name="dateTo" value="@ViewBag.DateTo" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" data-filter-key="dateTo" />
                </div>
                <div class="col-12 col-md-1 d-flex gap-2">
                    <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-sm  w-100">اعمال</button>
                </div>
            </form>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto " >
        <div class="table-responsive">
            <table class="w-full text-xs text-right border-collapse"  >
                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  ead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-300 text-xs font-bold border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >شماره</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >تاریخ</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >انبار</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >تامین‌کننده</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >تعداد</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold "  >وضعیت</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center"  >عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >@item.ReceiptNumber</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >@item.DateShamsi</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >@item.Warehouse.Name</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >@(item.Vendor?.Name ?? item.SupplierOrSource)</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  >@item.Items.Sum(row => row.Quantity).ToString("N3")</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "  ><span class="badge @WorkflowStatus.BadgeCss(item.WorkflowStatus)">@WorkflowStatus.Label(item.WorkflowStatus)</span></td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 text-center"  >
                                    <a asp-action="ReceiptDetails" asp-route-id="@item.Id" class="h-8 rounded-lg border border-slate-200 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800 px-3 text-xs font-bold text-slate-700 dark:text-slate-350 transition flex items-center gap-1  btn-sm">جزئیات</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 p-3 border-b border-slate-100 dark:border-slate-800/50 "   colspan="7" class="text-center text-muted py-4">رسیدی با این فیلترها پیدا نشد.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/warehouse-filters.js" asp-append-version="true"></script>
}
