@model List<WarehouseReceipt>
@{
    ViewData["Title"] = "رسیدهای انبار";
    var warehouseOptions = ViewBag.WarehouseOptions as List<SelectListItem> ?? new();
    var vendorOptions = ViewBag.VendorOptions as List<SelectListItem> ?? new();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h5 class="fw-bold mb-1">رسیدهای انبار</h5>
            <div class="text-muted small">با فیلترهای وضعیت، تاریخ، انبار و تامین‌کننده سریع‌تر بررسی کن.</div>
        </div>
        <a asp-action="CreateReceipt"
           class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-sm btn-sm">ثبت
            رسید جدید</a>
        </div>

        @if (TempData["WarehouseMessage"] is string message)
        {
            <div class="alert alert-info border-0 shadow-sm small">@message</div>
        }

        @{
            ViewData["SavedFiltersTitle"] = "فیلترهای ذخیره‌شده"; ViewData["SavedFiltersSubtitle"] = "فیلترهای رسید را ذخیره کن."; ViewData["SavedFiltersSaveButtonId"] = "receiptSaveFilter"; ViewData["SavedFiltersClearButtonId"] =
           "receiptClearFilter"; ViewData["SavedFiltersContainerId"] = "receiptSavedFilters";
        }
        <partial name="_SavedFiltersPanel" />

        <div
            class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 px-3 py-2 mb-3 overflow-x-auto">
            <form method="get" class="d-flex align-items-end gap-1.5 flex-nowrap" style="min-width:max-content"
                  data-warehouse-filter-form data-filters-key="warehouse-receipts" data-save-button-id="receiptSaveFilter"
                  data-clear-button-id="receiptClearFilter" data-presets-container-id="receiptSavedFilters">
                <input name="searchTerm" value="@ViewBag.SearchTerm"
                       class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-1.5 text-[11px] focus:ring-teal-500/20 focus:border-teal-500 outline-none flex-shrink-0"
                       style="width:130px;" data-filter-key="searchTerm" placeholder="جستجو..." />
                <select name="status"
                        class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-1.5 text-[11px] focus:ring-teal-500/20 focus:border-teal-500 outline-none flex-shrink-0"
                        style="width:115px;" data-filter-key="status">
                    <option value="">وضعیت</option>
                    <option value="@WorkflowStatus.Draft"
                            selected="@(ViewBag.Status as string == WorkflowStatus.Draft ? "selected" : null)">پیش‌نویس</option>
                    <option value="@WorkflowStatus.PendingApproval"
                            selected="@(ViewBag.Status as string == WorkflowStatus.PendingApproval ? "selected" : null)">در
                        انتظار تایید</option>
                        <option value="@WorkflowStatus.Approved"
                                selected="@(ViewBag.Status as string == WorkflowStatus.Approved ? "selected" : null)">تایید شده
                        </option>
                        <option value="@WorkflowStatus.Rejected"
                                selected="@(ViewBag.Status as string == WorkflowStatus.Rejected ? "selected" : null)">رد شده
                        </option>
                        <option value="@WorkflowStatus.Canceled"
                                selected="@(ViewBag.Status as string == WorkflowStatus.Canceled ? "selected" : null)">ابطال شده
                        </option>
                        <option value="@WorkflowStatus.Completed"
                                selected="@(ViewBag.Status as string == WorkflowStatus.Completed ? "selected" : null)">انجام شده
                        </option>
                    </select>
                    <select name="warehouseId"
                            class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-1.5 text-[11px] focus:ring-teal-500/20 focus:border-teal-500 outline-none flex-shrink-0"
                            style="width:100px;" data-filter-key="warehouseId">
                        <option value="">انبار</option>
                        @foreach (var option in warehouseOptions)
                        {
                            <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                        }
                    </select>
                    <select name="vendorId"
                            class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-1.5 text-[11px] focus:ring-teal-500/20 focus:border-teal-500 outline-none flex-shrink-0"
                            style="width:110px;" data-filter-key="vendorId">
                        <option value="">تامین‌کننده</option>
                        @foreach (var option in vendorOptions)
                        {
                            <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                        }
                    </select>
                    <input type="date" name="dateFrom" value="@ViewBag.DateFrom"
                           class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-1.5 text-[11px] focus:ring-teal-500/20 focus:border-teal-500 outline-none flex-shrink-0"
                           style="width:105px;" data-filter-key="dateFrom" />
                    <input type="date" name="dateTo" value="@ViewBag.DateTo"
                           class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-1.5 text-[11px] focus:ring-teal-500/20 focus:border-teal-500 outline-none flex-shrink-0"
                           style="width:105px;" data-filter-key="dateTo" />
                    <button type="submit"
                            class="bg-teal-600 hover:bg-teal-700 text-white px-2.5 py-1.5 rounded-lg text-[11px] font-bold transition shadow-sm flex-shrink-0">اعمال</button>
                </form>
            </div>

            <div
                class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto">
                <div class="table-responsive">
                    <table class="w-full text-xs text-right border-collapse">
                        <thead
                            class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-300 text-xs font-bold border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold">شماره</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold">تاریخ</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold">انبار</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold">تامین‌کننده</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold">تعداد</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold">وضعیت</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center">عملیات
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50">@item.ReceiptNumber</td>
                                        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50">@item.DateShamsi</td>
                                        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50">@item.Warehouse.Name</td>
                                        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50">@(item.Vendor?.Name ??
                                                                        item.SupplierOrSource)</td>
                                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50">@item.Items.Sum(row =>
                                                                            row.Quantity).ToString("N3")</td>
                                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50"><span
                                                    class="badge @WorkflowStatus.BadgeCss(item.WorkflowStatus)">@WorkflowStatus.Label(item.WorkflowStatus)</span>
                                                </td>
                                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 text-center">
                                                    <a asp-action="ReceiptDetails" asp-route-id="@item.Id"
                                                       class="h-8 rounded-lg border border-slate-200 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800 px-3 text-xs font-bold text-slate-700 dark:text-slate-300 transition flex items-center gap-1 btn-sm">جزئیات</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">رسیدی با این فیلترها پیدا نشد.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @section Scripts {
                    <script src="~/js/warehouse-filters.js" asp-append-version="true"></script>
                }