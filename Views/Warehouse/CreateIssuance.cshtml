@model WarehouseIssuanceUpsertVM
@{
    ViewData["Title"] = "ثبت خروج انبار";
    var stockSnapshotJson = ViewBag.StockSnapshotJson as string ?? "[]";
}

<div class="page-shell wh-page">
    <div class="section-header section-header-toned section-tone-info mb-3">
        <div class="section-header-copy">
            <h1 class="section-title">ثبت خروج انبار</h1>
            <p class="section-subtitle">پیش‌نمایش زنده، هشدار موجودی و ارسال برای بررسی</p>
        </div>
        <a asp-action="Issuances" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-bold text-slate-600 hover:bg-slate-50 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 no-underline">بازگشت</a>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 mb-3">
        <form asp-action="CreateIssuance" method="post" id="issuanceForm">
            <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-2 text-[12px] text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300 mb-3"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
                <div>
                    <label asp-for="IssuanceNumber" class="mb-1 block text-[11px] font-bold text-slate-500 dark:text-slate-400">شماره خروج</label>
                    <input asp-for="IssuanceNumber" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
                </div>
                <div>
                    <label asp-for="DateShamsi" class="mb-1 block text-[11px] font-bold text-slate-500 dark:text-slate-400">تاریخ</label>
                    <input asp-for="DateShamsi" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
                </div>
                <div>
                    <label asp-for="WarehouseId" class="mb-1 block text-[11px] font-bold text-slate-500 dark:text-slate-400">انبار</label>
                    <select asp-for="WarehouseId" asp-items="Model.WarehouseOptions" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"></select>
                </div>
                <div>
                    <label asp-for="EmployerId" class="mb-1 block text-[11px] font-bold text-slate-500 dark:text-slate-400">کارفرما</label>
                    <select asp-for="EmployerId" asp-items="Model.EmployerOptions" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                        <option value="">انتخاب کارفرما</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="mb-1 block text-[11px] font-bold text-slate-500 dark:text-slate-400">یادداشت</label>
                <textarea asp-for="Notes" rows="2" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"></textarea>
            </div>

            <div class="flex flex-wrap items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 mb-4 dark:border-slate-700 dark:bg-slate-900" id="issuanceSummaryBar">
                <div class="text-center"><span class="block text-[10px] text-slate-400 dark:text-slate-500">تعداد ردیف</span><strong class="text-sm text-slate-800 dark:text-white" id="issuanceRowCount">0</strong></div>
                <div class="text-center"><span class="block text-[10px] text-slate-400 dark:text-slate-500">جمع تعداد</span><strong class="text-sm text-slate-800 dark:text-white" id="issuanceTotalQty">0.000</strong></div>
                <div class="text-center"><span class="block text-[10px] text-slate-400 dark:text-slate-500">هشدار کمبود</span><strong class="text-sm text-rose-600 dark:text-rose-400" id="issuanceWarnings">0</strong></div>
                <button type="button" id="addIssuanceRow" class="mr-auto rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-bold text-slate-600 hover:bg-slate-100 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">+ ردیف</button>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
                <div class="xl:col-span-2 overflow-x-auto">
                    <table class="w-full text-[12px] text-right border-collapse" id="issuanceItemsTable">
                        <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="px-3 py-2.5 font-bold text-slate-600 dark:text-slate-300">کالا</th>
                                <th class="px-3 py-2.5 font-bold text-slate-600 dark:text-slate-300">تعداد</th>
                                <th class="px-3 py-2.5 font-bold text-slate-600 dark:text-slate-300">وضعیت موجودی</th>
                                <th class="px-3 py-2.5 font-bold text-slate-600 dark:text-slate-300"></th>
                            </tr>
                        </thead>
                        <tbody id="issuanceItemsBody"></tbody>
                    </table>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900">
                    <h6 class="mb-3 text-[12px] font-black text-slate-800 dark:text-white">پیش‌نمایش نهایی</h6>
                    <div class="space-y-2">
                        <div class="flex justify-between text-[11px]"><span class="text-slate-400 dark:text-slate-500">شماره خروج</span><strong class="text-slate-700 dark:text-slate-300" id="previewIssuanceNumber">-</strong></div>
                        <div class="flex justify-between text-[11px]"><span class="text-slate-400 dark:text-slate-500">تاریخ</span><strong class="text-slate-700 dark:text-slate-300" id="previewDateShamsi">-</strong></div>
                        <div class="flex justify-between text-[11px]"><span class="text-slate-400 dark:text-slate-500">انبار</span><strong class="text-slate-700 dark:text-slate-300" id="previewWarehouse">-</strong></div>
                        <div class="flex justify-between text-[11px]"><span class="text-slate-400 dark:text-slate-500">کارفرما</span><strong class="text-slate-700 dark:text-slate-300" id="previewEmployer">-</strong></div>
                        <div class="flex justify-between text-[11px]"><span class="text-slate-400 dark:text-slate-500">ردیف‌ها</span><strong class="text-slate-700 dark:text-slate-300" id="previewLines">0</strong></div>
                        <div class="flex justify-between text-[11px] border-t border-slate-200 pt-2 dark:border-slate-700"><span class="text-slate-400 dark:text-slate-500">هشدارهای کمبود</span><strong class="text-rose-600 dark:text-rose-400" id="previewWarnings">0</strong></div>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-2 mt-4 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="submit" name="SaveAsDraft" value="true" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-bold text-slate-600 hover:bg-slate-50 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">ذخیره پیش نویس</button>
                <button type="submit" name="SaveAsDraft" value="false" class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 px-3 py-1.5 text-[11px] font-bold text-white hover:bg-emerald-700 transition">ارسال برای بررسی</button>
                <a asp-action="Issuances" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-bold text-slate-600 hover:bg-slate-50 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 no-underline">بازگشت</a>
            </div>
        </form>
    </div>
</div>

<template id="issuanceRowTemplate">
    <tr>
        <td class="px-2 py-2">
            <select data-field="ProductId" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-2 py-1.5 text-[11px] outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                <option value="">انتخاب کالا</option>
                @foreach (var product in Model.ProductOptions)
                {
                    <option value="@product.Value">@product.Text</option>
                }
            </select>
        </td>
        <td class="px-2 py-2"><input type="number" data-field="Quantity" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-2 py-1.5 text-[11px] outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" min="0.001" step="0.001" /></td>
        <td class="px-2 py-2"><div class="text-[11px] text-slate-400 row-feedback">در انتظار انتخاب کالا</div></td>
        <td class="px-2 py-2 text-center"><button type="button" class="inline-flex items-center rounded-lg border border-rose-200 bg-rose-50 px-2 py-1 text-[10px] font-bold text-rose-600 hover:bg-rose-100 transition dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-400 removeRow">حذف</button></td>
    </tr>
</template>

@section Styles {
}
@section Scripts {
    <script id="whIssuanceStock" type="application/json">@Html.Raw(stockSnapshotJson)</script>
    <script id="whIssuanceItems" type="application/json">@Html.Raw(Json.Serialize(Model.Items ?? new List<WarehouseIssuanceItemVM>()))</script>
    <script src="~/js/warehouse-create-issuance-script.js" asp-append-version="true"></script>
}