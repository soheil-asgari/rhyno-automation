@model ContractIndexVM
@{
    ViewData["Title"] = "قراردادها";
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="alert alert-success py-2 px-3 small mb-3">@successMsg</div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="alert alert-danger py-2 px-3 small mb-3">@errorMsg</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="fw-bold mb-0">قراردادها</h6>
            <small class="text-muted">@Model.TotalCount قرارداد ( @Model.ActiveCount فعال | @Model.CompletedCount
                تکمیل‌شده | @Model.DraftCount پیش‌نویس )</small>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Dashboard" class="btn btn-sm btn-outline-success">داشبورد</a>
                <a asp-action="Archive" class="btn btn-sm btn-outline-secondary">بایگانی</a>
                <a asp-action="Settings" class="btn btn-sm btn-outline-info">تنظیمات</a>
                <a asp-action="Create" class="btn btn-sm btn-primary">قرارداد جدید</a>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-3 border-bottom">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label small text-muted mb-1">جستجو</label>
                        <input name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm"
                               placeholder="عنوان / شماره / مشتری" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small text-muted mb-1">وضعیت</label>
                        <select name="Status" class="form-select form-select-sm" asp-items="Model.StatusOptions">
                            <option value="">همه</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small text-muted mb-1">نوع قرارداد</label>
                        <select name="ContractType" class="form-select form-select-sm"
                                asp-items="Model.ContractTypeOptions">
                            <option value="">همه</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small text-muted mb-1">مسئول</label>
                        <select name="ResponsibleUserId" class="form-select form-select-sm"
                                asp-items="Model.ResponsibleUserOptions">
                            <option value="">همه</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small text-muted mb-1">نام مشتری</label>
                        <input name="ClientName" value="@Model.ClientName" class="form-control form-control-sm" />
                    </div>
                    <div class="col-6 col-md-1">
                        <label class="form-label small text-muted mb-1">از تاریخ شروع</label>
                        <input name="StartDateFrom" value="@Model.StartDateFrom?.ToString("yyyy-MM-dd")" type="date"
                               class="form-control form-control-sm" />
                    </div>
                    <div class="col-6 col-md-1">
                        <label class="form-label small text-muted mb-1">تا تاریخ شروع</label>
                        <input name="StartDateTo" value="@Model.StartDateTo?.ToString("yyyy-MM-dd")" type="date"
                               class="form-control form-control-sm" />
                    </div>
                    <div class="col-auto d-flex gap-1">
                        <button class="btn btn-sm btn-primary">اعمال</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">پاکسازی</a>
                    </div>
                </form>
            </div>

            <div class="card-body p-0">
                @if (Model.Items.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>شماره قرارداد</th>
                                    <th>عنوان</th>
                                    <th>مشتری</th>
                                    <th>نوع</th>
                                    <th>مبلغ کل</th>
                                    <th>پرداخت‌شده</th>
                                    <th>باقی‌مانده</th>
                                    <th>تاریخ شروع</th>
                                    <th>تاریخ پایان</th>
                                    <th>وضعیت</th>
                                    <th>مسئول</th>
                                    <th class="text-center">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@item.ContractNumber</td>
                                        <td>@item.Title</td>
                                        <td>@(item.CustomerName ?? item.ClientName)</td>
                                        <td>@(item.ContractType ?? "-")</td>
                                        <td class="SgFarsiDigits">@item.TotalAmount.ToString("N0")</td>
                                        <td class="SgFarsiDigits">@item.PaidAmount.ToString("N0")</td>
                                        <td class="SgFarsiDigits">@item.RemainingAmount.ToString("N0")</td>
                                        <td class="SgFarsiDigits">@item.StartDate.ToString("yyyy/MM/dd")</td>
                                        <td class="SgFarsiDigits">@(item.EndDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                        <td>
                                            <span class="badge @(item.Status switch
                                                  {
                                                      var s when s == ContractStatuses.Active => "text-bg-success",
                                                      var s when s == ContractStatuses.Completed => "text-bg-primary",
                                                      var s when s == ContractStatuses.Draft => "text-bg-secondary",
                                                      var s when s == ContractStatuses.Cancelled => "text-bg-danger",
                                                      var s when s == ContractStatuses.Archived => "text-bg-warning",
                                                      _ => "text-bg-light"
                                                  })">@item.Status</span>
                                        </td>
                                        <td>@item.ResponsibleUserName</td>
                                        <td class="text-center">
                                            <div class="d-inline-flex gap-1">
                                                <a asp-action="Details" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-info">نمایش</a>
                                                @if (item.IsOwnedByCurrentUser)
                                                {
                                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-primary">ویرایش</a>
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                                          onsubmit="return confirm('آیتم حذف شود؟');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                                    </form>
                                                    <form asp-action="ArchiveContract" asp-route-id="@item.Id" method="post"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-warning">بایگانی</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer text-muted small px-3 py-2 d-flex justify-content-between align-items-center">
                        <div>
                            مجموع مبلغ کل: <span class="SgFarsiDigits fw-bold">@Model.TotalAmountSum.ToString("N0")</span>
                            | مجموع پرداخت‌شده: <span class="SgFarsiDigits fw-bold">@Model.TotalPaidSum.ToString("N0")</span>
                            | @Model.FilteredCount مورد از @Model.TotalCount
                        </div>
                        @if (Model.TotalPages > 1)
                        {
                            <div class="d-flex gap-1">
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <a asp-action="Index" asp-route-Page="@p" asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-Status="@Model.Status"
                                       class="btn btn-sm @(p == Model.Page ? "btn-primary" : "btn-outline-secondary")">@p</a>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <partial name="_EmptyState" />
                }
            </div>
        </div>
    </div>