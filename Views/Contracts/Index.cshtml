@model ContractIndexVM
@{
    ViewData["Title"] = "قراردادها";
}

<div class="container-fluid py-1 space-y-2" dir="rtl">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 dark:border-emerald-900/40 dark:bg-emerald-950/20 px-3.5 py-2.5 text-[11px] text-emerald-700 dark:text-emerald-400 mb-3 flex items-center gap-2">
            <i class="bi bi-check-circle-fill text-emerald-500"></i>
            <span>@successMsg</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-900/40 dark:bg-rose-950/20 px-3.5 py-2.5 text-[11px] text-rose-700 dark:text-rose-400 mb-3 flex items-center gap-2">
            <i class="bi bi-exclamation-circle-fill text-rose-500"></i>
            <span>@errorMsg</span>
        </div>
    }

    @* Breadcrumb *@
    <partial name="_Breadcrumb" model='new[] {
        new RhynoBreadcrumbItem("خانه", "/"),
        new RhynoBreadcrumbItem("قراردادها", null)
    }' />

    @* Section Header *@
    <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between px-1">
        <div>
            <h1 class="text-[13px] font-bold text-slate-900 dark:text-white">قراردادها</h1>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                @Model.TotalCount قرارداد ( @Model.ActiveCount فعال | @Model.CompletedCount تکمیل‌شده | @Model.DraftCount پیش‌نویس | @Model.ExpiringSoonCount در شرف انقضا )
            </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <a asp-action="Dashboard" class="erp-btn">
                <i class="bi bi-speedometer2 ml-1"></i>داشبورد
            </a>
            <a asp-action="Archive" class="erp-btn">
                <i class="bi bi-archive ml-1"></i>بایگانی
            </a>
            <a asp-action="Settings" class="erp-btn">
                <i class="bi bi-gear ml-1"></i>تنظیمات
            </a>
            <a asp-action="Create" asp-route-_tab="1" class="erp-btn erp-btn-primary">
                <i class="bi bi-plus-circle ml-1"></i>قرارداد جدید
            </a>
        </div>
    </div>

    @* Filter Card *@
    <div class="erp-fieldset">
        <form method="get" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-2 items-end" data-filter-form>
            <div class="col-span-2 md:col-span-1">
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">جستجو</label>
                <input name="SearchTerm" value="@Model.SearchTerm" class="erp-input" placeholder="عنوان / شماره / مشتری" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">وضعیت</label>
                <select name="Status" class="erp-input" asp-items="Model.StatusOptions">
                    <option value="">همه</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">نوع قرارداد</label>
                <select name="ContractType" class="erp-input" asp-items="Model.ContractTypeOptions">
                    <option value="">همه</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">مسئول</label>
                <select name="AssignedUserId" class="erp-input" asp-items="Model.ResponsibleUserOptions">
                    <option value="">همه</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">وضعیت پرداخت</label>
                <select name="PaymentStatus" class="erp-input" asp-items="Model.PaymentStatusOptions">
                    <option value="">همه</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">از تاریخ شروع</label>
                <input name="StartDateFrom" value="@Model.StartDateFrom?.ToString("yyyy-MM-dd")" type="date" class="erp-input" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">تا تاریخ شروع</label>
                <input name="StartDateTo" value="@Model.StartDateTo?.ToString("yyyy-MM-dd")" type="date" class="erp-input" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">از تاریخ پایان</label>
                <input name="EndDateFrom" value="@Model.EndDateFrom?.ToString("yyyy-MM-dd")" type="date" class="erp-input" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">تا تاریخ پایان</label>
                <input name="EndDateTo" value="@Model.EndDateTo?.ToString("yyyy-MM-dd")" type="date" class="erp-input" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">حداقل مبلغ</label>
                <input name="MinAmount" value="@Model.MinAmount" type="number" class="erp-input" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">حداکثر مبلغ</label>
                <input name="MaxAmount" value="@Model.MaxAmount" type="number" class="erp-input" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">مشتری</label>
                <select name="CustomerId" class="erp-input" asp-items="Model.CustomerOptions">
                    <option value="">همه</option>
                </select>
            </div>
            <div class="flex items-end gap-2">
                <label class="flex items-center gap-1.5 text-[10px] font-bold text-slate-500 dark:text-slate-400 cursor-pointer">
                    <input name="ExpiringSoonOnly" value="true" type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300 text-teal-600 focus:ring-teal-500/20" @(Model.ExpiringSoonOnly == true ? "checked" : "") />
                    فقط در شرف انقضا
                </label>
                <label class="flex items-center gap-1.5 text-[10px] font-bold text-slate-500 dark:text-slate-400 cursor-pointer">
                    <input name="ShowArchived" value="true" type="checkbox" class="h-3.5 w-3.5 rounded border-slate-300 text-teal-600 focus:ring-teal-500/20" @(Model.ShowArchived ? "checked" : "") />
                    نمایش بایگانی
                </label>
            </div>
            <div class="flex gap-1">
                <button class="h-7 rounded-lg bg-teal-600 px-3 text-[11px] font-black text-white shadow-sm transition hover:bg-teal-700">
                    <i class="bi bi-funnel ml-1"></i>اعمال
                </button>
                <a asp-action="Index" class="h-7 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-[11px] font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 no-underline transition flex items-center">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    @* Data Table *@
    <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
        <div class="erp-card overflow-hidden position-relative" data-table-wrapper>
        @if (Model.Items.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-[11px]">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/30">
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">#</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">شماره قرارداد</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">عنوان</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">مشتری</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">نوع</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">مبلغ کل</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">پرداخت‌شده</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">باقی‌مانده</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">وضعیت پرداخت</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">تاریخ شروع</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">تاریخ پایان</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">وضعیت</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">مسئول</th>
                            <th class="text-center px-3 py-2 font-bold text-slate-500 dark:text-slate-400">عملیات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 dark:divide-slate-800/60">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                                <td class="px-3 py-2 text-slate-500">@item.Id</td>
                                <td class="px-3 py-2 font-bold text-slate-800 dark:text-slate-200">@item.ContractNumber</td>
                                <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@item.Title</td>
                                <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@(item.CustomerName ?? item.ClientName)</td>
                                <td class="px-3 py-2">
                                    <span class="inline-flex items-center rounded-md bg-slate-50 dark:bg-slate-800 px-2 py-0.5 text-[9px] font-bold text-slate-600 dark:text-slate-400 border border-slate-200/50 dark:border-slate-700">@(item.ContractType ?? "-")</span>
                                </td>
                                <td class="px-3 py-2 font-mono tabular-nums text-slate-800 dark:text-slate-200 font-bold">@item.TotalAmount.ToString("N0")</td>
                                <td class="px-3 py-2 font-mono tabular-nums text-emerald-600 dark:text-emerald-400">
                                    @{
                                        var paidSum = item.Payments?
                                            .Where(p => p.Status == "Paid")
                                            .Sum(p => p.Amount) ?? 0;
                                    }
                                    @paidSum.ToString("N0")
                                </td>
                                <td class="px-3 py-2 font-mono tabular-nums text-rose-600 dark:text-rose-400">
                                    @{
                                        var remainingSum = item.TotalAmount - paidSum;
                                    }
                                    @remainingSum.ToString("N0")
                                </td>
                                <td class="px-3 py-2">
                                    @{
                                        var paymentBadge = item.PaymentStatus switch
                                        {
                                            "FullyPaid" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200 dark:border-emerald-900/50",
                                            "PartiallyPaid" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200 dark:border-amber-900/50",
                                            _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700"
                                        };
                                        var paymentText = item.PaymentStatus switch
                                        {
                                            "FullyPaid" => "تسویه شده",
                                            "PartiallyPaid" => "جزئی",
                                            _ => "پرداخت نشده"
                                        };
                                    }
                                    <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold border @paymentBadge">@paymentText</span>
                                </td>
                                <td class="px-3 py-2 font-mono tabular-nums text-slate-600 dark:text-slate-400">@item.StartDate.ToString("yyyy/MM/dd")</td>
                                <td class="px-3 py-2 font-mono tabular-nums text-slate-600 dark:text-slate-400">@(item.EndDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                <td class="px-3 py-2">
                                    @{
                                        var statusBadge = item.Status switch
                                        {
                                            var s when s == ContractStatuses.Active => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200 dark:border-emerald-900/50",
                                            var s when s == ContractStatuses.Completed => "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 border-blue-200 dark:border-blue-900/50",
                                            var s when s == ContractStatuses.Draft => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700",
                                            var s when s == ContractStatuses.Cancelled => "bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400 border-rose-200 dark:border-rose-900/50",
                                            var s when s == ContractStatuses.Archived => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200 dark:border-amber-900/50",
                                            var s when s == ContractStatuses.Expired => "bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-400 border-slate-300 dark:border-slate-700",
                                            var s when s == ContractStatuses.ExpiringSoon => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200 dark:border-amber-900/50",
                                            var s when s == ContractStatuses.Suspended => "bg-sky-100 text-sky-700 dark:bg-sky-900/30 dark:text-sky-400 border-sky-200 dark:border-sky-900/50",
                                            var s when s == ContractStatuses.Terminated => "bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400 border-rose-200 dark:border-rose-900/50",
                                            var s when s == ContractStatuses.PendingApproval => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200 dark:border-amber-900/50",
                                            _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700"
                                        };
                                    }
                                    <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold border @statusBadge">@item.Status</span>
                                </td>
                                <td class="px-2 py-1.5 text-[11px] text-slate-600 dark:text-slate-400">@item.ResponsibleUserName</td>
                                <td class="px-3 py-2 text-center">
                                    <div class="inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="erp-btn text-[9px] px-1.5 py-0.5 h-5 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 no-underline transition" title="نمایش">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.IsOwnedByCurrentUser)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="erp-btn text-[9px] px-1.5 py-0.5 h-5 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 no-underline transition" title="ویرایش">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" data-guard-submit onsubmit="return confirm('آیتم حذف شود؟');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="erp-btn text-[9px] px-1.5 py-0.5 h-5 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-rose-950/20 dark:hover:text-rose-400 transition" title="حذف">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                            <form asp-action="ArchiveContract" asp-route-id="@item.Id" method="post" class="inline" data-guard-submit>
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="erp-btn text-[9px] px-1.5 py-0.5 h-5 hover:bg-amber-50 hover:text-amber-600 hover:border-amber-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-amber-950/20 dark:hover:text-amber-400 transition" title="بایگانی">
                                                    <i class="bi bi-archive"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Footer *@
            <div class="flex items-center justify-between px-2 py-1.5 border-t border-slate-100 dark:border-slate-800 text-[10px] text-slate-500 dark:text-slate-400">
                <div>
                    مجموع مبلغ کل: <span class="font-bold font-mono tabular-nums text-slate-800 dark:text-slate-200">@Model.TotalAmountSum.ToString("N0")</span>
                    | مجموع پرداخت‌شده: <span class="font-bold font-mono tabular-nums text-emerald-600">@Model.TotalPaidSum.ToString("N0")</span>
                    | @Model.FilteredCount مورد از @Model.TotalCount
                </div>
                @if (Model.TotalPages > 1)
                {
                    <div class="flex gap-1">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <a asp-action="Index" asp-route-Page="@p" asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-Status="@Model.Status"
                               class="rounded-lg px-2 py-1 text-[10px] font-bold no-underline transition @(p == Model.Page ? "bg-teal-600 text-white" : "border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800")" data-page-link>@p</a>
                        }
                    </div>
                }
            </div>
        
        }
        else
        {
            <div class="text-center py-8">
                <div class="inline-flex items-center justify-center h-9 w-9 rounded-full bg-slate-100 dark:bg-slate-800 mb-3">
                    <i class="bi bi-file-earmark-text text-slate-400 text-lg"></i>
                </div>
                <h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-1">هیچ قراردادی یافت نشد</h3>
                <p class="text-[11px] text-slate-400 dark:text-slate-500 mb-3">برای شروع، اولین قرارداد خود را ایجاد کنید.</p>
                <a asp-action="Create" class="inline-flex items-center gap-1 erp-btn erp-btn-primary">
                    <i class="bi bi-plus-circle"></i>ایجاد قرارداد جدید
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/contracts-index-style.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/contracts-index-script.js" asp-append-version="true"></script>
}
