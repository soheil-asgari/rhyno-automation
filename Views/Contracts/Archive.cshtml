@model ContractArchiveVM
@{
    ViewData["Title"] = "بایگانی قراردادها";
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="alert alert-success py-2 px-3 small mb-3">@successMsg</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="fw-bold mb-0">بایگانی قراردادها</h6>
            <small class="text-muted">@Model.FilteredCount مورد از @Model.TotalCount کل قراردادها</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-primary">قراردادهای فعال</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-3 border-bottom">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">جستجو</label>
                    <input name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm"
                           placeholder="عنوان / شماره / مشتری" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small text-muted mb-1">وضعیت</label>
                    <select name="Status" class="form-select form-select-sm" asp-items="Model.StatusOptions">
                        <option value="">همه</option>
                    </select>
                </div>
                <div class="col-auto d-flex gap-1">
                    <button class="btn btn-sm btn-primary">اعمال</button>
                    <a asp-action="Archive" class="btn btn-sm btn-outline-secondary">پاکسازی</a>
                </div>
            </form>
        </div>

        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>شماره قرارداد</th>
                                <th>عنوان</th>
                                <th>مشتری</th>
                                <th>مبلغ کل</th>
                                <th>تاریخ بایگانی</th>
                                <th>وضعیت</th>
                                <th>مسئول</th>
                                <th class="text-center">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.ContractNumber</td>
                                    <td>@item.Title</td>
                                    <td>@item.ClientName</td>
                                    <td class="SgFarsiDigits">@item.TotalAmount.ToString("N0")</td>
                                    <td class="SgFarsiDigits">@item.ArchivedAt?.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <span class="badge @(item.Status switch
                                              {
                                                  var s when s == ContractStatuses.Archived => "text-bg-warning",
                                                  var s when s == ContractStatuses.Active => "text-bg-success",
                                                  _ => "text-bg-light"
                                              })">@item.Status</span>
                                    </td>
                                    <td>@item.ResponsibleUserName</td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info">نمایش</a>
                                            @if (item.IsOwnedByCurrentUser || User.IsInRole("Admin"))
                                            {
                                                <form asp-action="UnarchiveContract" asp-route-id="@item.Id" method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success">خروج از
                                                        بایگانی</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer text-muted small px-3 py-2">
                        @Model.FilteredCount مورد نمایش‌داده‌شده
                    </div>
                }
            else
                {
                    <div class="text-center text-muted py-3 small">هیچ قرارداد بایگانی‌شده‌ای یافت نشد.</div>
                }
            </div>
        </div>
    </div>