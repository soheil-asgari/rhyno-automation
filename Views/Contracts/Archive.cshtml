@model ContractArchiveVM
@using OfficeAutomation.Modules.InvoiceStructuring
@{
    ViewData["Title"] = "بایگانی قراردادها";
}

<div class="container-fluid py-1 space-y-2" dir="rtl">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 dark:border-emerald-900/40 dark:bg-emerald-950/20 px-3.5 py-2.5 text-[11px] text-emerald-700 dark:text-emerald-400 mb-3 flex items-center gap-2">
            <i class="bi bi-check-circle-fill text-emerald-500"></i>
            <span>@successMsg</span>
        </div>
    }

    @* Section Header *@
    <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between px-1">
        <div>
            <h1 class="text-[13px] font-bold text-slate-900 dark:text-white">بایگانی قراردادها</h1>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">@Model.FilteredCount مورد از @Model.TotalCount کل قراردادها</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <a asp-action="Index" class="erp-btn hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 no-underline transition">
                <i class="bi bi-list-ul ml-1"></i>قراردادهای فعال
            </a>
        </div>
    </div>

    @* Filter Card *@
    <div class="erp-fieldset">
        <form method="get" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-2 items-end">
            <div class="col-span-2 md:col-span-1">
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">جستجو</label>
                <input name="SearchTerm" value="@Model.SearchTerm" class="erp-input" placeholder="عنوان / شماره / مشتری" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">وضعیت</label>
                <select name="Status" class="erp-input" asp-items="Model.StatusOptions">
                    <option value="">همه</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">نوع قرارداد</label>
                <select name="ContractType" class="erp-input" asp-items="Model.ContractTypeOptions">
                    <option value="">همه</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">وضعیت پرداخت</label>
                <select name="PaymentStatus" class="erp-input" asp-items="Model.PaymentStatusOptions">
                    <option value="">همه</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">مسئول</label>
                <select name="AssignedUserId" class="erp-input" asp-items="Model.ResponsibleUserOptions">
                    <option value="">همه</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">از تاریخ شروع</label>
                <div class="relative jalali-datepicker-wrapper">
                    <input type="text" class="erp-input jalali-date-input cursor-pointer" data-jalali="StartDateFrom" placeholder="انتخاب تاریخ" value="@(Model.StartDateFrom.HasValue ? JalaliDateHelper.ToShamsiString(Model.StartDateFrom.Value) : "")" readonly />
                    <input type="hidden" name="StartDateFrom" class="jalali-date-hidden" value="@Model.StartDateFrom?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">تا تاریخ شروع</label>
                <div class="relative jalali-datepicker-wrapper">
                    <input type="text" class="erp-input jalali-date-input cursor-pointer" data-jalali="StartDateTo" placeholder="انتخاب تاریخ" value="@(Model.StartDateTo.HasValue ? JalaliDateHelper.ToShamsiString(Model.StartDateTo.Value) : "")" readonly />
                    <input type="hidden" name="StartDateTo" class="jalali-date-hidden" value="@Model.StartDateTo?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="flex gap-1">
                <button class="h-7 rounded-lg bg-teal-600 px-3 text-[11px] font-black text-white shadow-sm transition hover:bg-teal-700">
                    <i class="bi bi-funnel ml-1"></i>اعمال
                </button>
                <a asp-action="Archive" class="h-7 rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-[11px] font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 no-underline transition flex items-center">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    @* Data Table *@
    <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
        @if (Model.Items.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-[11px]">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/30">
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">#</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">شماره قرارداد</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">عنوان</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">مشتری</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">نوع</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">مبلغ کل</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">پرداخت‌شده</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">باقی‌مانده</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">وضعیت پرداخت</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">تاریخ شروع</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">تاریخ پایان</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">تاریخ بایگانی</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">بایگانی‌کننده</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">وضعیت</th>
                            <th class="text-right px-3 py-2 font-bold text-slate-500 dark:text-slate-400">مسئول</th>
                            <th class="text-center px-3 py-2 font-bold text-slate-500 dark:text-slate-400">عملیات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 dark:divide-slate-800/60">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                                <td class="px-3 py-2 text-slate-500">@item.Id</td>
                                <td class="px-3 py-2 font-bold text-slate-800 dark:text-slate-200">@item.ContractNumber</td>
                                <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@item.Title</td>
                                <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@(item.CustomerName ?? item.ClientName)</td>
                                <td class="px-3 py-2">
                                    <span class="inline-flex items-center rounded-md bg-slate-50 dark:bg-slate-800 px-2 py-0.5 text-[9px] font-bold text-slate-600 dark:text-slate-400 border border-slate-200/50 dark:border-slate-700">@(item.ContractType ?? "-")</span>
                                </td>
                                <td class="px-3 py-2 font-mono tabular-nums text-slate-800 dark:text-slate-200 font-bold">@item.TotalAmount.ToString("N0")</td>
                                <td class="px-3 py-2 font-mono tabular-nums text-emerald-600 dark:text-emerald-400">@item.PaidAmount.ToString("N0")</td>
                                <td class="px-3 py-2 font-mono tabular-nums text-rose-600 dark:text-rose-400">@item.RemainingBalance.ToString("N0")</td>
                                <td class="px-3 py-2">
                                    @{
                                        var archivePayBadge = item.PaymentStatus switch
                                        {
                                            "FullyPaid" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/40",
                                            "PartiallyPaid" => "bg-amber-100 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300 border-amber-200 dark:border-amber-800/40",
                                            _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700"
                                        };
                                        var archivePayText = item.PaymentStatus switch
                                        {
                                            "FullyPaid" => "تسویه شده",
                                            "PartiallyPaid" => "جزئی",
                                            _ => "پرداخت نشده"
                                        };
                                    }
                                    <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold border @archivePayBadge">@archivePayText</span>
                                </td>
                                <td class="px-3 py-2 font-mono tabular-nums text-slate-600 dark:text-slate-400">@JalaliDateHelper.ToShamsiString(item.StartDate)</td>
                                <td class="px-3 py-2 font-mono tabular-nums text-slate-600 dark:text-slate-400">@(item.EndDate.HasValue ? JalaliDateHelper.ToShamsiString(item.EndDate.Value) : "-")</td>
                                <td class="px-3 py-2 font-mono tabular-nums text-slate-600 dark:text-slate-400">@(item.ArchivedAt.HasValue ? JalaliDateHelper.ToShamsiString(item.ArchivedAt.Value) : "-")</td>
                                <td class="px-2 py-1.5 text-[11px] text-slate-600 dark:text-slate-400">@(item.ArchivedByUserName ?? "-")</td>
                                <td class="px-3 py-2">
                                    @{
                                        var archiveBadge = item.Status switch
                                        {
                                            var s when s == ContractStatuses.Archived => "bg-amber-100 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300 border-amber-200 dark:border-amber-800/40",
                                            var s when s == ContractStatuses.Active => "bg-emerald-100 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/40",
                                            _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700"
                                        };
                                    }
                                    <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold border @archiveBadge">@item.Status</span>
                                </td>
                                <td class="px-2 py-1.5 text-[11px] text-slate-600 dark:text-slate-400">@item.ResponsibleUserName</td>
                                <td class="px-3 py-2 text-center">
                                    <div class="inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="erp-btn text-[9px] px-1.5 py-0.5 h-5 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 no-underline transition" title="نمایش">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.IsOwnedByCurrentUser || User.IsInRole("Admin"))
                                        {
                                            <form asp-action="UnarchiveContract" asp-route-id="@item.Id" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="erp-btn text-[9px] px-1.5 py-0.5 h-5 hover:bg-emerald-50 hover:text-emerald-600 hover:border-emerald-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-emerald-950/20 dark:hover:text-emerald-400 transition" title="خروج از بایگانی">
                                                    <i class="bi bi-box-arrow-up"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="px-2 py-1.5 border-t border-slate-100 dark:border-slate-800 text-[10px] text-slate-500 dark:text-slate-400">
                @Model.FilteredCount مورد نمایش‌داده‌شده
            </div>
        }
        else
        {
            <div class="text-center py-8">
                <div class="inline-flex items-center justify-center h-9 w-9 rounded-full bg-slate-100 dark:bg-slate-800 mb-3">
                    <i class="bi bi-archive text-slate-400 text-lg"></i>
                </div>
                <h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-1">هیچ قرارداد بایگانی‌شده‌ای یافت نشد</h3>
                <p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ قراردادی در بایگانی وجود ندارد.</p>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/persian-datepicker.min.css" />
    <link rel="stylesheet" href="~/css/contracts-archive-style.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/persian-date.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var PERSIAN_MONTHS = ['فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور', 'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند'];
            var PERSIAN_WEEKDAYS = ['ش', 'ی', 'د', 'س', 'چ', 'پ', 'ج'];

            function toPersianDigits(str) { return String(str).replace(/\d/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'[d]; }); }

            function writeJalaliToHidden(input, jalali) {
                var wrapper = input.closest('.jalali-datepicker-wrapper');
                var hidden = wrapper ? wrapper.querySelector('input.jalali-date-hidden') : null;
                if (hidden) {
                    if (!jalali) { hidden.value = ''; return; }
                    try {
                        var parts = jalali.trim().split('/');
                        if (parts.length === 3) {
                            var y = parseInt(parts[0], 10), m = parseInt(parts[1], 10), d = parseInt(parts[2], 10);
                            if (!isNaN(y) && !isNaN(m) && !isNaN(d) && typeof persianDate !== 'undefined') {
                                var pd = new persianDate([y, m, d]);
                                var g = pd.toDate();
                                hidden.value = g.getFullYear() + '-' + String(g.getMonth() + 1).padStart(2, '0') + '-' + String(g.getDate()).padStart(2, '0');
                            }
                        }
                    } catch (e) { }
                }
            }

            function createDatepicker(input) {
                var wrapper = input.closest('.jalali-datepicker-wrapper') || input.parentElement;
                if (!wrapper) return;
                wrapper.style.position = 'relative';

                var popup = wrapper.querySelector('.vanilla-jalali-popup');
                if (!popup) {
                    popup = document.createElement('div');
                    popup.className = 'vanilla-jalali-popup';
                    wrapper.appendChild(popup);
                }

                var viewYear = 0, viewMonth = 0;

                function render() {
                    if (typeof persianDate === 'undefined') return;
                    var today = new persianDate();
                    if (!viewYear) viewYear = today.year();
                    if (!viewMonth) viewMonth = today.month();

                    var daysInMonth = today.daysInMonth(viewYear, viewMonth);
                    var firstWeekday = today.getFirstWeekDayOfMonth(viewYear, viewMonth);

                    var html = '<div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;border-bottom:1px solid #f1f5f9;">';
                    html += '<button type="button" class="vjp-nav-btn" data-nav="prev">&rsaquo;</button>';
                    html += '<span style="font-size:12px;font-weight:700;color:#334155;">' + PERSIAN_MONTHS[viewMonth - 1] + ' ' + toPersianDigits(viewYear) + '</span>';
                    html += '<button type="button" class="vjp-nav-btn" data-nav="next">&lsaquo;</button>';
                    html += '</div>';

                    html += '<div style="display:grid;grid-template-columns:repeat(7,1fr);padding:4px 6px;border-bottom:1px solid #f1f5f9;">';
                    PERSIAN_WEEKDAYS.forEach(function (w) {
                        html += '<div style="text-align:center;font-size:10px;font-weight:700;color:#94a3b8;padding:2px 0;">' + w + '</div>';
                    });
                    html += '</div>';

                    html += '<div style="display:grid;grid-template-columns:repeat(7,1fr);padding:6px;">';
                    for (var i = 0; i < firstWeekday; i++) { html += '<div></div>'; }
                    for (var day = 1; day <= daysInMonth; day++) {
                        var isToday = (day === today.date() && viewMonth === today.month() && viewYear === today.year());
                        html += '<button type="button" class="vjp-day-btn' + (isToday ? ' is-today' : '') + '" data-day="' + day + '">' + toPersianDigits(day) + '</button>';
                    }
                    html += '</div>';

                    popup.innerHTML = html;

                    popup.querySelector('[data-nav="prev"]')?.addEventListener('click', function (e) {
                        e.stopPropagation(); e.preventDefault();
                        viewMonth--; if (viewMonth < 1) { viewMonth = 12; viewYear--; } render();
                    });
                    popup.querySelector('[data-nav="next"]')?.addEventListener('click', function (e) {
                        e.stopPropagation(); e.preventDefault();
                        viewMonth++; if (viewMonth > 12) { viewMonth = 1; viewYear++; } render();
                    });
                    popup.querySelectorAll('[data-day]').forEach(function (btn) {
                        btn.addEventListener('click', function (e) {
                            e.stopPropagation(); e.preventDefault();
                            var day = parseInt(btn.getAttribute('data-day'), 10);
                            var selected = new persianDate([viewYear, viewMonth, day]);
                            var jalali = selected.format('YYYY/MM/DD');
                            input.value = jalali;
                            writeJalaliToHidden(input, jalali);
                            popup.style.display = 'none';
                        });
                    });
                }

                input.addEventListener('click', function (e) {
                    e.stopPropagation();
                    document.querySelectorAll('.vanilla-jalali-popup').forEach(function (p) { if (p !== popup) p.style.display = 'none'; });
                    viewYear = 0; viewMonth = 0;
                    render();
                    popup.style.display = 'block';
                });
            }

            document.querySelectorAll('.jalali-date-input').forEach(createDatepicker);
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.jalali-datepicker-wrapper')) {
                    document.querySelectorAll('.vanilla-jalali-popup').forEach(function (p) { p.style.display = 'none'; });
                }
            });
        });
    </script>
}