@model ContractCreateVM
@{
    ViewData["Title"] = "ایجاد قرارداد جدید";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">ایجاد قرارداد جدید</h6>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">بازگشت</a>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <h6 class="fw-bold small text-muted mb-2">اطلاعات عمومی</h6>
                <div class="row g-2 mb-3">
                    <div class="col-md-3">
                        <label asp-for="ContractNumber" class="form-label small"></label>
                        <input asp-for="ContractNumber" class="form-control form-control-sm" />
                        <span asp-validation-for="ContractNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Title" class="form-label small"></label>
                        <input asp-for="Title" class="form-control form-control-sm" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="ContractType" class="form-label small"></label>
                        <select asp-for="ContractType" class="form-select form-select-sm"
                                asp-items="Model.ContractTypeOptions">
                            <option value="">انتخاب کنید</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Status" class="form-label small"></label>
                        <select asp-for="Status" class="form-select form-select-sm"
                                asp-items="Model.StatusOptions"></select>
                    </div>
                </div>

                <h6 class="fw-bold small text-muted mb-2">مشتری / طرف قرارداد</h6>
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label asp-for="CustomerId" class="form-label small"></label>
                        <select asp-for="CustomerId" class="form-select form-select-sm"
                                asp-items="Model.CustomerOptions">
                            <option value="">بدون مشتری (ثبت دستی)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ClientName" class="form-label small"></label>
                        <input asp-for="ClientName" class="form-control form-control-sm" />
                        <span asp-validation-for="ClientName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="ClientPhone" class="form-label small"></label>
                        <input asp-for="ClientPhone" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="ClientAddress" class="form-label small"></label>
                        <input asp-for="ClientAddress" class="form-control form-control-sm" />
                    </div>
                </div>

                <h6 class="fw-bold small text-muted mb-2">تاریخ‌ها</h6>
                <div class="row g-2 mb-3">
                    <div class="col-md-2">
                        <label asp-for="StartDate" class="form-label small"></label>
                        <input asp-for="StartDate" type="date" class="form-control form-control-sm" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="EndDate" class="form-label small"></label>
                        <input asp-for="EndDate" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="SigningDate" class="form-label small"></label>
                        <input asp-for="SigningDate" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="RenewalDate" class="form-label small"></label>
                        <input asp-for="RenewalDate" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="ExpirationDate" class="form-label small"></label>
                        <input asp-for="ExpirationDate" type="date" class="form-control form-control-sm" />
                    </div>
                </div>

                <h6 class="fw-bold small text-muted mb-2">مالی</h6>
                <div class="row g-2 mb-3">
                    <div class="col-md-3">
                        <label asp-for="TotalAmount" class="form-label small"></label>
                        <input asp-for="TotalAmount" class="form-control form-control-sm" />
                        <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                    </div>
                </div>

                <h6 class="fw-bold small text-muted mb-2">اختصاص</h6>
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label asp-for="ResponsibleUserId" class="form-label small"></label>
                        <select asp-for="ResponsibleUserId" class="form-select form-select-sm"
                                asp-items="Model.UserOptions">
                            <option value="">انتخاب کنید</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ContractTemplateId" class="form-label small"></label>
                        <select asp-for="ContractTemplateId" class="form-select form-select-sm"
                                asp-items="Model.TemplateOptions">
                            <option value="">بدون قالب</option>
                        </select>
                    </div>
                </div>

                <h6 class="fw-bold small text-muted mb-2">متن قرارداد</h6>
                <div class="row g-2 mb-3">
                    <div class="col-12">
                        <label asp-for="Description" class="form-label small"></label>
                        <textarea asp-for="Description" class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TermsAndConditions" class="form-label small"></label>
                        <textarea asp-for="TermsAndConditions" class="form-control form-control-sm" rows="4"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Notes" class="form-label small"></label>
                        <textarea asp-for="Notes" class="form-control form-control-sm" rows="4"></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-success">ذخیره</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">بازگشت</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}