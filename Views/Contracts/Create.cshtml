@model ContractCreateVM
@{
    ViewData["Title"] = "ایجاد قرارداد جدید";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contracts-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/persian-datepicker.min.css" />
    <link rel="stylesheet" href="~/css/contracts-create-style.css" asp-append-version="true" />
}

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 shadow-sm mb-6">
    <!-- Breadcrumb inside card -->
    <div class="mb-3">
        <partial name="_Breadcrumb" model='new[] {
                                                                           new RhynoBreadcrumbItem("خانه", "/"),
                                                                           new RhynoBreadcrumbItem("قراردادها", "/Contracts"),
                                                                           new RhynoBreadcrumbItem("ایجاد قرارداد", null)
                                                                       }' />
</div>

    <!-- Header -->
    <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-3.5">
            <div
                class="w-11 h-11 rounded-xl bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 flex items-center justify-center text-2xl border border-teal-100 dark:border-teal-900/50 shadow-sm">
                <i class="bi bi-file-earmark-plus"></i>
            </div>
            <div>
                <h1 class="text-base font-bold text-slate-800 dark:text-slate-100">ایجاد قرارداد جدید</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">اطلاعات قرارداد را در سه گام مشخص و منظم
                    ثبت کنید.</p>
                </div>
            </div>
            <a asp-action="Index"
               class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700/50 border border-slate-200 dark:border-slate-700 px-3.5 py-2 rounded-lg transition-colors">
                <i class="bi bi-arrow-right text-sm"></i>
                <span>بازگشت به فهرست</span>
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post" id="contractCreateForm">
        @Html.AntiForgeryToken()

        <!-- Validation Summary -->
        <div asp-validation-summary="All"
             class="hidden empty:hidden text-xs text-red-600 bg-red-50 border border-red-200 rounded-lg p-3 mb-6 dark:bg-red-950/30 dark:border-red-800 dark:text-red-400">
        </div>

        <!-- Wizard Steps Navigation Header -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 shadow-sm mb-6">
            <div class="relative max-w-2xl mx-auto px-6 py-1">
                <!-- Connecting Line -->
                <div class="absolute top-5 left-12 right-12 h-0.5 bg-slate-200 dark:bg-slate-800">
                    <div id="wizardProgressLine" class="h-full bg-teal-600 transition-all duration-300" style="width: 0%;">
                    </div>
                </div>

                <!-- Steps Container -->
                <div class="flex items-center justify-between relative z-10">
                    <!-- Step 1 -->
                    <button type="button"
                            class="wizard-step-btn group flex flex-col items-center cursor-pointer focus:outline-none"
                            data-step="1">
                        <span
                            class="step-badge w-10 h-10 rounded-full flex items-center justify-center text-xs font-bold ring-4 ring-white dark:ring-slate-900 bg-teal-600 text-white shadow-sm transition-all">
                            1
                        </span>
                        <span
                            class="step-label text-xs font-bold text-teal-600 dark:text-teal-400 mt-2.5 transition-colors">
                            اطلاعات اصلی و مشتری
                        </span>
                    </button>

                    <!-- Step 2 -->
                    <button type="button"
                            class="wizard-step-btn group flex flex-col items-center cursor-pointer focus:outline-none"
                            data-step="2">
                        <span
                            class="step-badge w-10 h-10 rounded-full flex items-center justify-center text-xs font-bold ring-4 ring-white dark:ring-slate-900 bg-slate-100 dark:bg-slate-800 text-slate-400 border border-slate-300 dark:border-slate-700 transition-all">
                            2
                        </span>
                        <span
                            class="step-label text-xs font-medium text-slate-400 dark:text-slate-500 mt-2.5 transition-colors">
                            تاریخ‌ها و مالی
                        </span>
                    </button>

                    <!-- Step 3 -->
                    <button type="button"
                            class="wizard-step-btn group flex flex-col items-center cursor-pointer focus:outline-none"
                            data-step="3">
                        <span
                            class="step-badge w-10 h-10 rounded-full flex items-center justify-center text-xs font-bold ring-4 ring-white dark:ring-slate-900 bg-slate-100 dark:bg-slate-800 text-slate-400 border border-slate-300 dark:border-slate-700 transition-all">
                            3
                        </span>
                        <span
                            class="step-label text-xs font-medium text-slate-400 dark:text-slate-500 mt-2.5 transition-colors">
                            محتوا و شرایط
                        </span>
                    </button>
                </div>
            </div>
        </div>
        <!-- STEP 1: General & Client Info -->
        <div class="wizard-step-content active" data-step-panel="1">
            <div
                class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm space-y-6">
                <div>
                    <h2
                        class="text-sm font-bold text-slate-800 dark:text-slate-200 mb-4 pb-2 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
                        <i class="bi bi-info-circle text-teal-600"></i> مشخصات اصلی قرارداد
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label asp-for="ContractNumber"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <input asp-for="ContractNumber"
                                   class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500" />
                            <span asp-validation-for="ContractNumber" class="text-[11px] text-red-500 mt-1 block"></span>
                        </div>
                        <div class="md:col-span-2">
                            <label asp-for="Title"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <input asp-for="Title"
                                   class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500" />
                            <span asp-validation-for="Title" class="text-[11px] text-red-500 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="ContractType"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <select asp-for="ContractType"
                                    class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500"
                                    asp-items="Model.ContractTypeOptions">
                                <option value="">انتخاب کنید</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="Status"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <select asp-for="Status"
                                    class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500"
                                    asp-items="Model.StatusOptions"></select>
                        </div>
                        <div>
                            <label asp-for="ExpiryNoticeDays"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <input asp-for="ExpiryNoticeDays" type="number"
                                   class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500" />
                        </div>
                    </div>
                </div>

                <div>
                    <h2
                        class="text-sm font-bold text-slate-800 dark:text-slate-200 mb-4 pb-2 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
                        <i class="bi bi-people text-teal-600"></i> مشخصات طرف قرارداد (مشتری)
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="CustomerId"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <select asp-for="CustomerId"
                                    class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500"
                                    asp-items="Model.CustomerOptions">
                                <option value="">بدون مشتری (ثبت دستی)</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="ClientName"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <input asp-for="ClientName"
                                   class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500" />
                            <span asp-validation-for="ClientName" class="text-[11px] text-red-500 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="ClientPhone"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <input asp-for="ClientPhone"
                                   class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500" />
                        </div>
                        <div>
                            <label asp-for="ClientAddress"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <input asp-for="ClientAddress"
                                   class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- STEP 2: Dates, Financials & Assignment -->
        <div class="wizard-step-content" data-step-panel="2">
            <div
                class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm space-y-6">
                <div>
                    <h2
                        class="text-sm font-bold text-slate-800 dark:text-slate-200 mb-4 pb-2 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
                        <i class="bi bi-calendar3 text-teal-600"></i> زمان‌بندی و مبالغ
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div>
                            <label asp-for="StartDate"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <div class="relative jalali-datepicker-wrapper">
                                <input asp-for="StartDateDisplay" type="text"
                                       class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500 jalali-date-input cursor-pointer"
                                       data-jalali="StartDate" placeholder="انتخاب تاریخ" readonly />
                                <input asp-for="StartDate" type="hidden" class="jalali-date-hidden" />
                            </div>
                            <span asp-validation-for="StartDate" class="text-[11px] text-red-500 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="EndDate"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <div class="relative jalali-datepicker-wrapper">
                                <input asp-for="EndDateDisplay" type="text"
                                       class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500 jalali-date-input cursor-pointer"
                                       data-jalali="EndDate" placeholder="انتخاب تاریخ" readonly />
                                <input asp-for="EndDate" type="hidden" class="jalali-date-hidden" />
                            </div>
                            <span asp-validation-for="EndDate" class="text-[11px] text-red-500 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="SignDate"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <div class="relative jalali-datepicker-wrapper">
                                <input asp-for="SignDateDisplay" type="text"
                                       class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500 jalali-date-input cursor-pointer"
                                       data-jalali="SignDate" placeholder="انتخاب تاریخ" readonly />
                                <input asp-for="SignDate" type="hidden" class="jalali-date-hidden" />
                            </div>
                            <span asp-validation-for="SignDate" class="text-[11px] text-red-500 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="TotalAmount"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <input asp-for="TotalAmount"
                                   class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500" />
                            <span asp-validation-for="TotalAmount" class="text-[11px] text-red-500 mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <div>
                    <h2
                        class="text-sm font-bold text-slate-800 dark:text-slate-200 mb-4 pb-2 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
                        <i class="bi bi-person-badge text-teal-600"></i> ارجاع و قالب
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="AssignedUserId"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <select asp-for="AssignedUserId"
                                    class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500"
                                    asp-items="Model.UserOptions">
                                <option value="">انتخاب کنید</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="TemplateId"
                                   class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"></label>
                            <select asp-for="TemplateId" id="TemplateId"
                                    class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500"
                                    asp-items="Model.TemplateOptions">
                                <option value="">بدون قالب</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- STEP 3: Content & Terms -->
        <div class="wizard-step-content" data-step-panel="3">
            <div
                class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">توضیحات</label>
                        <textarea asp-for="Description" rows="3"
                                  class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500"></textarea>
                        <span asp-validation-for="Description" class="text-[11px] text-red-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">یادداشت‌ها</label>
                        <textarea asp-for="Notes" rows="3"
                                  class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500"></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">شرایط و
                            ضوابط</label>
                            <textarea asp-for="TermsAndConditions" rows="3"
                                      class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-950 focus:outline-none focus:border-teal-500"></textarea>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-800 dark:text-slate-200 mb-2">متن قرارداد (ویرایشگر
                            بصری)</label>

                            <!-- WYSIWYG Toolbar -->
                            <div
                                class="flex flex-wrap items-center gap-1 p-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-t-lg">
                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="bold" title="ضخیم"><i class="bi bi-type-bold"></i></button>
                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="italic" title="کج"><i class="bi bi-type-italic"></i></button>
                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="underline" title="زیرخط"><i class="bi bi-type-underline"></i></button>
                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="strikeThrough" title="خط‌خورده"><i class="bi bi-type-strikethrough"></i></button>

                                <div class="w-px h-4 bg-slate-300 dark:bg-slate-700 mx-1"></div>

                                <select
                                    class="px-2 py-1 text-xs border border-slate-200 dark:border-slate-800 rounded bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300"
                                    onchange="changeFontSize(this.value)">
                                    <option value="1">خیلی کوچک</option>
                                    <option value="2">کوچک</option>
                                    <option value="3" selected>معمولی</option>
                                    <option value="4">متوسط</option>
                                    <option value="5">بزرگ</option>
                                </select>

                                <div class="w-px h-4 bg-slate-300 dark:bg-slate-700 mx-1"></div>

                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="insertOrderedList" title="لیست شماره‌دار"><i class="bi bi-list-ol"></i></button>
                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="insertUnorderedList" title="لیست نقطه‌ای"><i class="bi bi-list-ul"></i></button>

                                <div class="w-px h-4 bg-slate-300 dark:bg-slate-700 mx-1"></div>

                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="justifyRight" title="راست‌چین"><i class="bi bi-text-right"></i></button>
                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="justifyCenter" title="وسط‌چین"><i class="bi bi-text-center"></i></button>
                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="justifyLeft" title="چپ‌چین"><i class="bi bi-text-left"></i></button>

                                <div class="w-px h-4 bg-slate-300 dark:bg-slate-700 mx-1"></div>

                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        onclick="insertImage()" title="تصویر"><i class="bi bi-image"></i></button>
                                <input type="file" id="imageUploadInput" accept="image/*" class="hidden"
                                       onchange="handleImageUpload(event)">
                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        onclick="insertTable()" title="جدول"><i class="bi bi-table"></i></button>
                                <button type="button"
                                        class="wysiwyg-btn p-1.5 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded"
                                        data-cmd="removeFormat" title="حذف استایل"><i class="bi bi-eraser"></i></button>
                            </div>

                            <!-- Editor Body -->
                            <div id="createContractEditor" contenteditable="true"
                                 class="min-h-[220px] max-h-[450px] overflow-y-auto p-4 border border-t-0 border-slate-200 dark:border-slate-800 rounded-b-lg bg-white dark:bg-slate-950 text-xs leading-relaxed focus:outline-none">
                            </div>
                            <textarea asp-for="ContractBodyHtml" class="hidden" id="ContractBodyHtml"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Wizard Navigation & Actions Footer -->
                <!-- Wizard Navigation & Actions Footer -->
                <div
                    class="flex items-center justify-between mt-6 mb-28 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 shadow-sm relative z-10">
                    <button type="button" id="prevStepBtn"
                            class="hidden px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer">
                        <i class="bi bi-chevron-right ml-1"></i> گام قبلی
                    </button>
                    <div class="flex-1"></div>
                    <button type="button" id="nextStepBtn"
                            class="px-5 py-2 text-xs font-semibold text-white bg-teal-600 rounded-lg hover:bg-teal-700 transition cursor-pointer">
                        گام بعدی <i class="bi bi-chevron-left mr-1"></i>
                    </button>
                    <button type="submit" id="submitFormBtn"
                            class="hidden px-5 py-2 text-xs font-bold text-white bg-teal-600 rounded-lg hover:bg-teal-700 transition shadow-sm cursor-pointer">
                        <i class="bi bi-check-lg ml-1"></i> ثبت قرارداد
                    </button>
                </div>
            </form>
        </div>

