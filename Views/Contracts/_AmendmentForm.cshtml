@model AmendmentCreateVM
@{
    Layout = null;
}

<div class="fixed inset-0 z-50 bg-black/50 hidden flex items-center justify-center p-4 backdrop-blur-sm transition-all" id="amendmentModal" data-modal-container>
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 w-full max-w-lg overflow-hidden transition-all transform scale-100">
        @* Modal Header *@
        <div class="bg-slate-50/80 dark:bg-slate-800/80 px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center font-bold text-sm">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <h3 class="text-sm font-black text-slate-900 dark:text-white">ثبت اصلاحیه / الحاقیه جدید</h3>
            </div>
            <button type="button" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition cursor-pointer border-0 bg-transparent" data-close-modal title="بستن">&times;</button>
        </div>

        @* Modal Form *@
        <form asp-action="CreateAmendment" asp-route-contractId="@Model.ContractId" method="post" enctype="multipart/form-data" data-guard-submit>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ContractId" />

            <div class="p-5 space-y-4 text-right" dir="rtl">
                @* 1. عنوان اصلاحیه *@
                <div>
                    <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">عنوان اصلاحیه / الحاقیه <span class="text-rose-500">*</span></label>
                    <input asp-for="Title" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none transition" placeholder="عنوان مانند: الحاقیه افزایش مبلغ و تمدید زمان" required />
                    <span asp-validation-for="Title" class="text-[10px] text-rose-500 mt-1 block"></span>
                </div>

                @* 2. نوع اصلاحیه *@
                <div>
                    <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">نوع اصلاحیه <span class="text-rose-500">*</span></label>
                    <select asp-for="AmendmentType" id="amendmentTypeSelect" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none transition">
                        <option value="Renewal">تمدید زمان قرارداد</option>
                        <option value="AmountIncrease">افزایش مبلغ قرارداد</option>
                        <option value="AmountDecrease">کاهش مبلغ قرارداد</option>
                        <option value="TermsChange">تغییر شروط و بندها</option>
                        <option value="Amendment">اصلاحیه عمومی</option>
                        <option value="Addendum">الحاقیه کلی</option>
                    </select>
                    <span asp-validation-for="AmendmentType" class="text-[10px] text-rose-500 mt-1 block"></span>
                </div>

                @* 3. تاریخ مؤثر & تاریخ پایان جدید *@
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">تاریخ مؤثر / تاریخ الحاقیه <span class="text-rose-500">*</span></label>
                        <div class="relative jalali-datepicker-wrapper">
                            <input type="text" id="amendmentEffectiveDate" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none jalali-input jalali-date-input cursor-pointer" data-jalali="EffectiveDate" placeholder="۱۴۰۳/۰۱/۰۱" readonly required />
                            <input type="hidden" name="EffectiveDate" id="amendmentEffectiveDateHidden" class="jalali-date-hidden" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div>
                        <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">تاریخ پایان جدید (اختیاری)</label>
                        <div class="relative jalali-datepicker-wrapper">
                            <input type="text" id="amendmentNewEndDate" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none jalali-input jalali-date-input cursor-pointer" data-jalali="NewEndDate" placeholder="۱۴۰۳/۱۲/۲۹" readonly />
                            <input type="hidden" name="NewEndDate" id="amendmentNewEndDateHidden" class="jalali-date-hidden" />
                        </div>
                    </div>
                </div>

                @* 4. مبلغ اصلاحیه *@
                <div>
                    <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">مبلغ اصلاحیه (اختیاری)</label>
                    <div class="relative">
                        <input asp-for="AmountChange" type="number" step="1" id="amendmentAmountChange" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 pl-12 text-xs focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none font-mono tabular-nums" placeholder="۰ (مثبت = افزایش / منفی = کاهش)" />
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-bold text-slate-400">تومان</span>
                    </div>
                    <span asp-validation-for="AmountChange" class="text-[10px] text-rose-500 mt-1 block"></span>
                </div>

                @* 5. فایل ضمیمه الحاقیه *@
                <div>
                    <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">فایل ضمیمه الحاقیه (اختیاری)</label>
                    <input type="file" name="attachmentFile" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-1.5 text-xs focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none file:mr-0 file:ml-2 file:border-0 file:bg-teal-500/10 file:text-teal-600 file:rounded-lg file:px-2.5 file:py-1 file:text-[10px] file:font-bold hover:file:bg-teal-500/20 transition cursor-pointer" accept=".pdf,.doc,.docx,.jpg,.png,.zip" />
                    <p class="text-[10px] text-slate-400 mt-1">فرمت‌های مجاز: PDF, Word, تصویر یا فایل فشرده</p>
                </div>

                @* 6. شرح و دلایل اصلاحیه *@
                <div>
                    <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">شرح و دلایل اصلاحیه</label>
                    <textarea asp-for="Description" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none resize-y transition" rows="3" placeholder="توضیحات جامع درباره دلایل و جزئیات تغییرات قرارداد..."></textarea>
                </div>

                @* 7. نیاز به تایید *@
                <div class="flex items-center gap-2 pt-1">
                    <input asp-for="RequiresApproval" type="checkbox" id="amendmentRequiresApproval" class="rounded border-slate-300 dark:border-slate-700 text-teal-600 focus:ring-teal-500/20 w-4 h-4 cursor-pointer" />
                    <label for="amendmentRequiresApproval" class="text-xs text-slate-700 dark:text-slate-300 font-medium cursor-pointer">ارسال جهت تایید و دریافت موافقت مدیریت قبل از اعمال</label>
                </div>
            </div>

            @* Modal Footer *@
            <div class="flex items-center justify-end gap-2 px-5 py-3.5 bg-slate-50/80 dark:bg-slate-800/80 border-t border-slate-200 dark:border-slate-800">
                <button type="button" class="erp-btn text-xs text-slate-700 hover:bg-slate-200/60 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800 transition" data-close-modal>
                    <i class="bi bi-x-lg ml-1"></i>انصراف
                </button>
                <button type="submit" class="erp-btn erp-btn-primary text-xs text-white shadow-md transition hover:bg-teal-700 flex items-center gap-1.5">
                    <i class="bi bi-check2-circle"></i>ثبت نهایی اصلاحیه
                </button>
            </div>
        </form>
    </div>
</div>