@model AmendmentCreateVM
@{
    Layout = null;
}

<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm" data-modal-container>
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-white/20 w-full max-w-lg mx-4 overflow-hidden" data-modal-content>
        <form asp-action="CreateAmendment" asp-route-contractId="@Model.ContractId" method="post" data-guard-submit>
            @Html.AntiForgeryToken()

            <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-100 dark:border-slate-800">
                <h2 class="text-sm font-black text-slate-900 dark:text-white">ایجاد اصلاحیه جدید</h2>
                <button type="button" class="h-7 w-7 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition" data-close-modal>
                    <i class="bi bi-x-lg text-[10px]"></i>
                </button>
            </div>

            <div class="p-5 space-y-3">
                <div>
                    <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">@Html.DisplayNameFor(m => m.AmendmentType)</label>
                    <select asp-for="AmendmentType" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none">
                        <option value="Amendment">اصلاحیه</option>
                        <option value="Addendum">الحاقیه</option>
                        <option value="Renewal">تمدید</option>
                    </select>
                    <span asp-validation-for="AmendmentType" class="text-[9px] text-rose-500"></span>
                </div>

                <div>
<div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">@Html.DisplayNameFor(m => m.AmountChange)</label>
                        <div class="relative">
                            <input asp-for="AmountChange" type="number" step="1" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none font-mono" placeholder="0" />
                            <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-[9px] text-slate-400">تومان</span>
                        </div>
                        <span asp-validation-for="AmountChange" class="text-[9px] text-rose-500"></span>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">@Html.DisplayNameFor(m => m.EffectiveDate)</label>
                        <input asp-for="EffectiveDate" type="date" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" />
                        <span asp-validation-for="EffectiveDate" class="text-[9px] text-rose-500"></span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">@Html.DisplayNameFor(m => m.EndDateChangeDays)</label>
                        <input asp-for="EndDateChangeDays" type="number" step="1" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none font-mono" placeholder="0" />
                        <span class="text-[9px] text-slate-400">روز</span>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">@Html.DisplayNameFor(m => m.NewEndDate)</label>
                        <input asp-for="NewEndDate" type="date" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" />
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="RequiresApproval" type="checkbox" class="rounded border-slate-300 dark:border-slate-700 text-teal-600 focus:ring-teal-500/20" />
                    <label class="text-[11px] text-slate-600 dark:text-slate-400 cursor-pointer">@Html.DisplayNameFor(m => m.RequiresApproval)</label>
                </div>
            </div>

            <div class="flex gap-2 justify-end px-5 py-3 border-t border-slate-100 dark:border-slate-800">
                <button type="submit" class="erp-btn erp-btn-primary text-[11px] text-white shadow-sm transition hover:bg-teal-700">
                    <i class="bi bi-check2 ml-1"></i>ایجاد اصلاحیه
                </button>
                <button type="button" class="erp-btn text-[11px] text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 transition" data-close-modal>
                    <i class="bi bi-x-lg ml-1"></i>انصراف
                </button>
            </div>
        </form>
    </div>
</div>
                    <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">@Html.DisplayNameFor(m => m.Title)</label>
                    <input asp-for="Title" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="عنوان اصلاحیه" />
                    <span asp-validation-for="Title" class="text-[9px] text-rose-500"></span>
                </div>

                <div>
                    <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">@Html.DisplayNameFor(m => m.Description)</label>
                    <textarea asp-for="Description" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none resize-y" rows="3" placeholder="شرح اصلاحیه"></textarea>
                </div>