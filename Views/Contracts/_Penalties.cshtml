@model PenaltySectionVM
@using System.Globalization
@{
    bool canEdit = ViewBag.CanEdit ?? false;
    int contractId = ViewBag.ContractId;
    var penaltyTypes = ViewBag.PenaltyTypeOptions as List<SelectListItem> ?? new();
    var capTypes = ViewBag.CapTypeOptions as List<SelectListItem> ?? new();
}
<div class="bg-white dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700/40 p-3 mt-3">
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-[12px] font-bold text-slate-800 dark:text-slate-200">
            <i class="bi bi-exclamation-triangle ml-1 text-amber-500"></i>Ã—Ì„Â œÌ—ò—œ
        </h3>
        @if (canEdit) {
            <button type="button" class="erp-btn erp-btn-primary text-white shadow-sm transition hover:bg-teal-700 cursor-pointer text-[10px] px-3 py-1.5" data-modal-target="penaltyRuleModal">
                <i class="bi bi-gear ml-1"></i> ‰ŸÌ„«  Ã—Ì„Â
            </button>
        }
    </div>

    @* Active Rule Summary *@
    @{
        var activeRule = Model.Rules.FirstOrDefault(r => r.IsActive);
    }
    @if (activeRule != null)
    {
        <div class="flex flex-wrap gap-3 mb-3 p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-[10px]">
            <span class="text-slate-600 dark:text-slate-400">
                <span class="font-bold text-slate-800 dark:text-slate-200">‰Ê⁄:</span> @activeRule.PenaltyTypeDisplay
            </span>
            @if (activeRule.PenaltyPercentage.HasValue)
            {
                <span class="text-slate-600 dark:text-slate-400">
                    <span class="font-bold text-slate-800 dark:text-slate-200">œ—’œ:</span> @activeRule.PenaltyPercentage%
                </span>
            }
            @if (activeRule.PenaltyAmount.HasValue)
            {
                <span class="text-slate-600 dark:text-slate-400">
                    <span class="font-bold text-slate-800 dark:text-slate-200">„»·€ À«» :</span> @activeRule.PenaltyAmount.Value.ToString("N0")
                </span>
            }
            <span class="text-slate-600 dark:text-slate-400">
                <span class="font-bold text-slate-800 dark:text-slate-200">—Ê“  ‰›”:</span> @activeRule.GracePeriodDays
            </span>
            <span class="text-slate-600 dark:text-slate-400">
                <span class="font-bold text-slate-800 dark:text-slate-200">”ﬁ›:</span> @activeRule.CapTypeDisplay @(activeRule.CapValue.HasValue ? $"({activeRule.CapValue})" : "")
            </span>
        </div>
    }
    else
    {
        <div class="text-[10px] text-slate-400 dark:text-slate-500 mb-3 p-2 rounded bg-slate-50 dark:bg-slate-900/40">
            <i class="bi bi-info-circle ml-0.5"></i>ÂÌç ﬁ«‰Ê‰ Ã—Ì„Â ›⁄«·Ì ÊÃÊœ ‰œ«—œ.
        </div>
    }

    @* Calculated Penalties Table *@
    @if (Model.Penalties.Count > 0)
    {
        <div class="overflow-x-auto">
            <table class="w-full text-[11px]">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50">
                        <th class="px-3 py-2 text-right font-bold text-slate-600 dark:text-slate-400">„»·€</th>
                        <th class="px-3 py-2 text-center font-bold text-slate-600 dark:text-slate-400"> «—ÌŒ</th>
                        <th class="px-3 py-2 text-center font-bold text-slate-600 dark:text-slate-400">Ê÷⁄Ì </th>
                        <th class="px-3 py-2 text-right font-bold text-slate-600 dark:text-slate-400">„»‰«Ì „Õ«”»Â</th>
                        @if (canEdit) {<th class="px-3 py-2 text-center font-bold text-slate-600 dark:text-slate-400">⁄„·Ì« </th>}
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Penalties)
                    {
                        <tr class="border-b border-slate-50 dark:border-slate-800/50 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition">
                            <td class="px-3 py-2 text-left font-mono tabular-nums text-slate-700 dark:text-slate-300">@p.CalculatedAmount.ToString("N0")</td>
                            <td class="px-3 py-2 text-center text-slate-500">@ToPersianDate(p.AppliedDate)</td>
                            <td class="px-3 py-2 text-center">
                                <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold border @p.BadgeClass">@p.StatusDisplay</span>
                            </td>
                            <td class="px-3 py-2 text-slate-500 text-[10px] max-w-[200px] truncate" title="@p.CalculationBasis">@(p.CalculationBasis ?? "-")</td>
                            @if (canEdit)
                            {
                                <td class="px-3 py-2 text-center">
                                    <div class="inline-flex gap-1">
                                        @if (p.Status == "Pending")
                                        {
                                            <form action="/Contracts/@contractId/Penalties/UpdateStatus/@p.Id" method="post" class="inline penalty-status-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="status" value="Waived" />
                                                <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-500 transition" title="»Œ‘ÊœêÌ">»Œ‘ÊœêÌ</button>
                                            </form>
                                        }
                                        @if (p.Status == "Pending")
                                        {
                                            <form action="/Contracts/@contractId/Penalties/UpdateStatus/@p.Id" method="post" class="inline penalty-status-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="status" value="Applied" />
                                                <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-rose-50 hover:text-rose-600 transition" title="«⁄„«·">«⁄„«·</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-6">
            <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2"><i class="bi bi-check-circle text-slate-400"></i></div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">ÂÌç Ã—Ì„Âù«Ì „Õ«”»Â ‰‘œÂ «” .</p>
        </div>
    }
</div>

@* Penalty Rule Modal *@
<div id="penaltyRuleModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/40 backdrop-blur-sm" onclick="if(event.target===this)this.classList.add('hidden')">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-2xl max-w-lg w-full mx-4 p-5" onclick="event.stopPropagation()">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-[13px] font-bold text-slate-800 dark:text-slate-200"><i class="bi bi-gear ml-1 text-amber-500"></i> ‰ŸÌ„«  ﬁ«‰Ê‰ Ã—Ì„Â</h3>
            <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 text-lg" onclick="document.getElementById('penaltyRuleModal').classList.add('hidden')">&times;</button>
        </div>
        <form id="penaltyRuleForm" action="/Contracts/@contractId/Penalties/SaveRule" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ruleId" id="penaltyRuleId" value="" />
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[10px] font-medium text-slate-600 dark:text-slate-400 mb-0.5">‰Ê⁄ Ã—Ì„Â</label>
                    <select name="PenaltyType" class="w-full rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-2 py-1.5 text-[11px]">
                        @foreach (var opt in penaltyTypes) { <option value="@opt.Value">@opt.Text</option> }
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-medium text-slate-600 dark:text-slate-400 mb-0.5">œ—’œ Ã—Ì„Â</label>
                    <input type="number" name="PenaltyPercentage" step="0.01" min="0" max="100" class="w-full rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-2 py-1.5 text-[11px]" placeholder="„À·« 2" />
                </div>
                <div>
                    <label class="block text-[10px] font-medium text-slate-600 dark:text-slate-400 mb-0.5">„»·€ À«»  Ã—Ì„Â</label>
                    <input type="number" name="PenaltyAmount" step="1" min="0" class="w-full rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-2 py-1.5 text-[11px]" placeholder="„»·€ À«» " />
                </div>
                <div>
                    <label class="block text-[10px] font-medium text-slate-600 dark:text-slate-400 mb-0.5">—Ê“Â«Ì  ‰›”</label>
                    <input type="number" name="GracePeriodDays" min="0" max="365" value="0" class="w-full rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-2 py-1.5 text-[11px]" />
                </div>
                <div>
                    <label class="block text-[10px] font-medium text-slate-600 dark:text-slate-400 mb-0.5">‰Ê⁄ ”ﬁ›</label>
                    <select name="CapType" class="w-full rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-2 py-1.5 text-[11px]">
                        @foreach (var opt in capTypes) { <option value="@opt.Value">@opt.Text</option> }
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-medium text-slate-600 dark:text-slate-400 mb-0.5">„ﬁœ«— ”ﬁ›</label>
                    <input type="number" name="CapValue" step="1" min="0" class="w-full rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-2 py-1.5 text-[11px]" placeholder="œ— ’Ê—  ‰Ì«“" />
                </div>
            </div>
            <div class="flex items-center gap-2">
                <input type="checkbox" name="IsActive" value="true" checked id="penaltyIsActive" class="rounded border-slate-300" />
                <label for="penaltyIsActive" class="text-[11px] text-slate-600 dark:text-slate-400">›⁄«·</label>
            </div>
            <div class="flex justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-700">
                <button type="button" class="px-3 py-1.5 rounded border border-slate-200 dark:border-slate-600 text-[11px] text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 transition" onclick="document.getElementById('penaltyRuleModal').classList.add('hidden')">«‰’—«›</button>
                <button type="submit" class="px-3 py-1.5 bg-teal-500 hover:bg-teal-600 text-white rounded text-[11px] font-medium transition">–ŒÌ—Â</button>
            </div>
        </form>
    </div>
</div>

@functions {
    string ToPersianDate(DateTime value) {
        if (value == DateTime.MinValue || value.Year < 1700) return "N/A";
        try { var cal = new PersianCalendar(); return $"{cal.GetYear(value):0000}/{cal.GetMonth(value):00}/{cal.GetDayOfMonth(value):00}"; } catch { return "N/A"; }
    }
}
