@* ── Attachment Preview Modal ──────────────────────────────────── *@
<partial name="_AttachmentPreview" />

@section Styles {
    <link rel="stylesheet" href="~/css/contracts-details-style.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/persian-date.min.js"></script>
    <script src="~/js/contracts-details-script.js" asp-append-version="true"></script>
    <script src="~/js/contracts-attachment-upload.js" asp-append-version="true"></script>
    <script src="~/js/contracts-attachment-preview.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var sched = document.getElementById('paymentScheduleContainer');
        if (sched) initPaymentSchedule(sched);
        var guar = document.getElementById('guaranteesContainer');
        if (guar) initGuarantees(guar);
        var pen = document.getElementById('penaltiesContainer');
        if (pen) initPenalties(pen);
    });

    // ── Payment Schedule Lazy-Load (with empty-state + error handling) ──
    function initPaymentSchedule(container) {
        var id = container.getAttribute('data-contract-id'); if (!id) return;
        function load() {
            // 1. Show skeleton only
            container.innerHTML = '<div class="schedule-skeleton space-y-2"><div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-2/3"></div></div>';
            fetch('/Contracts/Schedule/' + id)
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    var text = (html || '').trim();
                    // 2. Empty / too-short response → "no data" state
                    if (text === '' || text === '<div></div>' || text.length < 20) {
                        container.innerHTML = '<div class="text-center py-6"><div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2"><i class="bi bi-wallet2 text-slate-400"></i></div><p class="text-[11px] text-slate-400 dark:text-slate-500">برنامه پرداختی ثبت نشده است.</p><button onclick="window.reloadPaymentSchedule()" class="mt-2 text-[10px] text-teal-600 hover:text-teal-700 underline">تلاش مجدد</button></div>'
                    } else {
                        // 3. Real data
                        container.innerHTML = html;
                    }
                })
                .catch(function () {
                    container.innerHTML = '<div class="text-center py-4 text-[11px] text-rose-500"><i class="bi bi-exclamation-triangle ml-1"></i>خطا در بارگذاری. <button onclick="window.reloadPaymentSchedule()" class="text-teal-600 underline mr-1">تلاش مجدد</button></div>';
                });
        }
        var tab = document.querySelector('[data-tab="payments"]');
        if (tab) tab.addEventListener('click', function () { if (!container.dataset.loaded) { container.dataset.loaded = '1'; load(); } });
        if (document.getElementById('tab-payments') && !document.getElementById('tab-payments').classList.contains('hidden')) { container.dataset.loaded = '1'; load(); }
    }

    // ── Guarantees Lazy-Load (with empty-state + error handling) ──
    function initGuarantees(container) {
        var id = container.getAttribute('data-contract-id'); if (!id) return;
        function load() {
            container.innerHTML = '<div class="schedule-skeleton space-y-2"><div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div></div>';
            fetch('/Contracts/' + id + '/Guarantees')
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    var text = (html || '').trim();
                    if (text === '' || text === '<div></div>' || text.length < 20) {
                        container.innerHTML = '<div class="text-center py-6"><div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2"><i class="bi bi-shield-check text-slate-400"></i></div><p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ ضمانت‌نامه‌ای ثبت نشده است.</p></div>';
                    } else {
                        container.innerHTML = html;
                        bindGuaranteeUI();
                    }
                })
                .catch(function () {
                    container.innerHTML = '<div class="text-center py-4 text-[11px] text-rose-500"><i class="bi bi-exclamation-triangle ml-1"></i>خطا در بارگذاری ضمانت‌نامه‌ها.</div>';
                });
        }
        var tab = document.querySelector('[data-tab="payments"]');
        if (tab) tab.addEventListener('click', function () { if (!container.dataset.loaded) { container.dataset.loaded = '1'; load(); } });
        if (document.getElementById('tab-payments') && !document.getElementById('tab-payments').classList.contains('hidden')) { container.dataset.loaded = '1'; load(); }
    }

    // ── Penalties Lazy-Load (with empty-state + error handling) ──
    function initPenalties(container) {
        var id = container.getAttribute('data-contract-id'); if (!id) return;
        function load() {
            container.innerHTML = '<div class="schedule-skeleton space-y-2"><div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div></div>';
            fetch('/Contracts/' + id + '/Penalties')
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    var text = (html || '').trim();
                    if (text === '' || text === '<div></div>' || text.length < 20) {
                        container.innerHTML = '<div class="text-center py-6"><div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2"><i class="bi bi-exclamation-triangle text-slate-400"></i></div><p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ جریمه‌ای ثبت نشده است.</p></div>';
                    } else {
                        container.innerHTML = html;
                        bindPenaltyUI();
                    }
                })
                .catch(function () {
                    container.innerHTML = '<div class="text-center py-4 text-[11px] text-rose-500"><i class="bi bi-exclamation-triangle ml-1"></i>خطا در بارگذاری جریمه‌ها.</div>';
                });
        }
        var tab = document.querySelector('[data-tab="payments"]');
        if (tab) tab.addEventListener('click', function () { if (!container.dataset.loaded) { container.dataset.loaded = '1'; load(); } });
        if (document.getElementById('tab-payments') && !document.getElementById('tab-payments').classList.contains('hidden')) { container.dataset.loaded = '1'; load(); }
    }

        // -- Retry helper for schedule --
    window.reloadPaymentSchedule = function () {
        var c = document.getElementById('paymentScheduleContainer');
        if (c) { delete c.dataset.loaded; initPaymentSchedule(c); }
    };

    // -- Penalty UI Binding --
    function bindPenaltyUI() {
        document.querySelectorAll('[data-open-penalty-modal]').forEach(function (b) {
            b.addEventListener('click', function () {
                var m = document.getElementById('penaltyRuleModal');
                if (m) m.classList.remove('hidden');
            });
        });
        document.querySelectorAll('[data-close-modal]').forEach(function (b) {
            b.addEventListener('click', function () {
                this.closest('.fixed.inset-0').classList.add('hidden');
            });
        });
        document.querySelectorAll('.fixed.inset-0').forEach(function (m) {
            m.addEventListener('click', function (e) { if (e.target === this) this.classList.add('hidden'); });
        });
        document.querySelectorAll('.penalty-status-form').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!confirm('تغییر وضعیت تایید شود؟')) return;
                var btn = this.querySelector('button');
                btn.disabled = true;
                fetch(this.action, {
                    method: 'POST',
                    body: new FormData(this),
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                }).then(function (r) { return r.json(); }).then(function (resp) {
                    if (resp.success) reloadPenalties();
                    else { alert(resp.message || 'خطا'); btn.disabled = false; }
                }).catch(function () { alert('خطا در ارتباط'); btn.disabled = false; });
            });
        });
        document.getElementById('penaltyRuleForm')?.addEventListener('submit', function (e) {
            e.preventDefault();
            var btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            fetch(this.action, {
                method: 'POST',
                body: new FormData(this),
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
            }).then(function (r) { return r.json(); }).then(function (resp) {
                if (resp.success) { document.getElementById('penaltyRuleModal').classList.add('hidden'); reloadPenalties(); }
                else { alert(resp.message || 'خطا'); }
                btn.disabled = false;
            }).catch(function () { alert('خطا در ارتباط'); btn.disabled = false; });
        });
    }

    function reloadPenalties() {
        var c = document.getElementById('penaltiesContainer');
        if (!c) return;
        delete c.dataset.loaded;
        initPenalties(c);
    }

    // -- Guarantee UI Binding --
    function bindGuaranteeUI() {
        document.querySelectorAll('[data-modal-target]').forEach(function (b) {
            b.addEventListener('click', function () {
                var m = document.getElementById(this.getAttribute('data-modal-target'));
                if (m) m.classList.remove('hidden');
            });
        });
        document.querySelectorAll('[data-close-modal]').forEach(function (b) {
            b.addEventListener('click', function () {
                this.closest('.fixed.inset-0').classList.add('hidden');
            });
        });
        document.querySelectorAll('.fixed.inset-0').forEach(function (m) {
            m.addEventListener('click', function (e) { if (e.target === this) this.classList.add('hidden'); });
        });
        document.querySelectorAll('.add-guarantee-form').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                e.preventDefault();
                var form = this;
                var btn = form.querySelector('button[type="submit"]');
                if (btn) btn.disabled = true;
                fetch(form.action, { method: 'POST', body: new FormData(form) })
                    .then(function (r) { return r.json(); })
                    .then(function (resp) {
                        if (resp.success) {
                            form.closest('.fixed.inset-0').classList.add('hidden');
                            form.reset();
                            reloadGuarantees();
                        } else { alert(resp.message || 'خطا در ثبت ضمانت‌نامه.'); }
                        if (btn) btn.disabled = false;
                    })
                    .catch(function () { alert('خطا در ارتباط با سرور.'); if (btn) btn.disabled = false; });
            });
        });
        document.querySelectorAll('.release-guarantee-form').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!confirm('آزادسازی تایید شود؟')) return;
                var btn = this.querySelector('button');
                btn.disabled = true;
                fetch(this.action, {
                    method: 'POST',
                    body: new FormData(this),
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                }).then(function (r) { return r.json(); }).then(function (resp) {
                    if (resp.success) reloadGuarantees();
                    else { alert(resp.message || 'خطا'); btn.disabled = false; }
                }).catch(function () { alert('خطا در ارتباط'); btn.disabled = false; });
            });
        });
        document.querySelectorAll('.delete-guarantee-form').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!confirm('حذف تایید شود؟')) return;
                fetch(this.action, {
                    method: 'POST',
                    body: new FormData(this),
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                }).then(function (r) { return r.json(); }).then(function (resp) {
                    if (resp.success) reloadGuarantees();
                    else alert(resp.message || 'خطا');
                }).catch(function () { alert('خطا در ارتباط'); });
            });
        });
    }

    function reloadGuarantees() {
        var c = document.getElementById('guaranteesContainer');
        if (!c) return;
        delete c.dataset.loaded;
        initGuarantees(c);
    }
</script>
}




