@model ContractDetailsVM
@using System.Globalization
@{
    ViewData["Title"] = "جزئیات قرارداد";
    var activeTab = ViewBag.ActiveTab ?? "overview";

    // Safe date validation helpers
    bool hasValidEndDate = Model.EndDate.HasValue && Model.EndDate.Value.Year > 1700;
    bool hasValidStartDate = Model.StartDate.Year > 1700;
    bool hasValidSignDate = Model.SignDate.HasValue && Model.SignDate.Value.Year > 1700;

    int? remainingDays = hasValidEndDate ? (int?)(Model.EndDate!.Value.Date - DateTime.Today).Days : null;

    // Calculate payment stats from Payments collection
    decimal paidAmount = Model.Payments?
        .Where(p => p.Status == "Paid")
        .Sum(p => p.Amount) ?? 0;
    decimal totalAmount = Model.TotalAmount;
    decimal remainingAmountCalc = totalAmount - paidAmount;
    int paymentProgress = totalAmount > 0 ? (int)Math.Min(100, Math.Round((paidAmount / totalAmount) * 100)) : 0;
}
@functions {
    /// <summary>
    /// Safely converts a DateTime to Persian (Shamsi) date string.
    /// Returns "ثبت نشده" for DateTime.MinValue, uninitialized dates, or years before 1700 (Gregorian)
    /// to avoid PersianCalendar ArgumentOutOfRangeException.
    /// </summary>
    string ToPersianDate(DateTime value)
    {
        if (value == DateTime.MinValue || value.Year < 1700)
            return "ثبت نشده";
        try
        {
            var cal = new PersianCalendar();
            return $"{cal.GetYear(value):0000}/{cal.GetMonth(value):00}/{cal.GetDayOfMonth(value):00}";
        }
        catch
        {
            return "ثبت نشده";
        }
    }
    string ToPersianDateNullable(DateTime? value)
    {
        if (!value.HasValue) return "ثبت نشده";
        return ToPersianDate(value.Value);
    }
}

<div class="container-fluid py-1 space-y-2" dir="rtl">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 dark:border-emerald-900/40 dark:bg-emerald-950/20 px-3.5 py-2.5 text-[11px] text-emerald-700 dark:text-emerald-400 mb-3 flex items-center gap-2">
            <i class="bi bi-check-circle-fill text-emerald-500"></i>
            <span>@successMsg</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-900/40 dark:bg-rose-950/20 px-3.5 py-2.5 text-[11px] text-rose-700 dark:text-rose-400 mb-3 flex items-center gap-2">
            <i class="bi bi-exclamation-circle-fill text-rose-500"></i>
            <span>@errorMsg</span>
        </div>
    }

    @* Breadcrumb *@
    <partial name="_Breadcrumb" model='new[] {
        new RhynoBreadcrumbItem("خانه", "/"),
        new RhynoBreadcrumbItem("قراردادها", "/Contracts"),
        new RhynoBreadcrumbItem("جزئیات قرارداد", null)
    }' />

    @* Section Header Card *@
    <div class="erp-card p-2.5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded bg-gradient-to-br from-teal-500 to-emerald-600 flex items-center justify-center text-xs">
                    <i class="bi bi-file-earmark-text text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="text-[13px] font-bold text-slate-900 dark:text-white">@Model.Title</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@Model.ContractNumber</p>
                </div>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                @if (Model.CanEdit)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="erp-btn erp-btn-primary text-white shadow-sm transition hover:bg-teal-700 no-underline">
                        <i class="bi bi-pencil ml-1"></i>ویرایش
                    </a>
                    <form asp-action="ArchiveContract" asp-route-id="@Model.Id" method="post" class="inline" data-guard-submit>
                        @Html.AntiForgeryToken()
                        <button type="submit" class="erp-btn text-slate-700 hover:bg-amber-50 hover:text-amber-600 hover:border-amber-200 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-amber-950/20 dark:hover:text-amber-400 no-underline transition">
                            <i class="bi bi-archive ml-1"></i>بایگانی
                        </button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline" data-guard-submit onsubmit="return confirm('آیتم حذف شود؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="erp-btn text-slate-700 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-rose-950/20 dark:hover:text-rose-400 no-underline transition">
                            <i class="bi bi-trash ml-1"></i>حذف
                        </button>
                    </form>
                }
                <a asp-action="GenerateDocument" asp-route-id="@Model.Id" target="_blank" class="erp-btn text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 no-underline transition">
                    <i class="bi bi-printer ml-1"></i>چاپ/PDF
                </a>
                <a asp-action="Index" class="erp-btn text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 no-underline transition">
                    <i class="bi bi-arrow-right ml-1"></i>بازگشت
                </a>
            </div>
        </div>
    </div>

    @* Modern Tabs *@
    <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden" data-contract-tabs>
        <div class="border-b border-slate-100 dark:border-slate-800">
            <ul class="flex flex-wrap text-[11px] font-bold" role="tablist">
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "overview" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="overview" type="button">
                        <i class="bi bi-speedometer2 ml-1"></i>نمای کلی
                    </button>
                </li>
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "content" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="content" type="button">
                        <i class="bi bi-file-text ml-1"></i>متن قرارداد
                    </button>
                </li>
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "payments" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="payments" type="button">
                        <i class="bi bi-wallet2 ml-1"></i>پرداخت‌ها
                    </button>
                </li>
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "attachments" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="attachments" type="button">
                        <i class="bi bi-paperclip ml-1"></i>ضمیمه‌ها
                    </button>
                </li>
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "activity" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="activity" type="button">
                        <i class="bi bi-clock-history ml-1"></i>تاریخچه فعالیت
                    </button>
                </li>
            </ul>
        </div>

        <div class="p-3.5">
            @* Tab 1: Overview & Metrics *@
            <div class="tab-panel @(activeTab == "overview" ? "" : "hidden")" id="tab-overview">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3">
                    <div class="rounded-lg bg-gradient-to-br from-teal-50 to-emerald-50 dark:from-teal-950/20 dark:to-emerald-950/20 border border-teal-100 dark:border-teal-900/30 p-3">
                        <span class="text-[9px] font-bold text-teal-600 dark:text-teal-400">مبلغ کل</span>
                        <div class="text-sm font-black text-slate-900 dark:text-white font-mono tabular-nums mt-1">@Model.TotalAmount.ToString("N0")</div>
                    </div>
                    <div class="rounded-lg bg-gradient-to-br from-emerald-50 to-green-50 dark:from-emerald-950/20 dark:to-green-950/20 border border-emerald-100 dark:border-emerald-900/30 p-3">
                        <span class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400">پرداخت شده</span>
                        <div class="text-sm font-black text-emerald-600 dark:text-emerald-400 font-mono tabular-nums mt-1">@paidAmount.ToString("N0")</div>
                    </div>
                    <div class="rounded-lg bg-gradient-to-br from-rose-50 to-red-50 dark:from-rose-950/20 dark:to-red-950/20 border border-rose-100 dark:border-rose-900/30 p-3">
                        <span class="text-[9px] font-bold text-rose-600 dark:text-rose-400">باقی مانده</span>
                        <div class="text-sm font-black text-rose-600 dark:text-rose-400 font-mono tabular-nums mt-1">@remainingAmountCalc.ToString("N0")</div>
                    </div>
                    <div class="rounded-lg bg-gradient-to-br from-amber-50 to-yellow-50 dark:from-amber-950/20 dark:to-yellow-950/20 border border-amber-100 dark:border-amber-900/30 p-3">
                        <span class="text-[9px] font-bold text-amber-600 dark:text-amber-400">روزهای باقی‌مانده</span>
                        <div class="text-sm font-black text-amber-600 dark:text-amber-400 font-mono tabular-nums mt-1">
                            @if (hasValidEndDate && remainingDays.HasValue)
                            {
                                if (remainingDays.Value < 0)
                                {
                                    <span class="text-rose-600 dark:text-rose-400">منقضی شده (@Math.Abs(remainingDays.Value) روز پیش)</span>
                                }
                                else if (remainingDays.Value == 0)
                                {
                                    <text>امروز</text>
                                }
                                else
                                {
                                    <text>@remainingDays.Value روز باقی‌مانده</text>
                                }
                            }
                            else
                            {
                                <text>تاریخ پایان مشخص نشده</text>
                            }
                        </div>
                    </div>
                </div>

                @* Lifecycle Status Stepper *@
                <partial name="_LifecycleStepper" model="Model" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
                    <div>
                        
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">مسئول:</span><span class="text-slate-700 dark:text-slate-300">@(Model.ResponsibleUserName ?? "-")</span></div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">قالب:</span><span class="text-slate-700 dark:text-slate-300">@(Model.TemplateName ?? "بدون قالب")</span></div>
                            @if (Model.IsArchived)
                            {
                                <div class="flex justify-between text-[11px]"><span class="text-slate-500">بایگانی‌کننده:</span><span class="text-slate-700 dark:text-slate-300">@(Model.ArchivedByUserName ?? "-")</span></div>
                                <div class="flex justify-between text-[11px]"><span class="text-slate-500">تاریخ بایگانی:</span><span class="font-mono text-slate-700 dark:text-slate-300">@ToPersianDateNullable(Model.ArchivedAt)</span></div>
                            }
                        </div>
                    <div>
                        <div class="space-y-2.5">
                            <h3 class="text-[11px] font-black text-slate-800 dark:text-slate-200 tracking-wide flex items-center gap-1.5">
                                <i class="bi bi-calendar3 text-teal-500 text-[11px]"></i>تاریخ‌های مهم
                            </h3>
                            <div class="rounded-lg bg-slate-50 dark:bg-slate-800/30 border border-slate-100 dark:border-slate-700/50 p-3">
                                <div class="grid grid-cols-2 gap-x-4 gap-y-2.5">
                                    <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">تاریخ شروع:</span>
                                    <span class="text-[11px] font-medium text-slate-800 dark:text-slate-200 font-mono tabular-nums text-left">@ToPersianDate(Model.StartDate)</span>
                                    <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">تاریخ پایان:</span>
                                    <span class="text-[11px] font-medium text-slate-800 dark:text-slate-200 font-mono tabular-nums text-left">@ToPersianDateNullable(Model.EndDate)</span>
                                    <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">تاریخ امضا:</span>
                                    <span class="text-[11px] font-medium text-slate-800 dark:text-slate-200 font-mono tabular-nums text-left">@ToPersianDateNullable(Model.SignDate)</span>
                                    <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">وضعیت پرداخت:</span>
                                    <div class="text-left">
                                        @if (remainingAmountCalc <= 0 && totalAmount > 0) {
                                            <span class="inline-block px-2 py-0.5 text-[10px] rounded bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 font-bold">تسویه شده</span>
                                        } else if (paidAmount > 0) {
                                            <span class="inline-block px-2 py-0.5 text-[10px] rounded bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 font-bold">پرداخت جزئی</span>
                                        } else {
                                            <span class="inline-block px-2 py-0.5 text-[10px] rounded bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-400 font-bold">پرداخت نشده</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    </div>

                @if (totalAmount > 0)
                {
                    <div class="mt-2">
                        <div class="flex justify-between text-[10px] text-slate-500 mb-1">
                            <span>پیشرفت پرداخت (@paidAmount.ToString("N0") از @totalAmount.ToString("N0"))</span>
                            <span class="font-bold">@paymentProgress%</span>
                        </div>
                        <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                            <div class="h-full rounded-full bg-emerald-500 transition-all" style="width: @paymentProgress%"></div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mt-3">
                        <span class="text-[10px] font-bold text-slate-500 block mb-1">توضیحات</span>
                        <p class="text-[11px] text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-950 rounded-lg p-2.5">@Model.Description</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-3">
                        <span class="text-[10px] font-bold text-slate-500 block mb-1">یادداشت‌ها</span>
                        <p class="text-[11px] text-slate-700 dark:text-slate-300 bg-amber-50 dark:bg-amber-950/20 border border-amber-100 dark:border-amber-900/30 rounded-lg p-2.5">@Model.Notes</p>
                    </div>
                }
            @* Dynamic Type-Specific Fields (EAV) *@
            @if (Model.TypeFields is { Count: > 0 } && Model.TypeFields.Any(f => f.ContractType == Model.ContractType && !string.IsNullOrEmpty(f.Value)))
            {
                var relevantFields = Model.TypeFields.Where(f => f.ContractType == Model.ContractType && !string.IsNullOrEmpty(f.Value)).ToList();
                var sections = relevantFields.GroupBy(f => f.SectionName ?? "سایر اطلاعات").ToList();

                <div class="mt-3">
                    <h3 class="text-[10px] font-bold text-slate-500 block mb-2">اطلاعات تخصصی قرارداد</h3>
                    <div class="rounded-lg bg-indigo-50 dark:bg-indigo-950/20 border border-indigo-100 dark:border-indigo-900/30 p-3">
                        @foreach (var sec in sections)
                        {
                            <div class="mb-2 last:mb-0">
                                <span class="text-[9px] font-bold text-indigo-600 dark:text-indigo-400 block mb-1">@sec.Key</span>
                                <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
                                    @foreach (var field in sec)
                                    {
                                        <div>
                                            <span class="text-[9px] text-slate-500">@field.DisplayName:</span>
                                            <span class="text-[11px] font-medium text-slate-900 dark:text-white">@field.Value</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            </div>
            @* Tab 2: Document Content *@
            <div class="tab-panel @(activeTab == "content" ? "" : "hidden")" id="tab-content">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-[11px] font-black text-slate-900 dark:text-white">متن قرارداد</h3>
                    <a asp-action="GenerateDocument" asp-route-id="@Model.Id" target="_blank" class="erp-btn erp-btn-primary text-[10px] text-white shadow-sm transition hover:bg-teal-700 no-underline">
                        <i class="bi bi-printer ml-1"></i>چاپ / Save PDF
                    </a>
                </div>
                @if (!string.IsNullOrEmpty(Model.ContractBodyHtml))
                {
                    <div class="border border-slate-200 dark:border-slate-800 rounded-lg p-4 bg-white">
                        @Html.Raw(Model.ContractBodyHtml)
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.TermsAndConditions))
                {
                    <div class="border border-slate-200 dark:border-slate-800 rounded-lg p-4 bg-white">
                        @Html.Raw(Model.TermsAndConditions)
                    </div>
                }
                else
                {
                    <div class="text-center py-8">
                        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2">
                            <i class="bi bi-file-text text-slate-400"></i>
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500">متن قراردادی ثبت نشده است.</p>
                    </div>
                }
            </div>

            @* Tab 3: Payments & Installments *@
            <div class="tab-panel @(activeTab == "payments" ? "" : "hidden")" id="tab-payments">
                @if (Model.CanViewFinancials)
                {
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-xs font-black text-slate-900 dark:text-white">پرداخت‌ها</h3>
                        @if (Model.CanEdit)
                        {
                            <button type="button" id="btnNewPayment" class="erp-btn erp-btn-primary text-white shadow-sm transition hover:bg-teal-700 cursor-pointer" data-modal-target="addPaymentModal">
                                <i class="bi bi-plus-circle ml-1"></i>پرداخت جدید
                            </button>
                        }
                    </div>

                    @if (Model.TotalAmount > 0)
                    {
                        var paidPct = (int)(Model.PaidAmount * 100 / Model.TotalAmount);
                        <div class="mb-3">
                            <div class="flex justify-between text-[10px] text-slate-500 mb-1">
                                <span>پیشرفت پرداخت (@Model.PaidAmount.ToString("N0") از @Model.TotalAmount.ToString("N0"))</span>
                                <span class="font-bold">@paidPct%</span>
                            </div>
                            <div class="w-full h-2.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                <div class="h-full rounded-full bg-emerald-500 transition-all" style="width: @paidPct%"></div>
                            </div>
                        </div>
                    }
<div id="paymentScheduleContainer" class="mt-3" data-contract-id="@Model.Id">
                        <div class="schedule-skeleton space-y-2 " aria-label="در حال بارگذاری برنامه پرداخت">
                            <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3"></div>
                            <div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div>
                            <div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div>
                            <div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div>
                            <div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-2/3"></div>
                        </div>
                    </div>

                    @* Guarantees / Retention Money Section *@
                    <div id="guaranteesContainer" class="mt-3" data-contract-id="@Model.Id" data-can-edit="@(Model.CanEdit ? "true" : "false")" data-can-view="@(Model.CanViewFinancials ? "true" : "false")">
                        <div class="schedule-skeleton space-y-2">
                            <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3"></div>
                            <div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div>
                            <div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div>
                        </div>
                    </div>

                    @* Penalty / Late Payment Section *@
                    <div id="penaltiesContainer" class="mt-3" data-contract-id="@Model.Id" data-can-edit="@(Model.CanEdit ? "true" : "false")" data-can-view="@(Model.CanViewFinancials ? "true" : "false")">
                        <div class="schedule-skeleton space-y-2">
                            <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3"></div>
                            <div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div>
                            <div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div>
                        </div>
                    </div>

                    @if (Model.Payments != null && Model.Payments.Any())
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-[11px]">
                                <thead>
                                    <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/30">
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">مبلغ</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">تاریخ پرداخت</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">سررسید</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">وضعیت</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">روش پرداخت</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">شماره مرجع</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">توضیحات</th>
                                        @if (Model.CanEdit)
                                        {
                                            <th class="text-center px-3 py-2 font-bold text-slate-500">عملیات</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50 dark:divide-slate-800/60">
                                    @foreach (var payment in Model.Payments)
                                    {
                                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                                            <td class="px-3 py-2 font-mono tabular-nums font-bold text-slate-800 dark:text-slate-200">@payment.Amount.ToString("N0")</td>
                                            <td class="px-3 py-2 font-mono tabular-nums text-slate-600">@ToPersianDate(payment.PaymentDate)</td>
                                            <td class="px-3 py-2 font-mono tabular-nums text-slate-600">@ToPersianDateNullable(payment.DueDate)</td>
                                            <td class="px-3 py-2">
                                                @{
                                                    var payStatusBadge = payment.Status switch
                                                    {
                                                        "Paid" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
                                                        "Pending" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
                                                        "Overdue" => "bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400",
                                                        _ => "bg-slate-100 text-slate-600"
                                                    };
                                                    var payStatusText = payment.Status switch
                                                    {
                                                        "Paid" => "پرداخت شده",
                                                        "Pending" => "در انتظار",
                                                        "Overdue" => "سررسید گذشته",
                                                        _ => payment.Status
                                                    };
                                                }
                                                <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold border @payStatusBadge">@payStatusText</span>
                                            </td>
                                            <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@(payment.PaymentMethod ?? "-")</td>
                                            <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@(payment.ReferenceNumber ?? "-")</td>
                                            <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@(payment.Notes ?? "-")</td>
                                            @if (Model.CanEdit)
                                            {
                                                <td class="px-3 py-2 text-center">
                                                    <form asp-action="DeletePayment" asp-route-paymentId="@payment.Id" asp-route-contractId="@Model.Id" method="post" class="inline" data-guard-submit onsubmit="return confirm('پرداخت حذف شود؟');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-rose-950/20 dark:hover:text-rose-400 transition" title="حذف">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-6">
                            <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2">
                                <i class="bi bi-credit-card text-slate-400"></i>
                            </div>
                            <p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ پرداختی ثبت نشده است.</p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-6">
                        <i class="bi bi-lock text-slate-400 text-lg"></i>
                        <p class="text-[11px] text-slate-400 mt-2">شما به اطلاعات مالی دسترسی ندارید.</p>
                    </div>
                }
            </div>

            @* Tab 4: Attachments *@
            <div class="tab-panel @(activeTab == "attachments" ? "" : "hidden")" id="tab-attachments" data-contract-id="@Model.Id" data-can-edit="@(Model.CanEdit ? "true" : "false")">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-xs font-black text-slate-900 dark:text-white">ضمیمه‌ها</h3>
                    @if (Model.CanEdit)
                    {
                        <button type="button" id="btnUploadAttachment" class="erp-btn erp-btn-primary text-white shadow-sm transition hover:bg-teal-700 cursor-pointer" data-modal-target="uploadAttachmentModal">
                            <i class="bi bi-cloud-upload ml-1"></i>بارگذاری فایل
                        </button>
                    }
                </div>

                @if (Model.CanEdit)
                {
                    @* Drag-and-Drop Upload Zone *@
                    <div class="contract-dropzone" id="contractDropzone">
                        <i class="bi bi-cloud-upload contract-dropzone-icon"></i>
                        <p class="contract-dropzone-text">فایل‌ها را اینجا رها کنید یا کلیک کنید</p>
                        <p class="contract-dropzone-sub">فایل‌های PDF, Word, Excel, تصاویر تا ۲۰ مگابایت</p>
                        <span class="contract-dropzone-hint">چند فایل را می‌توانید همزمان انتخاب کنید</span>
                        <input type="file" id="contractFileInput" class="hidden" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.tiff,.tif,.bmp,.zip,.rar,.7z,.txt" />
                    </div>

                    @* Validation Error Messages Container *@
                    <div class="contract-upload-errors" id="contractUploadErrors"></div>

                    @* Upload Progress Queue *@
                    <div class="contract-upload-queue" id="contractUploadQueue"></div>
                }

                @* Existing Attachments List *@
                <div id="contractAttachmentsList">
                 @if (Model.Attachments.Any())
{
    <div class="overflow-x-auto">
        <table class="w-full text-[11px]">
            <thead>
                <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/30">
                    <th class="text-right px-3 py-2 font-bold text-slate-500">نام فایل</th>
                    <th class="text-right px-3 py-2 font-bold text-slate-500">نوع</th>
                    <th class="text-right px-3 py-2 font-bold text-slate-500">حجم</th>
                    <th class="text-right px-3 py-2 font-bold text-slate-500">بارگذاری‌کننده</th>
                    <th class="text-right px-3 py-2 font-bold text-slate-500">تاریخ</th>
                    <th class="text-center px-3 py-2 font-bold text-slate-500">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/60" id="contractAttachmentsBody">
                @foreach (var att in Model.Attachments)
                {
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition" data-attachment-id="@att.Id">
                        <td class="px-3 py-2 font-bold text-slate-800 dark:text-slate-200">
                            <i class="bi bi-file-earmark ml-1 text-slate-400"></i>@att.FileName
                        </td>
                        <td class="px-3 py-2 text-slate-600">@att.ContentType</td>
                        <td class="px-3 py-2 font-mono tabular-nums text-slate-600">@(att.FileSize > 1024 ? $"{att.FileSize / 1024} KB" : $"{att.FileSize} B")</td>
                        <td class="px-3 py-2 text-slate-600">@(att.UploadedByUserName ?? "-")</td>
                        <td class="px-3 py-2 font-mono tabular-nums text-slate-600">@ToPersianDate(att.CreatedAt)</td>
                        <td class="px-3 py-2 text-center">
                            <div class="inline-flex gap-1">
                                <button type="button" onclick="openAttachmentPreview(@att.Id, '@att.FileName.Replace("'", "\\'")', '@(att.ContentType ?? "")', @att.FileSize, '/Contracts/DownloadAttachment/@att.Id')" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-sky-50 hover:text-sky-600 hover:border-sky-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-sky-950/20 dark:hover:text-sky-400 transition cursor-pointer" title="پیش‌نمایش">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <a asp-action="DownloadAttachment" asp-route-attachmentId="@att.Id" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 no-underline transition" title="دانلود">
                                    <i class="bi bi-download"></i>
                                </a>
                                @if (Model.CanEdit)
                                {
                                    <button type="button" onclick="deleteAttachment(@att.Id)" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-rose-950/20 dark:hover:text-rose-400 transition cursor-pointer" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
                else
                {
                    <div class="text-center py-6" id="contractAttachmentsEmpty">
                        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2">
                            <i class="bi bi-paperclip text-slate-400"></i>
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ ضمیمه‌ای وجود ندارد.</p>
                    </div>
                }

                @* Document Requirements Checklist *@
                <div id="documentRequirementsContainer" data-contract-id="@Model.Id" data-can-edit="@(Model.CanEdit ? "true" : "false")">
                    <div class="text-center py-6">
                        <div class="schedule-skeleton space-y-2">
                            <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3 mx-auto"></div>
                            <div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div>
                        </div>
                    </div>
                </div>

            </div>

            @* Tab 5.5: Amendments *@
            <div class="tab-panel @(activeTab == "amendments" ? "" : "hidden")" id="tab-amendments">
                <h3 class="text-[11px] font-black text-slate-900 dark:text-white mb-3">اصلاحیه‌ها / الحاقیه‌ها / تمدیدها</h3>
                @if (Model.Amendments.Any())
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-[11px]">
                            <thead>
                                <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/30">
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">#</th>
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">نوع</th>
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">عنوان</th>
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">تغییر مبلغ</th>
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">تاریخ اثر</th>
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">وضعیت</th>
                                    <th class="text-center px-3 py-2 font-bold text-slate-500">عملیات</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/60">
                                @foreach (var am in Model.Amendments)
                                {
                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                                        <td class="px-3 py-2 font-bold text-slate-800 dark:text-slate-200">@am.AmendmentNumber</td>
                                        <td class="px-3 py-2"><span class="inline-block rounded-full px-2 py-0.5 text-[9px] font-bold bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400">@am.AmendmentTypeDisplay</span></td>
                                        <td class="px-3 py-2 font-bold text-slate-800 dark:text-slate-200">@am.Title</td>
                                        <td class="px-3 py-2 font-mono tabular-nums @(am.AmountChange >= 0 ? "text-emerald-600" : "text-rose-600")">@(am.AmountChange >= 0 ? "+" : "")@am.AmountChange.ToString("N0")</td>
                                        <td class="px-3 py-2 font-mono tabular-nums text-slate-600">@ToPersianDate(am.EffectiveDate)</td>
                                        <td class="px-3 py-2">
                                            @if (am.Status == "Draft") { <span class="inline-block rounded-full px-2 py-0.5 text-[9px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">پیش‌نویس</span> }
                                            else if (am.Status == "PendingApproval") { <span class="inline-block rounded-full px-2 py-0.5 text-[9px] font-bold bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400">در انتظار تایید</span> }
                                            else if (am.Status == "Approved") { <span class="inline-block rounded-full px-2 py-0.5 text-[9px] font-bold bg-teal-100 dark:bg-teal-900/30 text-teal-700 dark:text-teal-400">تایید شده</span> }
                                            else if (am.Status == "Applied") { <span class="inline-block rounded-full px-2 py-0.5 text-[9px] font-bold bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">اعمال شده</span> }
                                            else if (am.Status == "Rejected") { <span class="inline-block rounded-full px-2 py-0.5 text-[9px] font-bold bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-400">رد شده</span> }
                                            else if (am.Status == "Cancelled") { <span class="inline-block rounded-full px-2 py-0.5 text-[9px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-400">لغو شده</span> }
                                        </td>
                                        <td class="px-3 py-2 text-center">
                                            <div class="inline-flex gap-1">
                                                @if (am.CanEdit && Model.CanEdit)
                                                {
                                                    <form asp-action="SubmitAmendmentForApproval" asp-route-amendmentId="@am.Id" method="post" class="inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-sky-50 hover:text-sky-600 hover:border-sky-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-sky-950/20 dark:hover:text-sky-400 transition" title="ارسال به تایید">
                                                            <i class="bi bi-send"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (am.CanApply && Model.CanEdit)
                                                {
                                                    <form asp-action="ApplyAmendment" asp-route-amendmentId="@am.Id" method="post" class="inline" onsubmit="return confirm('اصلاحیه اعمال شود؟');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 hover:border-emerald-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-emerald-950/20 dark:hover:text-emerald-400 transition" title="اعمال">
                                                            <i class="bi bi-check2-all"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (am.Status == "Draft" || am.Status == "PendingApproval")
                                                {
                                                    <form asp-action="CancelAmendment" asp-route-amendmentId="@am.Id" method="post" class="inline" onsubmit="return confirm('لغو شود؟');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-rose-950/20 dark:hover:text-rose-400 transition" title="لغو">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-6">
                        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2">
                            <i class="bi bi-pencil-square text-slate-400"></i>
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ اصلاحیه‌ای برای این قرارداد وجود ندارد.</p>
                    </div>
                }
                @if (Model.CanEdit)
                {
                    <div class="mt-3 flex justify-end">
                        <a asp-action="CreateAmendment" asp-route-contractId="@Model.Id" class="erp-btn erp-btn-primary text-white shadow-sm transition hover:bg-teal-700 no-underline" data-modal-target="amendmentModal">
                            <i class="bi bi-plus-lg ml-1"></i>ایجاد اصلاحیهٔ جدید
                        </a>
                    </div>
                }
            </div>

            @* Tab 5: Activity Log *@
            <div class="tab-panel @(activeTab == "activity" ? "" : "hidden")" id="tab-activity">
                <h3 class="text-[11px] font-black text-slate-900 dark:text-white mb-3">تاریخچه فعالیت</h3>
                @if (Model.AuditLogs.Any())
                {
                    <div class="space-y-2">
                        @foreach (var log in Model.AuditLogs)
                        {
                            <div class="flex items-start gap-3 p-2.5 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-800">
                                <div class="h-7 w-7 rounded-full bg-teal-100 dark:bg-teal-900/30 flex items-center justify-center flex-shrink-0">
                                    <i class="bi bi-person text-teal-600 dark:text-teal-400 text-xs"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[11px] font-bold text-slate-800 dark:text-slate-200">@log.UserName</span>
                                        <span class="text-[9px] text-slate-400">@ToPersianDate(log.CreatedAt) @log.CreatedAt.ToString("HH:mm")</span>
                                    </div>
                                    <p class="text-[10px] text-slate-600 dark:text-slate-400 mt-0.5">
                                        @switch (log.Action)
                                        {
                                            case "Created":
                                                <span>قرارداد را ایجاد کرد</span>
                                                break;
                                            case "StatusChanged":
                                                <span>وضعیت را از <strong>@log.OldStatus</strong> به <strong>@log.NewStatus</strong> تغییر داد</span>
                                                break;
                                            case "Archived":
                                                <span>قرارداد را بایگانی کرد</span>
                                                break;
                                            case "Unarchived":
                                                <span>قرارداد را از بایگانی خارج کرد</span>
                                                break;
                                            case "Edited":
                                                <span>قرارداد را ویرایش کرد</span>
                                                break;
                                            case "AttachmentUploaded":
                                                <span>@log.Description</span>
                                                break;
                                            case "AttachmentDeleted":
                                                <span>@log.Description</span>
                                                break;
                                            default:
                                                <span>@log.Action - @log.Description</span>
                                                break;
                                        }
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-6">
                        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2">
                            <i class="bi bi-clock-history text-slate-400"></i>
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ فعالیتی ثبت نشده است.</p>
                    </div>
                }
            </div>
        </div>
</div>

@* Add Payment Modal *@
@if (Model.CanViewFinancials && Model.CanEdit)
{
    <div class="fixed inset-0 z-50 bg-black/50 hidden flex items-center justify-center p-4" id="addPaymentModal">
        <div class="bg-white dark:bg-slate-900 rounded-lg shadow-xl border border-gray-200 dark:border-slate-700 w-full max-w-lg overflow-visible">
            <div class="bg-gray-50 dark:bg-slate-800 px-4 py-3 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="bi bi-wallet2 text-teal-600 text-xs"></i>
                    <span class="text-sm font-bold text-gray-900 dark:text-white">ثبت پرداخت جدید</span>
                </div>
                <button type="button" class="w-7 h-7 flex items-center justify-center rounded-md text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-200 dark:hover:bg-slate-700 transition cursor-pointer border-0 bg-transparent text-lg" data-close-modal>&times;</button>
            </div>
            <form asp-action="AddPayment" method="post" data-guard-submit>
                @Html.AntiForgeryToken()
                <input type="hidden" name="ContractId" value="@Model.Id" />
                <div class="p-3 space-y-2">
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">مبلغ</label>
                        <input name="Amount" type="number" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" required />
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">تاریخ پرداخت</label>
                        <input name="PaymentDate" type="text" id="paymentDate" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none jalali-input" placeholder="140X/MM/DD" autocomplete="off" required />
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">تاریخ سررسید</label>
                        <input name="DueDate" type="text" id="paymentDueDate" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none jalali-input" placeholder="140X/MM/DD" autocomplete="off" />
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">وضعیت</label>
                        <select name="Status" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none">
                            <option value="Paid">پرداخت شده</option>
                            <option value="Pending">در انتظار</option>
                            <option value="Overdue">سررسید گذشته</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">روش پرداخت</label>
                        <select name="PaymentMethod" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none">
                            <option value="">انتخاب کنید</option>
                            <option value="Card">کارت بانکی</option>
                            <option value="Check">چک</option>
                            <option value="BankTransfer">انتقال بانکی</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">شماره مرجع</label>
                        <input name="ReferenceNumber" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" />
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1">توضیحات</label>
                        <textarea name="Notes" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none resize-y" rows="2"></textarea>
                    </div>
                </div>
                <div class="flex gap-2 justify-end py-2 px-3 border-t border-slate-100 dark:border-slate-800">
                    <button type="submit" class="erp-btn erp-btn-primary text-[10px] text-white shadow-sm transition hover:bg-teal-700">
                        <i class="bi bi-check-lg ml-1"></i>ثبت پرداخت
                    </button>
                    <button type="button" class="erp-btn text-[10px] text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 transition" data-close-modal>
                        <i class="bi bi-x-lg ml-1"></i>انصراف
                    </button>
                </div>
            </form>
        </div>
    </div>
}

