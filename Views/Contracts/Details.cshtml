@* 5. Attachment Preview Modal Partial *@
<partial name="_AttachmentPreview" />

@section Styles {
    <link rel="stylesheet" href="~/css/contracts-details-style.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/signature-pad/signature_pad.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/persian-date.min.js"></script>
    <script src="~/js/contracts-details-script.js" asp-append-version="true"></script>
    <script src="~/js/contracts-attachment-upload.js" asp-append-version="true"></script>
    <script src="~/js/contracts-attachment-preview.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var sched = document.getElementById('paymentScheduleContainer');
            if (sched) initPaymentSchedule(sched);
            var guar = document.getElementById('guaranteesContainer');
            if (guar) initGuarantees(guar);
            var pen = document.getElementById('penaltiesContainer');
            if (pen) initPenalties(pen);
            var docReq = document.getElementById('documentRequirementsContainer');
            if (docReq) initDocumentRequirements(docReq);
        });

        // ── Payment Schedule Lazy-Load ──
        function initPaymentSchedule(container) {
            var id = container.getAttribute('data-contract-id'); if (!id) return;
            function load() {
                container.innerHTML = '<div class="schedule-skeleton space-y-2"><div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div></div>';
                fetch('/Contracts/Schedule/' + id)
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        var text = (html || '').trim();
                        if (text === '' || text === '<div></div>' || text.length < 20) {
                            container.innerHTML = '<div class="text-center py-6"><div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2"><i class="bi bi-wallet2 text-slate-400"></i></div><p class="text-[11px] text-slate-400 dark:text-slate-500">برنامه پرداختی ثبت نشده است.</p></div>';
                        } else {
                            container.innerHTML = html;
                            if (typeof window.initJalaliPickers === 'function') {
                                window.initJalaliPickers();
                            }
                        }
                    })
                    .catch(function () {
                        container.innerHTML = '<div class="text-center py-4 text-[11px] text-rose-500"><i class="bi bi-exclamation-triangle ml-1"></i>خطا در بارگذاری برنامه پرداخت.</div>';
                    });
            }
            var tab = document.querySelector('[data-tab="payments"]');
            if (tab) tab.addEventListener('click', function () { if (!container.dataset.loaded) { container.dataset.loaded = '1'; load(); } });
            if (document.getElementById('tab-payments') && !document.getElementById('tab-payments').classList.contains('hidden')) { container.dataset.loaded = '1'; load(); }
        }

        // ── Guarantees Lazy-Load ──
        function initGuarantees(container) {
            var id = container.getAttribute('data-contract-id'); if (!id) return;
            function load() {
                container.innerHTML = '<div class="schedule-skeleton space-y-2"><div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div></div>';
                fetch('/Contracts/' + id + '/Guarantees')
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        var text = (html || '').trim();
                        if (text === '' || text === '<div></div>' || text.length < 20) {
                            container.innerHTML = '<div class="text-center py-6"><div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2"><i class="bi bi-shield-check text-slate-400"></i></div><p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ ضمانت‌نامه‌ای ثبت نشده است.</p></div>';
                        } else {
                            container.innerHTML = html;
                            bindGuaranteeUI();
                        }
                    })
                    .catch(function () {
                        container.innerHTML = '<div class="text-center py-4 text-[11px] text-rose-500"><i class="bi bi-exclamation-triangle ml-1"></i>خطا در بارگذاری ضمانت‌نامه‌ها.</div>';
                    });
            }
            var tab = document.querySelector('[data-tab="payments"]');
            if (tab) tab.addEventListener('click', function () { if (!container.dataset.loaded) { container.dataset.loaded = '1'; load(); } });
            if (document.getElementById('tab-payments') && !document.getElementById('tab-payments').classList.contains('hidden')) { container.dataset.loaded = '1'; load(); }
        }

        // ── Penalties Lazy-Load ──
        function initPenalties(container) {
            var id = container.getAttribute('data-contract-id'); if (!id) return;
            function load() {
                container.innerHTML = '<div class="schedule-skeleton space-y-2"><div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div></div>';
                fetch('/Contracts/' + id + '/Penalties')
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        var text = (html || '').trim();
                        if (text === '' || text === '<div></div>' || text.length < 20) {
                            container.innerHTML = '<div class="text-center py-6"><div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2"><i class="bi bi-exclamation-triangle text-slate-400"></i></div><p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ جریمه‌ای ثبت نشده است.</p></div>';
                        } else {
                            container.innerHTML = html;
                            bindPenaltyUI();
                        }
                    })
                    .catch(function () {
                        container.innerHTML = '<div class="text-center py-4 text-[11px] text-rose-500"><i class="bi bi-exclamation-triangle ml-1"></i>خطا در بارگذاری جریمه‌ها.</div>';
                    });
            }
            var tab = document.querySelector('[data-tab="payments"]');
            if (tab) tab.addEventListener('click', function () { if (!container.dataset.loaded) { container.dataset.loaded = '1'; load(); } });
            if (document.getElementById('tab-payments') && !document.getElementById('tab-payments').classList.contains('hidden')) { container.dataset.loaded = '1'; load(); }
        }

        // Helper functions
        window.reloadPaymentSchedule = function () {
            var c = document.getElementById('paymentScheduleContainer');
            if (c) { delete c.dataset.loaded; initPaymentSchedule(c); }
        };

        function bindPenaltyUI() {
            document.querySelectorAll('[data-open-penalty-modal]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var m = document.getElementById('penaltyRuleModal');
                    if (m) m.classList.remove('hidden');
                });
            });
            document.querySelectorAll('[data-close-modal]').forEach(function (b) {
                b.addEventListener('click', function () {
                    this.closest('.fixed.inset-0').classList.add('hidden');
                });
            });
        }

        function reloadPenalties() {
            var c = document.getElementById('penaltiesContainer');
            if (!c) return;
            delete c.dataset.loaded;
            initPenalties(c);
        }

        function bindGuaranteeUI() {
            document.querySelectorAll('[data-modal-target]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var m = document.getElementById(this.getAttribute('data-modal-target'));
                    if (m) m.classList.remove('hidden');
                });
            });
            document.querySelectorAll('[data-close-modal]').forEach(function (b) {
                b.addEventListener('click', function () {
                    this.closest('.fixed.inset-0').classList.add('hidden');
                });
            });
        }

        function reloadGuarantees() {
            var c = document.getElementById('guaranteesContainer');
            if (!c) return;
            delete c.dataset.loaded;
            initGuarantees(c);
        }

        // ── Document Requirements Lazy-Load ──
        function initDocumentRequirements(container) {
            var id = container.getAttribute('data-contract-id'); if (!id) return;
            function load() {
                container.innerHTML = '<div class="schedule-skeleton space-y-2"><div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/3 mx-auto"></div><div class="h-8 bg-slate-200 dark:bg-slate-700 rounded w-full"></div></div>';
                fetch('/Contracts/' + id + '/Requirements')
                    .then(function (r) {
                        if (!r.ok) throw new Error('Status ' + r.status);
                        return r.text();
                    })
                    .then(function (html) {
                        var text = (html || '').trim();
                        if (text === '' || text === '<div></div>' || text.length < 15) {
                            container.innerHTML = '';
                        } else {
                            container.innerHTML = html;
                            bindRequirementsUI(container);
                        }
                    })
                    .catch(function () {
                        container.innerHTML = '';
                    });
            }
            var tab = document.querySelector('[data-tab="attachments"]');
            if (tab) tab.addEventListener('click', function () { if (!container.dataset.loaded) { container.dataset.loaded = '1'; load(); } });
            if (document.getElementById('tab-attachments') && !document.getElementById('tab-attachments').classList.contains('hidden')) { container.dataset.loaded = '1'; load(); }
        }

        function bindRequirementsUI(container) {
            var seedForm = container.querySelector('.seed-requirements-form');
            if (seedForm) {
                seedForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var formData = new FormData(seedForm);
                    fetch(seedForm.action, {
                        method: 'POST',
                        body: formData
                    }).then(function () {
                        reloadRequirements();
                    }).catch(function () {
                        reloadRequirements();
                    });
                });
            }
            container.querySelectorAll('.upload-for-req-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var uploadBtn = document.getElementById('btnUploadAttachment');
                    if (uploadBtn) {
                        uploadBtn.click();
                    } else {
                        var fileInput = document.getElementById('contractFileInput');
                        if (fileInput) fileInput.click();
                    }
                });
            });
        }

        window.reloadRequirements = function () {
            var c = document.getElementById('documentRequirementsContainer');
            if (!c) return;
            delete c.dataset.loaded;
            initDocumentRequirements(c);
        };

        // ════════════════════════════════════════════════════════════
        // Modal Form AJAX Validation Feedback Handler
        // ════════════════════════════════════════════════════════════
        function clearFormErrors(form) {
            form.querySelectorAll('.field-validation-error-msg').forEach(function (el) { el.remove(); });
            form.querySelectorAll('.border-red-500').forEach(function (el) {
                el.classList.remove('border-red-500');
                if (el.classList.contains('jalali-datepicker-wrapper')) {
                    el.querySelector('input')?.classList.remove('border-red-500');
                }
            });
            var genErr = form.querySelector('.form-general-error');
            if (genErr) genErr.remove();
        }

        function applyFormFieldErrors(form, errors) {
            clearFormErrors(form);
            if (!errors) return;

            var firstInvalidEl = null;

            for (var fieldName in errors) {
                if (!errors.hasOwnProperty(fieldName)) continue;
                var errorMsg = errors[fieldName];
                if (!errorMsg) continue;

                if (fieldName.toLowerCase() === 'general') {
                    var genDiv = document.createElement('div');
                    genDiv.className = 'form-general-error p-2.5 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-[11px] text-rose-600 dark:text-rose-400 mb-3';
                    genDiv.innerHTML = '<i class="bi bi-exclamation-circle ml-1"></i>' + errorMsg;
                    var container = form.querySelector('.space-y-3, .space-y-4, .p-5') || form;
                    container.insertBefore(genDiv, container.firstChild);
                    continue;
                }

                // Match input, select, textarea by name (case-insensitive)
                var input = form.querySelector('[name="' + fieldName + '" i]');
                if (!input) {
                    var allInputs = form.querySelectorAll('input, select, textarea');
                    for (var i = 0; i < allInputs.length; i++) {
                        var n = allInputs[i].getAttribute('name') || '';
                        if (n.toLowerCase() === fieldName.toLowerCase()) {
                            input = allInputs[i];
                            break;
                        }
                    }
                }

                if (input) {
                    var targetBorderEl = input;
                    var insertAfterEl = input;

                    // If input is inside a jalali datepicker wrapper or input-with-icon wrapper
                    var jalaliWrapper = input.closest('.jalali-datepicker-wrapper');
                    if (jalaliWrapper) {
                        var visibleInput = jalaliWrapper.querySelector('.jalali-input, .jalali-date-input');
                        if (visibleInput) {
                            visibleInput.classList.add('border-red-500');
                        }
                        insertAfterEl = jalaliWrapper;
                    } else if (input.parentElement && input.parentElement.classList.contains('relative') && input.parentElement.querySelector('span')) {
                        input.classList.add('border-red-500');
                        insertAfterEl = input.parentElement;
                    } else {
                        input.classList.add('border-red-500');
                    }

                    var errSpan = document.createElement('div');
                    errSpan.className = 'field-validation-error-msg text-[10px] text-rose-500 mt-1 font-medium flex items-center gap-1';
                    errSpan.innerHTML = '<i class="bi bi-exclamation-circle"></i><span>' + errorMsg + '</span>';
                    insertAfterEl.parentNode.insertBefore(errSpan, insertAfterEl.nextSibling);

                    if (!firstInvalidEl) {
                        firstInvalidEl = jalaliWrapper ? jalaliWrapper.querySelector('.jalali-input') : input;
                    }
                }
            }

            if (firstInvalidEl) {
                firstInvalidEl.focus();
            }
        }

        function initModalAjaxValidation(modalId, formSelector, onSuccess) {
            var modal = document.getElementById(modalId);
            if (!modal) return;
            var form = modal.querySelector(formSelector || 'form');
            if (!form) return;

            // Clear errors when typing/changing inputs
            form.addEventListener('input', function (e) {
                var el = e.target;
                el.classList.remove('border-red-500');
                var jw = el.closest('.jalali-datepicker-wrapper');
                var errNode = (jw || el.parentElement?.classList.contains('relative') ? (jw || el.parentElement) : el).nextElementSibling;
                if (errNode && errNode.classList.contains('field-validation-error-msg')) {
                    errNode.remove();
                }
            });

            // Clear errors when modal closes
            modal.querySelectorAll('[data-close-modal]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    clearFormErrors(form);
                });
            });

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var submitBtn = form.querySelector('button[type="submit"]');
                var originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="inline-block animate-spin mr-1"><i class="bi bi-arrow-repeat"></i></span> در حال ثبت...';
                }

                clearFormErrors(form);

                var actionUrl = form.getAttribute('action') || window.location.href;
                var formData = new FormData(form);

                fetch(actionUrl, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(function (res) {
                    return res.json().catch(function () {
                        return { success: false, message: 'خطا در ارتباط با سرور.' };
                    });
                })
                .then(function (data) {
                    if (data && data.success) {
                        modal.classList.add('hidden');
                        form.reset();
                        clearFormErrors(form);
                        if (window.RhynoFormGuard && typeof window.RhynoFormGuard.release === 'function') {
                            window.RhynoFormGuard.release(form);
                        }
                        if (typeof onSuccess === 'function') {
                            onSuccess(data);
                        }
                        var msg = data.message || 'عملیات با موفقیت انجام شد.';
                        if (window.AppUI && typeof window.AppUI.toast === 'function') {
                            window.AppUI.toast(msg, 'success');
                        } else if (window.Rhyno && typeof window.Rhyno.toast === 'function') {
                            window.Rhyno.toast(msg, 'success');
                        }
                    } else {
                        if (window.RhynoFormGuard && typeof window.RhynoFormGuard.release === 'function') {
                            window.RhynoFormGuard.release(form);
                        }
                        if (data && data.errors && Object.keys(data.errors).length > 0) {
                            applyFormFieldErrors(form, data.errors);
                        } else if (data && data.message) {
                            applyFormFieldErrors(form, { General: data.message });
                        } else {
                            applyFormFieldErrors(form, { General: 'اطلاعات وارد شده نامعتبر است.' });
                        }
                    }
                })
                .catch(function (err) {
                    if (window.RhynoFormGuard && typeof window.RhynoFormGuard.release === 'function') {
                        window.RhynoFormGuard.release(form);
                    }
                    applyFormFieldErrors(form, { General: 'خطا در ارسال اطلاعات: ' + (err.message || 'خطای ناشناخته') });
                })
                .finally(function () {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnHtml;
                    }
                });
            });
        }

        // Initialize AJAX modal forms on DOM ready
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Add Payment Modal
            initModalAjaxValidation('addPaymentModal', 'form', function (res) {
                if (typeof window.reloadPaymentSchedule === 'function') {
                    window.reloadPaymentSchedule();
                }
                setTimeout(function () {
                    window.location.reload();
                }, 400);
            });

            // 2. Add Guarantee Modal
            initModalAjaxValidation('addGuaranteeModal', '.add-guarantee-form', function (res) {
                if (typeof window.reloadGuarantees === 'function') {
                    window.reloadGuarantees();
                }
            });

            // 3. Amendment Modal
            initModalAjaxValidation('amendmentModal', 'form', function (res) {
                setTimeout(function () {
                    window.location.reload();
                }, 400);
            });
        });
    </script>
}
