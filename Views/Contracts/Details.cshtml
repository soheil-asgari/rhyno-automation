@model ContractDetailsVM
@{
    ViewData["Title"] = "جزئیات قرارداد";
    var activeTab = ViewBag.ActiveTab ?? "overview";
}

<div class="container-fluid py-2 space-y-2" dir="rtl">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 dark:border-emerald-900/40 dark:bg-emerald-950/20 px-3.5 py-2.5 text-[11px] text-emerald-700 dark:text-emerald-400 mb-3 flex items-center gap-2">
            <i class="bi bi-check-circle-fill text-emerald-500"></i>
            <span>@successMsg</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 dark:border-rose-900/40 dark:bg-rose-950/20 px-3.5 py-2.5 text-[11px] text-rose-700 dark:text-rose-400 mb-3 flex items-center gap-2">
            <i class="bi bi-exclamation-circle-fill text-rose-500"></i>
            <span>@errorMsg</span>
        </div>
    }

    @* Breadcrumb *@
    <partial name="_Breadcrumb" model='new[] {
        new RhynoBreadcrumbItem("خانه", "/"),
        new RhynoBreadcrumbItem("قراردادها", "/Contracts"),
        new RhynoBreadcrumbItem("جزئیات قرارداد", null)
    }' />

    @* Section Header *@
    <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between px-1">
        <div>
            <h1 class="text-[16px] font-black text-slate-900 dark:text-white">جزئیات قرارداد - @Model.Title</h1>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">@Model.ContractNumber</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            @if (Model.CanEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="rounded-lg bg-teal-600 px-3 py-1.5 text-[11px] font-black text-white shadow-sm transition hover:bg-teal-700 no-underline">
                    <i class="bi bi-pencil ml-1"></i>ویرایش
                </a>
                <form asp-action="ArchiveContract" asp-route-id="@Model.Id" method="post" class="inline" data-guard-submit>
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 py-1.5 text-[11px] font-bold text-slate-700 hover:bg-amber-50 hover:text-amber-600 hover:border-amber-200 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-amber-950/20 dark:hover:text-amber-400 no-underline transition">
                        <i class="bi bi-archive ml-1"></i>بایگانی
                    </button>
                </form>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline" data-guard-submit onsubmit="return confirm('آیتم حذف شود؟');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 py-1.5 text-[11px] font-bold text-slate-700 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-rose-950/20 dark:hover:text-rose-400 no-underline transition">
                        <i class="bi bi-trash ml-1"></i>حذف
                    </button>
                </form>
            }
            <a asp-action="GenerateDocument" asp-route-id="@Model.Id" target="_blank" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 py-1.5 text-[11px] font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 no-underline transition">
                <i class="bi bi-printer ml-1"></i>چاپ/PDF
            </a>
            <a asp-action="Index" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 py-1.5 text-[11px] font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 no-underline transition">
                <i class="bi bi-arrow-right ml-1"></i>بازگشت به فهرست
            </a>
        </div>
    </div>

    @* Modern Tabs *@
    <div class="bg-white dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden" data-contract-tabs>
        <div class="border-b border-slate-100 dark:border-slate-800">
            <ul class="flex flex-wrap text-[11px] font-bold" role="tablist">
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "overview" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="overview" type="button">
                        <i class="bi bi-speedometer2 ml-1"></i>نمای کلی
                    </button>
                </li>
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "content" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="content" type="button">
                        <i class="bi bi-file-text ml-1"></i>متن قرارداد
                    </button>
                </li>
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "payments" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="payments" type="button">
                        <i class="bi bi-wallet2 ml-1"></i>پرداخت‌ها
                    </button>
                </li>
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "attachments" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="attachments" type="button">
                        <i class="bi bi-paperclip ml-1"></i>ضمیمه‌ها
                    </button>
                </li>
                <li role="presentation">
                    <button class="tab-btn px-4 py-2.5 border-b-2 transition @(activeTab == "activity" ? "border-teal-500 text-teal-600 dark:text-teal-400" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300")" data-tab="activity" type="button">
                        <i class="bi bi-clock-history ml-1"></i>تاریخچه فعالیت
                    </button>
                </li>
            </ul>
        </div>

        <div class="p-3.5">
            @* Tab 1: Overview & Metrics *@
            <div class="tab-panel @(activeTab == "overview" ? "" : "hidden")" id="tab-overview">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3">
                    <div class="rounded-lg bg-gradient-to-br from-teal-50 to-emerald-50 dark:from-teal-950/20 dark:to-emerald-950/20 border border-teal-100 dark:border-teal-900/30 p-3">
                        <span class="text-[9px] font-bold text-teal-600 dark:text-teal-400">مبلغ کل</span>
                        <div class="text-sm font-black text-slate-900 dark:text-white font-mono tabular-nums mt-1">@Model.TotalAmount.ToString("N0")</div>
                    </div>
                    <div class="rounded-lg bg-gradient-to-br from-emerald-50 to-green-50 dark:from-emerald-950/20 dark:to-green-950/20 border border-emerald-100 dark:border-emerald-900/30 p-3">
                        <span class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400">پرداخت شده</span>
                        <div class="text-sm font-black text-emerald-600 dark:text-emerald-400 font-mono tabular-nums mt-1">@Model.PaidAmount.ToString("N0")</div>
                    </div>
                    <div class="rounded-lg bg-gradient-to-br from-rose-50 to-red-50 dark:from-rose-950/20 dark:to-red-950/20 border border-rose-100 dark:border-rose-900/30 p-3">
                        <span class="text-[9px] font-bold text-rose-600 dark:text-rose-400">باقی مانده</span>
                        <div class="text-sm font-black text-rose-600 dark:text-rose-400 font-mono tabular-nums mt-1">@Model.RemainingBalance.ToString("N0")</div>
                    </div>
                    <div class="rounded-lg bg-gradient-to-br from-amber-50 to-yellow-50 dark:from-amber-950/20 dark:to-yellow-950/20 border border-amber-100 dark:border-amber-900/30 p-3">
                        <span class="text-[9px] font-bold text-amber-600 dark:text-amber-400">روزهای باقی‌مانده</span>
                        <div class="text-sm font-black text-amber-600 dark:text-amber-400 font-mono tabular-nums mt-1">@Model.DaysRemaining روز</div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
                    <div>
                        <h3 class="text-[11px] font-black text-slate-900 dark:text-white mb-2">اطلاعات قرارداد</h3>
                        <div class="space-y-2">
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">شماره قرارداد:</span><span class="font-bold text-slate-800 dark:text-slate-200">@Model.ContractNumber</span></div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">عنوان:</span><span class="text-slate-700 dark:text-slate-300">@Model.Title</span></div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">نوع:</span><span class="text-slate-700 dark:text-slate-300">@(Model.ContractType ?? "-")</span></div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">وضعیت:</span>
                                @{
                                    var sBadge = Model.Status switch
                                    {
                                        var s when s == ContractStatuses.Active => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
                                        var s when s == ContractStatuses.Completed => "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400",
                                        var s when s == ContractStatuses.Draft => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400",
                                        var s when s == ContractStatuses.ExpiringSoon => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
                                        var s when s == ContractStatuses.Expired => "bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-400",
                                        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400"
                                    };
                                }
                                <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold @sBadge">@Model.Status</span>
                            </div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">مشتری:</span><span class="text-slate-700 dark:text-slate-300">@(!string.IsNullOrEmpty(Model.CustomerName) ? Model.CustomerName : Model.ClientName)</span></div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">مسئول:</span><span class="text-slate-700 dark:text-slate-300">@(Model.ResponsibleUserName ?? "-")</span></div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">قالب:</span><span class="text-slate-700 dark:text-slate-300">@(Model.TemplateName ?? "بدون قالب")</span></div>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-[11px] font-black text-slate-900 dark:text-white mb-2">تاریخ‌های مهم</h3>
                        <div class="space-y-2">
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">تاریخ شروع:</span><span class="font-bold text-slate-800 dark:text-slate-200 font-mono">@Model.StartDate.ToString("yyyy/MM/dd")</span></div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">تاریخ پایان:</span><span class="font-mono text-slate-700 dark:text-slate-300">@(Model.EndDate?.ToString("yyyy/MM/dd") ?? "-")</span></div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">تاریخ امضا:</span><span class="font-mono text-slate-700 dark:text-slate-300">@(Model.SignDate?.ToString("yyyy/MM/dd") ?? "-")</span></div>
                            <div class="flex justify-between text-[11px]"><span class="text-slate-500">وضعیت پرداخت:</span>
                                @{
                                    var pBadge = Model.PaymentStatus switch
                                    {
                                        "FullyPaid" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
                                        "PartiallyPaid" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
                                        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400"
                                    };
                                    var pText = Model.PaymentStatus switch
                                    {
                                        "FullyPaid" => "تسویه شده",
                                        "PartiallyPaid" => "پرداخت جزئی",
                                        _ => "پرداخت نشده"
                                    };
                                }
                                <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold @pBadge">@pText</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.TotalAmount > 0)
                {
                    var paidPct = (int)(Model.PaidAmount * 100 / Model.TotalAmount);
                    <div class="mt-2">
                        <div class="flex justify-between text-[10px] text-slate-500 mb-1">
                            <span>پیشرفت پرداخت</span>
                            <span class="font-bold">@paidPct%</span>
                        </div>
                        <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                            <div class="h-full rounded-full bg-emerald-500 transition-all" style="width: @paidPct%"></div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mt-3">
                        <span class="text-[10px] font-bold text-slate-500 block mb-1">توضیحات</span>
                        <p class="text-[11px] text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-950 rounded-lg p-2.5">@Model.Description</p>
                    </div>
                }
            </div>

            @* Tab 2: Document Content *@
            <div class="tab-panel @(activeTab == "content" ? "" : "hidden")" id="tab-content">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-[11px] font-black text-slate-900 dark:text-white">متن قرارداد</h3>
                    <a asp-action="GenerateDocument" asp-route-id="@Model.Id" target="_blank" class="rounded-lg bg-teal-600 px-3 py-1.5 text-[10px] font-black text-white shadow-sm transition hover:bg-teal-700 no-underline">
                        <i class="bi bi-printer ml-1"></i>چاپ / Save PDF
                    </a>
                </div>
                @if (!string.IsNullOrEmpty(Model.ContractBodyHtml))
                {
                    <div class="border border-slate-200 dark:border-slate-800 rounded-lg p-4 bg-white">
                        @Html.Raw(Model.ContractBodyHtml)
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.TermsAndConditions))
                {
                    <div class="border border-slate-200 dark:border-slate-800 rounded-lg p-4 bg-white">
                        @Html.Raw(Model.TermsAndConditions)
                    </div>
                }
                else
                {
                    <div class="text-center py-8">
                        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2">
                            <i class="bi bi-file-text text-slate-400"></i>
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500">متن قراردادی ثبت نشده است.</p>
                    </div>
                }
            </div>

            @* Tab 3: Payments & Installments *@
            <div class="tab-panel @(activeTab == "payments" ? "" : "hidden")" id="tab-payments">
                @if (Model.CanViewFinancials)
                {
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-[11px] font-black text-slate-900 dark:text-white">پرداخت‌ها</h3>
                        @if (Model.CanEdit)
                        {
                            <button type="button" class="rounded-lg bg-teal-600 px-3 py-1.5 text-[10px] font-black text-white shadow-sm transition hover:bg-teal-700 no-underline" data-modal-target="addPaymentModal" onclick="openModal('addPaymentModal')">
                                <i class="bi bi-plus-circle ml-1"></i>پرداخت جدید
                            </button>
                        }
                    </div>

                    @if (Model.TotalAmount > 0)
                    {
                        var paidPct = (int)(Model.PaidAmount * 100 / Model.TotalAmount);
                        <div class="mb-3">
                            <div class="flex justify-between text-[10px] text-slate-500 mb-1">
                                <span>پیشرفت پرداخت (@Model.PaidAmount.ToString("N0") از @Model.TotalAmount.ToString("N0"))</span>
                                <span class="font-bold">@paidPct%</span>
                            </div>
                            <div class="w-full h-2.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                <div class="h-full rounded-full bg-emerald-500 transition-all" style="width: @paidPct%"></div>
                            </div>
                        </div>
                    }

                    @if (Model.Payments.Any())
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-[11px]">
                                <thead>
                                    <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/30">
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">مبلغ</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">تاریخ پرداخت</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">سررسید</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">وضعیت</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">روش پرداخت</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">شماره مرجع</th>
                                        <th class="text-right px-3 py-2 font-bold text-slate-500">توضیحات</th>
                                        @if (Model.CanEdit)
                                        {
                                            <th class="text-center px-3 py-2 font-bold text-slate-500">عملیات</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50 dark:divide-slate-800/60">
                                    @foreach (var payment in Model.Payments)
                                    {
                                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                                            <td class="px-3 py-2 font-mono tabular-nums font-bold text-slate-800 dark:text-slate-200">@payment.Amount.ToString("N0")</td>
                                            <td class="px-3 py-2 font-mono tabular-nums text-slate-600">@payment.PaymentDate.ToString("yyyy/MM/dd")</td>
                                            <td class="px-3 py-2 font-mono tabular-nums text-slate-600">@(payment.DueDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                            <td class="px-3 py-2">
                                                @{
                                                    var payStatusBadge = payment.Status switch
                                                    {
                                                        "Paid" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
                                                        "Pending" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
                                                        "Overdue" => "bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400",
                                                        _ => "bg-slate-100 text-slate-600"
                                                    };
                                                    var payStatusText = payment.Status switch
                                                    {
                                                        "Paid" => "پرداخت شده",
                                                        "Pending" => "در انتظار",
                                                        "Overdue" => "سررسید گذشته",
                                                        _ => payment.Status
                                                    };
                                                }
                                                <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[9px] font-bold border @payStatusBadge">@payStatusText</span>
                                            </td>
                                            <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@(payment.PaymentMethod ?? "-")</td>
                                            <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@(payment.ReferenceNumber ?? "-")</td>
                                            <td class="px-3 py-2 text-slate-700 dark:text-slate-300">@(payment.Notes ?? "-")</td>
                                            @if (Model.CanEdit)
                                            {
                                                <td class="px-3 py-2 text-center">
                                                    <form asp-action="DeletePayment" asp-route-paymentId="@payment.Id" asp-route-contractId="@Model.Id" method="post" class="inline" data-guard-submit onsubmit="return confirm('پرداخت حذف شود؟');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-rose-950/20 dark:hover:text-rose-400 transition" title="حذف">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-6">
                            <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2">
                                <i class="bi bi-credit-card text-slate-400"></i>
                            </div>
                            <p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ پرداختی ثبت نشده است.</p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-6">
                        <i class="bi bi-lock text-slate-400 text-lg"></i>
                        <p class="text-[11px] text-slate-400 mt-2">شما به اطلاعات مالی دسترسی ندارید.</p>
                    </div>
                }
            </div>

            @* Tab 4: Attachments *@
            <div class="tab-panel @(activeTab == "attachments" ? "" : "hidden")" id="tab-attachments">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-[11px] font-black text-slate-900 dark:text-white">ضمیمه‌ها</h3>
                    @if (Model.CanEdit)
                    {
                        <button type="button" class="rounded-lg bg-teal-600 px-3 py-1.5 text-[10px] font-black text-white shadow-sm transition hover:bg-teal-700 no-underline" data-modal-target="uploadAttachmentModal" onclick="openModal('uploadAttachmentModal')">
                            <i class="bi bi-cloud-upload ml-1"></i>بارگذاری فایل
                        </button>
                    }
                </div>
                @if (Model.Attachments.Any())
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-[11px]">
                            <thead>
                                <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/30">
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">نام فایل</th>
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">نوع</th>
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">حجم</th>
                                    <th class="text-right px-3 py-2 font-bold text-slate-500">تاریخ</th>
                                    <th class="text-center px-3 py-2 font-bold text-slate-500">عملیات</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/60">
                                @foreach (var att in Model.Attachments)
                                {
                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                                        <td class="px-3 py-2 font-bold text-slate-800 dark:text-slate-200">
                                            <i class="bi bi-file-earmark ml-1 text-slate-400"></i>@att.FileName
                                        </td>
                                        <td class="px-3 py-2 text-slate-600">@att.ContentType</td>
                                        <td class="px-3 py-2 font-mono tabular-nums text-slate-600">@(att.FileSize > 1024 ? $"{att.FileSize / 1024} KB" : $"{att.FileSize} B")</td>
                                        <td class="px-3 py-2 font-mono tabular-nums text-slate-600">@att.CreatedAt.ToString("yyyy/MM/dd")</td>
                                        <td class="px-3 py-2 text-center">
                                            <div class="inline-flex gap-1">
                                                <a asp-action="DownloadAttachment" asp-route-attachmentId="@att.Id" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 no-underline transition" title="دانلود">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                                @if (Model.CanEdit)
                                                {
                                                    <form asp-action="DeleteAttachment" asp-route-attachmentId="@att.Id" asp-route-contractId="@Model.Id" method="post" class="inline" data-guard-submit onsubmit="return confirm('فایل حذف شود؟');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-2 py-1 text-[9px] font-bold text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-rose-950/20 dark:hover:text-rose-400 transition" title="حذف">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-6">
                        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2">
                            <i class="bi bi-paperclip text-slate-400"></i>
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ ضمیمه‌ای وجود ندارد.</p>
                    </div>
                }
            </div>

            @* Tab 5: Activity Log *@
            <div class="tab-panel @(activeTab == "activity" ? "" : "hidden")" id="tab-activity">
                <h3 class="text-[11px] font-black text-slate-900 dark:text-white mb-3">تاریخچه فعالیت</h3>
                @if (Model.AuditLogs.Any())
                {
                    <div class="space-y-2">
                        @foreach (var log in Model.AuditLogs)
                        {
                            <div class="flex items-start gap-3 p-2.5 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-800">
                                <div class="h-7 w-7 rounded-full bg-teal-100 dark:bg-teal-900/30 flex items-center justify-center flex-shrink-0">
                                    <i class="bi bi-person text-teal-600 dark:text-teal-400 text-xs"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[11px] font-bold text-slate-800 dark:text-slate-200">@log.UserName</span>
                                        <span class="text-[9px] text-slate-400">@log.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
                                    </div>
                                    <p class="text-[10px] text-slate-600 dark:text-slate-400 mt-0.5">
                                        @switch (log.Action)
                                        {
                                            case "Created":
                                                <span>قرارداد را ایجاد کرد</span>
                                                break;
                                            case "StatusChanged":
                                                <span>وضعیت را از <strong>@log.OldStatus</strong> به <strong>@log.NewStatus</strong> تغییر داد</span>
                                                break;
                                            case "Archived":
                                                <span>قرارداد را بایگانی کرد</span>
                                                break;
                                            case "Unarchived":
                                                <span>قرارداد را از بایگانی خارج کرد</span>
                                                break;
                                            case "Edited":
                                                <span>قرارداد را ویرایش کرد</span>
                                                break;
                                            default:
                                                <span>@log.Action - @log.Description</span>
                                                break;
                                        }
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-6">
                        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 mb-2">
                            <i class="bi bi-clock-history text-slate-400"></i>
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500">هیچ فعالیتی ثبت نشده است.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

