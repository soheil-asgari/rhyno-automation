@model ContractEditVM
@{
    ViewData["Title"] = "ویرایش قرارداد";
}

<div class="container-fluid py-1 space-y-2" dir="rtl">
    @* Page Header Card *@
    <div class="erp-card p-3 mb-3">
        <partial name="_Breadcrumb" model='new[] {
            new RhynoBreadcrumbItem("خانه", "/"),
            new RhynoBreadcrumbItem("قراردادها", "/Contracts"),
            new RhynoBreadcrumbItem("ویرایش قرارداد", null)
        }' />

        <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
            <div class="w-7 h-7 rounded bg-teal-50 dark:bg-teal-950/30 flex items-center justify-center text-teal-600 dark:text-teal-400 text-sm"><i class="bi bi-file-earmark-text"></i></div>
            <div>
                <h1>ویرایش قرارداد</h1>
                <p>ویرایش اطلاعات قرارداد</p>
            </div>
            <div >
                <a asp-action="Index" erp-btn>
                    <i class="bi bi-arrow-right"></i>بازگشت
                </a>
            </div>
        </div>
    </div>

    @section Styles {
        <link rel="stylesheet" href="~/css/contracts-form.css" asp-append-version="true" />
    }

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger alert alert-danger mb-3" style="font-size:0.85rem;"></div>

        @* Redesigned Single-Column Layout - No Gaps *@
        <div class="contract-create-layout-redesigned">
        @* Card 1: General Information *@
        <div class="erp-fieldset">
            <div class="flex items-center gap-2 mb-2 pb-1 border-b border-slate-100 dark:border-slate-800">
                <div class="w-6 h-6 rounded bg-teal-50 dark:bg-teal-950/30 flex items-center justify-center text-teal-600 dark:text-teal-400 text-[10px]"><i class="bi bi-info-circle"></i></div>
                <div>
                    <h2>اطلاعات عمومی</h2>
                    <p class="form-section-desc">اطلاعات پایه قرارداد</p>
                </div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-2">
                <div>
                    <label asp-for="ContractNumber" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="ContractNumber" class="erp-input" />
                    </div>
                    <span asp-validation-for="ContractNumber" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div style="grid-column: span 2;">
                    <label asp-for="Title" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="Title" class="erp-input" />
                    </div>
                    <span asp-validation-for="Title" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div>
                    <label asp-for="ContractType" class="erp-label"></label>
                    <div class="input-wrapper">
                        <select asp-for="ContractType" class="erp-select" asp-items="Model.ContractTypeOptions">
                            <option value="">انتخاب کنید</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label asp-for="Status" class="erp-label"></label>
                    <div class="input-wrapper">
                        <select asp-for="Status" class="erp-select" asp-items="Model.StatusOptions"></select>
                    </div>
                </div>
                <div>
                    <label asp-for="ExpiryNoticeDays" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="ExpiryNoticeDays" type="number" class="erp-input" />
                    </div>
                </div>
            </div>
        </div>

        @* Card 2: Client & Party Info *@
        <div class="erp-fieldset">
            <div class="flex items-center gap-2 mb-2 pb-1 border-b border-slate-100 dark:border-slate-800">
                <div class="w-6 h-6 rounded bg-teal-50 dark:bg-teal-950/30 flex items-center justify-center text-teal-600 dark:text-teal-400 text-[10px]"><i class="bi bi-people"></i></div>
                <div>
                    <h2>مشتری / طرف قرارداد</h2>
                    <p class="form-section-desc">مشخصات طرف دیگر قرارداد</p>
                </div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-2">
                <div>
                    <label asp-for="CustomerId" class="erp-label"></label>
                    <div class="input-wrapper">
                        <select asp-for="CustomerId" class="erp-select" asp-items="Model.CustomerOptions">
                            <option value="">بدون مشتری (ثبت دستی)</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label asp-for="ClientName" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="ClientName" class="erp-input" />
                    </div>
                    <span asp-validation-for="ClientName" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div>
                    <label asp-for="ClientPhone" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="ClientPhone" class="erp-input" />
                    </div>
                </div>
                <div>
                    <label asp-for="ClientAddress" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="ClientAddress" class="erp-input" />
                    </div>
                </div>
            </div>
        </div>

        @* Card 3: Dates & Financials *@
        <div class="erp-fieldset">
            <div class="flex items-center gap-2 mb-2 pb-1 border-b border-slate-100 dark:border-slate-800">
                <div class="w-6 h-6 rounded bg-teal-50 dark:bg-teal-950/30 flex items-center justify-center text-teal-600 dark:text-teal-400 text-[10px]"><i class="bi bi-calendar3"></i></div>
                <div>
                    <h2>تاریخ‌ها و مالی</h2>
                    <p class="form-section-desc">تاریخ‌های کلیدی و مبالغ قرارداد</p>
                </div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-2">
                <div>
                    <label asp-for="StartDate" class="erp-label"></label>
                    <div class="input-wrapper icon-left jalali-datepicker-wrapper">
                        <span class="form-icon-left"><i class="bi bi-calendar3"></i></span>
                        <input asp-for="StartDateDisplay" type="text" class="erp-input jalali-date-input" data-jalali="StartDate" data-target="StartDate" placeholder="تاریخ را انتخاب کنید" readonly />
                        <input asp-for="StartDate" type="hidden" class="jalali-date-hidden" />
                    </div>
                    <span asp-validation-for="StartDate" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div>
                    <label asp-for="EndDate" class="erp-label"></label>
                    <div class="input-wrapper icon-left jalali-datepicker-wrapper">
                        <span class="form-icon-left"><i class="bi bi-calendar3"></i></span>
                        <input asp-for="EndDateDisplay" type="text" class="erp-input jalali-date-input" data-jalali="EndDate" data-target="EndDate" placeholder="تاریخ را انتخاب کنید" readonly />
                        <input asp-for="EndDate" type="hidden" class="jalali-date-hidden" />
                    </div>
                    <span asp-validation-for="EndDate" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div>
                    <label asp-for="SignDate" class="erp-label"></label>
                    <div class="input-wrapper icon-left jalali-datepicker-wrapper">
                        <span class="form-icon-left"><i class="bi bi-calendar3"></i></span>
                        <input asp-for="SignDateDisplay" type="text" class="erp-input jalali-date-input" data-jalali="SignDate" data-target="SignDate" placeholder="تاریخ را انتخاب کنید" readonly />
                        <input asp-for="SignDate" type="hidden" class="jalali-date-hidden" />
                    </div>
                    <span asp-validation-for="SignDate" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div>
                    <label asp-for="TotalAmount" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="TotalAmount" class="erp-input" dir="ltr" />
                    </div>
                    <span asp-validation-for="TotalAmount" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div>
                    <label asp-for="CurrencyCode" class="erp-label"></label>
                    <div class="input-wrapper">
                        <select asp-for="CurrencyCode" class="erp-select" asp-items="Model.CurrencyOptions"></select>
                    </div>
                    <span asp-validation-for="CurrencyCode" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div id="exchangeRateContainer" style="@(Model.CurrencyCode == "IRR" ? "display:none;" : "")">
                    <label asp-for="ExchangeRate" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="ExchangeRate" type="number" step="any" class="erp-input" dir="ltr" />
                    </div>
                    <span asp-validation-for="ExchangeRate" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div>
                    <label asp-for="TaxMethod" class="erp-label"></label>
                    <div class="input-wrapper">
                        <select asp-for="TaxMethod" class="erp-select" asp-items="Model.TaxMethodOptions"></select>
                    </div>
                    <span asp-validation-for="TaxMethod" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div id="taxRateContainer" style="@(Model.TaxMethod == "None" ? "display:none;" : "")">
                    <label asp-for="DefaultTaxRatePercent" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="DefaultTaxRatePercent" type="number" step="any" class="erp-input" dir="ltr" />
                    </div>
                    <span asp-validation-for="DefaultTaxRatePercent" class="text-[9px] text-red-500 mt-0.5"></span>
                </div>
                <div>
                    <label asp-for="TotalTaxAmount" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="TotalTaxAmount" readonly class="erp-input bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-mono font-bold" dir="ltr" />
                    </div>
                </div>
                <div>
                    <label asp-for="TotalAmountInclusiveTax" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="TotalAmountInclusiveTax" readonly class="erp-input bg-slate-50 dark:bg-slate-800 text-teal-700 dark:text-teal-400 font-mono font-bold" dir="ltr" />
                    </div>
                </div>
                <div>
                    <label asp-for="PaidAmount" class="erp-label"></label>
                    <div class="input-wrapper">
                        <input asp-for="PaidAmount" class="erp-input" dir="ltr" />
                    </div>
                </div>
            </div>
            <div class="mt-2">
                <span class="text-[9px] text-red-500 mt-0.5" style="color:#6b7280;">وضعیت پرداخت: @Model.PaymentStatus</span>
            </div>
        </div>

        @* Card 4: Assignment *@
        <div class="erp-fieldset">
            <div class="flex items-center gap-2 mb-2 pb-1 border-b border-slate-100 dark:border-slate-800">
                <div class="w-6 h-6 rounded bg-teal-50 dark:bg-teal-950/30 flex items-center justify-center text-teal-600 dark:text-teal-400 text-[10px]"><i class="bi bi-person-badge"></i></div>
                <div>
                    <h2>اختصاص</h2>
                    <p class="form-section-desc">مسئول و قالب قرارداد</p>
                </div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-2">
                <div>
                    <label asp-for="AssignedUserId" class="erp-label"></label>
                    <div class="input-wrapper">
                        <select asp-for="AssignedUserId" class="erp-select" asp-items="Model.UserOptions">
                            <option value="">انتخاب کنید</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label asp-for="TemplateId" class="erp-label"></label>
                    <div class="input-wrapper">
                        <select asp-for="TemplateId" class="erp-select" asp-items="Model.TemplateOptions">
                            <option value="">بدون قالب</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @* Card 5: Content & Terms *@
        <div class="erp-fieldset">
            <div class="flex items-center gap-2 mb-2 pb-1 border-b border-slate-100 dark:border-slate-800">
                <div class="w-6 h-6 rounded bg-teal-50 dark:bg-teal-950/30 flex items-center justify-center text-teal-600 dark:text-teal-400 text-[10px]"><i class="bi bi-file-text"></i></div>
                <div>
                    <h2>متن قرارداد</h2>
                    <p class="form-section-desc">شرح، یادداشت‌ها و متن قرارداد</p>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 12px;">
                    <div>
                        <label class="erp-label">توضیحات</label>
                        <textarea asp-for="Description" class="erp-input" style="min-height:48px; resize: vertical;"></textarea>
                        <span asp-validation-for="Description" class="text-[9px] text-red-500 mt-0.5"></span>
                    </div>
                    <div>
                        <label class="erp-label">یادداشت‌ها</label>
                        <textarea asp-for="Notes" class="erp-input" style="min-height:48px; resize: vertical;"></textarea>
                    </div>
                    <div>
                        <label class="erp-label">شرایط و ضوابط</label>
                        <textarea asp-for="TermsAndConditions" class="erp-input" style="min-height:48px; resize: vertical;"></textarea>
                    </div>
                </div>
            @* ── Dynamic Type-Specific Fields ── *@
            <div id="dynamicFieldsContainer" class="mt-3">
                @* Rendered by JS based on selected contract type *@
            </div>
            <input type="hidden" id="allTypeFieldsJson" value='@System.Text.Json.JsonSerializer.Serialize(Model.TypeFields)' />
            <input type="hidden" id="submittedFieldValuesJson" name="FieldValues" value='@System.Text.Json.JsonSerializer.Serialize(Model.FieldValues)' />
            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-2" style="margin-bottom:20px;">
                <div>
                    <label class="erp-label">متن قرارداد (ویرایشگر بصری)</label>
                    @* Toolbar *@
                    <div class="flex flex-wrap items-center gap-1 mb-1.5 px-2 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg">
                        <button type="button" class="wysiwyg-btn px-2 py-0.5 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:hover:bg-slate-800 rounded transition border-0 bg-transparent cursor-pointer" data-cmd="bold" title="ضخیم"><b>B</b></button>
                        <button type="button" class="wysiwyg-btn px-2 py-0.5 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:hover:bg-slate-800 rounded transition border-0 bg-transparent cursor-pointer" data-cmd="italic" title="کج"><i>I</i></button>
                        <button type="button" class="wysiwyg-btn px-2 py-0.5 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:hover:bg-slate-800 rounded transition border-0 bg-transparent cursor-pointer" data-cmd="underline" title="زیرخط"><u>U</u></button>
                        <span class="w-px h-4 bg-slate-300 dark:bg-slate-600 mx-1"></span>
                        <button type="button" class="wysiwyg-btn px-2 py-0.5 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:hover:bg-slate-800 rounded transition border-0 bg-transparent cursor-pointer" data-cmd="insertOrderedList" title="لیست شماره‌دار"><i class="bi bi-list-ol"></i></button>
                        <button type="button" class="wysiwyg-btn px-2 py-0.5 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:hover:bg-slate-800 rounded transition border-0 bg-transparent cursor-pointer" data-cmd="insertUnorderedList" title="لیست نقطه‌ای"><i class="bi bi-list-ul"></i></button>
                        <span class="w-px h-4 bg-slate-300 dark:bg-slate-600 mx-1"></span>
                        <button type="button" class="wysiwyg-btn px-2 py-0.5 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:hover:bg-slate-800 rounded transition border-0 bg-transparent cursor-pointer" data-cmd="justifyRight" title="راست‌چین"><i class="bi bi-text-right"></i></button>
                        <button type="button" class="wysiwyg-btn px-2 py-0.5 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:hover:bg-slate-800 rounded transition border-0 bg-transparent cursor-pointer" data-cmd="justifyCenter" title="وسط‌چین"><i class="bi bi-text-center"></i></button>
                        <button type="button" class="wysiwyg-btn px-2 py-0.5 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:hover:bg-slate-800 rounded transition border-0 bg-transparent cursor-pointer" data-cmd="justifyLeft" title="چپ‌چین"><i class="bi bi-text-left"></i></button>
                    </div>
                    <div id="editContractEditor" class="wysiwyg-editor" contenteditable="true"
                         style="min-height:120px;background:#fff;border:1px solid #e2e8f0;border-radius:3px;padding:8px;font-size:11px;line-height:1.6;font-family:Vazirmatn,Tahoma,sans-serif;direction:rtl;text-align:right;overflow-y:auto;"
                         data-placeholder="متن قرارداد را اینجا بنویسید..."></div>
                    <textarea asp-for="ContractBodyHtml" class="hidden" id="ContractBodyHtml"></textarea>
                </div>
            </div>
        </div><!-- /contract-create-layout-redesigned -->

        @* Action Buttons *@
        <div class="erp-card flex items-center justify-between px-3 py-2" style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:0;">
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                <i class="bi bi-info-circle me-1"></i>تغییرات اعمال‌شده بلافاصله در سوابق قرارداد ثبت می‌شود.
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="erp-btn erp-btn-primary">
                    <i class="bi bi-check-lg ml-1"></i>ذخیره تغییرات
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="erp-btn">
                    انصراف
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/persian-date.min.js"></script>
    <link rel="stylesheet" href="~/css/persian-datepicker.min.css" />
    <link rel="stylesheet" href="~/css/contracts-edit-style.css" asp-append-version="true" />
    <script src="~/js/contracts-edit-script.js" asp-append-version="true"></script>
}
