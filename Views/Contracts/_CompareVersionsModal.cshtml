@* ── Compare Contract Versions Modal ────────────────────────────────────── *@
<div class="fixed inset-0 z-[100] bg-black/60 hidden items-center justify-center p-2 sm:p-4 backdrop-blur-sm" id="compareVersionsModal">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 w-full max-w-6xl max-h-[92vh] flex flex-col overflow-hidden">
        @* ── Modal Header ── *@
        <div class="bg-slate-50 dark:bg-slate-800/80 px-5 py-3.5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between flex-shrink-0">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center text-base">
                    <i class="bi bi-file-earmark-diff"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        مقایسه نسخه‌های قرارداد
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">
                        بررسی تغییرات متن قرارداد، متمم‌ها و ویرایش‌ها با تفکیک دقیق در سطح کلمات
                    </p>
                </div>
            </div>
            <button type="button" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition cursor-pointer border-0 bg-transparent text-xl flex-shrink-0" id="compareModalClose">&times;</button>
        </div>

        @* ── Controls Toolbar: Selectors & View Mode Toggle ── *@
        <div class="bg-slate-100/70 dark:bg-slate-950/60 p-4 border-b border-slate-200 dark:border-slate-800 flex-shrink-0">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                @* Version 1 (Base) Selector *@
                <div class="md:col-span-4">
                    <label for="diffVersionA" class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">
                        نسخه اول (پایه / قبلی):
                    </label>
                    <select id="diffVersionA" class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none">
                        <option value="">در حال دریافت لیست نسخه‌ها...</option>
                    </select>
                </div>

                @* Version 2 (Compare) Selector *@
                <div class="md:col-span-4">
                    <label for="diffVersionB" class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">
                        نسخه دوم (مقایسه / جدید یا جاری):
                    </label>
                    <select id="diffVersionB" class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none">
                        <option value="">در حال دریافت لیست نسخه‌ها...</option>
                    </select>
                </div>

                @* View Mode Toggle Switch (Side-by-Side vs. Inline) *@
                <div class="md:col-span-4 flex items-center justify-between sm:justify-end gap-3 pt-1 md:pt-0">
                    <div class="inline-flex rounded-xl bg-slate-200 dark:bg-slate-800 p-1 text-xs font-bold border border-slate-300 dark:border-slate-700" role="group">
                        <button type="button" id="btnDiffSideBySide" class="px-3 py-1.5 rounded-lg transition text-slate-700 dark:text-slate-300 flex items-center gap-1.5 cursor-pointer border-0 bg-transparent" title="نمایش دو ستونی کنار هم">
                            <i class="bi bi-layout-split"></i>
                            <span>کنار هم</span>
                        </button>
                        <button type="button" id="btnDiffInline" class="px-3 py-1.5 rounded-lg transition text-slate-700 dark:text-slate-300 flex items-center gap-1.5 cursor-pointer border-0 bg-transparent" title="نمایش یکپارچه متنی">
                            <i class="bi bi-text-paragraph"></i>
                            <span>درون‌خطی</span>
                        </button>
                    </div>

                    <button type="button" id="btnRefreshDiff" class="erp-btn erp-btn-secondary text-xs px-3 py-2 text-slate-600 dark:text-slate-300" title="تازه‌سازی مقایسه">
                        <i class="bi bi-arrow-repeat"></i>
                    </button>
                </div>
            </div>

            @* Stats and Legend Row *@
            <div class="mt-3 pt-2.5 border-t border-slate-200/70 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
                @* Legend badges *@
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-800 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-950/50 border border-emerald-300 dark:border-emerald-800 px-2 py-0.5 rounded-md">
                        <i class="bi bi-plus-circle text-emerald-600 dark:text-emerald-400"></i>
                        <span>افزوده شده (سبز)</span>
                    </span>
                    <span class="inline-flex items-center gap-1 text-[11px] font-medium text-rose-800 dark:text-rose-300 bg-rose-100 dark:bg-rose-950/50 border border-rose-300 dark:border-rose-800 px-2 py-0.5 rounded-md line-through">
                        <i class="bi bi-dash-circle text-rose-600 dark:text-rose-400"></i>
                        <span>حذف شده (قرمز)</span>
                    </span>
                </div>

                @* Word-level stats *@
                <div id="diffStatsContainer" class="flex items-center gap-3 font-mono text-[11px] text-slate-600 dark:text-slate-400">
                    <span class="text-slate-400">تغییرات کلمات:</span>
                    <span class="text-emerald-700 dark:text-emerald-400 font-bold" id="statWordsAdded">+0 کلمه افزوده</span>
                    <span class="text-slate-300 dark:text-slate-700">|</span>
                    <span class="text-rose-700 dark:text-rose-400 font-bold" id="statWordsRemoved">-0 کلمه حذف شده</span>
                </div>
            </div>
        </div>

        @* ── Main Diff Display Area ── *@
        <div class="flex-1 overflow-y-auto p-4 sm:p-5 relative min-h-[350px]" id="diffContentArea">
            @* Loading Spinner *@
            <div class="absolute inset-0 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xs flex flex-col items-center justify-center gap-3 z-10 hidden" id="diffLoading">
                <div class="w-8 h-8 border-2 border-teal-500 border-t-transparent rounded-full animate-spin"></div>
                <span class="text-xs text-slate-500 dark:text-slate-400">در حال دریافت محتوای نسخه‌ها و محاسبه تغییرات...</span>
            </div>

            @* Empty / Initial State Prompt *@
            <div class="text-center py-12 text-slate-400 dark:text-slate-500" id="diffEmptyState">
                <div class="inline-flex items-center justify-center h-12 w-12 rounded-2xl bg-slate-100 dark:bg-slate-800 mb-2 text-2xl">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <p class="text-xs">لطفاً دو نسخه را از منوهای بالا جهت مشاهده تفاوت‌ها انتخاب کنید.</p>
            </div>

            @* Side-by-Side Container *@
            <div id="diffSideBySideContainer" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4 h-full">
                @* Left Column: Version A (Old) *@
                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 p-4 flex flex-col">
                    <div class="pb-2 mb-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between flex-shrink-0">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5" id="headerVersionA">
                            <i class="bi bi-file-earmark text-slate-400"></i>نسخه اول (پایه)
                        </span>
                        <span class="text-[10px] font-mono text-slate-500" id="metaVersionA"></span>
                    </div>
                    <div class="diff-viewer text-xs leading-relaxed text-slate-800 dark:text-slate-200 overflow-y-auto max-h-[55vh] p-2 whitespace-pre-wrap font-sans" id="contentVersionA" dir="rtl"></div>
                </div>

                @* Right Column: Version B (New / Current) *@
                <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 p-4 flex flex-col">
                    <div class="pb-2 mb-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between flex-shrink-0">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5" id="headerVersionB">
                            <i class="bi bi-file-earmark-text text-teal-500"></i>نسخه دوم (مقایسه)
                        </span>
                        <span class="text-[10px] font-mono text-slate-500" id="metaVersionB"></span>
                    </div>
                    <div class="diff-viewer text-xs leading-relaxed text-slate-800 dark:text-slate-200 overflow-y-auto max-h-[55vh] p-2 whitespace-pre-wrap font-sans" id="contentVersionB" dir="rtl"></div>
                </div>
            </div>

            @* Inline Diff Container *@
            <div id="diffInlineContainer" class="hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 p-4">
                <div class="pb-2 mb-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                        <i class="bi bi-text-paragraph text-teal-500"></i>نمای یکپارچه تغییرات متن
                    </span>
                    <span class="text-[10px] text-slate-400" id="inlineDiffNotice">متون خط‌خورده قرمز حذف شده و متون سبز اضافه شده‌اند.</span>
                </div>
                <div class="diff-viewer text-xs leading-relaxed text-slate-800 dark:text-slate-200 overflow-y-auto max-h-[55vh] p-3 whitespace-pre-wrap font-sans" id="contentInline" dir="rtl"></div>
            </div>
        </div>

        @* ── Modal Footer ── *@
        <div class="bg-slate-50 dark:bg-slate-800/80 px-5 py-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between flex-shrink-0">
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
                <i class="bi bi-info-circle ml-1 text-teal-600"></i>تغییرات در سطح کلمات محاسبه و نمایش داده می‌شوند.
            </span>
            <button type="button" class="erp-btn text-xs px-4 py-2 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700" id="compareModalCloseBtn">بستن</button>
        </div>
    </div>
</div>
