@model ContractSettingsVM
@{
    ViewData["Title"] = "تنظیمات قراردادها";
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="alert alert-success py-2 px-3 small mb-3">@successMsg</div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="alert alert-danger py-2 px-3 small mb-3">@errorMsg</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">تنظیمات قراردادها</h6>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">بازگشت</a>
    </div>

    @* General Settings Card *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-light py-2 px-3">
            <small class="fw-bold">تنظیمات عمومی</small>
        </div>
        <div class="card-body p-3">
            <form asp-action="Settings" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label asp-for="DefaultStatus" class="form-label small"></label>
                        <select asp-for="DefaultStatus" class="form-select form-select-sm"
                                asp-items="Model.StatusOptions">
                            <option value="">پیش‌فرض (پیش‌نویس)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DefaultResponsibleUserId" class="form-label small"></label>
                        <select asp-for="DefaultResponsibleUserId" class="form-select form-select-sm"
                                asp-items="Model.UserOptions">
                            <option value="">بدون پیش‌فرض</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="NotifyOnCreate" class="form-check-input" />
                            <label asp-for="NotifyOnCreate" class="form-check-label small">اعلان هنگام ایجاد
                                قرارداد</label>
                            </div>
                        </div>
                        <div class="col-12 mt-2">
                            <button type="submit" class="btn btn-sm btn-success">ذخیره تنظیمات</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @* Template Manager Card *@
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                <small class="fw-bold">قالب‌های قرارداد</small>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                        data-bs-target="#addTemplateModal">+ قالب جدید</button>
            </div>
            <div class="card-body p-0">
                @if (Model.Templates.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>نام قالب</th>
                                    <th>توضیحات</th>
                                    <th>پیش‌فرض</th>
                                    <th class="text-center">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var template in Model.Templates)
                                {
                                    <tr>
                                        <td>@template.Name</td>
                                        <td>@(template.Description ?? "-")</td>
                                        <td>
                                            @if (template.IsDefault)
                                            {
                                                <span class="badge text-bg-success">فعال</span>
                                            }
                                            else
                                            {
                                                <form asp-action="SetDefaultTemplate" asp-route-templateId="@template.Id" method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success">انتخاب</button>
                                                </form>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="d-inline-flex gap-1">
                                                <form asp-action="DeleteTemplate" asp-route-templateId="@template.Id" method="post"
                                                      class="d-inline" onsubmit="return confirm('قالب حذف شود؟');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3 small">هیچ قالبی تعریف نشده است.</div>
                }
            </div>
        </div>
    </div>
    @* Add Template Modal *@
    <div class="modal fade" id="addTemplateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="SaveTemplate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CurrentTemplateId" />
                    <div class="modal-header py-2 px-3">
                        <small class="fw-bold">قالب جدید</small>
                        <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-3">
                        <div class="mb-2">
                            <label asp-for="TemplateName" class="form-label small"></label>
                            <input asp-for="TemplateName" class="form-control form-control-sm" required />
                        </div>
                        <div class="mb-2">
                            <label asp-for="Description" class="form-label small"></label>
                            <textarea asp-for="Description" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                        <div class="mb-2">
                            <label asp-for="FormatJson" class="form-label small"></label>
                            <textarea asp-for="FormatJson" class="form-control form-control-sm font-monospace" rows="4"
                                      placeholder='{"fields":["title","clientName","totalAmount"],"showHeader":true}'></textarea>
                        </div>
                        <div class="mb-2">
                            <label asp-for="TemplateHtml" class="form-label small"></label>
                            <textarea asp-for="TemplateHtml" class="form-control form-control-sm font-monospace" rows="6"
                                      placeholder="<html>...</html>"></textarea>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsDefault" class="form-check-input" type="checkbox" />
                            <label asp-for="IsDefault" class="form-check-label small">به عنوان قالب پیش‌فرض</label>
                        </div>
                    </div>
                    <div class="modal-footer py-2 px-3">
                        <button type="submit" class="btn btn-sm btn-success">ذخیره</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-bs-dismiss="modal">انصراف</button>
                    </div>
                </form>
            </div>
        </div>
    </div>