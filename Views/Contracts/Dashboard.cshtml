@model ContractDashboardVM
@{
    ViewData["Title"] = "داشبورد قراردادها";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">داشبورد قراردادها</h6>
        <a asp-action="Index" class="btn btn-sm btn-outline-primary">فهرست قراردادها</a>
    </div>

    @* Summary Cards *@
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="SgFarsiDigits fs-5 fw-bold text-primary">@Model.TotalContracts.ToString("N0")</div>
                <small class="text-muted">کل قراردادها</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="SgFarsiDigits fs-5 fw-bold text-success">@Model.ActiveContracts.ToString("N0")</div>
                <small class="text-muted">فعال</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="SgFarsiDigits fs-5 fw-bold text-warning">@Model.ExpiringSoonCount.ToString("N0")</div>
                <small class="text-muted">در حال انقضا (30 روز)</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="SgFarsiDigits fs-5 fw-bold text-danger">@Model.ExpiredContracts.ToString("N0")</div>
                <small class="text-muted">منقضی شده</small>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="SgFarsiDigits fs-5 fw-bold text-secondary">@Model.DraftContracts.ToString("N0")</div>
                <small class="text-muted">پیش‌نویس</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="SgFarsiDigits fs-5 fw-bold text-info">@Model.ArchivedContracts.ToString("N0")</div>
                <small class="text-muted">بایگانی شده</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="SgFarsiDigits fs-5 fw-bold text-success">@Model.FullyPaid.ToString("N0")</div>
                <small class="text-muted">پرداخت کامل</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="SgFarsiDigits fs-5 fw-bold text-danger">@Model.Unpaid.ToString("N0")</div>
                <small class="text-muted">پرداخت نشده</small>
            </div>
        </div>
    </div>

    @* Financial Summary *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-light py-2 px-3">
            <small class="fw-bold">خلاصه مالی</small>
        </div>
        <div class="card-body p-3">
            <div class="row g-2">
                <div class="col-md-4">
                    <small class="text-muted d-block">مبلغ کل قراردادها</small>
                    <span class="SgFarsiDigits fw-bold text-primary fs-5">@Model.TotalAmount.ToString("N0")</span>
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">مبلغ پرداخت شده</small>
                    <span class="SgFarsiDigits fw-bold text-success fs-5">@Model.TotalPaid.ToString("N0")</span>
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">باقی مانده</small>
                    <span class="SgFarsiDigits fw-bold text-danger fs-5">@Model.TotalOutstanding.ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>

    @* Payment Status Breakdown *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light py-2 px-3">
            <small class="fw-bold">وضعیت پرداخت</small>
        </div>
        <div class="card-body p-3">
            <div class="row g-2 text-center">
                <div class="col-4">
                    <div class="p-2 bg-success bg-opacity-10 rounded">
                        <div class="SgFarsiDigits fw-bold text-success">@Model.FullyPaid.ToString("N0")</div>
                        <small class="text-muted">تکمیل</small>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 bg-warning bg-opacity-10 rounded">
                        <div class="SgFarsiDigits fw-bold text-warning">@Model.PartiallyPaid.ToString("N0")</div>
                        <small class="text-muted">جزئی</small>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 bg-danger bg-opacity-10 rounded">
                        <div class="SgFarsiDigits fw-bold text-danger">@Model.Unpaid.ToString("N0")</div>
                        <small class="text-muted">پرداخت نشده</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>