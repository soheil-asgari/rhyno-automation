@model OfficeAutomation.Controllers.AuditDashboardViewModel
@{
    ViewData["Title"] = "داشبورد لاگ";
    ViewData["SectionTitle"] = "داشبورد لاگ و رویدادهای حساس";
    ViewData["SectionSubtitle"] = "نمای سریع و قابل‌فیلتر از رخدادهای امنیتی، حذف‌ها و تغییرات حساس";
}

@section Styles {
    <link rel="stylesheet" href="~/css/audit-dashboard-index-style.css" asp-append-version="true" />
}

<div class="page-shell audit-dashboard-page">
    <partial name="_SectionHeader" />

    <div class="audit-stats-grid">
        <div class="audit-stat-card is-active">
            <span class="audit-stat-label">کل رویدادها</span>
            <span class="audit-stat-value">@Model.TotalEvents</span>
        </div>
        <div class="audit-stat-card">
            <span class="audit-stat-label">رویدادهای هفته</span>
            <span class="audit-stat-value text-primary">@Model.WeekEvents</span>
        </div>
        <div class="audit-stat-card">
            <span class="audit-stat-label">رویداد حساس امروز</span>
            <span class="audit-stat-value text-warning">@Model.SensitiveEventsToday</span>
        </div>
        <div class="audit-stat-card">
            <span class="audit-stat-label">حذف امروز</span>
            <span class="audit-stat-value text-danger">@Model.DeletesToday</span>
        </div>
    </div>

    <div
        class="bg-white dark:bg-dark-surface rounded-2xl border border-gray-100 dark:border-dark-border shadow-sm p-4 mb-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
            <div class="sm:col-span-2 md:col-span-4">
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">جستجوی متنی</label>
                <input type="search"
                       class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                       id="audit-search" placeholder="کاربر، جدول، ستون، ماژول یا عملیات..." />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">ماژول</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-module">
                    <option value="">همه ماژول‌ها</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">عملیات</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-action">
                    <option value="">همه عملیات</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">جدول</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-table">
                    <option value="">همه جدول‌ها</option>
                </select>
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mt-4">
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">کاربر</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-user">
                    <option value="">همه کاربران</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">از تاریخ</label>
                <input type="date"
                       class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                       id="audit-from" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">تا تاریخ</label>
                <input type="date"
                       class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                       id="audit-to" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">فقط حساس</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-sensitive">
                    <option value="">همه</option>
                    <option value="true">بله</option>
                    <option value="false">خیر</option>
                </select>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-3 mt-4 pt-4 border-t border-gray-100 dark:border-dark-border">
            <button
                class="inline-flex items-center gap-1.5 px-4 py-2.5 text-sm font-bold rounded-xl bg-teal-600 text-white hover:bg-teal-700 shadow-sm transition"
                id="audit-refresh">
                <i class="bi bi-funnel"></i> اعمال فیلتر
            </button>
            <a class="inline-flex items-center gap-1.5 px-4 py-2.5 text-sm font-bold rounded-xl border border-gray-200 dark:border-dark-border text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-dark-elevated transition"
               id="audit-export" href="/api/admin/audit-logs/export" target="_blank">
                <i class="bi bi-download"></i> خروجی CSV
            </a>
            <div class="flex flex-wrap gap-2 ms-auto">
                <button type="button"
                        class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition"
                        id="audit-expand-all"><i class="bi bi-arrows-expand"></i> باز کردن همه</button>
                <button type="button"
                        class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition"
                        id="audit-collapse-all"><i class="bi bi-arrows-collapse"></i> بستن همه</button>
                <button type="button"
                        class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition"
                        id="audit-copy-json"><i class="bi bi-copy"></i> کپی JSON</button>
            </div>
        </div>
    </div>

    <div
        class="overflow-x-auto min-w-full my-4 rounded-2xl border border-gray-100 dark:border-dark-border bg-white dark:bg-dark-surface shadow-sm">
        <table class="w-full min-w-[800px] text-right text-sm border-collapse">
            <thead>
                <tr class="bg-gray-50 dark:bg-dark-elevated text-gray-600 dark:text-dark-muted font-bold">
                    <th class="px-4 py-3 whitespace-nowrap">زمان</th>
                    <th class="px-4 py-3 whitespace-nowrap">کاربر</th>
                    <th class="px-4 py-3 whitespace-nowrap">عملیات</th>
                    <th class="px-4 py-3 whitespace-nowrap">ماژول</th>
                    <th class="px-4 py-3 whitespace-nowrap">جدول</th>
                    <th class="px-4 py-3 whitespace-nowrap">حساس</th>
                    <th class="px-4 py-3 whitespace-nowrap">جزئیات</th>
                </tr>
            </thead>
            <tbody id="audit-table-body" class="divide-y divide-gray-100 dark:divide-dark-border">
                <tr>
                    <td colspan="7">
                        <div class="flex flex-col items-center justify-center py-12 text-gray-400 dark:text-gray-500">
                            <i class="bi bi-hourglass-split text-3xl mb-3"></i>
                            <span class="text-sm">در حال بارگذاری ...</span>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="flex items-center justify-between mt-3 px-1">
        <div class="text-xs text-gray-500 dark:text-dark-muted" id="audit-summary"></div>
        <div class="flex items-center gap-2">
            <button
            class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition disabled:opacity-40 disabled:cursor-not-allowed"
            id="audit-prev"><i class="bi bi-chevron-right"></i> قبلی</button>
            <button
            class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition disabled:opacity-40 disabled:cursor-not-allowed"
            id="audit-next">بعدی <i class="bi bi-chevron-left"></i></button>
        </div>
    </div>

    <div class="bg-white dark:bg-dark-surface rounded-2xl border border-gray-100 dark:border-dark-border shadow-sm p-4 mt-3"
         id="audit-detail-panel" style="display:none;">
        <h3 class="text-sm font-black text-gray-900 dark:text-white mb-3">جزئیات ردیف انتخاب‌شده</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <span class="block text-xs text-gray-500 dark:text-dark-muted mb-1">مقادیر قبلی</span>
                <pre class="audit-json" id="audit-old-values"></pre>
            </div>
            <div>
                <span class="block text-xs text-gray-500 dark:text-dark-muted mb-1">مقادیر جدید</span>
                <pre class="audit-json" id="audit-new-values"></pre>
            </div>
        </div>
        <div class="text-xs text-gray-500 dark:text-dark-muted mt-3" id="audit-detail-meta"></div>
    </div>
</div>

<script src="~/js/audit-dashboard-index-script.js" asp-append-version="true"></script>
