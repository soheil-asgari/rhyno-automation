@model OfficeAutomation.Controllers.AuditDashboardViewModel
@{
    ViewData["Title"] = "داشبورد لاگ";
    ViewData["SectionTitle"] = "داشبورد لاگ و رویدادهای حساس";
    ViewData["SectionSubtitle"] = "نمای سریع و قابل‌فیلتر از رخدادهای امنیتی، حذف‌ها و تغییرات حساس";
}

@section Styles {
    <style>
        .audit-dashboard-page .section-header {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .audit-dashboard-page .section-subtitle {
            margin: 0.35rem 0 0;
            color: #64748b;
            font-size: 0.95rem;
        }

        .audit-stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .audit-stat-card {
            background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
            border: 1px solid #dbe7f3;
            border-radius: 18px;
            padding: 1.1rem 1.2rem;
            box-shadow: 0 12px 30px -22px rgba(15, 23, 42, 0.28);
        }

        .audit-stat-card.is-active {
            background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);
            border-color: #1d4ed8;
            color: #fff;
        }

        .audit-stat-label {
            display: block;
            font-size: 0.86rem;
            color: #64748b;
            margin-bottom: 0.45rem;
        }

        .audit-stat-card.is-active .audit-stat-label {
            color: rgba(255, 255, 255, 0.82);
        }

        .audit-stat-value {
            display: block;
            font-size: 2rem;
            line-height: 1;
            font-weight: 800;
            color: #0f172a;
        }

        .audit-stat-card.is-active .audit-stat-value {
            color: #fff;
        }

        .audit-json {
            direction: ltr;
            text-align: left;
            background: #0f172a;
            color: #e2e8f0;
            border-radius: 14px;
            padding: 1rem;
            min-height: 140px;
            overflow: auto;
            font-size: 0.82rem;
        }

        .audit-inline-detail .audit-json {
            min-height: auto;
            max-height: 220px;
            padding: 0.75rem;
            border-radius: 12px;
        }

        @@media (max-width: 992px) {
            .audit-stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 576px) {
            .audit-dashboard-page .section-header {
                align-items: start;
            }

            .audit-stats-grid {
                grid-template-columns: 1fr;
            }

            .audit-stat-value {
                font-size: 1.6rem;
            }
        }
    </style>
}

<div class="page-shell audit-dashboard-page">
    <partial name="_SectionHeader" />

    <div class="audit-stats-grid">
        <div class="audit-stat-card is-active">
            <span class="audit-stat-label">کل رویدادها</span>
            <span class="audit-stat-value">@Model.TotalEvents</span>
        </div>
        <div class="audit-stat-card">
            <span class="audit-stat-label">رویدادهای هفته</span>
            <span class="audit-stat-value text-primary">@Model.WeekEvents</span>
        </div>
        <div class="audit-stat-card">
            <span class="audit-stat-label">رویداد حساس امروز</span>
            <span class="audit-stat-value text-warning">@Model.SensitiveEventsToday</span>
        </div>
        <div class="audit-stat-card">
            <span class="audit-stat-label">حذف امروز</span>
            <span class="audit-stat-value text-danger">@Model.DeletesToday</span>
        </div>
    </div>

    <div
        class="bg-white dark:bg-dark-surface rounded-2xl border border-gray-100 dark:border-dark-border shadow-sm p-4 mb-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
            <div class="sm:col-span-2 md:col-span-4">
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">جستجوی متنی</label>
                <input type="search"
                       class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                       id="audit-search" placeholder="کاربر، جدول، ستون، ماژول یا عملیات..." />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">ماژول</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-module">
                    <option value="">همه ماژول‌ها</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">عملیات</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-action">
                    <option value="">همه عملیات</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">جدول</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-table">
                    <option value="">همه جدول‌ها</option>
                </select>
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mt-4">
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">کاربر</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-user">
                    <option value="">همه کاربران</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">از تاریخ</label>
                <input type="date"
                       class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                       id="audit-from" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">تا تاریخ</label>
                <input type="date"
                       class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                       id="audit-to" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">فقط حساس</label>
                <select
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:border-teal-500 focus:ring-1 focus:ring-teal-500/10 outline-none transition"
                    id="audit-sensitive">
                    <option value="">همه</option>
                    <option value="true">بله</option>
                    <option value="false">خیر</option>
                </select>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-3 mt-4 pt-4 border-t border-gray-100 dark:border-dark-border">
            <button
                class="inline-flex items-center gap-1.5 px-4 py-2.5 text-sm font-bold rounded-xl bg-teal-600 text-white hover:bg-teal-700 shadow-sm transition"
                id="audit-refresh">
                <i class="bi bi-funnel"></i> اعمال فیلتر
            </button>
            <a class="inline-flex items-center gap-1.5 px-4 py-2.5 text-sm font-bold rounded-xl border border-gray-200 dark:border-dark-border text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-dark-elevated transition"
               id="audit-export" href="/api/admin/audit-logs/export" target="_blank">
                <i class="bi bi-download"></i> خروجی CSV
            </a>
            <div class="flex flex-wrap gap-2 ms-auto">
                <button type="button"
                        class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition"
                        id="audit-expand-all"><i class="bi bi-arrows-expand"></i> باز کردن همه</button>
                <button type="button"
                        class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition"
                        id="audit-collapse-all"><i class="bi bi-arrows-collapse"></i> بستن همه</button>
                <button type="button"
                        class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition"
                        id="audit-copy-json"><i class="bi bi-copy"></i> کپی JSON</button>
            </div>
        </div>
    </div>

    <div
        class="overflow-x-auto min-w-full my-4 rounded-2xl border border-gray-100 dark:border-dark-border bg-white dark:bg-dark-surface shadow-sm">
        <table class="w-full min-w-[800px] text-right text-sm border-collapse">
            <thead>
                <tr class="bg-gray-50 dark:bg-dark-elevated text-gray-600 dark:text-dark-muted font-bold">
                    <th class="px-4 py-3 whitespace-nowrap">زمان</th>
                    <th class="px-4 py-3 whitespace-nowrap">کاربر</th>
                    <th class="px-4 py-3 whitespace-nowrap">عملیات</th>
                    <th class="px-4 py-3 whitespace-nowrap">ماژول</th>
                    <th class="px-4 py-3 whitespace-nowrap">جدول</th>
                    <th class="px-4 py-3 whitespace-nowrap">حساس</th>
                    <th class="px-4 py-3 whitespace-nowrap">جزئیات</th>
                </tr>
            </thead>
            <tbody id="audit-table-body" class="divide-y divide-gray-100 dark:divide-dark-border">
                <tr>
                    <td colspan="7">
                        <div class="flex flex-col items-center justify-center py-12 text-gray-400 dark:text-gray-500">
                            <i class="bi bi-hourglass-split text-3xl mb-3"></i>
                            <span class="text-sm">در حال بارگذاری ...</span>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="flex items-center justify-between mt-3 px-1">
        <div class="text-xs text-gray-500 dark:text-dark-muted" id="audit-summary"></div>
        <div class="flex items-center gap-2">
            <button
            class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition disabled:opacity-40 disabled:cursor-not-allowed"
            id="audit-prev"><i class="bi bi-chevron-right"></i> قبلی</button>
            <button
            class="inline-flex items-center gap-1 px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-dark-elevated transition disabled:opacity-40 disabled:cursor-not-allowed"
            id="audit-next">بعدی <i class="bi bi-chevron-left"></i></button>
        </div>
    </div>

    <div class="bg-white dark:bg-dark-surface rounded-2xl border border-gray-100 dark:border-dark-border shadow-sm p-4 mt-3"
         id="audit-detail-panel" style="display:none;">
        <h3 class="text-sm font-black text-gray-900 dark:text-white mb-3">جزئیات ردیف انتخاب‌شده</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <span class="block text-xs text-gray-500 dark:text-dark-muted mb-1">مقادیر قبلی</span>
                <pre class="audit-json" id="audit-old-values"></pre>
            </div>
            <div>
                <span class="block text-xs text-gray-500 dark:text-dark-muted mb-1">مقادیر جدید</span>
                <pre class="audit-json" id="audit-new-values"></pre>
            </div>
        </div>
        <div class="text-xs text-gray-500 dark:text-dark-muted mt-3" id="audit-detail-meta"></div>
    </div>
</div>

<script>
    (() => {
        const body = document.getElementById("audit-table-body");
        const summary = document.getElementById("audit-summary");
        const detailPanel = document.getElementById("audit-detail-panel");
        const oldValues = document.getElementById("audit-old-values");
        const newValues = document.getElementById("audit-new-values");
        const detailMeta = document.getElementById("audit-detail-meta");
        const moduleSelect = document.getElementById("audit-module");
        const actionSelect = document.getElementById("audit-action");
        const tableSelect = document.getElementById("audit-table");
        const searchInput = document.getElementById("audit-search");
        const userSelect = document.getElementById("audit-user");
        const fromInput = document.getElementById("audit-from");
        const toInput = document.getElementById("audit-to");
        const sensitiveSelect = document.getElementById("audit-sensitive");
        const exportLink = document.getElementById("audit-export");
        const expandAllButton = document.getElementById("audit-expand-all");
        const collapseAllButton = document.getElementById("audit-collapse-all");
        const copyJsonButton = document.getElementById("audit-copy-json");
        const pageSize = 20;
        let page = 1;
        let totalPages = 1;
        let lastRows = [];
        let allRows = [];
        let selectedRowIndex = null;

        const escape = (value) => String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll("\"", "&quot;");

        const params = () => {
            const query = new URLSearchParams();
            if (moduleSelect.value) query.set("Module", moduleSelect.value);
            if (actionSelect.value) query.set("Action", actionSelect.value);
            if (tableSelect.value) query.set("TableName", tableSelect.value);
            if (userSelect.value) query.set("UserId", userSelect.value);
            if (fromInput.value) query.set("From", `${fromInput.value}T00:00:00+03:30`);
            if (toInput.value) query.set("To", `${toInput.value}T23:59:59+03:30`);
            if (sensitiveSelect.value) query.set("SensitiveOnly", sensitiveSelect.value);
            query.set("Page", page.toString());
            query.set("PageSize", pageSize.toString());
            return query;
        };

        const applyExportHref = () => {
            const query = new URLSearchParams();
            if (moduleSelect.value) query.set("Module", moduleSelect.value);
            if (actionSelect.value) query.set("Action", actionSelect.value);
            if (tableSelect.value) query.set("TableName", tableSelect.value);
            if (userSelect.value) query.set("UserId", userSelect.value);
            if (fromInput.value) query.set("From", `${fromInput.value}T00:00:00+03:30`);
            if (toInput.value) query.set("To", `${toInput.value}T23:59:59+03:30`);
            if (sensitiveSelect.value) query.set("SensitiveOnly", sensitiveSelect.value);
            exportLink.href = `/api/admin/audit-logs/export?${query.toString()}`;
        };

        const showDetails = (item) => {
            if (!item) return;
            detailPanel.style.display = "block";
            oldValues.textContent = formatJson(item.oldValues);
            newValues.textContent = formatJson(item.newValues);
            detailMeta.textContent = `${item.tableName} | ${item.module} | ${item.userDisplayName || item.userId || "-"} | ${new Date(item.dateTime).toLocaleString("fa-IR")}`;
        };

        const formatJson = (value) => {
            if (!value) return "ندارد";
            try {
                const parsed = JSON.parse(value);
                return JSON.stringify(parsed, null, 2);
            } catch {
                return value;
            }
        };

        const applyClientSearch = () => {
            const term = (searchInput.value || "").trim().toLowerCase();
            if (!term) {
                renderRows(allRows);
                return;
            }

            const filtered = allRows.filter(item => {
                const haystack = [
                    item.userDisplayName,
                    item.userId,
                    item.action,
                    item.tableName,
                    item.module,
                    item.affectedColumns,
                    item.oldValues,
                    item.newValues,
                    item.userIP
                ].filter(Boolean).join(" ").toLowerCase();
                return haystack.includes(term);
            });

            renderRows(filtered);
            summary.textContent = `${filtered.length} رکورد مطابق جستجو`;
        };

        const renderRows = (items) => {
            lastRows = items || [];
            if (!items.length) {
                body.innerHTML = `<tr><td colspan="7"><div class="empty-state"><i class="bi bi-inbox"></i><div>رکوردی پیدا نشد.</div></div></td></tr>`;
                return;
            }

            body.innerHTML = items.map((item, index) => {
                const actionBadgeClass = item.action === "Delete" ? "bg-red-100 text-red-700 dark:bg-red-500/15 dark:text-red-400" : item.action === "Update" ? "bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-400" : "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-400";
                const sensitiveBadgeClass = item.isSensitive ? "bg-red-100 text-red-700 dark:bg-red-500/15 dark:text-red-400" : "bg-gray-100 text-gray-500 dark:bg-slate-700 dark:text-slate-400";

                return `
                <tr class="audit-row hover:bg-gray-50 dark:hover:bg-dark-elevated cursor-pointer transition" data-index="${index}">
                    <td class="px-4 py-3 whitespace-nowrap text-gray-700 dark:text-gray-300">${new Date(item.dateTime).toLocaleString("fa-IR")}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-900 dark:text-white font-medium">${escape(item.userDisplayName || item.userId || "-")}</td>
                    <td class="px-4 py-3 whitespace-nowrap"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold ${actionBadgeClass}">${escape(item.action)}</span></td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-600 dark:text-gray-400">${escape(item.module)}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-600 dark:text-gray-400">${escape(item.tableName)}</td>
                    <td class="px-4 py-3 whitespace-nowrap"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold ${sensitiveBadgeClass}">${item.isSensitive ? 'بله' : 'خیر'}</span></td>
                    <td class="px-4 py-3">
                        <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-bold rounded-lg text-teal-600 dark:text-teal-400 border border-teal-200 dark:border-teal-500/30 hover:bg-teal-50 dark:hover:bg-teal-500/10 transition audit-toggle mb-2">نمایش جزئیات</button>
                        <div class="text-xs text-gray-400 dark:text-gray-500 mt-1">${escape(item.affectedColumns || "-")}</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">${item.newValues ? "دارای داده جدید" : "بدون داده جدید"}</div>
                        <div class="audit-inline-detail mt-2" style="display:none;">
                            <div class="text-xs text-gray-400 dark:text-gray-500 mb-1">مقادیر قبلی</div>
                            <pre class="mb-2 audit-json">${escape(formatJson(item.oldValues))}</pre>
                            <div class="text-xs text-gray-400 dark:text-gray-500 mb-1">مقادیر جدید</div>
                            <pre class="mb-0 audit-json">${escape(formatJson(item.newValues))}</pre>
                        </div>
                    </td>
                </tr>
                `;
            }).join("");

            body.querySelectorAll(".audit-row").forEach(row => {
                const detail = row.querySelector(".audit-inline-detail");
                const toggle = row.querySelector(".audit-toggle");
                toggle?.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const open = detail.style.display !== "none";
                    detail.style.display = open ? "none" : "block";
                });
                row.addEventListener("click", () => {
                    selectedRowIndex = Number(row.dataset.index);
                    showDetails(lastRows[selectedRowIndex]);
                });
            });
        };

        const loadOptions = async () => {
            const response = await fetch("/api/admin/audit-logs/filter-options", { credentials: "same-origin" });
            if (!response.ok) return;
            const data = await response.json();
            const fill = (select, values, valueKey = "value", labelKey = "label") => {
                values.forEach(v => {
                    const option = document.createElement("option");
                    option.value = v[valueKey] ?? v;
                    option.textContent = v[labelKey] ?? v;
                    select.appendChild(option);
                });
            };
            fill(moduleSelect, data.modules || []);
            fill(actionSelect, data.actions || []);
            fill(tableSelect, data.tableNames || []);
            fill(userSelect, data.users || []);
        };

        const loadData = async () => {
            body.innerHTML = `<tr><td colspan="7"><div class="empty-state"><i class="bi bi-hourglass-split"></i><div>در حال بارگذاری ...</div></div></td></tr>`;
            const response = await fetch(`/api/admin/audit-logs?${params().toString()}`, { credentials: "same-origin" });
            if (!response.ok) {
                body.innerHTML = `<tr><td colspan="7"><div class="empty-state"><i class="bi bi-exclamation-triangle"></i><div>خطا در دریافت داده‌ها</div></div></td></tr>`;
                return;
            }

            const data = await response.json();
            totalPages = data.totalPages || 1;
            allRows = data.items || [];
            renderRows(allRows);
            summary.textContent = `صفحه ${data.page} از ${data.totalPages} | ${data.totalCount} رکورد`;
            document.getElementById("audit-prev").disabled = page <= 1;
            document.getElementById("audit-next").disabled = page >= totalPages;
            applyExportHref();
        };

        document.getElementById("audit-refresh").addEventListener("click", (e) => {
            e.preventDefault();
            page = 1;
            loadData();
        });

        document.getElementById("audit-prev").addEventListener("click", () => {
            if (page > 1) {
                page--;
                loadData();
            }
        });

        document.getElementById("audit-next").addEventListener("click", () => {
            if (page < totalPages) {
                page++;
                loadData();
            }
        });

        expandAllButton.addEventListener("click", () => {
            document.querySelectorAll(".audit-inline-detail").forEach(detail => detail.style.display = "block");
        });

        collapseAllButton.addEventListener("click", () => {
            document.querySelectorAll(".audit-inline-detail").forEach(detail => detail.style.display = "none");
        });

        copyJsonButton.addEventListener("click", async () => {
            const item = selectedRowIndex != null ? lastRows[selectedRowIndex] : null;
            if (!item) return;
            const payload = {
                oldValues: item.oldValues ? (() => { try { return JSON.parse(item.oldValues); } catch { return item.oldValues; } })() : null,
                newValues: item.newValues ? (() => { try { return JSON.parse(item.newValues); } catch { return item.newValues; } })() : null,
                affectedColumns: item.affectedColumns,
                tableName: item.tableName,
                action: item.action
            };
            await navigator.clipboard.writeText(JSON.stringify(payload, null, 2));
            window.AppUI?.toast("کپی شد", "JSON ردیف انتخاب‌شده در کلیپ‌بورد قرار گرفت.", "success");
        });

        [moduleSelect, actionSelect, tableSelect, userSelect, fromInput, toInput, sensitiveSelect].forEach(el => {
            el.addEventListener("change", () => {
                page = 1;
                loadData();
            });
        });

        searchInput.addEventListener("input", applyClientSearch);

        Promise.all([loadOptions()]).then(() => loadData());
    })();
</script>
