@model OfficeAutomation.Modules.Persistence.Entities.MowadiyanSettings
@using OfficeAutomation.Modules.InvoiceStructuring
@{
    ViewData["Title"] = "تنظیمات سامانه مودیان";
    var alert = TempData["AlertMessage"] as string;
}

<!-- ═══════════════════════════════════════════════════════
     CSS loaded directly (not inside a Razor section) so styles
     execute both in full-view (_Layout / _TabLayout) and
     PartialView / tab / AJAX modes.
     ═══════════════════════════════════════════════════════ -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
<link rel="stylesheet" href="~/css/mowadiyan.css" asp-append-version="true" />

<div class="mow-root" dir="rtl">

    <!-- ═══════════════ HEADER ═══════════════ -->
    <div class="mow-header">
        <div class="mow-header-left">
            <i class="bi bi-gear"></i>
            <h5>تنظیمات سامانه مودیان</h5>
        </div>
        <span class="mow-header-date">@JalaliDateHelper.TodayShamsi()</span>
    </div>

    <!-- ═══════════════ ALERT ═══════════════ -->
    @if (!string.IsNullOrWhiteSpace(alert))
    {
        <div class="alert alert-success mow-alert-success py-2 px-3 small">@alert</div>
    }

    <form id="mowadiyan-settings-form" asp-controller="Mowadiyan" asp-action="SaveSettings" method="post" data-guard-ignore>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

        <!-- ═══════════════════════════════════════════════════════════════
             CARD 1  —  شناسه‌های ارتباطی و هویت  (Identity & Keys)
             ═══════════════════════════════════════════════════════════════ -->
        <div class="card mow-settings-card mb-3">
            <div class="card-header mow-card-header">
                <i class="bi bi-person-badge"></i>
                <span>شناسه‌های ارتباطی و هویت</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ClientId" class="form-label mow-form-label">شناسه سرویس‌گیرنده (Client
                            ID)</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input asp-for="ClientId" class="form-control" dir="ltr"
                                       placeholder="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX" />
                            </div>
                            <span asp-validation-for="ClientId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MemorySecret" class="form-label mow-form-label">کلید حافظه مالیاتی (Memory
                                Secret)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                                    <input asp-for="MemorySecret" class="form-control" dir="ltr" type="password"
                                           id="pwdMemorySecret" />
                                    <button class="btn btn-outline-secondary mow-toggle-pwd" type="button"
                                            onclick="togglePassword('pwdMemorySecret', this)" title="نمایش/مخفی‌سازی">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="MemorySecret" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EconomicCode" class="form-label mow-form-label">کد اقتصادی</label>
                                <input asp-for="EconomicCode" class="form-control form-control-sm" dir="ltr"
                                       placeholder="۱۲۳۴۵۶۷۸۹۰" />
                                <span asp-validation-for="EconomicCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NationalId" class="form-label mow-form-label">شناسه ملی</label>
                                <input asp-for="NationalId" class="form-control form-control-sm" dir="ltr"
                                       placeholder="۰۰۱۲۳۴۵۶۷۸" />
                                <span asp-validation-for="NationalId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ═══════════════════════════════════════════════════════════════
             CARD 2  —  ورود به پورتال و فایل خروجی  (Portal Login)
             ═══════════════════════════════════════════════════════════════ -->
                <div class="card mow-settings-card mb-3">
                    <div class="card-header mow-card-header">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>ورود به پورتال سامانه مودیان (فایل خروجی)</span>
                    </div>
                    <div class="card-body">
                        <div class="mow-sandbox-hint mb-3">
                            <i class="bi bi-info-circle"></i>
                            <span>این مشخصات برای ثبت درخواست فایل خروجی (خرید داخلی) و دانلود خودکار صورتحساب‌ها به کار می‌رود.
                                رمز یکبارمصرف (OTP) هنگام انجام عملیات درخواست، به صورت دستی وارد می‌شود.</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="PortalUsername" class="form-label mow-form-label">نام کاربری پورتال</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                                        <input asp-for="PortalUsername" class="form-control" dir="ltr" placeholder="username"
                                               value="@Model?.PortalUsername" />
                                    </div>
                                    <span asp-validation-for="PortalUsername" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="PortalPassword" class="form-label mow-form-label">رمز عبور پورتال</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                                        <input asp-for="PortalPassword" class="form-control" dir="ltr" type="password"
                                               id="pwdPortal" value="@Model?.PortalPassword" />
                                        <button class="btn btn-outline-secondary mow-toggle-pwd" type="button"
                                                onclick="togglePassword('pwdPortal', this)" title="نمایش/مخفی‌سازی">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="PortalPassword" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════════════════════════════════════════════════════════════
             CARD 3  —  گواهی دیجیتال و امنیت  (PKI & Certificates)
             ═══════════════════════════════════════════════════════════════ -->
                    <div class="card mow-settings-card mb-3">
                        <div class="card-header mow-card-header">
                            <i class="bi bi-shield-check"></i>
                            <span>گواهی دیجیتال و امنیت</span>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="PrivateKeyPath" class="form-label mow-form-label">مسیر فایل کلید خصوصی (.pfx /
                                        .pem)</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-file-earmark-lock"></i></span>
                                            <input asp-for="PrivateKeyPath" class="form-control" dir="ltr"
                                                   placeholder="C:\certs\tax-private.pfx" />
                                        </div>
                                        <span asp-validation-for="PrivateKeyPath" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="PrivateKeyPassword" class="form-label mow-form-label">رمز کلید خصوصی</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                            <input asp-for="PrivateKeyPassword" class="form-control" dir="ltr" type="password"
                                                   id="pwdPrivateKey" />
                                            <button class="btn btn-outline-secondary mow-toggle-pwd" type="button"
                                                    onclick="togglePassword('pwdPrivateKey', this)" title="نمایش/مخفی‌سازی">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="PrivateKeyPassword" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ═══════════════════════════════════════════════════════════════
             CARD 3  —  تنظیمات اتصال و سرور  (Connection & Environment)
             ═══════════════════════════════════════════════════════════════ -->
                        <div class="card mow-settings-card mb-3">
                            <div class="card-header mow-card-header">
                                <i class="bi bi-cloud"></i>
                                <span>تنظیمات اتصال و سرور</span>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="BaseUrl" class="form-label mow-form-label">آدرس API سامانه مودیان</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-globe2"></i></span>
                                            <input asp-for="BaseUrl" class="form-control" dir="ltr"
                                                   placeholder="https://tp.tax.gov.ir" />
                                        </div>
                                        <span asp-validation-for="BaseUrl" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label mow-form-label">وضعیت آزمایشی (Sandbox Mode)</label>
                                        <div class="form-check form-switch mow-switch mt-2">
                                            <input asp-for="IsSandbox" class="form-check-input" type="checkbox" role="switch"
                                                   id="chkSandbox" />
                                            <label asp-for="IsSandbox" class="form-check-label">
                                                @(Model?.IsSandbox == true ? "حالت آزمایشی فعال" : "حالت آزمایشی غیرفعال")
                                            </label>
                                        </div>
                                        <div class="mow-sandbox-hint">
                                            <i class="bi bi-info-circle"></i>
                                            <span>در حالت آزمایشی، داده‌ها به سرور اصلی سامانه مودیان ارسال نمی‌شوند.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ═══════════════ ACTIONS ═══════════════ -->
                        <div class="mow-form-actions">
                            <a href="javascript:void(0)"
                               onclick="if (window.tabManager) { window.tabManager.closeCurrentTab(); } else { history.back(); }"
                               class="btn btn-outline-secondary mow-btn-back">
                                <i class="bi bi-arrow-right"></i> بازگشت
                            </a>
                            <button type="submit" class="btn btn-primary mow-btn-save">
                                <i class="bi bi-check-lg"></i> ذخیره تنظیمات
                            </button>
                        </div>
                    </form>
                </div>

                <!-- ═══════════════════════════════════════════════════════
     Inline scripts — NOT inside a Razor section so they work
     in PartialView / tab / AJAX modes too.
     ═══════════════════════════════════════════════════════ -->
                <script>
                    // Password visibility toggle
                    function togglePassword(inputId, btn) {
                        var input = document.getElementById(inputId);
                        var icon = btn.querySelector('i');
                        if (!input) return;
                        if (input.type === 'password') {
                            input.type = 'text';
                            if (icon) { icon.className = 'bi bi-eye-slash'; }
                        } else {
                            input.type = 'password';
                            if (icon) { icon.className = 'bi bi-eye'; }
                        }
                    }

                    // Update sandbox label text when toggle changes
                    (function () {
                        var chk = document.getElementById('chkSandbox');
                        var lbl = chk && chk.parentElement && chk.parentElement.querySelector('.form-check-label');
                        if (chk && lbl) {
                            var updateLabel = function () {
                                lbl.textContent = chk.checked ? 'حالت آزمایشی فعال' : 'حالت آزمایشی غیرفعال';
                            };
                            chk.addEventListener('change', updateLabel);
                        }
                    })();
                </script>
                <!-- ═══════════════════════════════════════════════════════════════
     Dedicated AJAX POST submit handler.
     Performs a standard POST (via fetch) to /Mowadiyan/SaveSettings and
     shows a success/error toast. This runs instead of the native form
     submit so the shared tab-manager never rewrites the action into a
     GET navigation (which would 404, since SaveSettings is [HttpPost]).
     ═══════════════════════════════════════════════════════════════ -->
                <script>
                    (function () {
                        'use strict';

                        function mowToast(message, type) {
                            type = type || 'success';
                            var colors = { success: '#18af08', error: '#ef404d', info: '#4d99d0', warning: '#f08046' };
                            var existing = document.querySelector('.mow-toast');
                            if (existing) existing.remove();
                            var t = document.createElement('div');
                            t.className = 'mow-toast';
                            t.style.cssText = 'position:fixed;bottom:20px;left:20px;z-index:100000;direction:rtl;display:flex;' +
                                'align-items:center;gap:8px;background:' + (colors[type] || colors.info) + ';color:#fff;' +
                                'padding:10px 16px;border-radius:4px;font-size:12px;font-weight:700;' +
                                'box-shadow:0 8px 24px rgba(0,0,0,0.25);opacity:0;transition:opacity .25s;';
                            t.textContent = message;
                            document.body.appendChild(t);
                            requestAnimationFrame(function () { t.style.opacity = '1'; });
                            window.setTimeout(function () {
                                t.style.opacity = '0';
                                window.setTimeout(function () { t.remove(); }, 300);
                            }, 3500);
                        }

                        function setSaving(form, saving) {
                            var btn = form.querySelector('button[type="submit"], .mow-btn-save');
                            if (!btn) return;
                            if (saving) {
                                btn.setAttribute('data-orig-html', btn.innerHTML);
                                btn.innerHTML = '<i class="bi bi-hourglass-split"></i> در حال ذخیره...';
                            } else {
                                var orig = btn.getAttribute('data-orig-html');
                                if (orig) { btn.innerHTML = orig; btn.removeAttribute('data-orig-html'); }
                            }
                            btn.disabled = saving;
                        }

                        function bindMowSettingsForm(root) {
                            var form = root.querySelector ? root.querySelector('#mowadiyan-settings-form') || root.querySelector('form[method="post"]') : null;
                            if (!form || form.getAttribute('data-mow-bound') === '1') return;
                            form.setAttribute('data-mow-bound', '1');

                            form.addEventListener('submit', function (e) {
                                e.preventDefault();
                                e.stopImmediatePropagation(); // ensure tab-manager never sees a navigation

                                setSaving(form, true);
                                var data = new FormData(form);
                                fetch(form.getAttribute('action') || window.location.href, {
                                    method: 'POST',
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest',
                                        'Accept': 'application/json'
                                    },
                                    credentials: 'same-origin',
                                    body: data
                                }).then(function (res) {
                                    var ct = res.headers.get('content-type') || '';
                                    if (ct.indexOf('application/json') >= 0) {
                                        return res.json().then(function (payload) {
                                            if (payload && payload.success) {
                                                mowToast(payload.message || 'تنظیمات با موفقیت ذخیره شد', 'success');
                                            } else {
                                                mowToast((payload && payload.message) || 'خطا در ذخیره\u200cسازی تنظیمات', 'error');
                                            }
                                        });
                                    }
                                    // Not a JSON response → server-side validation error rendered as HTML.
                                    // Swap in the fresh form so validation messages are shown, then rebind.
                                    return res.text().then(function (html) {
                                        var wrapper = document.createElement('div');
                                        wrapper.innerHTML = html;
                                        var newRoot = wrapper.querySelector('.mow-root') || wrapper;
                                        var host = form.closest('.mow-root') || document.body;
                                        host.outerHTML = newRoot.outerHTML;
                                        bindMowSettingsForm(document);
                                    });
                                }).catch(function () {
                                    mowToast('خطا در برقراری ارتباط با سرور', 'error');
                                }).finally(function () {
                                    setSaving(form, false);
                                });
                            });
                        }

                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', function () { bindMowSettingsForm(document); });
                        } else {
                            bindMowSettingsForm(document);
                        }
                    })();
                </script>