@using OfficeAutomation.Modules.InvoiceStructuring
@using OfficeAutomation.Modules.Persistence.Entities
@{
    ViewData["Title"] = "تطبیق سامانه مودیان";
    var results = ViewBag.Results as List<InvoiceReconciliationResult> ?? new List<InvoiceReconciliationResult>();
    var alert = TempData["AlertMessage"] as string;
}

<!-- CSS loaded directly for Partial/Tab mode -->
<link rel="stylesheet" href="~/css/mowadiyan.css" asp-append-version="true" />

<div class="mow-root" dir="rtl">
    <div class="mow-header">
        <div class="mow-header-left">
            <i class="bi bi-arrow-left-right"></i>
            <h5>ماتریس تطبیق فاکتورها با سامانه مودیان</h5>
        </div>
        <span class="mow-header-date">@JalaliDateHelper.TodayShamsi()</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(alert))
    {
        <div class="mow-alert mow-alert-success">@alert</div>
    }

    <div class="mow-action-bar">
        <form asp-action="RunReconciliation" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="sg-btn sg-btn-primary" title="انجام تطبیق برای همه فاکتورهای ارسال شده">
                <i class="bi bi-arrow-repeat"></i> اجرای تطبیق
            </button>
        </form>
        <button type="button" class="sg-btn sg-btn-info" id="btnOpenExportModal" onclick="mowOpenExportModal()" title="دریافت خودکار صورتحساب‌های خرید از سامانه مودیان">
            <i class="bi bi-download"></i> دریافت فایل خروجی (مودیان)
        </button>
        <a class="sg-btn sg-btn-secondary" asp-action="Index"><i class="bi bi-arrow-right"></i> بازگشت به داشبورد</a>
    </div>

    @if (ViewBag.HasPortalSettings != null && ViewBag.HasPortalSettings == false)
    {
        <div class="mow-alert mow-alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            برای دریافت فایل خروجی باید ابتدا «نام کاربری و رمز عبور پورتال مودیان» را در بخش تنظیمات وارد کنید.
            <a asp-action="Settings" class="mow-alert-link">رفتن به تنظیمات</a>
        </div>
    }

    <div class="mow-table-wrap">
        <table class="mow-data-table">
            <thead>
                <tr>
                    <th>شماره فاکتور</th>
                    <th>وضعیت تطبیق</th>
                    <th>شماره پیگیری مالیاتی</th>
                    <th>مبلغ محلی (ریال)</th>
                    <th>مبلغ سامانه (ریال)</th>
                    <th>نرخ محلی</th>
                    <th>نرخ سامانه</th>
                    <th>اختلافات</th>
                </tr>
            </thead>
            <tbody>
                @if (results.Count == 0)
                {
                    <tr><td colspan="8" style="text-align:center; color:#888;">نتیجه تطبیقی ثبت نشده است. ابتدا فاکتورها را ارسال کنید.</td></tr>
                }
                @foreach (var r in results)
                {
                    var cls = "mow-rec-" + r.Status.ToString().ToLowerInvariant();
                    <tr class="@(r.Status == ReconciliationStatus.Mismatched ? "mow-discrepancy" : "")">
                        <td class="mow-cell-number">@(r.InvoiceRecord?.InvoiceNumber ?? r.InvoiceRecordId.ToString("N"))</td>
                        <td><span class="mow-badge @cls">@StatusLabel(r.Status)</span></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(r.TaxReferenceId))
                            {
                                <span class="mow-ref-badge">@CurrencyNormalizer.ToPersianDigits(r.TaxReferenceId)</span>
                            }
                            else
                            {
                                <span style="color:#888;">—</span>
                            }
                        </td>
                        <td class="mow-cell-amount">@CurrencyNormalizer.ToPersianDigits((r.InvoiceRecord?.FinalAmount ?? 0).ToString("N0"))</td>
                        <td class="mow-cell-amount">@CurrencyNormalizer.ToPersianDigits((r.PortalTotalAmount ?? 0).ToString("N0"))</td>
                        <td>@((r.InvoiceRecord?.VatRate ?? 0).ToString("0.##"))%</td>
                        <td>@((r.PortalVatRate ?? 0).ToString("0.##"))%</td>
                        <td>
                            @if (r.Discrepancies.Count > 0)
                            {
                                var tooltip = string.Join(" | ", r.Discrepancies.Select(d => d.Description));
                                <span class="mow-badge mow-status-rejectedbytaxorg" title="@tooltip">
                                    @CurrencyNormalizer.ToPersianDigits(r.Discrepancies.Count.ToString()) مورد
                                </span>
                            }
                            else
                            {
                                <span style="color:#888;">—</span>
                            }
                        </td>
                    </tr>
                    @if (r.Discrepancies.Count > 0)
                    {
                        <tr class="mow-discrepancy">
                            <td colspan="8" style="white-space:normal;">
                                <ul style="margin:0; padding-right:1rem; font-size:11px;">
                                    @foreach (var d in r.Discrepancies)
                                    {
                                        <li>
                                            <strong>@d.Description</strong>
                                            @if (!string.IsNullOrWhiteSpace(d.Suggestion))
                                            {
                                                <span style="color:#2e7d32;"> — پیشنهاد: @d.Suggestion</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- ═══════════════════ MODAL: دریافت فایل خروجی (مودیان) ═══════════════════ -->
    <div class="mow-modal-overlay" id="mowExportModal" style="display:none;">
        <div class="mow-modal" role="dialog" aria-modal="true" aria-labelledby="mowExportTitle">
            <div class="mow-modal-header">
                <h5 id="mowExportTitle"><i class="bi bi-download"></i> درخواست فایل خروجی از سامانه مودیان</h5>
                <button type="button" class="mow-modal-close" onclick="mowCloseExportModal()" title="بستن">&times;</button>
            </div>

            <form id="frmPortalExport" method="post" onsubmit="return false;">
                @Html.AntiForgeryToken()

                <!-- Step A — انتخاب سال و دوره مالیاتی -->
                <div class="mow-modal-body" id="mowExportFormBody">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="mow-form-label">سال مالیاتی</label>
                            <select id="mowTaxYear" class="form-control form-control-sm mow-select">
                                @for (var y = 1400; y <= 1410; y++)
                                {
                                    <option value="@y" selected="@(y == (JalaliDateHelper.CurrentShamsiYear()))">@CurrencyNormalizer.ToPersianDigits(y.ToString())</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="mow-form-label">دوره مالیاتی (فصل)</label>
                            <select id="mowTaxPeriod" class="form-control form-control-sm mow-select">
                                <option value="1">بهار</option>
                                <option value="2" selected>تابستان</option>
                                <option value="3">پاییز</option>
                                <option value="4">زمستان</option>
                            </select>
                        </div>
                    </div>

                    <div class="mow-otp-box">
                        <i class="bi bi-chat-dots"></i>
                        <div>
                            <label class="mow-form-label" for="mowOtpCode">کد تأیید پیامکی (SMS OTP)</label>
                            <p class="mow-hint">با کلیک روی «ارسال کد پیامک»، کد یکبارمصرف برای شما پیامک می‌شود.</p>
                        </div>
                        <button type="button" class="sg-btn sg-btn-info mow-send-otp-btn" id="btnSendOtp" onclick="mowInitiateLogin()">
                            <i class="bi bi-send"></i> ارسال کد پیامک
                        </button>
                    </div>
                    <input id="mowOtpCode" name="otpCode" class="form-control form-control-sm mow-otp-input" dir="ltr"
                           maxlength="6" inputmode="numeric" autocomplete="one-time-code"
                           placeholder="کد ۶ رقمی" disabled />
                    <div class="mow-otp-status" id="mowOtpStatus" role="status"></div>
                </div>

                <!-- Step B — پیشرفت مرحله‌به‌مرحله -->
                <div class="mow-modal-body" id="mowExportProgressBody" style="display:none;">
                    <div class="mow-progress-list">
                        <div class="mow-progress-item" data-role="p-Authenticating">
                            <i class="bi bi-shield-lock mow-progress-icon"></i>
                            <span>احراز هویت و تأیید کد پیامکی</span>
                        </div>
                        <div class="mow-progress-item" data-role="p-Submitting">
                            <i class="bi bi-send mow-progress-icon"></i>
                            <span>ارسال درخواست خروجی (خرید داخلی - تمام وضعیت‌ها)</span>
                        </div>
                        <div class="mow-progress-item" data-role="p-Producing">
                            <i class="bi bi-hourglass-split mow-progress-icon"></i>
                            <span>در حال تولید فایل توسط سامانه مودیان</span>
                        </div>
                        <div class="mow-progress-item" data-role="p-Importing">
                            <i class="bi bi-cloud-arrow-down mow-progress-icon"></i>
                            <span>دانلود و ثبت خودکار فاکتورها در دیتابیس</span>
                        </div>
                        <div class="mow-progress-item" data-role="p-Completed">
                            <i class="bi bi-check-circle mow-progress-icon"></i>
                            <span>با موفقیت انجام شد</span>
                        </div>
                    </div>
                    <div class="mow-progress-message" id="mowProgressMessage"></div>
                    <div class="mow-progress-cta" id="mowProgressCta" style="display:none;">
                        <button type="button" class="sg-btn sg-btn-primary" onclick="mowCloseExportModal(true)">بسته</button>
                    </div>
                </div>

                <div class="mow-modal-footer">
                    <button type="button" class="sg-btn sg-btn-secondary" id="btnCancelExport" onclick="mowCloseExportModal()">انصراف</button>
                    <button type="button" class="sg-btn sg-btn-success" id="btnStartExport" onclick="mowStartExport()" disabled>
                        <i class="bi bi-download"></i> دریافت و ثبت
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<script id="mowUrls" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        initiateLogin = Url.Action("InitiatePortalLogin"),
        createExport = Url.Action("CreatePortalExport"),
        exportProgress = Url.Action("ExportProgress"),
        reconciliation = Url.Action("Reconciliation")
    }))</script>
    <script src="~/js/mowadiyan-reconciliation-script.js" asp-append-version="true"></script>

@functions {
    static string StatusLabel(ReconciliationStatus s) => s switch
    {
        ReconciliationStatus.Matched => "تطبیق شده",
        ReconciliationStatus.Mismatched => "نامطابق",
        ReconciliationStatus.Pending => "در انتظار",
        ReconciliationStatus.NotSubmitted => "ارسال نشده",
        _ => s.ToString()
    };
}