@model OfficeAutomation.Models.Leave
@{
    ViewData["Title"] = "درخواست مرخصی جدید";
}

<link rel="stylesheet" href="~/css/persian-datepicker.min.css">

<div class="w-full flex-1 flex flex-col gap-6 p-4 md:p-6" dir="rtl">
    <!-- Header Section -->
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-teal-50 dark:bg-teal-950/30 text-teal-600 dark:text-teal-400 text-lg border border-teal-200/30">
                <i class="bi bi-send-plus"></i>
            </div>
            <div>
                <h1 class="m-0 text-lg font-black text-slate-900 dark:text-white tracking-tight">ثبت درخواست مرخصی</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">لطفاً بازه زمانی و علت مرخصی خود را دقیق وارد کنید.</p>
            </div>
        </div>
        <a asp-action="Index" class="flex items-center justify-center px-3 h-9 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm bg-transparent no-underline">
            <span>بازگشت به لیست</span>
        </a>
    </header>

    <!-- Form Card -->
    <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <form asp-action="Create" id="leaveForm" class="flex flex-col gap-6">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 dark:bg-rose-955/10 text-rose-800 dark:text-rose-450 border border-rose-200 dark:border-rose-900/50 rounded-xl text-xs font-semibold leading-relaxed"></div>
            }
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Status" value="در انتظار تایید" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Start Date -->
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">از تاریخ</label>
                    <div class="relative w-full">
                        <input type="text" id="start_date_picker" class="h-9 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 pr-9 pl-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 text-left font-mono tabular-nums pdate" placeholder="انتخاب کنید..." readonly />
                        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"><i class="bi bi-calendar-event"></i></span>
                    </div>
                    <input type="hidden" asp-for="StartDate" id="StartDate" />
                    <span asp-validation-for="StartDate" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- End Date -->
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">تا تاریخ</label>
                    <div class="relative w-full">
                        <input type="text" id="end_date_picker" class="h-9 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-955 pr-9 pl-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 text-left font-mono tabular-nums pdate" placeholder="انتخاب کنید..." readonly />
                        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"><i class="bi bi-calendar-check"></i></span>
                    </div>
                    <input type="hidden" asp-for="EndDate" id="EndDate" />
                    <span asp-validation-for="EndDate" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Duration Alert Box -->
                <div class="md:col-span-2">
                    <div id="duration_box" class="flex items-center gap-2 p-3 bg-teal-50 dark:bg-teal-950/20 text-teal-800 dark:text-teal-400 border border-teal-200/40 dark:border-teal-900/50 rounded-xl text-xs font-semibold shadow-sm d-none">
                        <i class="bi bi-info-circle text-teal-600 dark:text-teal-450 text-sm"></i>
                        <span>مدت مرخصی:</span>
                        <strong id="days_count" class="font-mono tabular-nums font-black text-sm">0</strong>
                        <span>روز</span>
                    </div>
                </div>

                <!-- Reason -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label asp-for="Reason" class="text-xs font-bold text-slate-700 dark:text-slate-300">علت مرخصی / توضیحات</label>
                    <textarea asp-for="Reason" class="w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 p-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" rows="3" placeholder="مثلاً: کارهای شخصی، مسافرت و ..."></textarea>
                    <span asp-validation-for="Reason" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800 pt-4 mt-2">
                <a asp-action="Index" class="flex items-center justify-center px-4 h-9 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm no-underline">
                    <span>انصراف</span>
                </a>
                <button type="submit" class="flex items-center gap-1.5 px-5 h-9 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm">
                    <i class="bi bi-check-circle"></i>
                    <span>ثبت درخواست</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/persian-date.js"></script>
    <script src="~/js/persian-datepicker.min.js"></script>
    <script src="~/js/leave-create-handler.js"></script>
    <script>
        $(document).ready(function() {
            if (typeof $.fn.persianDatepicker === 'undefined') {
                console.error("خطا: کتابخانه تقویم فارسی بارگذاری نشده است!");
            }
        });
    </script>
}