@model IEnumerable<OfficeAutomation.Models.Leave>
@{
    ViewData["Title"] = "درخواست‌های مرخصی";
    var leaves = Model?.ToList() ?? new List<OfficeAutomation.Models.Leave>();
    var pendingCount = leaves.Count(item => WorkflowStatus.IsPending(item.Status));
    var approvedCount = leaves.Count(item => WorkflowStatus.IsApproved(item.Status));
    var rejectedCount = leaves.Count(item => WorkflowStatus.IsRejected(item.Status));
    var status = (Context.Request.Query["status"].ToString() ?? string.Empty).Trim().ToLowerInvariant();
    var filteredLeaves = string.IsNullOrWhiteSpace(status)
        ? leaves
        : leaves.Where(item =>
            (status == "pending" && WorkflowStatus.IsPending(item.Status)) ||
            (status == "approved" && WorkflowStatus.IsApproved(item.Status)) ||
            (status == "rejected" && WorkflowStatus.IsRejected(item.Status))).ToList();
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <!-- Header Card -->
    <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
        <div>
            <h1 class="m-0 text-sm font-black text-slate-900 dark:text-white tracking-tight">درخواست‌های مرخصی</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">نمایش وضعیت درخواست‌ها با رنگ‌بندی سازگار با تم تیره و دسترسی سریع به عملیات.</p>
        </div>
        <a asp-action="Create" class="flex items-center gap-1.5 px-2.5 h-8 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm no-underline self-start sm:self-auto">
            <i class="bi bi-plus-circle-fill"></i>
            <span>درخواست جدید</span>
        </a>
    </header>

    <!-- Saved Filters Card Panel -->
    <div class="shadow-sm border border-slate-200 dark:border-slate-800 rounded-lg p-2.5 bg-white dark:bg-slate-900 flex flex-col gap-3">
        @{ ViewData["SavedFiltersTitle"] = "فیلترهای ذخیره‌شده"; ViewData["SavedFiltersSubtitle"] = "فیلترها را برای دسترسی سریع ذخیره کن."; ViewData["SavedFiltersSaveButtonId"] = "leavesSaveFilter"; ViewData["SavedFiltersClearButtonId"] = "leavesClearSaved"; ViewData["SavedFiltersContainerId"] = "leavesSavedFilters"; }
        <partial name="_SavedFiltersPanel" />
    </div>

    <!-- Numerical Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a asp-action="Index" class="no-underline flex flex-col items-start gap-1 p-2.5 bg-white dark:bg-slate-900 border @(string.IsNullOrWhiteSpace(status) ? "border-teal-600 dark:border-teal-500 ring-2 ring-teal-500/10" : "border-slate-200 dark:border-slate-800") rounded-lg shadow-sm transition hover:-translate-y-0.5 active:scale-98">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">کل درخواست‌ها</span>
            <span class="text-lg font-black text-slate-800 dark:text-white mt-1">@leaves.Count</span>
            <span class="text-[9px] text-slate-400 mt-0.5 font-bold">نمایش همه</span>
        </a>
        <a asp-action="Index" asp-route-status="pending" class="no-underline flex flex-col items-start gap-1 p-2.5 bg-white dark:bg-slate-900 border @(status == "pending" ? "border-teal-600 dark:border-teal-500 ring-2 ring-teal-500/10" : "border-slate-200 dark:border-slate-800") rounded-lg shadow-sm transition hover:-translate-y-0.5 active:scale-98">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">در انتظار</span>
            <span class="text-lg font-black text-amber-600 mt-1">@pendingCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5 font-bold">فقط موارد باز</span>
        </a>
        <a asp-action="Index" asp-route-status="approved" class="no-underline flex flex-col items-start gap-1 p-2.5 bg-white dark:bg-slate-900 border @(status == "approved" ? "border-teal-600 dark:border-teal-500 ring-2 ring-teal-500/10" : "border-slate-200 dark:border-slate-800") rounded-lg shadow-sm transition hover:-translate-y-0.5 active:scale-98">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">تایید شده</span>
            <span class="text-lg font-black text-emerald-650 dark:text-emerald-400 mt-1">@approvedCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5 font-bold">موارد نهایی</span>
        </a>
        <a asp-action="Index" asp-route-status="rejected" class="no-underline flex flex-col items-start gap-1 p-2.5 bg-white dark:bg-slate-900 border @(status == "rejected" ? "border-teal-600 dark:border-teal-500 ring-2 ring-teal-500/10" : "border-slate-200 dark:border-slate-800") rounded-lg shadow-sm transition hover:-translate-y-0.5 active:scale-98">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">رد شده</span>
            <span class="text-lg font-black text-rose-600 mt-1">@rejectedCount</span>
            <span class="text-[9px] text-slate-400 mt-0.5 font-bold">موارد رد شده</span>
        </a>
    </div>

    <!-- Data Grid Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-xs text-right border-collapse text-slate-700 dark:text-slate-300">
                <thead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="px-3 py-2.5 font-bold">درخواست‌دهنده</th>
                        <th class="px-3 py-2.5 font-bold text-left">بازه زمانی</th>
                        <th class="px-3 py-2.5 font-bold text-left">مدت زمان</th>
                        <th class="px-3 py-2.5 font-bold">علت مرخصی</th>
                        <th class="px-3 py-2.5 font-bold text-center">وضعیت</th>
                        <th class="px-3 py-2.5 font-bold text-center w-1">عملیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                    @if (filteredLeaves.Any())
                    {
                        foreach (var item in filteredLeaves)
                        {
                            var fullName = item.User?.FullName ?? item.User?.UserName ?? "کاربر";
                            var initial = !string.IsNullOrWhiteSpace(fullName) ? fullName.Substring(0, 1) : "؟";
                            var days = (item.EndDate - item.StartDate).Days + 1;
                            
                            var badgeClass = WorkflowStatus.IsApproved(item.Status)
                                ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200/40"
                                : (WorkflowStatus.IsRejected(item.Status)
                                ? "bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400 border-rose-200/40"
                                : "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200/40");
                                
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                                <!-- Personnel Name and Avatar -->
                                <td class="px-3 py-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-teal-50 dark:bg-teal-950/40 border border-teal-200/40 dark:border-teal-800/30 text-teal-700 dark:text-teal-400 flex items-center justify-center font-black text-xs">
                                            @initial
                                        </div>
                                        <div class="font-bold text-slate-900 dark:text-white">@fullName</div>
                                    </div>
                                </td>
                                
                                <!-- Start/End dates -->
                                <td class="px-3 py-3 text-left font-mono tabular-nums text-slate-500 leading-relaxed">
                                    <div>از: @item.StartDate.ToString("yyyy/MM/dd")</div>
                                    <div>تا: @item.EndDate.ToString("yyyy/MM/dd")</div>
                                </td>
                                
                                <!-- Duration days -->
                                <td class="px-3 py-3 text-left font-mono tabular-nums font-bold text-slate-900 dark:text-white">@days روز</td>
                                
                                <!-- Reason -->
                                <td class="px-3 py-3 text-slate-600 dark:text-slate-400 max-w-[220px] truncate" title="@item.Reason">
                                    @item.Reason
                                </td>
                                
                                <!-- Workflow Badge -->
                                <td class="px-3 py-3 text-center">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border @badgeClass">
                                        @WorkflowStatus.Label(item.Status)
                                    </span>
                                </td>
                                
                                <!-- Actions -->
                                <td class="px-3 py-3 text-center w-1">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition" title="ویرایش">
                                            <i class="bi bi-pencil-square text-sm"></i>
                                        </a>
                                        <button class="p-1 text-slate-500 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition btn-delete" data-id="@item.Id" type="button" title="حذف">
                                            <i class="bi bi-trash text-sm"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-3 py-4 text-center text-slate-450 dark:text-slate-550">در این فیلتر موردی ثبت نشده است.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/js/leaves-index-script.js" asp-append-version="true"></script>
