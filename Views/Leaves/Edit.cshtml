@model OfficeAutomation.Models.Leave
@{
    ViewData["Title"] = "ویرایش مرخصی";
}

<div class="w-full flex-1 flex flex-col gap-3 p-2.5 md:p-3" dir="rtl">
    <!-- Header Card -->
    <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
        <div>
            <h1 class="m-0 text-sm font-black text-slate-900 dark:text-white tracking-tight">ویرایش مرخصی</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">اطلاعات مرخصی را ویرایش و ذخیره کنید.</p>
        </div>
        <a asp-action="Index" class="flex items-center justify-center px-3 h-8 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm bg-transparent no-underline">
            <span>بازگشت به لیست</span>
        </a>
    </header>

    <!-- Form Card -->
    <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
        <form asp-action="Edit" method="post" id="leaveEditForm" class="flex flex-col gap-3" novalidate>
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 dark:bg-rose-955/10 text-rose-800 dark:text-rose-450 border border-rose-200 dark:border-rose-900/50 rounded-lg text-xs font-semibold leading-relaxed d-none" id="modelSummary"></div>
            }
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <!-- User -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="UserId" class="text-xs font-bold text-slate-700 dark:text-slate-300">کاربر</label>
                    <select asp-for="UserId" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" id="UserId" asp-items="ViewBag.UserId">
                        <option value="">— انتخاب کنید —</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Status -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Status" class="text-xs font-bold text-slate-700 dark:text-slate-300">وضعیت</label>
                    <select asp-for="Status" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" id="Status">
                        <option value="">— انتخاب کنید —</option>
                        <option value="Pending">در انتظار</option>
                        <option value="Approved">تایید شده</option>
                        <option value="Rejected">رد شده</option>
                    </select>
                    <span asp-validation-for="Status" class="text-xs text-rose-500 mt-1 block"></span>
                    <span class="text-[10px] text-slate-400">وضعیت را متناسب با فرآیند تایید انتخاب کنید.</span>
                </div>

                <!-- Start Date (Fa) -->
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">تاریخ شروع</label>
                    <input type="text" id="StartDateFa" name="StartDateFa" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 text-left font-mono tabular-nums" placeholder="مثلاً 1402/12/01" autocomplete="off" />
                    <input asp-for="StartDate" type="hidden" id="StartDate" />
                    <span asp-validation-for="StartDate" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- End Date (Fa) -->
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">تاریخ پایان</label>
                    <input type="text" id="EndDateFa" name="EndDateFa" class="h-8 w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-955 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 text-left font-mono tabular-nums" placeholder="مثلاً 1402/12/05" autocomplete="off" />
                    <input asp-for="EndDate" type="hidden" id="EndDate" />
                    <span asp-validation-for="EndDate" class="text-xs text-rose-500 mt-1 block"></span>
                    <span class="text-[10px] text-slate-400" id="daysHint"></span>
                </div>

                <!-- Reason -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label asp-for="Reason" class="text-xs font-bold text-slate-700 dark:text-slate-300">دلیل مرخصی</label>
                    <textarea asp-for="Reason" class="w-full rounded-lg border border-slate-200 bg-white dark:bg-slate-905 p-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800" id="Reason" rows="3" placeholder="مثلاً: مرخصی استعلاجی / امور شخصی / سفر و ..."></textarea>
                    <span asp-validation-for="Reason" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800 pt-2 mt-2">
                <a asp-action="Index" class="flex items-center justify-center px-2.5 h-8 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm no-underline">
                    <span>انصراف</span>
                </a>
                <button type="submit" class="flex items-center gap-1.5 px-3 h-8 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm" id="btnSaveLeave">
                    <span class="btn-text">ذخیره تغییرات</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/persian-datepicker/persian-datepicker.min.css" />
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/lib/persian-date/persian-date.min.js"></script>
    <script src="~/lib/persian-datepicker/persian-datepicker.min.js"></script>
    <script src="~/js/leave-edit.js"></script>
}