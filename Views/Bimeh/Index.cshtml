@model InsuranceIndexVM
@{
    ViewData["Title"] = "لیست بیمه";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var quickActions = new List<OfficeAutomation.Models.FinancialQuickActionVM>
    {
        new() { Title = "لیست جدید", Description = "ساخت لیست بیمه جدید", Url = Url.Action("Create", "Bimeh") ?? "#", Icon = "bi-plus-circle", Tone = "primary" },
        new() { Title = "هاب مالی", Description = "بازگشت به هاب مالی", Url = Url.Action("Dashboard", "Financial") ?? "#", Icon = "bi-speedometer2", Tone = "success" },
        new() { Title = "لیست حقوق", Description = "مشاهده هم‌راستا با حقوق", Url = Url.Action("Index", "Payroll") ?? "#", Icon = "bi-cash-stack", Tone = "warning" }
    };
}

<div class="w-full flex-1 flex flex-col gap-6 p-4 md:p-6" dir="rtl">
    <!-- Header Card -->
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <div>
            <h1 class="m-0 text-lg font-black text-slate-900 dark:text-white tracking-tight">مدیریت لیست بیمه</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">لیست و وضعیت درخواست‌های ثبت‌شده در سیستم</p>
        </div>
        <a asp-action="Create" class="flex items-center gap-1.5 px-4 h-9 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm no-underline self-start sm:self-auto">
            <i class="bi bi-plus-circle-fill"></i>
            <span>لیست جدید</span>
        </a>
    </header>

    <!-- Warnings Section -->
    @if (Model.QualityWarnings.Any())
    {
        <div class="flex flex-col gap-2">
            @foreach (var warning in Model.QualityWarnings)
            {
                <div class="flex items-center gap-2 p-3 bg-amber-50 dark:bg-amber-955/10 text-amber-800 dark:text-amber-400 border border-amber-200 dark:border-amber-900/50 rounded-xl text-xs font-semibold shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill text-amber-600 dark:text-amber-400 text-sm"></i>
                    <span>@warning</span>
                </div>
            }
        </div>
    }

    <!-- Quick Actions Panel -->
    <div class="shadow-sm border border-slate-200 dark:border-slate-800 rounded-2xl p-4 bg-white dark:bg-slate-900">
        <partial name="_QuickActionsGrid" model="quickActions" />
    </div>

    <!-- Filters Panel -->
    <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm flex flex-col gap-4">
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 items-end">
            <!-- Search field -->
            <div class="lg:col-span-4 flex flex-col gap-1.5">
                <label asp-for="SearchTerm" class="text-xs font-bold text-slate-500 dark:text-slate-400">جستجو</label>
                <input asp-for="SearchTerm" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="پروژه یا مدیر پروژه..." />
            </div>
            
            <!-- Month field -->
            <div class="lg:col-span-2 flex flex-col gap-1.5">
                <label asp-for="Month" class="text-xs font-bold text-slate-500 dark:text-slate-400">ماه</label>
                <input asp-for="Month" type="number" min="1" max="12" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" />
            </div>

            <!-- Year field -->
            <div class="lg:col-span-2 flex flex-col gap-1.5">
                <label asp-for="Year" class="text-xs font-bold text-slate-500 dark:text-slate-400">سال</label>
                <input asp-for="Year" type="number" min="1300" max="1600" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" />
            </div>

            <!-- Status field -->
            <div class="lg:col-span-2 flex flex-col gap-1.5">
                <label asp-for="Status" class="text-xs font-bold text-slate-500 dark:text-slate-400">وضعیت</label>
                <select asp-for="Status" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none">
                    <option value="">همه</option>
                    @foreach (var statusOption in Model.AvailableStatuses)
                    {
                        <option value="@statusOption">@statusOption</option>
                    }
                </select>
            </div>

            <!-- Actions buttons -->
            <div class="lg:col-span-2 flex gap-2">
                <button type="submit" class="h-9 flex-1 flex items-center justify-center gap-1.5 px-4 rounded-lg bg-teal-600 hover:bg-teal-700 dark:bg-teal-50 dark:hover:bg-teal-600 text-white text-xs font-bold transition shadow-sm">
                    <span>اعمال</span>
                </button>
                <a asp-action="Index" class="h-9 flex-1 flex items-center justify-center border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm no-underline bg-transparent">
                    <span>حذف</span>
                </a>
            </div>
        </form>

        <div class="flex flex-wrap gap-4 items-center mt-2 border-t border-slate-100 dark:border-slate-800 pt-3 text-[10px] font-bold text-slate-500 dark:text-slate-400">
            <div>تعداد کل: <span class="font-mono text-slate-700 dark:text-slate-300">@Model.TotalCount</span></div>
            <div>نتایج فیلتر: <span class="font-mono text-slate-700 dark:text-slate-300">@Model.FilteredCount</span></div>
            <div>گروه تکراری: <span class="font-mono text-slate-700 dark:text-slate-300">@Model.DuplicateGroupCount</span></div>
        </div>
    </div>

    <!-- Data Grid Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-xs text-right border-collapse" >
                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " ead class="sticky top-0 z-10 bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold" >پروژه</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold" >مدیر پروژه</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-center" >ماه / سال</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-left" >تعداد پرسنل</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-center" >وضعیت</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-center w-1" >عملیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                    @if (Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            var badgeClass = item.Status == "ارسال شده" || item.Status == "تایید شده" || item.Status == "ثبت شده"
                                ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border border-emerald-200/40"
                                : (item.Status == "پیش‌نویس"
                                ? "bg-slate-100 text-slate-700 dark:bg-slate-800/40 dark:text-slate-400 border border-slate-200/40"
                                : "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border border-amber-200/40");

                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 font-bold text-slate-900 dark:text-white" >@item.ProjectName</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 font-medium text-slate-800 dark:text-slate-200" >@item.ManagerName</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 text-center font-mono text-slate-500" >@item.Month / @item.Year</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 text-left font-mono tabular-nums font-bold" >
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 text-teal-700 dark:bg-teal-950/30 dark:text-teal-400 border border-teal-200/30">
                                        @item.EmployeeCount نفر
                                    </span>
                                </td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 text-center" >
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold border @badgeClass">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-3 text-center w-1" >
                                    <div class="flex items-center justify-center gap-1.5">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition" title="جزئیات/ریز لیست">
                                            <i class="bi bi-eye text-sm"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-1 text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400 transition" title="ویرایش">
                                            <i class="bi bi-pencil-square text-sm"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-1 text-slate-500 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition" title="حذف">
                                            <i class="bi bi-trash text-sm"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 "  colspan="6" class="px-3 py-8 text-center text-slate-400 dark:text-slate-500">
                                <partial name="_EmptyState" model='new { Icon = "bi-shield-lock", Title = "هنوز لیست بیمه‌ای ثبت نشده است.", Description = "از دکمه لیست جدید برای شروع استفاده کنید." }' />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
