@model InsuranceIndexVM
@{
    ViewData["Title"] = "لیست بیمه";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var quickActions = new List<OfficeAutomation.Models.FinancialQuickActionVM>
    {
        new() { Title = "لیست جدید", Description = "ساخت لیست بیمه جدید", Url = Url.Action("Create", "Bimeh") ?? "#", Icon =
"bi-plus-circle", Tone = "primary" },
        new() { Title = "هاب مالی", Description = "بازگشت به هاب مالی", Url = Url.Action("Dashboard", "Financial") ?? "#", Icon
= "bi-speedometer2", Tone = "success" },
        new() { Title = "لیست حقوق", Description = "مشاهده هم‌راستا با حقوق", Url = Url.Action("Index", "Payroll") ?? "#", Icon
= "bi-cash-stack", Tone = "warning" }
    };
}

<div class="w-full flex-1 flex flex-col gap-5 p-3 md:p-4" dir="rtl">
    <!-- Header Card -->
    <header
        class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
        <div>
            <h1 class="m-0 text-lg font-black text-slate-900 dark:text-white tracking-tight">مدیریت لیست بیمه</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">لیست و وضعیت درخواست‌های ثبت‌شده در سیستم</p>
        </div>
        <a asp-action="Create"
           class="flex items-center gap-1.5 px-4 h-9 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition shadow-sm shadow-indigo-500/20 no-underline self-start sm:self-auto">
            <i class="bi bi-plus-circle-fill"></i>
            <span>لیست جدید</span>
        </a>
    </header>

    <!-- Warnings Section -->
    @if (Model.QualityWarnings.Any())
    {
        <div class="flex flex-col gap-2">
            @foreach (var warning in Model.QualityWarnings)
            {
                <div
                    class="flex items-center gap-2 p-3.5 bg-amber-50/80 dark:bg-amber-955/10 text-amber-800 dark:text-amber-400 border border-amber-200/60 dark:border-amber-900/40 rounded-2xl text-xs font-semibold shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill text-amber-600 dark:text-amber-400 text-sm"></i>
                    <span>@warning</span>
                </div>
            }
        </div>
    }

    <!-- Quick Actions Panel -->
    <div class="shadow-sm border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 bg-white dark:bg-slate-900">
        <partial name="_QuickActionsGrid" model="quickActions" />
    </div>

    <!-- Filters Panel -->
    <div
        class="p-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm flex flex-col gap-4">
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 items-end">
            <!-- Search field -->
            <div class="lg:col-span-4 flex flex-col gap-1.5">
                <label asp-for="SearchTerm" class="text-xs font-bold text-slate-500 dark:text-slate-400">جستجو</label>
                <input asp-for="SearchTerm"
                       class="w-full h-9 rounded-xl border border-slate-200/80 bg-slate-50/60 px-3 text-sm text-slate-800 outline-none transition-all placeholder:text-slate-400 focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:placeholder:text-slate-500 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20"
                       placeholder="پروژه یا مدیر پروژه..." />
            </div>

            <!-- Month field -->
            <div class="lg:col-span-2 flex flex-col gap-1.5">
                <label asp-for="Month" class="text-xs font-bold text-slate-500 dark:text-slate-400">ماه</label>
                <input asp-for="Month" type="number" min="1" max="12"
                       class="w-full h-9 rounded-xl border border-slate-200/80 bg-slate-50/60 px-3 text-sm text-slate-800 outline-none transition-all focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20" />
            </div>

            <!-- Year field -->
            <div class="lg:col-span-2 flex flex-col gap-1.5">
                <label asp-for="Year" class="text-xs font-bold text-slate-500 dark:text-slate-400">سال</label>
                <input asp-for="Year" type="number" min="1300" max="1600"
                       class="w-full h-9 rounded-xl border border-slate-200/80 bg-slate-50/60 px-3 text-sm text-slate-800 outline-none transition-all focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20" />
            </div>

            <!-- Status field -->
            <div class="lg:col-span-2 flex flex-col gap-1.5">
                <label asp-for="Status" class="text-xs font-bold text-slate-500 dark:text-slate-400">وضعیت</label>
                <select asp-for="Status"
                        class="w-full h-9 rounded-xl border border-slate-200/80 bg-slate-50/60 px-3 text-sm text-slate-800 outline-none transition-all focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:focus:border-indigo-400 dark:focus:ring-indigo-500/20">
                    <option value="">همه</option>
                    @foreach (var statusOption in Model.AvailableStatuses)
                    {
                        <option value="@statusOption">@statusOption</option>
                    }
                </select>
            </div>

            <!-- Actions buttons -->
            <div class="lg:col-span-2 flex gap-2">
                <button type="submit"
                        class="h-9 flex-1 flex items-center justify-center gap-1.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition shadow-sm shadow-indigo-500/20">
                    <span>اعمال</span>
                </button>
                <a asp-action="Index"
                   class="h-9 flex-1 flex items-center justify-center border border-slate-200/80 dark:border-slate-700/60 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-bold transition shadow-sm no-underline bg-transparent">
                    <span>حذف</span>
                </a>
            </div>
        </form>

        <div
            class="flex flex-wrap gap-4 items-center border-t border-slate-100/80 dark:border-slate-800 pt-4 text-[10px] font-bold text-slate-500 dark:text-slate-400">
            <div>تعداد کل: <span class="font-mono text-slate-700 dark:text-slate-300">@Model.TotalCount</span></div>
            <div>نتایج فیلتر: <span class="font-mono text-slate-700 dark:text-slate-300">@Model.FilteredCount</span>
            </div>
            <div>گروه تکراری: <span
                class="font-mono text-slate-700 dark:text-slate-300">@Model.DuplicateGroupCount</span></div>
            </div>
        </div>

        <!-- Data Grid Table -->
        <div
            class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto w-full">
                <table class="w-full text-xs text-right border-collapse text-slate-700 dark:text-slate-300">
                    <thead
                        class="sticky top-0 z-10 bg-slate-50/80 dark:bg-slate-800/60 backdrop-blur-sm border-b border-slate-100 dark:border-slate-800/60">
                        <tr>
                            <th
                                class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                پروژه</th>
                                <th
                                    class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                    مدیر پروژه</th>
                                    <th
                                        class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center">
                                        ماه / سال</th>
                                        <th
                                            class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-right">
                                            تعداد پرسنل</th>
                                            <th
                                                class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center">
                                                وضعیت</th>
                                                <th
                                                    class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center w-1">
                                                    عملیات</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                                                @if (Model.Items.Any())
                                                {
                                                    @foreach (var item in Model.Items)
                                                    {
                                                        var (badgeClass, dotColor) = item.Status switch
                                                        {
                                                            "ارسال شده" or "تایید شده" or "ثبت شده" => ("bg-emerald-50 text-emerald-700 border-emerald-200/60 dark:bg-emerald-950/40 dark:text-emerald-400 dark:border-emerald-800/40", "bg-emerald-500"),
                                                            "پیش‌نویس" => ("bg-slate-100 text-slate-600 border-slate-200/60 dark:bg-slate-800/40 dark:text-slate-400 dark:border-slate-700/40", "bg-slate-400"),
                                                            _ => ("bg-amber-50 text-amber-700 border-amber-200/60 dark:bg-amber-950/40 dark:text-amber-400 dark:border-amber-800/40", "bg-amber-500")
                                                        };

                                                        <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                                                            <td class="px-4 py-3.5 font-bold text-slate-900 dark:text-white">@item.ProjectName</td>
                                                            <td class="px-4 py-3.5 font-medium text-slate-800 dark:text-slate-200">@item.ManagerName</td>
                                                            <td class="px-4 py-3.5 text-center font-mono text-slate-500">@item.Month / @item.Year</td>
                                                            <td class="px-4 py-3.5 text-right font-mono tabular-nums font-bold" dir="ltr">
                                                                <span
                                                                    class="inline-flex items-center rounded-full px-2.5 py-1 text-[10px] font-medium bg-indigo-50 text-indigo-700 border border-indigo-200/60 dark:bg-indigo-950/30 dark:text-indigo-400 dark:border-indigo-800/40">
                                                                    @item.EmployeeCount نفر
                                                                </span>
                                                            </td>
                                                            <td class="px-4 py-3.5 text-center">
                                                                <span
                                                                    class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-medium border @badgeClass">
                                                                    <span class="status-dot status-dot-pulse @dotColor"></span>@item.Status
                                                                </span>
                                                            </td>
                                                            <td class="px-4 py-3.5 text-center w-1">
                                                                <div class="flex items-center justify-center gap-1">
                                                                    <a asp-action="Details" asp-route-id="@item.Id"
                                                                       class="p-1.5 text-slate-400 hover:text-indigo-600 dark:text-slate-500 dark:hover:text-indigo-400 transition-colors"
                                                                       title="جزئیات/ریز لیست">
                                                                        <i class="bi bi-eye text-sm"></i>
                                                                    </a>
                                                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                                                       class="p-1.5 text-slate-400 hover:text-indigo-600 dark:text-slate-500 dark:hover:text-indigo-400 transition-colors"
                                                                       title="ویرایش">
                                                                        <i class="bi bi-pencil-square text-sm"></i>
                                                                    </a>
                                                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                                                       class="p-1.5 text-slate-400 hover:text-rose-600 dark:text-slate-500 dark:hover:text-rose-400 transition-colors"
                                                                       title="حذف">
                                                                        <i class="bi bi-trash text-sm"></i>
                                                                    </a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="6" class="px-4 py-12 text-center">
                                                            <partial name="_EmptyState"
                                                                     model='new { Icon = "bi-shield-check", Title = "هنوز لیست بیمه‌ای ثبت نشده است", Description = "از دکمه لیست جدید برای شروع استفاده کنید.", ActionUrl = Url.Action("Create"), ActionText = "لیست جدید" }' />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>