@model InsuranceEditVM
@{
    ViewData["Title"] = "ویرایش لیست بیمه";
}

<div class="w-full flex-1 flex flex-col gap-6 p-4 md:p-6" dir="rtl">
    <!-- Header Section -->
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <div>
            <h1 class="m-0 text-lg font-black text-slate-900 dark:text-white tracking-tight">ویرایش لیست بیمه</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">ذخیره مستقیم اطلاعات با اتصال به سرمایه انسانی</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="Index" class="flex items-center justify-center px-3 h-9 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-bold transition shadow-sm bg-transparent no-underline">
                <span>بازگشت</span>
            </a>
            <button type="button" id="copyPreviousMonth" class="flex items-center gap-1.5 px-4 h-9 border border-teal-200 dark:border-teal-900/50 hover:bg-teal-50 dark:hover:bg-teal-955/20 text-teal-700 dark:text-teal-400 rounded-lg text-xs font-bold transition shadow-sm bg-transparent">
                <i class="bi bi-arrow-repeat"></i>
                <span>کپی از ماه قبل</span>
            </button>
            <button type="button" id="saveInsuranceAjax" class="flex items-center gap-1.5 px-4 h-9 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm">
                <i class="bi bi-lightning-charge"></i>
                <span>ذخیره سریع</span>
            </button>
        </div>
    </header>

    <!-- Success banner -->
    @if (TempData["InsuranceSuccess"] is string successMessage)
    {
        <div class="flex items-center gap-2 p-3 bg-emerald-50 dark:bg-emerald-950/10 text-emerald-800 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50 rounded-xl text-xs font-semibold shadow-sm">
            <i class="bi bi-check-circle-fill text-emerald-650 dark:text-emerald-400"></i>
            <span>@successMessage</span>
        </div>
    }

    <!-- Info/Statuses row -->
    <div class="flex flex-wrap gap-2 items-center text-xs text-slate-500 dark:text-slate-400 p-4 bg-slate-50 dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 rounded-xl leading-relaxed">
        <span class="font-bold text-slate-700 dark:text-slate-300">وضعیت‌های لیست:</span>
        <span>پیش‌نویس</span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span>ارسال‌شده</span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span>در حال بررسی</span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span>تاییدشده</span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span>بسته‌شده</span>
    </div>

    <!-- Main Form Card -->
    <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm">
        <form asp-action="Edit" method="post" id="bimehEditForm" class="flex flex-col gap-6">
            @Html.AntiForgeryToken()
            <input class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" type="hidden" asp-for="Id" id="idField" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 dark:bg-rose-950/10 text-rose-800 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 rounded-xl text-xs font-semibold leading-relaxed"></div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
                <!-- Project Name -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="ProjectName" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="ProjectName" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" maxlength="150" id="projectNameField" />
                    <span asp-validation-for="ProjectName" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Manager Name -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="ManagerName" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="ManagerName" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" maxlength="100" id="managerNameField" />
                    <span asp-validation-for="ManagerName" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Month -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Month" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="Month" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" type="number" min="1" max="12" id="monthField" />
                    <span asp-validation-for="Month" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Year -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Year" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <input asp-for="Year" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" type="number" min="1300" max="1600" id="yearField" />
                    <span asp-validation-for="Year" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Status -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Status" class="text-xs font-bold text-slate-700 dark:text-slate-300"></label>
                    <select asp-for="Status" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" id="statusField">
                        @foreach (var status in Model.AvailableStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                    <span asp-validation-for="Status" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Table Header Toolbar -->
            <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-800 pt-4 mt-2">
                <h3 class="m-0 text-sm font-black text-slate-900 dark:text-white">کارکنان لیست بیمه</h3>
                <button type="button" id="addRow" class="flex items-center gap-1 px-3 h-8 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-lg text-[11px] font-bold transition shadow-sm">
                    <i class="bi bi-plus-lg"></i>
                    <span>افزودن ردیف</span>
                </button>
            </div>

            <!-- Table Employees list -->
            <div class="border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden">
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-xs text-right border-collapse" >
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " ead class="bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold" >نام کارمند</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold" >سمت</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-center" >شروع کار (شمسی)</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-center" >ترک کار (شمسی)</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-left" >روز کارکرد</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-left" >حقوق مشمول</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-left" >حق بیمه ۷٪</th>
                                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold px-3 py-2.5 font-bold text-center w-1" >حذف</th>
                            </tr>
                        </thead>
                        <tbody id="employeeRows" class="divide-y divide-slate-100 dark:divide-slate-800/60"></tbody>
                    </table>
                </div>
            </div>

            <!-- Footer Details/Submit -->
            <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-800 pt-4 mt-2">
                <span id="employeeCountLabel" class="text-xs font-bold text-slate-500 dark:text-slate-400">تعداد کارکنان: @Model.Employees.Count</span>
                <button type="submit" class="flex items-center gap-1.5 px-5 h-9 bg-teal-600 hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-600 text-white rounded-lg text-xs font-bold transition shadow-sm">
                    <i class="bi bi-check-circle"></i>
                    <span>ذخیره تغییرات</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Template for cloning rows -->
<template id="employeeRowTemplate">
    <tr>
        <!-- Employee search box -->
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-2 min-w-[200px]" >
            <div class="relative w-full employee-autocomplete">
                <input data-field="FullName" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" maxlength="120" autocomplete="off" placeholder="جستجو نام/کد پرسنلی..." required />
                <input class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" type="hidden" data-field="HumanCapitalEmployeeId" />
                <div class="employee-suggestions absolute top-full right-0 left-0 z-50 mt-1 max-h-48 overflow-y-auto bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-lg hidden"></div>
            </div>
        </td>
        
        <!-- Job Title -->
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-2 min-w-[150px]" >
            <input data-field="JobTitle" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" maxlength="100" required readonly />
            <small class="text-[9px] text-slate-400 mt-0.5 block">از پرونده پرسنلی</small>
        </td>
        
        <!-- Hire date / Start Date -->
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-2 min-w-[140px]" >
            <input type="text" data-field="StartWorkSolar" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="1405/03/01" required readonly />
            <small class="text-[9px] text-slate-400 mt-0.5 block">قفل‌شده از تاریخ استخدام</small>
        </td>
        
        <!-- End Work date -->
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-2 min-w-[140px]" >
            <input type="text" data-field="EndWorkSolar" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="1405/03/31" />
        </td>
        
        <!-- Work Days count -->
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-2 w-20" >
            <input type="number" data-field="WorkDays" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" min="0" max="31" required />
        </td>
        
        <!-- Salary -->
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-2 min-w-[130px]" >
            <input type="number" data-field="Salary" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" min="0" step="0.01" required />
        </td>
        
        <!-- Calculated Insurance -->
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-2 min-w-[110px]" >
            <div class="h-9 w-full rounded-lg border border-slate-200 bg-slate-50 dark:bg-slate-900 px-3 text-xs text-slate-600 dark:text-slate-300 outline-none flex items-center justify-start font-bold font-mono tabular-nums dark:border-slate-800" data-insurance-cell>0 ریال</div>
        </td>
        
        <!-- Delete Row Action -->
        <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 px-3 py-2 text-center" >
            <button type="button" class="px-2.5 py-1.5 rounded-lg border border-rose-200 dark:border-rose-900/50 hover:bg-rose-50 dark:hover:bg-rose-950/20 text-rose-700 dark:text-rose-400 text-[10px] font-bold transition removeRow cursor-pointer">حذف</button>
        </td>
    </tr>
</template>

@section Scripts {
    <script src="~/js/persian-date.js" asp-append-version="true"></script>
    <script src="~/js/persian-datepicker.min.js" asp-append-version="true"></script>
    <script src="~/js/insurance-form.js" asp-append-version="true"></script>
    <script>
        (() => {
            const initialEmployees = @Html.Raw(Json.Serialize((Model.Employees ?? new List<InsuranceEmployeeRowViewModel>()).Select(e => new {
                humanCapitalEmployeeId = e.HumanCapitalEmployeeId,
                fullName = e.FullName,
                jobTitle = e.JobTitle,
                startWorkSolar = e.StartWorkSolar,
                endWorkSolar = e.EndWorkSolar,
                workDays = e.WorkDays,
                salary = e.Salary
            })));

            window.initInsuranceForm({
                mode: 'edit',
                formId: 'bimehEditForm',
                rowsContainerId: 'employeeRows',
                rowTemplateId: 'employeeRowTemplate',
                addRowButtonId: 'addRow',
                employeeCountLabelId: 'employeeCountLabel',
                copyPreviousMonthButtonId: 'copyPreviousMonth',
                projectNameFieldId: 'projectNameField',
                managerNameFieldId: 'managerNameField',
                monthFieldId: 'monthField',
                yearFieldId: 'yearField',
                statusFieldId: 'statusField',
                idFieldId: 'idField',
                saveAjaxButtonId: 'saveInsuranceAjax',
                initialEmployees
            });

            document.getElementById('employeeRows').addEventListener('input', event => {
                if (!event.target.classList.contains('salary-input')) return;
                const row = event.target.closest('tr');
                const salary = Number(event.target.value || 0);
                row.querySelector('[data-insurance-cell]').textContent = `${(salary * 0.07).toLocaleString('fa-IR')} ریال`;
            });

            document.getElementById('employeeRows').querySelectorAll('tr').forEach(row => {
                const salary = Number(row.querySelector('.salary-input')?.value || 0);
                const cell = row.querySelector('[data-insurance-cell]');
                if (cell) cell.textContent = `${(salary * 0.07).toLocaleString('fa-IR')} ریال`;
            });

            document.getElementById('saveInsuranceAjax')?.addEventListener('click', () => {
                if (window.AppUI?.toast) {
                    window.AppUI.toast('ذخیره سریع در حال ارسال است.', 'info');
                }
            });
        })();
    </script>
}
