@{
    ViewData["Title"] = "دستیار هوش مصنوعی";
}

<script src="~/js/aiassistant.js" defer></script>

<div class="container py-6" dir="rtl">
    @Html.AntiForgeryToken()

    <div class="w-full max-w-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden mx-auto">

        <div class="bg-slate-50 dark:bg-slate-850 px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center gap-2 text-slate-900 dark:text-white font-black text-sm">
            <i class="bi bi-stars text-teal-600 dark:text-teal-400"></i>
            <span>دستیار هوش مصنوعی</span>
        </div>

        <div class="p-0">
            <div id="chatMessages" class="h-[500px] overflow-y-auto p-4 space-y-4 flex flex-col">
                <div class="flex items-start gap-2.5 self-start">
                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex-shrink-0">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div class="bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 rounded-2xl rounded-bl-none p-3.5 max-w-[80%] text-xs font-semibold leading-relaxed">
                        سلام 👋
                        چطور میتونم کمکتون کنم؟
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-850 p-3 border-t border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-2 bg-white dark:bg-slate-950 border border-slate-250 dark:border-slate-800 rounded-xl px-3 py-1">
                <input id="userInput"
                       type="text"
                       class="flex-1 bg-transparent border-none text-xs text-slate-800 dark:text-slate-250 placeholder-slate-400 dark:placeholder-slate-650 focus:outline-none focus:ring-0 py-2"
                       placeholder="پیام خود را بنویسید..." />

                <button id="sendBtn" class="h-8 w-8 rounded-lg bg-teal-600 hover:bg-teal-700 text-white flex items-center justify-center transition">
                    <i class="bi bi-send text-xs"></i>
                </button>
            </div>
        </div>

    </div>
</div>
