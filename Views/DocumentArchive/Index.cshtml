@model OfficeAutomation.Models.DocumentArchiveIndexVM
@{
    ViewData["Title"] = "بایگانی اسناد";
    var searchTerm = Model.SearchTerm ?? string.Empty;
    var category = Model.Category ?? string.Empty;
    var accessLevel = Model.AccessLevel ?? string.Empty;
    var totalItems = Model.Items.Count;
    var publicCount = Model.Items.Count(i => i.AccessLevel == "Public");
    var restrictedCount = Model.Items.Count(i => i.AccessLevel == "Restricted");
    var totalSize = Model.Items.Sum(i => i.FileSize);
}

<div class="w-full flex-1 flex flex-col gap-5 p-3 md:p-4" dir="rtl">
    @Html.AntiForgeryToken()

    @* ── Toast Message ── *@
    @if (TempData["ArchiveMessage"] is string archiveMessage)
    {
        <div
            class="flex items-center gap-2 rounded-xl border border-emerald-200/60 bg-emerald-50/80 px-4 py-3 text-xs font-medium text-emerald-800 dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-300">
            <i class="bi bi-check-circle-fill text-emerald-600 dark:text-emerald-400"></i>
            <span>@archiveMessage</span>
        </div>
    }

    @* ── Header Card ── *@
    <header
        class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
        <div class="flex items-center gap-3">
            <div
                class="w-11 h-11 flex items-center justify-center rounded-xl bg-amber-50 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400 text-lg border border-amber-200/30 dark:border-amber-800/30">
                <i class="bi bi-archive"></i>
            </div>
            <div>
                <h1 class="m-0 text-lg font-black text-slate-900 dark:text-white tracking-tight">بایگانی اسناد</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">مدیریت و دسته‌بندی هوشمند اسناد و پیوست‌های
                    سازمانی</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <div class="relative min-w-[220px]">
                    <i class="bi bi-search absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input id="archiveSearch" type="text" placeholder="جستجو در عنوان یا نام فایل..."
                           class="h-9 w-full rounded-xl border border-slate-200/80 bg-slate-50/60 pr-10 pl-3 text-xs text-slate-800 outline-none transition-all placeholder:text-slate-400 focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:placeholder:text-slate-500 dark:focus:border-amber-400 dark:focus:ring-amber-500/20"
                           onkeydown="if(event.key==='Enter'){ document.getElementById('archiveFilterForm').submit(); }" />
                </div>
                <div class="flex items-center gap-1.5">
                    <a asp-action="ExportExcel" asp-route-searchTerm="@searchTerm" asp-route-category="@category"
                       asp-route-accessLevel="@accessLevel"
                       class="flex items-center gap-1 px-3 h-9 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-sm shadow-emerald-500/20 no-underline"
                       title="خروجی Excel">
                        <i class="bi bi-file-earmark-excel"></i>
                        <span class="hidden sm:inline">Excel</span>
                    </a>
                    <a asp-action="ExportPdf" asp-route-searchTerm="@searchTerm" asp-route-category="@category"
                       asp-route-accessLevel="@accessLevel"
                       class="flex items-center gap-1 px-3 h-9 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold transition shadow-sm shadow-rose-500/20 no-underline"
                       title="خروجی PDF">
                        <i class="bi bi-file-earmark-pdf"></i>
                        <span class="hidden sm:inline">PDF</span>
                    </a>
                    @if (Model.CanUpload)
                    {
                        <button type="button" onclick="document.getElementById('uploadPanel').classList.toggle('hidden')"
                                class="flex items-center gap-1.5 px-4 h-9 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold transition shadow-sm shadow-amber-500/20">
                            <i class="bi bi-cloud-upload-fill"></i>
                            <span>آپلود سند</span>
                        </button>
                    }
                </div>
            </div>
        </header>

        @* ── Stats Cards ── *@
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div
                class="flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">کل اسناد</span>
                <span class="text-2xl font-black text-slate-800 dark:text-white mt-1">@totalItems.ToString("N0")</span>
                <span class="text-[9px] text-slate-400 mt-0.5">سند بایگانی‌شده</span>
            </div>
            <div
                class="flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">عمومی</span>
                <span class="text-2xl font-black text-emerald-600 mt-1">@publicCount.ToString("N0")</span>
                <span class="text-[9px] text-slate-400 mt-0.5">سند با دسترسی عمومی</span>
            </div>
            <div
                class="flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">محرمانه</span>
                <span class="text-2xl font-black text-rose-600 mt-1">@restrictedCount.ToString("N0")</span>
                <span class="text-[9px] text-slate-400 mt-0.5">سند با دسترسی محدود</span>
            </div>
            <div
                class="flex flex-col items-start gap-1 p-4 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">حجم کل</span>
                <span class="text-2xl font-black text-sky-600 mt-1">@FormatFileSize(totalSize)</span>
                <span class="text-[9px] text-slate-400 mt-0.5">مجموع حجم فایل‌ها</span>
            </div>
        </div>

        @* ── Upload Panel (Hidden by default) ── *@
        <div id="uploadPanel"
             class="hidden p-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
            @if (!Model.CanUpload)
            {
                <div
                    class="flex items-center gap-2 rounded-xl border border-amber-200/60 bg-amber-50/80 px-4 py-3 text-xs font-medium text-amber-800 dark:border-amber-500/20 dark:bg-amber-500/10 dark:text-amber-300">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>دسترسی آپلود سند برای شما فعال نیست.</span>
                </div>
            }
            else
            {
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="flex items-center gap-2 mb-4">
                        <i class="bi bi-cloud-arrow-up-fill text-amber-600 dark:text-amber-400 text-lg"></i>
                        <h5 class="m-0 text-sm font-bold text-slate-900 dark:text-white">آپلود سند جدید</h5>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">عنوان سند <span
                                class="text-rose-500">*</span></label>
                                <input name="Title" required maxlength="180"
                                       class="h-9 w-full rounded-xl border border-slate-200/80 bg-slate-50/60 px-3 text-xs text-slate-800 outline-none transition-all placeholder:text-slate-400 focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:placeholder:text-slate-500 dark:focus:border-amber-400 dark:focus:ring-amber-500/20"
                                       placeholder="عنوان گویا برای سند" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">دسته‌بندی</label>
                                <select name="Category"
                                        class="h-9 w-full rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700/80 dark:focus:border-amber-400 dark:focus:ring-amber-500/20">
                                    <option value="Letters">نامه</option>
                                    <option value="Invoices">فاکتور</option>
                                    <option value="Personnel">پرسنل</option>
                                    <option value="Contracts">قرارداد</option>
                                    <option value="Insurance">بیمه</option>
                                    <option value="Warehouse">انبار</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">سطح
                                    دسترسی</label>
                                    <select name="AccessLevel"
                                            class="h-9 w-full rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700/80 dark:focus:border-amber-400 dark:focus:ring-amber-500/20">
                                        <option value="Module">درون‌ماژولی</option>
                                        <option value="Public">عمومی</option>
                                        <option value="Restricted">محرمانه</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">ماژول
                                        مرتبط</label>
                                        <input name="RelatedModule" maxlength="120"
                                               class="h-9 w-full rounded-xl border border-slate-200/80 bg-slate-50/60 px-3 text-xs text-slate-800 outline-none transition-all placeholder:text-slate-400 focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:placeholder:text-slate-500 dark:focus:border-amber-400 dark:focus:ring-amber-500/20"
                                               placeholder="مثلاً Letters" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">نوع رکورد
                                            مرتبط</label>
                                            <input name="RelatedEntityType" maxlength="120"
                                                   class="h-9 w-full rounded-xl border border-slate-200/80 bg-slate-50/60 px-3 text-xs text-slate-800 outline-none transition-all placeholder:text-slate-400 focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:placeholder:text-slate-500 dark:focus:border-amber-400 dark:focus:ring-amber-500/20"
                                                   placeholder="مثلاً Invoice" />
                                        </div>
                                        <div class="md:col-span-2">
                                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">انتخاب فایل <span
                                                class="text-rose-500">*</span></label>
                                                <input type="file" name="File" required
                                                       class="block w-full text-xs text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-slate-700/80 rounded-xl bg-white dark:bg-slate-950 px-3 py-2 cursor-pointer outline-none transition-all focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 file:ml-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-amber-50 file:text-amber-700 dark:file:bg-amber-950/30 dark:file:text-amber-400 hover:file:bg-amber-100 dark:hover:file:bg-amber-950/50" />
                                                <p class="text-[10px] text-slate-400 mt-1">فرمت‌های مجاز: PDF, Word, Excel, تصاویر, ZIP (حداکثر ۲۰
                                                    مگابایت)</p>
                                                </div>
                                            </div>
                                            <div class="flex justify-end mt-4">
                                                <button type="button" onclick="document.getElementById('uploadPanel').classList.add('hidden')"
                                                        class="flex items-center gap-1.5 px-4 h-9 border border-slate-200/80 dark:border-slate-700/60 rounded-xl text-xs font-semibold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800 ml-2">
                                                    <i class="bi bi-x-lg"></i> انصراف
                                                </button>
                                                <button type="submit"
                                                        class="flex items-center gap-1.5 px-4 h-9 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold transition shadow-sm shadow-amber-500/20">
                                                    <i class="bi bi-check-lg"></i> آپلود و بایگانی
                                                </button>
                                            </div>
                                        </form>
                                    }
                                </div>

                                @* ── Advanced Filters Panel ── *@
                                <form id="archiveFilterForm" method="get"
                                      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 p-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
                                    <div>
                                        <label class="block text-[10px] font-bold text-slate-500 dark:text-slate-400 mb-1">جستجو</label>
                                        <input type="text" name="searchTerm" value="@searchTerm"
                                               class="h-9 w-full rounded-xl border border-slate-200/80 bg-slate-50/60 px-3 text-xs text-slate-800 outline-none transition-all placeholder:text-slate-400 focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:placeholder:text-slate-500 dark:focus:border-amber-400 dark:focus:ring-amber-500/20"
                                               placeholder="عنوان یا نام فایل..." />
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold text-slate-500 dark:text-slate-400 mb-1">دسته‌بندی</label>
                                        <select name="category"
                                                class="h-9 w-full rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700/80 dark:focus:border-amber-400 dark:focus:ring-amber-500/20">
                                            <option value="">همه دسته‌ها</option>
                                            <option value="Letters" selected="@(category == "Letters" ? "selected" : null)">نامه</option>
                                            <option value="Invoices" selected="@(category == "Invoices" ? "selected" : null)">فاکتور</option>
                                            <option value="Personnel" selected="@(category == "Personnel" ? "selected" : null)">پرسنل</option>
                                            <option value="Contracts" selected="@(category == "Contracts" ? "selected" : null)">قرارداد</option>
                                            <option value="Insurance" selected="@(category == "Insurance" ? "selected" : null)">بیمه</option>
                                            <option value="Warehouse" selected="@(category == "Warehouse" ? "selected" : null)">انبار</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold text-slate-500 dark:text-slate-400 mb-1">سطح دسترسی</label>
                                        <select name="accessLevel"
                                                class="h-9 w-full rounded-xl border border-slate-200/80 bg-white dark:bg-slate-950 px-3 text-xs text-slate-800 dark:text-slate-200 outline-none transition-all focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700/80 dark:focus:border-amber-400 dark:focus:ring-amber-500/20">
                                            <option value="">همه سطح‌ها</option>
                                            <option value="Public" selected="@(accessLevel == "Public" ? "selected" : null)">عمومی</option>
                                            <option value="Module" selected="@(accessLevel == "Module" ? "selected" : null)">درون‌ماژولی</option>
                                            <option value="Restricted" selected="@(accessLevel == "Restricted" ? "selected" : null)">محرمانه
                                            </option>
                                        </select>
                                    </div>
                                    <div class="flex items-end gap-2">
                                        <button type="submit"
                                                class="flex items-center gap-1.5 px-4 h-9 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold transition shadow-sm shadow-amber-500/20">
                                            <i class="bi bi-funnel-fill"></i> فیلتر
                                        </button>
                                        <a asp-action="Index"
                                           class="flex items-center gap-1.5 px-4 h-9 border border-slate-200/80 dark:border-slate-700/60 rounded-xl text-xs font-semibold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800 no-underline">
                                            <i class="bi bi-arrow-counterclockwise"></i> پاک کردن
                                        </a>
                                    </div>
                                </form>

                                @* ── Data Table Card ── *@
                                <div
                                    class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
                                    <div class="flex items-center justify-between px-5 py-3 border-b border-slate-100 dark:border-slate-800/60">
                                        <h5 class="m-0 text-sm font-bold text-slate-900 dark:text-white">اسناد بایگانی‌شده</h5>
                                        <span class="text-[10px] text-slate-500 dark:text-slate-400">@totalItems.ToString("N0") سند</span>
                                    </div>
                                    <div class="overflow-x-auto w-full">
                                        <table class="w-full text-xs text-right border-collapse text-slate-700 dark:text-slate-300"
                                               id="archiveTable">
                                            <thead
                                                class="sticky top-0 z-10 bg-slate-50/80 dark:bg-slate-800/60 backdrop-blur-sm border-b border-slate-100 dark:border-slate-800/60">
                                                <tr>
                                                    <th
                                                        class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                                        عنوان سند</th>
                                                        <th
                                                            class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                                            دسته</th>
                                                            <th
                                                                class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                                                سطح</th>
                                                                <th
                                                                    class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center">
                                                                    اندازه</th>
                                                                    <th
                                                                        class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center">
                                                                        ایجاد</th>
                                                                        <th
                                                                            class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 text-center w-1">
                                                                            عملیات</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60" id="archiveBody">
                                                                        @if (Model.Items.Count == 0)
                                                                        {
                                                                            <tr>
                                                                                <td colspan="6" class="px-4 py-16 text-center">
                                                                                    <div class="flex flex-col items-center gap-2">
                                                                                        <i class="bi bi-archive text-4xl text-slate-300 dark:text-slate-600"></i>
                                                                                        <span class="text-sm font-medium text-slate-500 dark:text-slate-400">سندی یافت
                                                                                            نشد</span>
                                                                                            <span class="text-[11px] text-slate-400 dark:text-slate-500">با کلیک روی دکمه «آپلود
                                                                                                سند» اولین سند خود را بایگانی کنید.</span>
                                                                                            </div>
                                                                                        </td>
                                                                                    </tr>
                                                                                }
                    else
                                                                                {
                                                                                    @foreach (var item in Model.Items)
                                                                                    {
                                                                                        var shamsiDate = item.CreatedAt.ToString("yyyy/MM/dd HH:mm");
                                                                                        var isRestricted = item.AccessLevel == "Restricted";
                                                                                        var isPublic = item.AccessLevel == "Public";

                                                                                        <tr class="archive-row-card hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors"
                                                                                            data-title="@item.Title" data-filename="@item.FileName" data-category="@item.Category"
                                                                                            data-access="@item.AccessLevel" data-creator="@item.CreatorName">
                                                                                            <td class="px-4 py-3.5 font-medium text-slate-900 dark:text-white min-w-[220px]">
                                                                                                <div class="flex items-center gap-2">
                                                                                                    @if (item.IsUnderLegalHold)
                                                                                                    {
                                                                                                        <i class="bi bi-lock-fill text-amber-500 text-xs"
                                                                                                           title="تحت نگهداری قانونی: @item.HoldReason"></i>
                                                                                                    }
                                                                                                    <div>
                                                                                                        <span class="font-bold">@item.Title</span>
                                                                                                        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                                                                                                            <span>@item.FileName</span>
                                                                                                            <span class="mx-1">·</span>
                                                                                                            <span>@item.CreatorName</span>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </td>
                                                                                            <td class="px-4 py-3.5">
                                                                                                <span
                                                                                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[10px] font-bold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                                                                                    @CategoryLabel(item.Category)
                                                                                                </span>
                                                                                            </td>
                                                                                            <td class="px-4 py-3.5">
                                                                                                @if (isRestricted)
                                                                                                {
                                                                                                    <span
                                                                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[10px] font-bold bg-rose-100 text-rose-700 dark:bg-rose-950/30 dark:text-rose-400">
                                                                                                        <i class="bi bi-shield-lock"></i> محرمانه
                                                                                                    </span>
                                                                                                }
                                                                                                else if (isPublic)
                                                                                                {
                                                                                                    <span
                                                                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-400">
                                                                                                        <i class="bi bi-globe2"></i> عمومی
                                                                                                    </span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <span
                                                                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[10px] font-bold bg-sky-100 text-sky-700 dark:bg-sky-950/30 dark:text-sky-400">
                                                                                                        <i class="bi bi-people"></i> درون‌ماژولی
                                                                                                    </span>
                                                                                                }
                                                                                            </td>
                                                                                            <td class="px-4 py-3.5 text-center">
                                                                                                <span class="text-slate-500 dark:text-slate-400">@FormatFileSize(item.FileSize)</span>
                                                                                            </td>
                                                                                            <td class="px-4 py-3.5 text-center text-slate-500 dark:text-slate-400 whitespace-nowrap">
                                                                                                @shamsiDate
                                                                                            </td>
                                                                                            <td class="px-4 py-3.5 text-center">
                                                                                                <div class="flex items-center justify-center gap-1">
                                                                                                    <a asp-action="Versions" asp-route-id="@item.Id"
                                                                                                       class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-indigo-100 hover:text-indigo-700 dark:hover:bg-indigo-950/30 dark:hover:text-indigo-400 transition no-underline"
                                                                                                       title="تاریخچه نسخه‌ها">
                                                                                                        <i class="bi bi-clock-history text-xs"></i>
                                                                                                    </a>
                                                                                                    @if (item.IsPreviewable)
                                                                                                    {
                                                                                                        <a asp-action="Preview" asp-route-id="@item.Id" target="_blank"
                                                                                                           class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-sky-100 hover:text-sky-700 dark:hover:bg-sky-950/30 dark:hover:text-sky-400 transition no-underline"
                                                                                                           title="پیش‌نمایش">
                                                                                                            <i class="bi bi-eye text-xs"></i>
                                                                                                        </a>
                                                                                                    }
                                                                                                    <a asp-action="Download" asp-route-id="@item.Id"
                                                                                                       class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-emerald-100 hover:text-emerald-700 dark:hover:bg-emerald-950/30 dark:hover:text-emerald-400 transition no-underline"
                                                                                                       title="دانلود">
                                                                                                        <i class="bi bi-download text-xs"></i>
                                                                                                    </a>
                                                                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline"
                                                                                                          onsubmit="return confirm('آیا از حذف این سند اطمینان دارید؟');">
                                                                                                        @Html.AntiForgeryToken()
                                                                                                        <button type="submit"
                                                                                                                class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-rose-100 hover:text-rose-700 dark:hover:bg-rose-950/30 dark:hover:text-rose-400 transition border-0 cursor-pointer"
                                                                                                                title="حذف">
                                                                                                            <i class="bi bi-trash3 text-xs"></i>
                                                                                                        </button>
                                                                                                    </form>
                                                                                                </div>
                                                                                            </td>
                                                                                        </tr>
                                                                                    }
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                </div>
                                                            </div>

@functions {
    string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    string CategoryLabel(string category)
    {
        return category switch
        {
            "Letters" => "نامه",
            "Invoices" => "فاکتور",
            "Personnel" => "پرسنل",
            "Contracts" => "قرارداد",
            "Insurance" => "بیمه",
            "Warehouse" => "انبار",
            _ => category
        };
    }
}

@section Scripts {
    <script>
        (function () {
            // Quick client-side search on the table
            var searchInput = document.getElementById('archiveSearch');
            if (!searchInput) return;

            searchInput.addEventListener('input', function () {
                var query = (this.value || '').trim().toLowerCase();
                var rows = document.querySelectorAll('#archiveBody .archive-row-card');
                var visible = 0;
                rows.forEach(function (row) {
                    var title = (row.getAttribute('data-title') || '').toLowerCase();
                    var filename = (row.getAttribute('data-filename') || '').toLowerCase();
                    var match = !query || title.includes(query) || filename.includes(query);
                    row.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
            });
        })();
    </script>
}
