@model OfficeAutomation.Models.WorkInboxVM
@using System.Text.Json

@{
    ViewData["Title"] = "کارتابل مرکزی";
    var itemsJson = JsonSerializer.Serialize(Model.Items);
    var assigneesJson = JsonSerializer.Serialize(Model.Assignees);
}

<div class="container-fluid py-2 space-y-2" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between px-1">
        <div>
            <h1 class="text-[16px] font-black text-slate-900 dark:text-white">کارتابل پیشرفته</h1>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">کارتابل عملیاتی با گروه‌بندی، نماهای ذخیره‌شده، اقدام‌های گروهی و پنل جزئیات سریع.</p>
        </div>
        <a class="h-7 rounded-lg border border-slate-200 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800 px-2.5 text-[11px] font-bold text-slate-700 dark:text-slate-350 transition flex items-center gap-1.5 no-underline" href="/Notifications">
            <i class="bi bi-bell"></i>
            <span>مرکز اعلان‌ها</span>
        </a>
    </div>

    <!-- Stats summary row -->
    <div class="grid grid-cols-4 sm:grid-cols-4 lg:grid-cols-7 gap-2.5">
        @{
            var filters = new[]
            {
                ("All", "همه", Model.TotalCount, "text-slate-900 dark:text-white"),
                ("Approvals", "تاییدها", Model.ApprovalCount, "text-emerald-600 dark:text-emerald-400"),
                ("Letters", "نامه‌ها", Model.LetterCount, "text-blue-600 dark:text-blue-400"),
                ("Alerts", "هشدارها", Model.AlertCount, "text-amber-600 dark:text-amber-400"),
                ("Overdue", "تاخیردار", Model.OverdueCount, "text-rose-600 dark:text-rose-400"),
                ("DueSoon", "نزدیک موعد", Model.DueSoonCount, "text-sky-600 dark:text-sky-400"),
                ("Unread", "خوانده‌نشده", Model.UnreadCount, "text-indigo-600 dark:text-indigo-400")
            };
        }
        @foreach (var f in filters)
        {
            var isActive = Model.ActiveFilter == f.Item1 || (f.Item1 == "All" && string.IsNullOrEmpty(Model.ActiveFilter));
            var activeBorderClass = isActive ? "border-teal-500 dark:border-teal-400 ring-2 ring-teal-500/10 bg-teal-50/10 dark:bg-teal-950/10" : "border-slate-200 dark:border-slate-850 bg-white dark:bg-slate-900";
            <a class="flex flex-col items-center justify-center p-2 rounded-lg border @activeBorderClass @f.Item4 shadow-sm no-underline hover:border-teal-500/50 transition duration-150" asp-action="Index" asp-route-filter="@(f.Item1 == "All" ? "" : f.Item1)">
                <strong class="text-sm font-black font-mono tabular-nums">@f.Item3.ToString("N0")</strong>
                <span class="text-[9px] text-slate-500 dark:text-slate-400 mt-0.5">@f.Item2</span>
            </a>
        }
    </div>

    @if (TempData["WorkInboxMessage"] is string inboxMessage && !string.IsNullOrWhiteSpace(inboxMessage))
    {
        <div class="flex items-center gap-2 p-2.5 bg-emerald-50 dark:bg-emerald-955/15 text-emerald-800 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50 rounded-lg text-[11px] font-semibold shadow-sm">
            <i class="bi bi-check-circle-fill text-emerald-600 dark:text-emerald-400 text-sm"></i>
            <span class="flex-1">@inboxMessage</span>
        </div>
    }
    @if (TempData["WorkInboxUnauthorized"] is string unauthorizedMessage && !string.IsNullOrWhiteSpace(unauthorizedMessage))
    {
        <div class="flex items-center gap-2 p-2.5 bg-amber-50 dark:bg-amber-955/15 text-amber-800 dark:text-amber-400 border border-amber-200 dark:border-amber-900/50 rounded-lg text-[11px] font-semibold shadow-sm">
            <i class="bi bi-exclamation-triangle-fill text-amber-600 dark:text-amber-450 text-sm"></i>
            <span class="flex-1">@unauthorizedMessage</span>
        </div>
    }
    @if (TempData["WorkInboxError"] is string errorMsg && !string.IsNullOrWhiteSpace(errorMsg))
    {
        <div class="flex items-center gap-2 p-2.5 bg-rose-50 dark:bg-rose-955/10 text-rose-800 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 rounded-lg text-[11px] font-semibold shadow-sm">
            <i class="bi bi-x-circle-fill text-rose-600 dark:text-rose-400 text-sm"></i>
            <span class="flex-1">@errorMsg</span>
        </div>
    }

    <!-- Main Workspace Container -->
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-3.5 overflow-x-auto inbox-workspace"
         data-items='@Html.Raw(itemsJson)'
         data-assignees='@Html.Raw(assigneesJson)'>
        <form asp-action="BulkAction" method="post" class="space-y-3" id="bulkActionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Filter" value="@Model.ActiveFilter" />

            <!-- Filters Controls Header -->
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-2.5 p-3 bg-slate-50 dark:bg-slate-950/40 rounded-lg border border-slate-200 dark:border-slate-850">
                <div class="lg:col-span-2 relative">
                    <input type="search" id="inboxSearchInput" class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg pr-9 pl-3 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="جستجو در عنوان، ماژول، فرستنده یا وضعیت..." />
                    <i class="bi bi-search absolute right-3 top-2 text-slate-400 text-xs"></i>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" id="groupBySelect">
                        <option value="none">بدون گروه‌بندی</option>
                        <option value="module">گروه بر اساس ماژول</option>
                        <option value="status">گروه بر اساس وضعیت</option>
                        <option value="sla">گروه بر اساس سطح خدمت</option>
                        <option value="priority">گروه بر اساس اولویت</option>
                    </select>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" id="moduleFilterSelect">
                        <option value="">همه ماژول‌ها</option>
                    </select>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" id="statusFilterSelect">
                        <option value="">همه وضعیت‌ها</option>
                    </select>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-2 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" id="readFilterSelect">
                        <option value="">خواندن: همه</option>
                        <option value="unread">فقط خوانده‌نشده</option>
                        <option value="read">فقط خوانده‌شده</option>
                    </select>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-2 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" id="actionFilterSelect">
                        <option value="">اقدام: همه</option>
                        <option value="required">نیازمند اقدام</option>
                        <option value="high">اولویت بالا</option>
                    </select>
                </div>
            </div>

            <!-- Saved Views Section -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800/80 pb-3">
                <div class="flex items-center gap-2">
                    <strong class="text-xs font-black text-slate-800 dark:text-slate-200">نماهای ذخیره‌شده</strong>
                    <button class="h-7 rounded-lg border border-slate-200 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800 px-2 text-[10px] font-bold text-slate-700 dark:text-slate-350 transition" type="button" id="saveCurrentViewBtn">ذخیره نمای فعلی</button>
                </div>
                <div class="flex flex-wrap gap-1.5" id="savedViewsList"></div>
            </div>

            <!-- Bulk Operation Toolbar -->
            <div class="flex flex-col lg:flex-row items-center gap-3 p-3 bg-slate-50 dark:bg-slate-950/20 rounded-lg border border-slate-200 dark:border-slate-800/60">
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 dark:text-slate-300 cursor-pointer">
                    <input type="checkbox" id="inboxSelectAll" class="rounded border-slate-300 dark:border-slate-800 text-teal-600 focus:ring-teal-500/20" />
                    <span>انتخاب همه</span>
                </label>
                <div class="text-[10px] text-slate-500 dark:text-slate-400 font-bold border-l border-slate-200 dark:border-slate-800 pl-3 ml-1" id="selectionMeta">0 مورد انتخاب شده</div>
                <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto lg:flex-1">
                    <select class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none w-32" name="Action" id="bulkActionSelect" required>
                        <option value="">انتخاب عملیات</option>
                        <option value="approve">تایید گروهی</option>
                        <option value="reject">رد گروهی</option>
                        <option value="mark-read">خوانده شد</option>
                        <option value="mark-unread">خوانده نشده</option>
                        <option value="delegate">واگذاری</option>
                    </select>
                    <select class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none w-32" name="ToUserId" id="bulkAssigneeSelect">
                        <option value="">کاربر مقصد</option>
                        @foreach (var assignee in Model.Assignees)
                        {
                            <option value="@assignee.UserId">@assignee.DisplayName</option>
                        }
                    </select>
                    <input class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none flex-1 min-w-[150px]" name="Note" id="bulkNoteInput" placeholder="یادداشت مشترک برای اقدام گروهی..." />
                    <button class="bg-teal-600 hover:bg-teal-700 text-white px-2.5 py-1.5 rounded-lg text-xs font-bold transition-colors" type="submit">
                        <i class="bi bi-check2-square"></i>
                        <span>اجرا</span>
                    </button>
                </div>
            </div>

            <!-- Workspace Layout (List + Detail) -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 align-start">
                <div class="lg:col-span-2 space-y-2">
                    @if (Model.Items.Count == 0)
                    {
                        <div class="p-4 text-center text-xs text-slate-400 bg-slate-50 dark:bg-slate-950/20 border border-slate-200 dark:border-slate-800 rounded-xl">فعلاً موردی برای این فیلتر وجود ندارد.</div>
                    }
                    else
                    {
                        <div id="inboxGroupsHost" class="space-y-2"></div>
                    }
                </div>

                <aside class="bg-slate-50 dark:bg-slate-950/20 border border-slate-200 dark:border-slate-800 rounded-lg p-2.5 min-h-[300px]" id="inboxDetailPane">
                    <div class="flex flex-col items-center justify-center text-center p-4 text-slate-400 h-full" id="detailEmptyState">
                        <i class="bi bi-layout-sidebar-inset text-lg mb-2 text-slate-300 dark:text-slate-700"></i>
                        <strong class="text-xs text-slate-700 dark:text-slate-350">یک آیتم را انتخاب کنید</strong>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">جزئیات، اقدام سریع و کامنت اینلاین اینجا نمایش داده می‌شود.</p>
                    </div>

                    <div class="hidden flex flex-col h-full gap-3" id="detailCard">
                        <div class="flex-1 space-y-3">
                            <div class="text-[10px] font-bold text-teal-600 dark:text-teal-400" id="detailEyebrow"></div>
                            <h2 class="text-sm font-black text-slate-900 dark:text-white" id="detailTitle"></h2>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed" id="detailSummary"></p>

                            <div class="grid grid-cols-2 gap-2 text-[10px] bg-white dark:bg-slate-900 p-3 rounded-lg border border-slate-150 dark:border-slate-800">
                                <div class="flex flex-col"><span class="text-slate-400">ماژول</span><strong class="text-slate-700 dark:text-slate-300 mt-0.5" id="detailModule"></strong></div>
                                <div class="flex flex-col"><span class="text-slate-400">وضعیت</span><strong class="text-slate-700 dark:text-slate-300 mt-0.5" id="detailStatus"></strong></div>
                                <div class="flex flex-col"><span class="text-slate-400">موعد</span><strong class="text-slate-700 dark:text-slate-300 mt-0.5" id="detailSla"></strong></div>
                                <div class="flex flex-col"><span class="text-slate-400">زمان ایجاد</span><strong class="text-slate-700 dark:text-slate-300 mt-0.5 font-mono" id="detailCreatedAt"></strong></div>
                            </div>

                            <div class="flex flex-wrap gap-1" id="detailChips"></div>

                            <div class="pt-3">
                                <a class="w-full h-8 rounded-lg border border-slate-200 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-350 transition flex items-center justify-center gap-1.5 no-underline" id="detailOpenLink" href="#" target="_self">
                                    <i class="bi bi-box-arrow-up-left"></i>
                                    <span>باز کردن جزئیات</span>
                                </a>
                            </div>
                        </div>

                        <div class="border-t border-slate-200 dark:border-slate-800 pt-2 space-y-3" id="detailStickyBar">
                            <!-- Case Task Inline Processing Actions -->
                            <div id="caseTaskActionArea" class="hidden space-y-2">
                                <div class="text-[10px] font-bold text-amber-500 mb-1">اقدامات مربوط به وظیفه جاری:</div>
                                <div class="flex gap-2">
                                    <button type="button" class="btn-process-task flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-2 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1" data-action="Approve">
                                        <i class="bi bi-check2-circle"></i>
                                        <span>تایید</span>
                                    </button>
                                    <button type="button" class="btn-process-task flex-1 bg-rose-600 hover:bg-rose-700 text-white py-2 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1" data-action="Reject">
                                        <i class="bi bi-x-circle"></i>
                                        <span>رد</span>
                                    </button>
                                </div>
                            </div>

                            <form asp-action="Decide" method="post" class="hidden" id="quickApproveForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="documentType" id="quickApproveDocumentType" />
                                <input type="hidden" name="documentId" id="quickApproveDocumentId" />
                                <input type="hidden" name="stepNumber" id="quickApproveStepNumber" />
                                <input type="hidden" name="decisionType" value="Approve" />
                                <input type="hidden" name="note" value="تایید از کارتابل" />
                                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-2 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>تایید یک‌کلیکی</span>
                                </button>
                            </form>

                            <form asp-action="Decide" method="post" class="hidden flex gap-2" id="quickRejectForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="documentType" id="quickRejectDocumentType" />
                                <input type="hidden" name="documentId" id="quickRejectDocumentId" />
                                <input type="hidden" name="stepNumber" id="quickRejectStepNumber" />
                                <input type="hidden" name="decisionType" value="Reject" />
                                <input type="text" name="note" class="flex-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="دلیل رد..." />
                                <button type="submit" class="border border-rose-600 hover:bg-rose-50 dark:hover:bg-rose-955/20 text-rose-600 px-3 py-1.5 rounded-lg text-xs font-bold transition">رد</button>
                            </form>

                            <form asp-action="AddComment" method="post" class="hidden flex gap-2" id="quickCommentForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="documentType" id="quickCommentDocumentType" />
                                <input type="hidden" name="documentId" id="quickCommentDocumentId" />
                                <input type="hidden" name="workflowStepId" id="quickCommentWorkflowStepId" />
                                <input type="text" name="body" class="flex-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="ثبت کامنت اینلاین..." />
                                <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-800 dark:hover:bg-slate-700 px-3 py-1.5 rounded-lg text-xs font-bold transition">کامنت</button>
                            </form>

                            <form asp-action="Delegate" method="post" class="hidden flex flex-col gap-2" id="quickDelegateForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="workflowStepId" id="quickDelegateWorkflowStepId" />
                                <div class="flex gap-2">
                                    <select name="toUserId" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-2 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none w-1/3" id="quickDelegateToUserId">
                                        @foreach (var assignee in Model.Assignees)
                                        {
                                            <option value="@assignee.UserId">@assignee.DisplayName</option>
                                        }
                                    </select>
                                    <input type="text" name="note" class="flex-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-1.5 text-xs focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="یادداشت واگذاری..." />
                                    <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-800 dark:hover:bg-slate-700 px-3 py-1.5 rounded-lg text-xs font-bold transition">واگذاری</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </aside>
            </div>
        </form>
    </div>
</div>

@section Styles {
}

@section Scripts {
    <script>
        (async () => {
            const workspace = document.querySelector('.inbox-workspace');
            if (!workspace) return;

            const items = JSON.parse(workspace.dataset.items || '[]');
            const assignees = JSON.parse(workspace.dataset.assignees || '[]');
            const groupsHost = document.getElementById('inboxGroupsHost');
            const searchInput = document.getElementById('inboxSearchInput');
            const groupBySelect = document.getElementById('groupBySelect');
            const moduleFilterSelect = document.getElementById('moduleFilterSelect');
            const statusFilterSelect = document.getElementById('statusFilterSelect');
            const readFilterSelect = document.getElementById('readFilterSelect');
            const actionFilterSelect = document.getElementById('actionFilterSelect');
            const savedViewsList = document.getElementById('savedViewsList');
            const saveCurrentViewBtn = document.getElementById('saveCurrentViewBtn');
            const selectAll = document.getElementById('inboxSelectAll');
            const selectionMeta = document.getElementById('selectionMeta');
            const actionSelect = document.getElementById('bulkActionSelect');
            const assigneeSelect = document.getElementById('bulkAssigneeSelect');
            const noteInput = document.getElementById('bulkNoteInput');

            const detailEmptyState = document.getElementById('detailEmptyState');
            const detailCard = document.getElementById('detailCard');
            const detailEyebrow = document.getElementById('detailEyebrow');
            const detailTitle = document.getElementById('detailTitle');
            const detailSummary = document.getElementById('detailSummary');
            const detailModule = document.getElementById('detailModule');
            const detailStatus = document.getElementById('detailStatus');
            const detailSla = document.getElementById('detailSla');
            const detailCreatedAt = document.getElementById('detailCreatedAt');
            const detailChips = document.getElementById('detailChips');
            const detailOpenLink = document.getElementById('detailOpenLink');

            const quickApproveForm = document.getElementById('quickApproveForm');
            const quickRejectForm = document.getElementById('quickRejectForm');
            const quickCommentForm = document.getElementById('quickCommentForm');
            const quickDelegateForm = document.getElementById('quickDelegateForm');

            const antiForgeryToken = document.querySelector('#bulkActionForm input[name="__RequestVerificationToken"]')?.value || '';
            const preferenceEndpoint = '/api/saved-views/WorkInbox';
            const storageKey = 'workInbox.savedViews.v2';
            const allowedIconPattern = /^bi-[a-z0-9-]+$/i;
            const allowedBadgePattern = /^(badge\s+)?text-bg-[a-z-]+$/i;
            const allowedPriorityPattern = /^inbox-priority-(high|normal)$/i;
            const state = {
                search: '',
                groupBy: 'none',
                module: '',
                status: '',
                read: '',
                action: '',
                selectedIds: new Set(),
                activeItemId: null
            };

            function uniqueValues(field) {
                return [...new Set(items.map(item => item[field]).filter(Boolean))].sort((a, b) => a.localeCompare(b));
            }

            function fillSelect(select, values) {
                values.forEach(value => {
                    const option = document.createElement('option');
                    option.value = value;
                    option.textContent = value;
                    select.appendChild(option);
                });
            }

            fillSelect(moduleFilterSelect, uniqueValues('module'));
            fillSelect(statusFilterSelect, uniqueValues('status'));

            function getSavedViews() {
                try {
                    return JSON.parse(localStorage.getItem(storageKey) || '[]');
                } catch {
                    return [];
                }
            }

            function setSavedViews(views) {
                localStorage.setItem(storageKey, JSON.stringify(views));
            }

            async function loadSavedViews() {
                try {
                    const response = await fetch(preferenceEndpoint, { credentials: 'same-origin' });
                    const payload = response.ok ? await response.json() : [];
                    const views = Array.isArray(payload)
                        ? payload.map(item => {
                            try {
                                return { name: item.name, state: JSON.parse(item.filterQueryJson || '{}') };
                            } catch {
                                return null;
                            }
                        }).filter(Boolean)
                        : [];

                    if (views.length > 0) {
                        setSavedViews(views);
                        return views;
                    }
                } catch {
                }

                return getSavedViews();
            }

            async function persistSavedViews(views) {
                setSavedViews(views);
                try {
                    await Promise.all(views.map(view => fetch(preferenceEndpoint, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            ...(antiForgeryToken ? { RequestVerificationToken: antiForgeryToken } : {})
                        },
                        body: JSON.stringify({
                            name: view.name,
                            targetGridId: 'WorkInbox',
                            filterQueryJson: JSON.stringify(view.state),
                            columnLayoutJson: '[]'
                        })
                    })));
                } catch {
                }
            }

            function sanitizeIcon(icon) {
                return allowedIconPattern.test(icon || '') ? icon : 'bi-circle';
            }

            function sanitizeBadgeClass(className) {
                return allowedBadgePattern.test(className || '') ? className : 'text-bg-secondary';
            }

            function sanitizePriorityClass(className) {
                return allowedPriorityPattern.test(className || '') ? className : 'inbox-priority-normal';
            }

            function sanitizeUrl(url) {
                if (!url || typeof url !== 'string') return '#';
                return /^(\/|https?:\/\/)/i.test(url) ? url : '#';
            }

            function escapeHtml(value) {
                return `${value ?? ''}`
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#39;');
            }

            function renderSavedViews(views = getSavedViews()) {
                savedViewsList.replaceChildren();

                if (views.length === 0) {
                    const empty = document.createElement('span');
                    empty.className = 'saved-view-empty';
                    empty.textContent = 'هیچ نمای ذخیره‌شده‌ای وجود ندارد.';
                    savedViewsList.appendChild(empty);
                    return;
                }

                views.forEach(view => {
                    const chip = document.createElement('div');
                    chip.className = 'saved-view-chip';

                    const apply = document.createElement('button');
                    apply.type = 'button';
                    apply.className = 'btn btn-sm btn-light';
                    apply.textContent = view.name;
                    apply.addEventListener('click', () => {
                        Object.assign(state, view.state);
                        syncControls();
                        renderInbox();
                    });

                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'btn btn-sm btn-link text-danger';
                    const removeIcon = document.createElement('i');
                    removeIcon.className = 'bi bi-x-lg';
                    remove.appendChild(removeIcon);
                    remove.addEventListener('click', async () => {
                        const nextViews = getSavedViews().filter(item => item.name !== view.name);
                        setSavedViews(nextViews);
                        try {
                            await fetch(`${preferenceEndpoint}/${encodeURIComponent(view.name)}`, {
                                method: 'DELETE',
                                credentials: 'same-origin',
                                headers: antiForgeryToken ? { RequestVerificationToken: antiForgeryToken } : {}
                            });
                        } catch {
                        }
                        renderSavedViews(nextViews);
                    });

                    chip.append(apply, remove);
                    savedViewsList.appendChild(chip);
                });
            }

            function syncControls() {
                searchInput.value = state.search;
                groupBySelect.value = state.groupBy;
                moduleFilterSelect.value = state.module;
                statusFilterSelect.value = state.status;
                readFilterSelect.value = state.read;
                actionFilterSelect.value = state.action;
            }

            function passesFilters(item) {
                const searchText = `${item.searchText || ''}`.toLowerCase();
                if (state.search && !searchText.includes(state.search.toLowerCase())) return false;
                if (state.module && item.module !== state.module) return false;
                if (state.status && item.status !== state.status) return false;
                if (state.read === 'read' && !item.isRead) return false;
                if (state.read === 'unread' && item.isRead) return false;
                if (state.action === 'required' && !item.requiresAction) return false;
                if (state.action === 'high' && item.priority !== 'High') return false;
                return true;
            }

            function getGroupName(item) {
                switch (state.groupBy) {
                    case 'module': return item.groupLabel || item.module;
                    case 'status': return item.status;
                    case 'sla': return item.slaState;
                    case 'priority': return item.priority;
                    default: return 'همه موارد';
                }
            }

            function updateSelectionMeta() {
                selectionMeta.textContent = `${state.selectedIds.size} مورد انتخاب شده`;
            }

            function updateBulkFieldRules() {
                const value = actionSelect.value || '';
                assigneeSelect.required = value === 'delegate';
                assigneeSelect.disabled = value !== 'delegate';
                noteInput.required = value === 'reject';
            }

            function renderDetail(item) {
                if (!item) {
                    detailEmptyState.classList.remove('d-none');
                    detailCard.classList.add('d-none');
                    return;
                }

                detailEmptyState.classList.add('d-none');
                detailCard.classList.remove('d-none');

                detailEyebrow.textContent = item.detailCaption || item.type;
                detailTitle.textContent = item.detailTitle || item.title;
                detailSummary.textContent = item.detailSummary || item.description;
                detailModule.textContent = item.module;
                detailStatus.textContent = item.status;
                detailSla.textContent = item.slaText || '-';
                detailCreatedAt.textContent = item.createdAtText;
                detailOpenLink.href = sanitizeUrl(item.url);

                detailChips.replaceChildren();
                [item.priority, item.requiresAction ? 'نیازمند اقدام' : '', !item.isRead ? 'خوانده‌نشده' : '', item.isOverdue ? 'نقض سطح خدمت' : '']
                    .filter(Boolean)
                    .forEach(label => {
                        const chip = document.createElement('span');
                        chip.className = 'detail-chip';
                        chip.textContent = label;
                        detailChips.appendChild(chip);
                    });

                const caseTaskActionArea = document.getElementById('caseTaskActionArea');
                const isCaseTask = item.id.startsWith('case-task-');

                if (isCaseTask && caseTaskActionArea) {
                    caseTaskActionArea.classList.remove('d-none');
                    // Set up click listeners for the process buttons
                    const btnProcessList = caseTaskActionArea.querySelectorAll('.btn-process-task');
                    btnProcessList.forEach(btn => {
                        // Remove old click listeners to prevent duplicates
                        const newBtn = btn.cloneNode(true);
                        btn.parentNode.replaceChild(newBtn, btn);

                        newBtn.addEventListener('click', async (e) => {
                            e.preventDefault();
                            const action = newBtn.dataset.action;
                            const taskIdStr = item.id.replace('case-task-', '');
                            const taskId = parseInt(taskIdStr);

                            // Show spinner
                            const originalText = newBtn.innerHTML;
                            newBtn.disabled = true;
                            newBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> در حال اقدام...';

                            try {
                                const response = await fetch('/WorkInbox/ProcessTask', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded',
                                        'RequestVerificationToken': antiForgeryToken
                                    },
                                    body: `taskId=${taskId}&triggerAction=${action}`
                                });

                                const result = await response.json();
                                if (result.success) {
                                    alert(result.message);
                                    // Remove the item from list DOM dynamically
                                    const rowToRemove = document.querySelector(`[data-item-id="${item.id}"]`);
                                    if (rowToRemove) {
                                        rowToRemove.remove();
                                    }
                                    // Remove from array state to update counters
                                    const idx = items.findIndex(i => i.id === item.id);
                                    if (idx > -1) {
                                        items.splice(idx, 1);
                                    }
                                    // Re-render
                                    renderInbox();
                                } else {
                                    alert('خطا: ' + result.message);
                                }
                            } catch (err) {
                                alert('بروز خطا در برقراری ارتباط با سرور.');
                            } finally {
                                newBtn.disabled = false;
                                newBtn.innerHTML = originalText;
                            }
                        });
                    });

                    // Hide regular forms
                    quickApproveForm.classList.add('d-none');
                    quickRejectForm.classList.add('d-none');
                    quickCommentForm.classList.add('d-none');
                    quickDelegateForm.classList.add('d-none');
                } else {
                    if (caseTaskActionArea) {
                        caseTaskActionArea.classList.add('d-none');
                    }
                    quickApproveForm.classList.toggle('d-none', !item.canInlineApprove || !item.documentType || !item.documentId || !item.stepNumber);
                    quickRejectForm.classList.toggle('d-none', !item.canInlineReject || !item.documentType || !item.documentId || !item.stepNumber);
                    quickCommentForm.classList.toggle('d-none', !item.canInlineComment || !item.documentType || !item.documentId);
                    quickDelegateForm.classList.toggle('d-none', !item.canInlineDelegate || !item.workflowStepId);
                }

                if (item.documentType) {
                    document.getElementById('quickApproveDocumentType').value = item.documentType;
                    document.getElementById('quickRejectDocumentType').value = item.documentType;
                    document.getElementById('quickCommentDocumentType').value = item.documentType;
                }
                if (item.documentId) {
                    document.getElementById('quickApproveDocumentId').value = item.documentId;
                    document.getElementById('quickRejectDocumentId').value = item.documentId;
                    document.getElementById('quickCommentDocumentId').value = item.documentId;
                }
                if (item.stepNumber) {
                    document.getElementById('quickApproveStepNumber').value = item.stepNumber;
                    document.getElementById('quickRejectStepNumber').value = item.stepNumber;
                }
                document.getElementById('quickCommentWorkflowStepId').value = item.workflowStepId || '';
                document.getElementById('quickDelegateWorkflowStepId').value = item.workflowStepId || '';
            }

            function renderInbox() {
                const filteredItems = items.filter(passesFilters);
                const groups = filteredItems.reduce((acc, item) => {
                    const key = getGroupName(item);
                    acc[key] ??= [];
                    acc[key].push(item);
                    return acc;
                }, {});

                groupsHost.replaceChildren();

                if (filteredItems.length === 0) {
                    groupsHost.innerHTML = '<div class="empty-state">No matching items found.</div>';
                    renderDetail(null);
                    updateSelectionMeta();
                    return;
                }

                Object.entries(groups).forEach(([groupName, groupItems]) => {
                    const section = document.createElement('section');
                    section.className = 'inbox-group';

                    const header = document.createElement('div');
                    header.className = 'flex items-center justify-between px-3 py-2 bg-slate-100/60 dark:bg-slate-950/40 rounded-lg text-xs font-black text-slate-700 dark:text-slate-300 mb-2';
                    header.innerHTML = `<span>${escapeHtml(groupName)}</span><span class="font-mono text-[10px] bg-slate-200/60 dark:bg-slate-800 px-2 py-0.5 rounded-full">${groupItems.length} مورد</span>`;

                    const body = document.createElement('div');
                    body.className = 'inbox-list flex flex-col divide-y divide-slate-100 dark:divide-slate-850';

                    groupItems.forEach(item => {
                        const row = document.createElement('article');
                        row.className = `flex items-center justify-between p-4 border-b border-slate-100 dark:border-slate-800/50 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors ${sanitizePriorityClass(item.priorityCssClass)}${state.activeItemId === item.id ? ' bg-teal-50/30 dark:bg-teal-950/20' : ''}`;
                        row.dataset.itemId = item.id;

                        const checked = state.selectedIds.has(item.id) ? 'checked' : '';
                        const unread = !item.isRead ? '<span class="inline-flex items-center rounded bg-rose-50 px-1.5 py-0.5 text-[9px] font-bold text-rose-700 dark:bg-rose-950/30 dark:text-rose-350 border border-rose-200 dark:border-rose-900/30">خوانده‌نشده</span>' : '<span class="inline-flex items-center rounded bg-slate-50 px-1.5 py-0.5 text-[9px] font-bold text-slate-550 dark:bg-slate-800 dark:text-slate-400 border border-slate-200 dark:border-slate-700">خوانده‌شده</span>';
                        const overdue = item.isOverdue ? '<span class="inline-flex items-center rounded bg-rose-100 px-1.5 py-0.5 text-[9px] font-bold text-rose-800 dark:bg-rose-900/40 dark:text-rose-300">نقض سطح خدمت</span>' : '';
                        const actionFlag = item.requiresAction ? '<span class="inline-flex items-center rounded bg-amber-50 px-1.5 py-0.5 text-[9px] font-bold text-amber-700 dark:bg-amber-950/20 dark:text-amber-450 border border-amber-250/30">نیازمند اقدام</span>' : '';

                        row.innerHTML = `
                            <input class="form-check-input inbox-item-check ml-3 rounded border-slate-300 dark:border-slate-800 text-teal-600 focus:ring-teal-500/20" type="checkbox" name="SelectedIds" value="${item.id}" ${checked} />
                            <button type="button" class="inbox-item-surface flex-1 flex items-center justify-between text-right border-0 bg-transparent p-0 outline-none w-full">
                                <div class="flex items-center gap-3 w-full">
                                    <span class="inbox-item-icon grid h-9 w-9 place-items-center rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-550 dark:text-slate-400"><i class="bi ${sanitizeIcon(item.icon)}"></i></span>
                                    <div class="inbox-item-body min-w-0 flex-1">
                                        <div class="inbox-title-row flex items-baseline justify-between">
                                            <strong class="text-xs font-black text-slate-900 dark:text-white">${escapeHtml(item.title)}</strong>
                                            <small class="text-[10px] text-slate-400 dark:text-slate-500 mr-2">${escapeHtml(item.createdAtText)}</small>
                                        </div>
                                        <div class="inbox-description text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5">${escapeHtml(item.description)}</div>
                                        <div class="inbox-meta flex items-center gap-1.5 flex-wrap mt-1 text-[10px] text-slate-450">
                                            <em class="font-bold not-italic bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-slate-600 dark:text-slate-300">${escapeHtml(item.module)}</em>
                                            <span class="badge ${sanitizeBadgeClass(item.statusCssClass)}">${escapeHtml(item.status)}</span>
                                            <span class="badge text-bg-light">${escapeHtml(item.slaText)}</span>
                                            ${unread}
                                            ${overdue}
                                            ${actionFlag}
                                        </div>
                                    </div>
                                </div>
                            </button>
                            <a class="inbox-open-icon text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 mr-3" href="${sanitizeUrl(item.url)}" aria-label="Open ${escapeHtml(item.title)}">
                                <i class="bi bi-arrow-left-short text-lg"></i>
                            </a>`;

                        const checkbox = row.querySelector('.inbox-item-check');
                        checkbox.addEventListener('change', () => {
                            if (checkbox.checked) state.selectedIds.add(item.id);
                            else state.selectedIds.delete(item.id);
                            updateSelectionMeta();
                        });

                        row.querySelector('.inbox-item-surface').addEventListener('click', () => {
                            state.activeItemId = item.id;
                            renderInbox();
                            renderDetail(item);
                        });

                        body.appendChild(row);
                    });

                    section.append(header, body);
                    groupsHost.appendChild(section);
                });

                const activeItem = filteredItems.find(item => item.id === state.activeItemId) || filteredItems[0];
                state.activeItemId = activeItem?.id || null;
                renderDetail(activeItem || null);
                updateSelectionMeta();
            }

            selectAll.addEventListener('change', () => {
                const currentRows = groupsHost.querySelectorAll('.inbox-item-check');
                currentRows.forEach(check => {
                    check.checked = selectAll.checked;
                    if (selectAll.checked) state.selectedIds.add(check.value);
                    else state.selectedIds.delete(check.value);
                });
                updateSelectionMeta();
            });

            searchInput.addEventListener('input', () => { state.search = searchInput.value.trim(); renderInbox(); });
            groupBySelect.addEventListener('change', () => { state.groupBy = groupBySelect.value; renderInbox(); });
            moduleFilterSelect.addEventListener('change', () => { state.module = moduleFilterSelect.value; renderInbox(); });
            statusFilterSelect.addEventListener('change', () => { state.status = statusFilterSelect.value; renderInbox(); });
            readFilterSelect.addEventListener('change', () => { state.read = readFilterSelect.value; renderInbox(); });
            actionFilterSelect.addEventListener('change', () => { state.action = actionFilterSelect.value; renderInbox(); });
            actionSelect.addEventListener('change', updateBulkFieldRules);

            saveCurrentViewBtn.addEventListener('click', async () => {
                const name = prompt('نام نمای ذخیره‌شده را وارد کنید');
                if (!name) return;
                const views = getSavedViews().filter(item => item.name !== name);
                views.push({ name, state: { ...state, selectedIds: [] } });
                await persistSavedViews(views);
                renderSavedViews(views);
            });

            syncControls();
            updateBulkFieldRules();
            renderSavedViews(await loadSavedViews());
            renderInbox();
        })();
    </script>
}



