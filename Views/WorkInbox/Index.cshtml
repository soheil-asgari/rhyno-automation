@model OfficeAutomation.Models.WorkInboxVM
@using System.Text.Json

@{
    ViewData["Title"] = "کارتابل مرکزی";
    var itemsJson = JsonSerializer.Serialize(Model.Items);
    var assigneesJson = JsonSerializer.Serialize(Model.Assignees);
}

<div class="w-full flex-1 flex flex-col gap-5 p-3 md:p-4" dir="rtl">
    <!-- Header -->
    <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm">
        <div>
            <h1 class="m-0 text-lg font-black text-slate-900 dark:text-white tracking-tight">کارتابل پیشرفته</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">کارتابل عملیاتی با گروه‌بندی، نماهای ذخیره‌شده، اقدام‌های گروهی و پنل جزئیات سریع.</p>
        </div>
        <a class="flex items-center gap-1.5 px-4 h-9 rounded-xl border border-slate-200/80 hover:bg-slate-50 dark:border-slate-700/60 dark:hover:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 transition no-underline" href="/Notifications">
            <i class="bi bi-bell"></i>
            <span>مرکز اعلان‌ها</span>
        </a>
    </header>

    <!-- Stats summary row -->
    <div class="grid grid-cols-4 sm:grid-cols-4 lg:grid-cols-7 gap-2.5">
        @{
            var filters = new[]
            {
                ("All", "همه", Model.TotalCount, "text-slate-900 dark:text-white"),
                ("Approvals", "تاییدها", Model.ApprovalCount, "text-emerald-600 dark:text-emerald-400"),
                ("Letters", "نامه‌ها", Model.LetterCount, "text-blue-600 dark:text-blue-400"),
                ("Alerts", "هشدارها", Model.AlertCount, "text-amber-600 dark:text-amber-400"),
                ("Overdue", "تاخیردار", Model.OverdueCount, "text-rose-600 dark:text-rose-400"),
                ("DueSoon", "نزدیک موعد", Model.DueSoonCount, "text-sky-600 dark:text-sky-400"),
                ("Unread", "خوانده‌نشده", Model.UnreadCount, "text-indigo-600 dark:text-indigo-400")
            };
        }
        @foreach (var f in filters)
        {
            var isActive = Model.ActiveFilter == f.Item1 || (f.Item1 == "All" && string.IsNullOrEmpty(Model.ActiveFilter));
            var activeBorderClass = isActive ? "border-indigo-500 dark:border-indigo-400 ring-2 ring-indigo-500/10 bg-indigo-50/10 dark:bg-indigo-950/10" : "border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900";
            <a class="flex flex-col items-center justify-center p-2.5 rounded-xl border @activeBorderClass @f.Item4 shadow-sm no-underline hover:border-indigo-500/50 transition duration-200" asp-action="Index" asp-route-filter="@(f.Item1 == "All" ? "" : f.Item1)">
                <strong class="text-sm font-black font-mono tabular-nums">@f.Item3.ToString("N0")</strong>
                <span class="text-[9px] text-slate-500 dark:text-slate-400 mt-0.5">@f.Item2</span>
            </a>
        }
    </div>

    @if (TempData["WorkInboxMessage"] is string inboxMessage && !string.IsNullOrWhiteSpace(inboxMessage))
    {
        <div class="flex items-center gap-2 p-3.5 bg-emerald-50/80 dark:bg-emerald-950/20 text-emerald-800 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-900/40 rounded-2xl text-xs font-semibold shadow-sm">
            <i class="bi bi-check-circle-fill text-emerald-600 dark:text-emerald-400 text-sm"></i>
            <span class="flex-1">@inboxMessage</span>
        </div>
    }
    @if (TempData["WorkInboxUnauthorized"] is string unauthorizedMessage && !string.IsNullOrWhiteSpace(unauthorizedMessage))
    {
        <div class="flex items-center gap-2 p-3.5 bg-amber-50/80 dark:bg-amber-950/15 text-amber-800 dark:text-amber-400 border border-amber-200/60 dark:border-amber-900/40 rounded-2xl text-xs font-semibold shadow-sm">
            <i class="bi bi-exclamation-triangle-fill text-amber-600 dark:text-amber-400 text-sm"></i>
            <span class="flex-1">@unauthorizedMessage</span>
        </div>
    }
    @if (TempData["WorkInboxError"] is string errorMsg && !string.IsNullOrWhiteSpace(errorMsg))
    {
        <div class="flex items-center gap-2 p-3.5 bg-rose-50/80 dark:bg-rose-950/10 text-rose-800 dark:text-rose-400 border border-rose-200/60 dark:border-rose-900/40 rounded-2xl text-xs font-semibold shadow-sm">
            <i class="bi bi-x-circle-fill text-rose-600 dark:text-rose-400 text-sm"></i>
            <span class="flex-1">@errorMsg</span>
        </div>
    }

    <!-- Main Workspace Container -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200/80 dark:border-slate-800 p-4 overflow-x-auto inbox-workspace"
         data-items='@Html.Raw(itemsJson)'
         data-assignees='@Html.Raw(assigneesJson)'>
        <form asp-action="BulkAction" method="post" class="space-y-4" id="bulkActionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Filter" value="@Model.ActiveFilter" />

            <!-- Filters Controls Header -->
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-3 p-4 bg-slate-50/80 dark:bg-slate-950/40 rounded-xl border border-slate-200/80 dark:border-slate-800">
                <div class="lg:col-span-2 relative">
                    <input type="search" id="inboxSearchInput" class="w-full bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl pr-10 pl-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400 dark:placeholder:text-slate-500" placeholder="جستجو در عنوان، ماژول، فرستنده یا وضعیت..." />
                    <i class="bi bi-search absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all" id="groupBySelect">
                        <option value="none">بدون گروه‌بندی</option>
                        <option value="module">گروه بر اساس ماژول</option>
                        <option value="status">گروه بر اساس وضعیت</option>
                        <option value="sla">گروه بر اساس سطح خدمت</option>
                        <option value="priority">گروه بر اساس اولویت</option>
                    </select>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all" id="moduleFilterSelect">
                        <option value="">همه ماژول‌ها</option>
                    </select>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all" id="statusFilterSelect">
                        <option value="">همه وضعیت‌ها</option>
                    </select>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all" id="readFilterSelect">
                        <option value="">خواندن: همه</option>
                        <option value="unread">فقط خوانده‌نشده</option>
                        <option value="read">فقط خوانده‌شده</option>
                    </select>
                </div>
                <div>
                    <select class="w-full bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all" id="actionFilterSelect">
                        <option value="">اقدام: همه</option>
                        <option value="required">نیازمند اقدام</option>
                        <option value="high">اولویت بالا</option>
                    </select>
                </div>
            </div>

            <!-- Saved Views Section -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100/80 dark:border-slate-800/60 pb-3">
                <div class="flex items-center gap-2">
                    <strong class="text-xs font-black text-slate-800 dark:text-slate-200">نماهای ذخیره‌شده</strong>
                    <button class="h-8 rounded-xl border border-slate-200/80 hover:bg-slate-50 dark:border-slate-700/60 dark:hover:bg-slate-800 px-3 text-[10px] font-bold text-slate-700 dark:text-slate-300 transition" type="button" id="saveCurrentViewBtn">ذخیره نمای فعلی</button>
                </div>
                <div class="flex flex-wrap gap-1.5" id="savedViewsList"></div>
            </div>

            <!-- Bulk Operation Toolbar -->
            <div class="flex flex-col lg:flex-row items-center gap-3 p-4 bg-slate-50/80 dark:bg-slate-950/20 rounded-xl border border-slate-200/80 dark:border-slate-800/60">
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 dark:text-slate-300 cursor-pointer">
                    <input type="checkbox" id="inboxSelectAll" class="rounded border-slate-300 dark:border-slate-700 text-indigo-600 focus:ring-indigo-500/20" />
                    <span>انتخاب همه</span>
                </label>
                <div class="text-[10px] text-slate-500 dark:text-slate-400 font-bold border-l border-slate-200/80 dark:border-slate-700 pl-3 ml-1" id="selectionMeta">0 مورد انتخاب شده</div>
                <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto lg:flex-1">
                    <select class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none w-32" name="Action" id="bulkActionSelect" required>
                        <option value="">انتخاب عملیات</option>
                        <option value="approve">تایید گروهی</option>
                        <option value="reject">رد گروهی</option>
                        <option value="mark-read">خوانده شد</option>
                        <option value="mark-unread">خوانده نشده</option>
                        <option value="delegate">واگذاری</option>
                    </select>
                    <select class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none w-32" name="ToUserId" id="bulkAssigneeSelect">
                        <option value="">کاربر مقصد</option>
                        @foreach (var assignee in Model.Assignees)
                        {
                            <option value="@assignee.UserId">@assignee.DisplayName</option>
                        }
                    </select>
                    <input class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none flex-1 min-w-[150px] transition-all" name="Note" id="bulkNoteInput" placeholder="یادداشت مشترک برای اقدام گروهی..." />
                    <button class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-xl text-xs font-bold transition shadow-sm shadow-indigo-500/20" type="submit">
                        <i class="bi bi-check2-square"></i>
                        <span>اجرا</span>
                    </button>
                </div>
            </div>

            <!-- Workspace Layout (List + Detail) -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 align-start">
                <div class="lg:col-span-2 space-y-2">
                    @if (Model.Items.Count == 0)
                    {
                        <partial name="_EmptyState" model='new { Icon = "bi-inboxes", Title = "کارتابل خالی است", Description = "فعلاً موردی برای این فیلتر وجود ندارد.", Size = "sm" }' />
                    }
                    else
                    {
                        <div id="inboxGroupsHost" class="space-y-2"></div>
                    }
                </div>

                <aside class="bg-slate-50/80 dark:bg-slate-950/40 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-3 min-h-[300px]" id="inboxDetailPane">
                    <div class="flex flex-col items-center justify-center text-center p-6 text-slate-400 h-full" id="detailEmptyState">
                        <div class="mx-auto mb-3 grid h-16 w-16 place-items-center rounded-2xl bg-slate-100/80 dark:bg-slate-800/60">
                            <i class="bi bi-layout-sidebar-inset text-2xl text-slate-300 dark:text-slate-600"></i>
                        </div>
                        <strong class="text-xs text-slate-700 dark:text-slate-300">یک آیتم را انتخاب کنید</strong>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">جزئیات، اقدام سریع و کامنت اینلاین اینجا نمایش داده می‌شود.</p>
                    </div>

                    <div class="hidden flex flex-col h-full gap-3" id="detailCard">
                        <div class="flex-1 space-y-3">
                            <div class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400" id="detailEyebrow"></div>
                            <h2 class="text-sm font-black text-slate-900 dark:text-white" id="detailTitle"></h2>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed" id="detailSummary"></p>

                            <div class="grid grid-cols-2 gap-2 text-[10px] bg-white dark:bg-slate-900 p-3 rounded-xl border border-slate-100/80 dark:border-slate-800">
                                <div class="flex flex-col"><span class="text-slate-400">ماژول</span><strong class="text-slate-700 dark:text-slate-300 mt-0.5" id="detailModule"></strong></div>
                                <div class="flex flex-col"><span class="text-slate-400">وضعیت</span><strong class="text-slate-700 dark:text-slate-300 mt-0.5" id="detailStatus"></strong></div>
                                <div class="flex flex-col"><span class="text-slate-400">موعد</span><strong class="text-slate-700 dark:text-slate-300 mt-0.5" id="detailSla"></strong></div>
                                <div class="flex flex-col"><span class="text-slate-400">زمان ایجاد</span><strong class="text-slate-700 dark:text-slate-300 mt-0.5 font-mono" id="detailCreatedAt"></strong></div>
                            </div>

                            <div class="flex flex-wrap gap-1" id="detailChips"></div>

                            <div class="pt-3">
                                <a class="w-full h-9 rounded-xl border border-slate-200/80 hover:bg-slate-50 dark:border-slate-700/60 dark:hover:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 transition flex items-center justify-center gap-1.5 no-underline" id="detailOpenLink" href="#" target="_self">
                                    <i class="bi bi-box-arrow-up-left"></i>
                                    <span>باز کردن جزئیات</span>
                                </a>
                            </div>
                        </div>

                        <div class="border-t border-slate-200/80 dark:border-slate-800 pt-3 space-y-3" id="detailStickyBar">
                            <!-- Case Task Inline Processing Actions -->
                            <div id="caseTaskActionArea" class="hidden space-y-2">
                                <div class="text-[10px] font-bold text-amber-500 mb-1">اقدامات مربوط به وظیفه جاری:</div>
                                <div class="flex gap-2">
                                    <button type="button" class="btn-process-task flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1 shadow-sm" data-action="Approve">
                                        <i class="bi bi-check2-circle"></i>
                                        <span>تایید</span>
                                    </button>
                                    <button type="button" class="btn-process-task flex-1 bg-rose-600 hover:bg-rose-700 text-white py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1 shadow-sm" data-action="Reject">
                                        <i class="bi bi-x-circle"></i>
                                        <span>رد</span>
                                    </button>
                                </div>
                            </div>

                            <form asp-action="Decide" method="post" class="hidden" id="quickApproveForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="documentType" id="quickApproveDocumentType" />
                                <input type="hidden" name="documentId" id="quickApproveDocumentId" />
                                <input type="hidden" name="stepNumber" id="quickApproveStepNumber" />
                                <input type="hidden" name="decisionType" value="Approve" />
                                <input type="hidden" name="note" value="تایید از کارتابل" />
                                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1 shadow-sm">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>تایید یک‌کلیکی</span>
                                </button>
                            </form>

                            <form asp-action="Decide" method="post" class="hidden flex gap-2" id="quickRejectForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="documentType" id="quickRejectDocumentType" />
                                <input type="hidden" name="documentId" id="quickRejectDocumentId" />
                                <input type="hidden" name="stepNumber" id="quickRejectStepNumber" />
                                <input type="hidden" name="decisionType" value="Reject" />
                                <input type="text" name="note" class="flex-1 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all" placeholder="دلیل رد..." />
                                <button type="submit" class="border border-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/20 text-rose-600 px-3 py-2 rounded-xl text-xs font-bold transition">رد</button>
                            </form>

                            <form asp-action="AddComment" method="post" class="hidden flex gap-2" id="quickCommentForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="documentType" id="quickCommentDocumentType" />
                                <input type="hidden" name="documentId" id="quickCommentDocumentId" />
                                <input type="hidden" name="workflowStepId" id="quickCommentWorkflowStepId" />
                                <input type="text" name="body" class="flex-1 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all" placeholder="ثبت کامنت اینلاین..." />
                                <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-800 dark:hover:bg-slate-700 px-3 py-2 rounded-xl text-xs font-bold transition">کامنت</button>
                            </form>

                            <form asp-action="Delegate" method="post" class="hidden flex flex-col gap-2" id="quickDelegateForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="workflowStepId" id="quickDelegateWorkflowStepId" />
                                <div class="flex gap-2">
                                    <select name="toUserId" class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none w-1/3 transition-all" id="quickDelegateToUserId">
                                        @foreach (var assignee in Model.Assignees)
                                        {
                                            <option value="@assignee.UserId">@assignee.DisplayName</option>
                                        }
                                    </select>
                                    <input type="text" name="note" class="flex-1 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/60 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all" placeholder="یادداشت واگذاری..." />
                                    <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-800 dark:hover:bg-slate-700 px-3 py-2 rounded-xl text-xs font-bold transition">واگذاری</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </aside>
            </div>
        </form>
    </div>
</div>

@section Styles {
}

@section Scripts {
    <script src="~/js/work-inbox-index-script.js" asp-append-version="true"></script>
}