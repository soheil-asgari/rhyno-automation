@model OfficeAutomation.Models.OverviewDashboardViewModel
@{
    ViewData["Title"] = "داشبورد مدیریتی راینو";
    var isTabContent = Context.Request.Query.ContainsKey("_tab");
    Layout = isTabContent ? "_TabLayout" : "_Layout";
}

<div class="space-y-6 pb-12 animate-fade-in">
    <!-- Header section with elegant title and refreshed style -->
    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
                <span class="p-2 rounded-xl bg-teal-500/10 text-teal-600 dark:bg-teal-500/20 dark:text-teal-400">
                    <i class="bi bi-grid-1x2-fill"></i>
                </span>
                خلاصه وضعیت و شاخص‌های کلیدی عملکرد (KPI)
            </h1>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                گزارش یکپارچه و قطعی از وضعیت مالی، انبارداری و فرآیندهای سازمان (بروزرسانی شده در لحظه)
            </p>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-500 bg-slate-100 dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700">
            <i class="bi bi-calendar-check"></i>
            <span>دوره مالی جاری: ماه جاری</span>
        </div>
    </div>

    <!-- KPI Summary Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Sales Card -->
        <div class="relative overflow-hidden rounded-2xl border border-emerald-500/10 bg-gradient-to-br from-emerald-500/5 to-transparent p-5 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-[1.01] dark:border-emerald-500/20">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">مجموع فروش ماه جاری</span>
                <span class="flex h-8 w-8 items-center justify-between rounded-lg bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400">
                    <i class="bi bi-graph-up-arrow mx-auto text-sm"></i>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-1">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@Model.TotalSales.ToString("N0")</span>
                <span class="text-xs text-slate-400">ریال</span>
            </div>
            <div class="mt-2 text-[10px] text-emerald-600 dark:text-emerald-400 flex items-center gap-1 font-semibold">
                <i class="bi bi-check-circle"></i>
                <span>ثبت شده در فاکتورهای فروش</span>
            </div>
        </div>

        <!-- Purchases Card -->
        <div class="relative overflow-hidden rounded-2xl border border-rose-500/10 bg-gradient-to-br from-rose-500/5 to-transparent p-5 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-[1.01] dark:border-rose-500/20">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">مجموع خرید ماه جاری</span>
                <span class="flex h-8 w-8 items-center justify-between rounded-lg bg-rose-500/10 text-rose-600 dark:bg-rose-500/20 dark:text-rose-400">
                    <i class="bi bi-graph-down-arrow mx-auto text-sm"></i>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-1">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@Model.TotalPurchases.ToString("N0")</span>
                <span class="text-xs text-slate-400">ریال</span>
            </div>
            <div class="mt-2 text-[10px] text-rose-600 dark:text-rose-400 flex items-center gap-1 font-semibold">
                <i class="bi bi-check-circle"></i>
                <span>ثبت شده در فاکتورهای خرید</span>
            </div>
        </div>

        <!-- Accounts Receivable -->
        <div class="relative overflow-hidden rounded-2xl border border-blue-500/10 bg-gradient-to-br from-blue-500/5 to-transparent p-5 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-[1.01] dark:border-blue-500/20">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">حساب‌های دریافتنی (AR)</span>
                <span class="flex h-8 w-8 items-center justify-between rounded-lg bg-blue-500/10 text-blue-600 dark:bg-blue-500/20 dark:text-blue-400">
                    <i class="bi bi-wallet2 mx-auto text-sm"></i>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-1">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@Model.AccountsReceivableBalance.ToString("N0")</span>
                <span class="text-xs text-slate-400">ریال</span>
            </div>
            <div class="mt-2 text-[10px] text-blue-600 dark:text-blue-400 flex items-center gap-1 font-semibold">
                <i class="bi bi-info-circle"></i>
                <span>مانده بدهکاران در دفتر معین</span>
            </div>
        </div>

        <!-- Accounts Payable -->
        <div class="relative overflow-hidden rounded-2xl border border-amber-500/10 bg-gradient-to-br from-amber-500/5 to-transparent p-5 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-[1.01] dark:border-amber-500/20">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">حساب‌های پرداختنی (AP)</span>
                <span class="flex h-8 w-8 items-center justify-between rounded-lg bg-amber-500/10 text-amber-600 dark:bg-amber-500/20 dark:text-amber-400">
                    <i class="bi bi-cash-stack mx-auto text-sm"></i>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-1">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@Model.AccountsPayableBalance.ToString("N0")</span>
                <span class="text-xs text-slate-400">ریال</span>
            </div>
            <div class="mt-2 text-[10px] text-amber-600 dark:text-amber-400 flex items-center gap-1 font-semibold">
                <i class="bi bi-info-circle"></i>
                <span>مانده بستانکاران در دفتر معین</span>
            </div>
        </div>
    </div>

    <!-- Charts Grid Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Sales and Purchases Chart -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="w-1.5 h-3.5 bg-teal-600 rounded-full"></span>
                مقایسه فروش و خرید ماه جاری
            </h3>
            <div class="relative min-h-64 h-64 flex items-center justify-center">
                <canvas id="salesPurchasesChart"></canvas>
            </div>
        </div>

        <!-- Pending Workflows by Module -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="w-1.5 h-3.5 bg-teal-600 rounded-full"></span>
                گردش‌کارهای در انتظار تایید به تفکیک واحد
            </h3>
            <div class="relative min-h-64 h-64 flex items-center justify-center">
                @if (Model.PendingWorkflows.Count == 0)
                {
                    <div class="text-center text-xs text-slate-400">هیچ گردش‌کار فعالی در انتظار تایید وجود ندارد.</div>
                }
                else
                {
                    <canvas id="workflowsChart"></canvas>
                }
            </div>
        </div>
    </div>

    <!-- Inventory Stock Below Reorder Point -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="w-1.5 h-3.5 bg-amber-500 rounded-full"></span>
                کالاهای زیر حد سفارش مجدد (نیاز به تامین)
            </h3>
            <span class="px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:bg-amber-500/20 dark:text-amber-400 text-[10px] font-bold">
                @Model.BelowReorderProducts.Count مورد
            </span>
        </div>

        @if (Model.BelowReorderProducts.Count == 0)
        {
            <div class="py-8 text-center text-xs text-slate-400 bg-slate-50 dark:bg-slate-950/40 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
                <i class="bi bi-box2 text-lg mb-2 block"></i>
                تمامی کالاهای فعال دارای موجودی بالای حد سفارش مجدد هستند.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-right text-xs">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-800 text-slate-400">
                            <th class="py-2.5 font-semibold">کد کالا</th>
                            <th class="py-2.5 font-semibold">نام کالا</th>
                            <th class="py-2.5 font-semibold">واحد سنجش</th>
                            <th class="py-2.5 font-semibold text-left">نقطه سفارش</th>
                            <th class="py-2.5 font-semibold text-left">موجودی فعلی</th>
                            <th class="py-2.5 font-semibold text-center">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50">
                        @foreach (var item in Model.BelowReorderProducts)
                        {
                            <tr class="text-slate-700 dark:text-slate-300 hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                                <td class="py-2.5 font-medium">@item.Code</td>
                                <td class="py-2.5 font-semibold">@item.Name</td>
                                <td class="py-2.5 text-slate-500">@item.Unit</td>
                                <td class="py-2.5 text-left font-mono">@item.ReorderPoint.ToString("N2")</td>
                                <td class="py-2.5 text-left font-mono text-rose-600 dark:text-rose-400 font-bold">@item.CurrentStock.ToString("N2")</td>
                                <td class="py-2.5 text-center">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-rose-500/10 px-2 py-0.5 text-[10px] font-bold text-rose-600 dark:bg-rose-500/20 dark:text-rose-400">
                                        <span class="h-1.5 w-1.5 rounded-full bg-rose-600 animate-pulse"></span>
                                        بحرانی
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script id="overviewChartData" type="application/json">@Html.Raw(Json.Serialize(new {
            totalSales = Model.TotalSales,
            totalPurchases = Model.TotalPurchases,
            pendingModules = Model.PendingWorkflows.Select(w => w.Module),
            pendingCounts = Model.PendingWorkflows.Select(w => w.Count)
        }))</script>
    <!-- Local Chart.js inclusion -->
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/management-dashboard-overview-script.js" asp-append-version="true"></script>
}
