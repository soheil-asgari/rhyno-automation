@model WaybillIndexVM
@{
    ViewData["Title"] = "ثبت بارنامه";
}

@section Styles {
}

<div class="container-fluid py-4 waybill-page">
    <div class="d-flex justify-content-between align-items-center mb-4 waybill-header">
        <div>
            <h5 class="fw-bold mb-1 text-dark">مدیریت بارنامه‌ها</h5>
            <p class="text-muted small mb-0">ثبت، جستجو و پیگیری وضعیت پرداخت بارنامه‌ها</p>
        </div>
        <a class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition-colors  px-4 shadow-sm waybill-new-btn" asp-action="Create">
            <i class="bi bi-plus-lg ms-1"></i> ثبت بارنامه جدید
        </a>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto  waybill-card" >
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto -body border-bottom p-3 p-md-4" >
            <form method="get" asp-action="Index" class="row g-2 g-md-3 align-items-end">
                <div class="col-12 col-md-7 col-lg-5">
                    <label asp-for="SearchTerm" class="form-label small text-muted mb-1">جستجو</label>
                    <input asp-for="SearchTerm" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="شماره بارنامه، راننده، مبدا یا مقصد" />
                </div>
                <div class="col-12 col-md-5 col-lg-3">
                    <label asp-for="PaymentStatus" class="form-label small text-muted mb-1">وضعیت پرداخت</label>
                    <select asp-for="PaymentStatus" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none">
                        <option value="">همه</option>
                        @foreach (var status in Model.AvailablePaymentStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-4 d-grid d-md-flex gap-2">
                    <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition-colors  flex-fill">اعمال</button>
                    <a asp-action="Index" class="btn btn-outline-secondary flex-fill">حذف فیلتر</a>
                </div>
            </form>
            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                <small class="text-muted">تعداد کل: @Model.TotalCount</small>
                <small class="text-muted">نتایج فیلتر: @Model.FilteredCount</small>
            </div>
        </div>
        <div class="table-responsive">
            <table class="w-full text-xs text-right border-collapse"  data-pro-table="waybills">
                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " ead class="bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >شماره بارنامه</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >تاریخ صدور</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >مبدا / مقصد</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >راننده</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >صافی راننده</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >وضعیت پرداخت</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center" >عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 fw-semibold" >@item.WaybillNumber</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 " >@item.IssueDate.ToString("yyyy/MM/dd")</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 " >@item.OriginCity <span class="text-muted">→</span> @item.DestinationCity</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 " >@item.DriverName</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 fw-semibold" >@item.NetPayToDriver.ToString("N0")</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 " >
                                    <span class="badge waybill-status-badge @GetStatusClass(item.PaymentStatus)">@item.PaymentStatus</span>
                                </td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 text-center" >
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">جزئیات</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">ویرایش</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 "  colspan="7" class="text-center py-4 text-muted">بارنامه‌ای برای نمایش وجود ندارد.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Paid" => "status-paid",
            "Pending" => "status-pending",
            "Internal" => "status-internal",
            _ => "status-pending"
        };
    }
}
