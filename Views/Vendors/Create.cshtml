@model Vendor
@{
    ViewData["Title"] = "ایجاد تامین‌کننده";
}

<div class="container-fluid py-4">
    <h6 class="fw-bold mb-3">ایجاد تامین‌کننده</h6>
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto " >
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto -body p-3" >
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <div class="row g-2">
                    <div class="col-md-4"><label asp-for="Name" class="form-label small"></label><input asp-for="Name" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" /></div>
                    <div class="col-md-4"><label asp-for="EconomicCode" class="form-label small"></label><input asp-for="EconomicCode" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" /></div>
                    <div class="col-md-4"><label asp-for="NationalId" class="form-label small"></label><input asp-for="NationalId" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" /></div>
                    <div class="col-md-4"><label asp-for="Phone" class="form-label small"></label><input asp-for="Phone" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" /></div>
                    <div class="col-md-8"><label asp-for="Address" class="form-label small"></label><input asp-for="Address" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" /></div>
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="IsActive" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" />
                            <label asp-for="IsActive" class="form-check-label small"></label>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-success">ذخیره</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">بازگشت</a>
                </div>
            </form>
        </div>
    </div>
</div>
