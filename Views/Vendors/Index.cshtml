@model List<Vendor>
@{
    ViewData["Title"] = "تامین‌کنندگان";
}

<div class="container-fluid py-4">
    @if (TempData["VendorMessage"] is string vendorMessage)
    {
        <div class="alert alert-info py-2 px-3 small mb-3">@vendorMessage</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">تامین‌کنندگان</h6>
        <a asp-action="Create" class="btn btn-sm btn-primary">تامین‌کننده جدید</a>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto " >
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 overflow-x-auto -body p-3 border-bottom" >
            <form method="get" class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">جستجو</label>
                    <input name="searchTerm" value="@ViewBag.SearchTerm" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 text-sm focus:ring-teal-500/20 focus:border-teal-500 outline-none" placeholder="نام / کد اقتصادی / شناسه ملی" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-primary">اعمال</button>
                </div>
            </form>
        </div>
        <div class="table-responsive">
            <table class="w-full text-xs text-right border-collapse" >
                <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " ead class="bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >نام</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >کد اقتصادی</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >شناسه ملی</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >تلفن</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold " >وضعیت</th>
                        <th class="p-3 border-b border-slate-100 dark:border-slate-800/50 font-bold text-center" >عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 " >@item.Name</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 " >@(string.IsNullOrWhiteSpace(item.EconomicCode) ? "-" : item.EconomicCode)</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 " >@(string.IsNullOrWhiteSpace(item.NationalId) ? "-" : item.NationalId)</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 " >@(string.IsNullOrWhiteSpace(item.Phone) ? "-" : item.Phone)</td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 " ><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "فعال" : "غیرفعال")</span></td>
                                <td class="p-3 border-b border-slate-100 dark:border-slate-800/50 text-center" >
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">ویرایش</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('آیتم حذف/غیرفعال شود؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td class="p-3 border-b border-slate-100 dark:border-slate-800/50 "  colspan="6" class="text-center text-muted py-3">رکوردی یافت نشد.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
