@{
    ViewData["Title"] = "داشبورد تحلیل فرآیند";
}

@section Styles {
    <style>
        .تحلیل-صفحه {
            display: grid;
            gap: 1rem;
        }

        .تحلیل-قهرمان,
        .تحلیل-فیلترها,
        .تحلیل-کارت,
        .تحلیل-جدول {
            border: 1px solid var(--border-color, #ddd);
            border-radius: 18px;
            background: linear-gradient(180deg, #fffdf8 0%, #fff 100%);
            box-shadow: 0 12px 32px rgba(44, 33, 16, .06);
        }

        .تحلیل-قهرمان,
        .تحلیل-فیلترها,
        .تحلیل-کارت,
        .تحلیل-جدول {
            padding: 1rem 1.15rem;
        }

        .تحلیل-قهرمان {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: end;
        }

        .تحلیل-قهرمان h1 {
            margin: 0 0 .35rem;
            font-size: 1.6rem;
            font-weight: 900;
        }

        .تحلیل-قهرمان p {
            margin: 0;
            color: var(--text-muted, #6b7280);
        }

        .تحلیل-فیلترها {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .75rem;
            align-items: end;
        }

        .تحلیل-فیلد {
            display: grid;
            gap: .35rem;
        }

        .تحلیل-فیلد label {
            font-size: .8rem;
            font-weight: 800;
            color: #6b7280;
        }

        .تحلیل-چکیده {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .85rem;
        }

        .تحلیل-کارت strong {
            display: block;
            font-size: 1.6rem;
            font-weight: 900;
            margin-bottom: .2rem;
        }

        .تحلیل-کارت span {
            color: #6b7280;
            font-size: .82rem;
        }

        .تحلیل-شبکه {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .تحلیل-باکس-نمودار {
            display: grid;
            gap: .75rem;
        }

        .تحلیل-باکس-نمودار h2,
        .تحلیل-جدول h2 {
            margin: 0;
            font-size: 1rem;
            font-weight: 900;
        }

        .تحلیل-باکس-نمودار p,
        .تحلیل-جدول p {
            margin: 0;
            color: #6b7280;
            font-size: .82rem;
        }

        .تحلیل-نمودار {
            min-height: 280px;
        }

        .تحلیل-جدول {
            overflow: hidden;
        }

        .تحلیل-جدول table {
            width: 100%;
            border-collapse: collapse;
            font-size: .86rem;
        }

        .تحلیل-جدول th,
        .تحلیل-جدول td {
            padding: .75rem .5rem;
            border-bottom: 1px solid #eee4d7;
            text-align: right;
        }

        .تحلیل-جدول th {
            color: #7c6b56;
            font-size: .78rem;
        }

        .تحلیل-بارگذاری {
            color: #6b7280;
            font-size: .85rem;
        }

        @@media (max-width: 980px) {
            .تحلیل-فیلترها,
            .تحلیل-چکیده,
            .تحلیل-شبکه {
                grid-template-columns: 1fr;
            }

            .تحلیل-قهرمان {
                display: grid;
            }
        }
    </style>
}

<section class="تحلیل-صفحه"
         data-نشانی-داده="@Url.Action("GetChartData", "ProcessAnalysis")">
    <div class="تحلیل-قهرمان">
        <div>
            <h1>داشبورد تحلیل فرآیند</h1>
            <p>زمان چرخه، گلوگاه‌ها، ماندگاری تایید و رویدادهای ممیزی را با خروجی کاملاً فارسی بررسی کنید.</p>
        </div>
        <div class="تحلیل-بارگذاری" id="وضعیتبارگذاری">آماده دریافت داده</div>
    </div>

    <form class="تحلیل-فیلترها" id="فرمفیلتر">
        <div class="تحلیل-فیلد">
            <label for="ازتاریخ">از تاریخ</label>
            <input id="ازتاریخ" name="ازتاریخ" class="form-control" type="date" />
        </div>
        <div class="تحلیل-فیلد">
            <label for="تاتاریخ">تا تاریخ</label>
            <input id="تاتاریخ" name="تاتاریخ" class="form-control" type="date" />
        </div>
        <div class="تحلیل-فیلد">
            <label for="تعدادبیشینه">تعداد نمایش</label>
            <select id="تعدادبیشینه" name="تعدادبیشینه" class="form-select">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="15">15</option>
                <option value="20">20</option>
            </select>
        </div>
        <div class="تحلیل-فیلد">
            <button class="btn btn-primary" type="submit">به‌روزرسانی داشبورد</button>
        </div>
        <div class="تحلیل-فیلد">
            <a class="btn btn-outline-success" id="پیوندخروجیاکسل" href="#">خروجی اکسل</a>
        </div>
    </form>

    <div class="تحلیل-چکیده">
        <div class="تحلیل-کارت">
            <strong id="خلاصهمیانگینچرخه">0</strong>
            <span>میانگین زمان چرخه (ساعت)</span>
        </div>
        <div class="تحلیل-کارت">
            <strong id="خلاصهنمونهها">0</strong>
            <span>تعداد نمونه‌های تکمیل‌شده</span>
        </div>
        <div class="تحلیل-کارت">
            <strong id="خلاصهدرانتظار">0</strong>
            <span>تعداد در انتظار تایید</span>
        </div>
        <div class="تحلیل-کارت">
            <strong id="خلاصهرویدادحساس">0</strong>
            <span>رویدادهای حساس ممیزی</span>
        </div>
    </div>

    <div class="تحلیل-شبکه">
        <section class="تحلیل-کارت تحلیل-باکس-نمودار">
            <h2>روند زمان چرخه</h2>
            <p>میانگین زمان پایان فرآیندها در بازه انتخاب‌شده</p>
            <div class="تحلیل-نمودار"><canvas id="نمودارزمانچرخه"></canvas></div>
        </section>

        <section class="تحلیل-کارت تحلیل-باکس-نمودار">
            <h2>گلوگاه‌های اصلی</h2>
            <p>مرحله‌هایی که بیشترین توقف را ایجاد کرده‌اند</p>
            <div class="تحلیل-نمودار"><canvas id="نمودارگلوگاه"></canvas></div>
        </section>

        <section class="تحلیل-کارت تحلیل-باکس-نمودار">
            <h2>توزیع ماندگاری تایید</h2>
            <p>تعداد اقلام در بازه‌های مختلف انتظار</p>
            <div class="تحلیل-نمودار"><canvas id="نمودارماندگاری"></canvas></div>
        </section>

        <section class="تحلیل-کارت تحلیل-باکس-نمودار">
            <h2>رویدادهای ممیزی</h2>
            <p>حجم رویدادها و رخدادهای حساس به تفکیک ماژول</p>
            <div class="تحلیل-نمودار"><canvas id="نمودارممیزی"></canvas></div>
        </section>
    </div>

    <div class="تحلیل-شبکه">
        <section class="تحلیل-جدول">
            <h2>جزئیات زمان چرخه</h2>
            <p>خلاصه هر فرآیند برای تحلیل روند تکمیل</p>
            <table>
                <thead>
                    <tr>
                        <th>فرآیند</th>
                        <th>تعداد</th>
                        <th>میانگین ساعت</th>
                        <th>میانه ساعت</th>
                        <th>بیشینه ساعت</th>
                    </tr>
                </thead>
                <tbody id="جدولزمانچرخه"></tbody>
            </table>
        </section>

        <section class="تحلیل-جدول">
            <h2>جزئیات گلوگاه و ماندگاری</h2>
            <p>پرریسک‌ترین بخش‌های فرآیند و وضعیت اقلام در انتظار</p>
            <table>
                <thead>
                    <tr>
                        <th>نوع</th>
                        <th>شرح</th>
                        <th>تعداد</th>
                        <th>میانگین ساعت</th>
                        <th>بیشینه ساعت</th>
                    </tr>
                </thead>
                <tbody id="جدولترکیبی"></tbody>
            </table>
        </section>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            const pageElement = document.querySelector('.تحلیل-صفحه');
            if (!pageElement) return;

            const filterForm = document.getElementById('فرمفیلتر');
            const loadingStatus = document.getElementById('وضعیتبارگذاری');
            const dataUrl = pageElement.dataset.نشانیداده;
            const excelExportLink = document.getElementById('پیوندخروجیاکسل');
            const charts = {};

            const elements = {
                cycleTimeAverage: document.getElementById('خلاصهمیانگینچرخه'),
                sampleCount: document.getElementById('خلاصهنمونهها'),
                pendingCount: document.getElementById('خلاصهدرانتظار'),
                sensitiveCount: document.getElementById('خلاصهرویدادحساس'),
                cycleTimeTableBody: document.getElementById('جدولزمانچرخه'),
                combinedTableBody: document.getElementById('جدولترکیبی')
            };

            function escapeHtml(value) {
                return `${value ?? ''}`
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function formatNumber(value) {
                return new Intl.NumberFormat('fa-IR', { maximumFractionDigits: 2 }).format(value ?? 0);
            }

            function buildChartConfig(chartData, type) {
                return {
                    type: type,
                    data: {
                        labels: chartData.labels,
                        datasets: chartData.series.map(series => ({
                            label: series.label,
                            data: series.values,
                            backgroundColor: type === 'line' ? 'rgba(0,0,0,0)' : series.color,
                            borderColor: series.color,
                            borderWidth: 2,
                            tension: .3,
                            fill: false
                        }))
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                labels: {
                                    font: { family: 'Vazir' }
                                }
                            }
                        },
                        scales: type === 'doughnut' ? {} : {
                            x: { ticks: { font: { family: 'Vazir' } } },
                            y: { ticks: { font: { family: 'Vazir' } } }
                        }
                    }
                };
            }

            function renderChart(canvasId, chartData, type) {
                if (charts[canvasId]) {
                    charts[canvasId].destroy();
                }

                const ctx = document.getElementById(canvasId).getContext('2d');
                charts[canvasId] = new Chart(ctx, buildChartConfig(chartData, type));
            }

            function renderTables(report) {
                elements.cycleTimeTableBody.innerHTML = report.cycleTime.items.map(item => `
                    <tr>
                        <td>${escapeHtml(item.processName || item.نامفرآیند || '')}</td>
                        <td>${formatNumber(item.count || item.تعداد)}</td>
                        <td>${formatNumber(item.averageHours || item.میانگینساعت)}</td>
                        <td>${formatNumber(item.medianHours || item.میانهساعت)}</td>
                        <td>${formatNumber(item.maxHours || item.بیشینهساعت)}</td>
                    </tr>`).join('');

                const bottleneckRows = report.bottlenecks.items.map(item => `
                    <tr>
                        <td>گلوگاه</td>
                        <td>${escapeHtml(item.processName || item.نامفرآیند || '')} - ${escapeHtml(item.stepName || item.ناممرحله || '')}</td>
                        <td>${formatNumber(item.count || item.تعداد)}</td>
                        <td>${formatNumber(item.averageStopHours || item.میانگینساعتتوقف)}</td>
                        <td>${formatNumber(item.maxStopHours || item.بیشینهساعتتوقف)}</td>
                    </tr>`);

                const pendingRows = report.approvalDuration.items.map(item => `
                    <tr>
                        <td>در انتظار تایید</td>
                        <td>${escapeHtml(item.processName || item.نامفرآیند || '')}</td>
                        <td>${formatNumber(item.pendingCount || item.تعداددرانتظار)}</td>
                        <td>${formatNumber(item.averageWaitHours || item.میانگینساعتانتظار)}</td>
                        <td>${formatNumber(item.maxWaitHours || item.بیشینهساعتانتظار)}</td>
                    </tr>`);

                elements.combinedTableBody.innerHTML = [...bottleneckRows, ...pendingRows].join('');
            }

            function renderReport(report) {
                elements.cycleTimeAverage.textContent = formatNumber(report.cycleTime.averageHours);
                elements.sampleCount.textContent = formatNumber(report.cycleTime.sampleCount);
                elements.pendingCount.textContent = formatNumber(report.approvalDuration.totalCount);
                elements.sensitiveCount.textContent = formatNumber(report.auditEvents.sensitiveCount);

                renderChart('نمودارزمانچرخه', report.cycleTime.trendChart, 'line');
                renderChart('نمودارگلوگاه', report.bottlenecks.bottleneckChart, 'bar');
                renderChart('نمودارماندگاری', report.approvalDuration.distributionChart, 'doughnut');
                renderChart('نمودارممیزی', report.auditEvents.eventChart, 'bar');
                renderTables(report);
            }

            async function loadReport() {
                loadingStatus.textContent = 'در حال بارگذاری...';
                const formData = new FormData(filterForm);
                const queryParams = new URLSearchParams();
                for (const [key, value] of formData.entries()) {
                    if (value) queryParams.set(key, value.toString());
                }

                excelExportLink.href = `${dataUrl.replace('/ChartData', '/ExportExcel')}?${queryParams.toString()}`;

                const response = await fetch(`${dataUrl}?${queryParams.toString()}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) {
                    loadingStatus.textContent = 'دریافت داده ناموفق بود';
                    return;
                }

                const report = await response.json();
                renderReport(report);
                loadingStatus.textContent = 'آخرین به‌روزرسانی انجام شد';
            }

            filterForm.addEventListener('submit', async event => {
                event.preventDefault();
                await loadReport();
            });

            const today = new Date();
            const fromDate = new Date();
            fromDate.setDate(today.getDate() - 30);
            document.getElementById('تاتاریخ').value = today.toISOString().slice(0, 10);
            document.getElementById('ازتاریخ').value = fromDate.toISOString().slice(0, 10);

            loadReport();
        })();
    </script>
}
