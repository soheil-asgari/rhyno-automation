@page
@model RegisterModel
@{
    ViewData["Title"] = "ثبت کاربر جدید";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - راینو ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-auth-modern.css" asp-append-version="true" />
</head>
<body class="auth-body flex-center">

    <div class="glow-sphere glow-top"></div>
    <div class="glow-sphere glow-bottom"></div>
    <div class="grid-pattern-overlay"></div>

    <main class="single-card-wrap max-w-lg">
        <div class="auth-card-panel standalone-card">
            
            <div class="auth-card-header">
                <div class="flex-between">
                    <div>
                        <h1 class="card-title">ثبت نام کاربر سازمانی</h1>
                        <p class="card-desc">اطلاعات کاربری را جهت صدور دسترسی وارد نمایید.</p>
                    </div>
                    <a asp-page="./Login" class="btn-ghost-sm">ورود</a>
                </div>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="auth-alert danger" role="alert"></div>

                <div class="form-grid-2">
                    <!-- Full Name -->
                    <div class="form-field">
                        <label asp-for="Input.FullName" class="field-label">نام و نام خانوادگی</label>
                        <div class="input-container">
                            <i class="bi bi-person-badge input-icon"></i>
                            <input asp-for="Input.FullName" placeholder="سهیل عسگری" class="field-input" autofocus />
                        </div>
                        <span asp-validation-for="Input.FullName" class="field-error"></span>
                    </div>

                    <!-- Service Location -->
                    <div class="form-field">
                        <label asp-for="Input.ServiceLocation" class="field-label">محل خدمت</label>
                        <div class="input-container">
                            <i class="bi bi-geo-alt-fill input-icon"></i>
                            <select asp-for="Input.ServiceLocation" class="field-input select-input">
                                <option value="">انتخاب شعبه / محل خدمت...</option>
                                <option value="تهران - دفتر مرکزی">تهران - دفتر مرکزی</option>
                                <option value="اصفهان - شعبه ۲">اصفهان - شعبه ۲</option>
                                <option value="کارخانه و انبار">کارخانه و انبار</option>
                            </select>
                        </div>
                        <span asp-validation-for="Input.ServiceLocation" class="field-error"></span>
                    </div>
                </div>

                <!-- Email -->
                <div class="form-field">
                    <label asp-for="Input.Email" class="field-label">آدرس ایمیل</label>
                    <div class="input-container">
                        <i class="bi bi-envelope-fill input-icon"></i>
                        <input asp-for="Input.Email" autocomplete="username" placeholder="name@company.com" class="field-input" dir="ltr" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <div class="form-grid-2">
                    <!-- Password -->
                    <div class="form-field">
                        <label asp-for="Input.Password" class="field-label">کلمه عبور</label>
                        <div class="input-container">
                            <i class="bi bi-shield-lock-fill input-icon"></i>
                            <input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="حداقل ۶ کاراکتر" class="field-input" dir="ltr" />
                        </div>
                        <span asp-validation-for="Input.Password" class="field-error"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-field">
                        <label asp-for="Input.ConfirmPassword" class="field-label">تکرار کلمه عبور</label>
                        <div class="input-container">
                            <i class="bi bi-shield-check-fill input-icon"></i>
                            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="تکرار رمز عبور" class="field-input" dir="ltr" />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                    </div>
                </div>

                <button type="submit" id="submitBtn" class="btn-primary-auth">
                    <span class="btn-text">ایجاد حساب کاربری</span>
                    <i class="bi bi-person-plus-fill btn-icon"></i>
                </button>
            </form>

            <footer class="auth-card-footer">
                <span>Rhyno Identity Security &mdash; @DateTime.Now.Year</span>
            </footer>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>