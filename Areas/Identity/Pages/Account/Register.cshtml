@page
@model RegisterModel
@{
    ViewData["Title"] = "ثبت نام کاربر جدید";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - راینو ERP</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-100 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <main class="grid min-h-screen place-items-center px-4 py-8">
        <section class="w-full max-w-[460px]">
            <div class="mb-5 flex items-center justify-between">
                <a asp-area="Identity" asp-page="/Account/Login" class="inline-flex items-center gap-2 no-underline">
                    <span class="grid h-9 w-9 place-items-center rounded-lg bg-slate-900 text-sm font-black text-white dark:bg-white dark:text-slate-950">R</span>
                    <span>
                        <span class="block text-sm font-black text-slate-900 dark:text-white">راینو ERP</span>
                        <span class="block text-[11px] text-slate-500 dark:text-slate-400">ایجاد کاربر سازمانی</span>
                    </span>
                </a>
                <a asp-area="Identity" asp-page="/Account/Login" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-[11px] font-bold text-slate-600 no-underline hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">ورود</a>
            </div>

            <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                <div class="mb-5">
                    <h1 class="m-0 text-lg font-black text-slate-950 dark:text-white">ثبت نام کاربر جدید</h1>
                    <p class="mt-1 text-[13px] leading-6 text-slate-500 dark:text-slate-400">اطلاعات پایه کاربر را برای دسترسی به سامانه وارد کنید.</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-4">
                    <div asp-validation-summary="ModelOnly" class="rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-[12px] leading-6 text-rose-700 empty:hidden dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200" role="alert"></div>

                    <div class="space-y-1.5">
                        <label asp-for="Input.FullName" class="block text-[12px] font-bold text-slate-700 dark:text-slate-200">نام و نام خانوادگی</label>
                        <input asp-for="Input.FullName" aria-required="true" placeholder="نام و نام خانوادگی" class="h-10 w-full rounded-md border border-slate-200 bg-slate-50 px-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-600 dark:focus:border-teal-400 dark:focus:bg-slate-950" />
                        <span asp-validation-for="Input.FullName" class="block text-[11px] font-semibold text-rose-600 dark:text-rose-300"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="Input.Email" class="block text-[12px] font-bold text-slate-700 dark:text-slate-200">ایمیل</label>
                        <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" class="h-10 w-full rounded-md border border-slate-200 bg-slate-50 px-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-600 dark:focus:border-teal-400 dark:focus:bg-slate-950" />
                        <span asp-validation-for="Input.Email" class="block text-[11px] font-semibold text-rose-600 dark:text-rose-300"></span>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-1.5">
                            <label asp-for="Input.Password" class="block text-[12px] font-bold text-slate-700 dark:text-slate-200">رمز عبور</label>
                            <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="حداقل ۶ کاراکتر" class="h-10 w-full rounded-md border border-slate-200 bg-slate-50 px-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-600 dark:focus:border-teal-400 dark:focus:bg-slate-950" />
                            <span asp-validation-for="Input.Password" class="block text-[11px] font-semibold text-rose-600 dark:text-rose-300"></span>
                        </div>

                        <div class="space-y-1.5">
                            <label asp-for="Input.ConfirmPassword" class="block text-[12px] font-bold text-slate-700 dark:text-slate-200">تکرار رمز عبور</label>
                            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="تکرار رمز" class="h-10 w-full rounded-md border border-slate-200 bg-slate-50 px-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-600 dark:focus:border-teal-400 dark:focus:bg-slate-950" />
                            <span asp-validation-for="Input.ConfirmPassword" class="block text-[11px] font-semibold text-rose-600 dark:text-rose-300"></span>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="Input.ServiceLocation" class="block text-[12px] font-bold text-slate-700 dark:text-slate-200">محل خدمت</label>
                        <select asp-for="Input.ServiceLocation" class="h-10 w-full rounded-md border border-slate-200 bg-slate-50 px-3 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-500/10 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:focus:border-teal-400 dark:focus:bg-slate-950">
                            <option value="">انتخاب محل خدمت...</option>
                            <option value="تهران">تهران</option>
                            <option value="اصفهان">اصفهان</option>
                        </select>
                        <span asp-validation-for="Input.ServiceLocation" class="block text-[11px] font-semibold text-rose-600 dark:text-rose-300"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md bg-slate-900 px-4 text-sm font-black text-white transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500/20 dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400">
                        ثبت نام
                    </button>
                </form>
            </div>

            <p class="mt-4 text-center text-[11px] text-slate-500 dark:text-slate-500">Rhyno Automation Identity</p>
        </section>
    </main>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
