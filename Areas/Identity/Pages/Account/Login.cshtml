                                <filter id="thinner-stroke">
                                    <feMorphology operator="erode" radius="20"></feMorphology>
                                </filter>
                            </defs>

                            <!-- اعمال فیلتر روی گروه اصلی -->
                            <g filter="url(#thinner-stroke)"
                               transform="translate(0.000000,545.000000) scale(0.050000,-0.050000)" stroke="none">
