@page
@model LoginModel
@using OfficeAutomation.Services.Tenancy
@inject ITenantSettingsService TenantSettingsService
@{
    Layout = null;
    OfficeAutomation.Models.SystemSetting? loginBranding = null;
    try { loginBranding = await TenantSettingsService.GetSystemSettingsAsync(); } catch { }
    var loginAppTitle = loginBranding?.ApplicationTitle ?? "راینو ERP";
    var loginLogoUrl = loginBranding?.LogoUrl;
    var loginFaviconUrl = loginBranding?.FaviconUrl;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود به حساب کاربری | @loginAppTitle</title>
    
    @if (!string.IsNullOrWhiteSpace(loginFaviconUrl))
    {
        <link rel="icon" href="@loginFaviconUrl" />
    }

    <!-- Icons & Core Stylesheet -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-auth-modern.css" asp-append-version="true" />
</head>
<body class="auth-body">

    <!-- Fluid Aurora Light Mesh Background -->
    <div class="aurora-canvas">
        <div class="aurora-blob aurora-1"></div>
        <div class="aurora-blob aurora-2"></div>
        <div class="aurora-blob aurora-3"></div>
        <div class="mesh-texture"></div>
    </div>

    <!-- Main Polymorphic Viewport -->
    <main class="auth-viewport">
        <div class="poly-card">
            
            <!-- Brand & Identity -->
            <header class="auth-identity stagger-1">
                <div class="brand-emblem-wrap">
                    <div class="brand-emblem">
                        @if (!string.IsNullOrWhiteSpace(loginLogoUrl))
                        {
                            <img src="@loginLogoUrl" alt="@loginAppTitle" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <span class="emblem-fallback" style="display:none;"><i class="bi bi-layers-half"></i></span>
                        }
                        else
                        {
                            <span class="emblem-fallback"><i class="bi bi-layers-half"></i></span>
                        }
                    </div>
                </div>
                <h1 class="brand-title">@loginAppTitle</h1>
                <p class="brand-description">سامانه یکپارچه مدیریت سازمانی و هوش تجاری</p>
            </header>

            <!-- Login Form -->
            <form method="post" id="loginForm" class="auth-form" novalidate>
                <!-- Server Errors Summary -->
                <div asp-validation-summary="ModelOnly" class="error-banner stagger-2" role="alert"></div>

                <!-- Username or Email Field -->
                <div class="form-field-group stagger-2">
                    <label asp-for="Input.Email" class="field-label">نام کاربری یا ایمیل</label>
                    <div class="glass-input-wrapper">
                        <i class="bi bi-person field-icon"></i>
                        <input asp-for="Input.Email"
                               autocomplete="username"
                               placeholder="شناسه کاربری یا name@company.com"
                               class="glass-input"
                               dir="ltr"
                               autofocus />
                    </div>
                    <span asp-validation-for="Input.Email" class="validation-message"></span>
                </div>

                <!-- Password Field -->
                <div class="form-field-group stagger-3">
                    <div class="field-label-split">
                        <label asp-for="Input.Password" class="field-label">کلمه عبور</label>
                        <a asp-page="./ForgotPassword" class="forgot-link">فراموشی رمز؟</a>
                    </div>
                    <div class="glass-input-wrapper">
                        <i class="bi bi-shield-lock field-icon"></i>
                        <input asp-for="Input.Password"
                               id="pwdField"
                               type="password"
                               autocomplete="current-password"
                               placeholder="••••••••••••"
                               class="glass-input password-text"
                               dir="ltr" />
                        <button type="button" id="pwdToggleBtn" class="pwd-peek-btn" tabindex="-1" title="نمایش/مخفی‌سازی رمز">
                            <i class="bi bi-eye" id="pwdToggleIcon"></i>
                        </button>
                    </div>
                    <!-- CapsLock Alert -->
                    <div id="capsHint" class="caps-warning" style="display: none;">
                        <i class="bi bi-capslock-fill"></i> کلید Caps Lock روشن است
                    </div>
                    <span asp-validation-for="Input.Password" class="validation-message"></span>
                </div>

                <!-- Remember Me & Helpers -->
                <div class="form-controls-row stagger-4">
                    <label class="ios-switch">
                        <input asp-for="Input.RememberMe" type="checkbox" />
                        <span class="switch-handle"></span>
                        <span class="switch-label">مرا به خاطر بسپار</span>
                    </label>
                </div>

                <!-- Action Button with Shimmer -->
                <div class="stagger-5">
                    <button type="submit" id="submitBtn" class="poly-submit-btn">
                        <span class="btn-text-wrap">
                            <span>ورود به سامانه</span>
                            <i class="bi bi-arrow-left"></i>
                        </span>
                        <div class="btn-spinner-wrap" style="display: none;">
                            <span class="spin-ring"></span>
                            <span>در حال بررسی اعتبار...</span>
                        </div>
                    </button>
                </div>
            </form>

            <!-- Bottom Meta Info -->
            <footer class="auth-card-footer stagger-5">
                <div class="security-badge">
                    <i class="bi bi-shield-check"></i>
                    <span>اتصال امن سازمانی (SSL 256-bit)</span>
                </div>
                <p class="copyright-text">&copy; @DateTime.Now.Year @loginAppTitle &mdash; تمامی حقوق محفوظ است</p>
            </footer>

        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Password toggle
            const toggleBtn = document.getElementById('pwdToggleBtn');
            const pwdField = document.getElementById('pwdField');
            const toggleIcon = document.getElementById('pwdToggleIcon');

            toggleBtn?.addEventListener('click', () => {
                const isPassword = pwdField.getAttribute('type') === 'password';
                pwdField.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
            });

            // CapsLock Warning
            const capsHint = document.getElementById('capsHint');
            pwdField?.addEventListener('keyup', (e) => {
                if (e.getModifierState && e.getModifierState('CapsLock')) {
                    capsHint.style.display = 'flex';
                } else {
                    capsHint.style.display = 'none';
                }
            });

            // Form Submit Loading State
            const form = document.getElementById('loginForm');
            const submitBtn = document.getElementById('submitBtn');
            form?.addEventListener('submit', function () {
                if ($(this).valid()) {
                    submitBtn.classList.add('loading');
                    submitBtn.disabled = true;
                    submitBtn.querySelector('.btn-text-wrap').style.display = 'none';
                    submitBtn.querySelector('.btn-spinner-wrap').style.display = 'flex';
                }
            });
        });
    </script>
</body>
</html>