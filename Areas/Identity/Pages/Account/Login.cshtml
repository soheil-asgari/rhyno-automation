                                d="M8295 7226 c-20 -5 -31 -17 -25 -26 6 -9 -17 -29 -51 -43 -42 -19 -58 -38 -52 -62 5 -19 1 -30 -8 -24 -10 6 -24 -12 -31 -41 -13 -53 24 -170 55 -170 10 0 17 -394 16 -945 -2 -520 -9 -928 -17 -906 -14 35 -16 35 -28 3 -16 -41 3 -132 28 -132 9 0 12 -14 5 -30 -8 -23 -2 -27 24 -17 23 9 31 6 22 -8 -19 -31 110 -125 172 -125 93 0 265 199 244 280 -7 28 -13 76 -14 107 0 36 -6 47 -16 31 -41 -66 -50 1644 -9 1847 13 70 8 81 -65 155 -44 43 -74 85 -67 93 7 7 -4 8 -23 1 -19 -7 -35 -4 -35 7 0 19 -61 22 -125 5 z m153 -178 c18 -48 14 -98 -9 -121 -47 -47 -27 -1867 20 -1901 50 -34 52 -80 8 -129 -80 -88 -201 3 -141 106 57 100 52 1876 -6 1912 -44 28 -53 104 -16 141 35 35 130 30 144 -8 z"
