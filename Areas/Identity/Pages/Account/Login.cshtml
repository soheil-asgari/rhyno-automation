@page
@model LoginModel
@using OfficeAutomation.Services.Tenancy
@inject ITenantSettingsService TenantSettingsService
@{
    Layout = null;
    OfficeAutomation.Models.SystemSetting? loginBranding = null;
    try { loginBranding = await TenantSettingsService.GetSystemSettingsAsync(); } catch { }
    var loginAppTitle = loginBranding?.ApplicationTitle ?? "راینو ERP";
    var loginBgUrl = loginBranding?.LoginBackgroundUrl;
    var loginLogoUrl = loginBranding?.LogoUrl;
    var loginFaviconUrl = loginBranding?.FaviconUrl;
    var loginPrimaryColor = loginBranding?.PrimaryColor;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود - @loginAppTitle</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(loginFaviconUrl))
    {
        <link rel="icon" href="@loginFaviconUrl" />
    }
    <style>
            @@font-face {
                font-family: 'Vazirmatn';
                src: url('/fonts/Vazir-Medium-FD-WOL.woff2') format('woff2');
                font-weight: 500;
                font-style: normal;
                font-display: swap;
            }

            :root {
                --rk-login-sky-1: #3a8cc7;
                --rk-login-sky-2: #7eb8dd;
                --rk-login-sky-3: #c8d9e8;
                --rk-login-sky-4: #e6d3d3;
                --rk-login-card: rgba(255, 255, 255, 0.72);
                --rk-login-card-solid: #f7fafc;
                --rk-login-input: rgba(255, 255, 255, 0.88);
                --rk-login-border: rgba(255, 255, 255, 0.55);
                --rk-login-text: #182a38;
                --rk-login-muted: #56738e;
                --rk-login-primary:
                    @(string.IsNullOrWhiteSpace(loginPrimaryColor)
                    ?
        "#2b7cb3" :
                    loginPrimaryColor)
                ;
            }

            * {
                box-sizing: border-box;
            }

            html,
            body {
                height: 100%;
                margin: 0;
            }

            body {
                font-family: 'Vazirmatn', 'Tahoma', 'Segoe UI', sans-serif;
                color: var(--rk-login-text);
                background: @(!string.IsNullOrWhiteSpace(loginBgUrl) ? $"url('{loginBgUrl}') no-repeat center center fixed" : "linear-gradient(160deg, #e8eef3 0%, #dce3ea 30%, #c8d6e0 65%, #e0e5eb 100%)");
                background-size: cover;
                min-height: 100vh;
                overflow: hidden;
                position: relative;
                display: grid;
                place-items: center;
            }

            /* subtle dot pattern overlay */
            body::after {
                content: '';
                position: fixed;
                inset: 0;
                z-index: 0;
                opacity: 0.12;
                background-image: radial-gradient(circle, #4a7a94 0.8px, transparent 0.8px);
                background-size: 28px 28px;
                pointer-events: none;
            }

            /* ambient glows */
            .ambient-glow {
                position: fixed;
                z-index: 0;
                width: 50vw;
                height: 50vw;
                max-width: 600px;
                max-height: 600px;
                border-radius: 50%;
                pointer-events: none;
                filter: blur(100px);
                opacity: 0.20;
            }

            .ambient-glow.top-right {
                right: -10%;
                top: -15%;
                background: radial-gradient(circle, rgba(43, 124, 179, 0.45), transparent 70%);
            }

            .ambient-glow.bottom-left {
                left: -8%;
                bottom: -12%;
                background: radial-gradient(circle, rgba(197, 139, 77, 0.30), transparent 70%);
            }

            .login-wrapper {
                position: relative;
                z-index: 2;
                width: min(800px, 96vw);
                min-height: 400px;
                display: grid;
                grid-template-columns: 0.85fr 1.15fr;
                gap: 12px;
                padding: 12px;
                animation: loginEnter 0.5s ease-out;
            }

            @@keyframes loginEnter {
                from { opacity: 0; transform: translateY(12px); }
                to   { opacity: 1; transform: translateY(0); }
            }

            /* Left panel — login form card */
            .login-card {
                border-radius: 14px;
                background: var(--rk-login-card);
                backdrop-filter: blur(24px) saturate(130%);
                -webkit-backdrop-filter: blur(24px) saturate(130%);
                border: 1px solid var(--rk-login-border);
                border-top: 3px solid var(--rk-login-primary);
                box-shadow: 0 16px 50px rgba(0, 0, 0, 0.08);
                padding: 28px 24px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                order: 1;
                position: relative;
            }

            /* subtle shimmer on card */
            .login-card::before {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: 14px;
                background: linear-gradient(180deg, rgba(255,255,255,0.25) 0%, transparent 25%);
                pointer-events: none;
            }

            /* Right panel — branding / empty visual like Rahkaran */
            .login-visual {
                order: 2;
                border-radius: 14px;
                background: linear-gradient(160deg, #1b4a5a 0%, #153a48 40%, #0e2a36 100%);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.15);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 28px;
                color: #fff;
                box-shadow: 0 12px 40px rgba(15, 30, 40, 0.15);
                position: relative;
                overflow: hidden;
            }

            /* subtle glow orb in visual panel */
            .login-visual::before {
                content: '';
                position: absolute;
                width: 200px;
                height: 200px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(197, 139, 77, 0.22), transparent 70%);
                right: -40px;
                bottom: -60px;
                pointer-events: none;
            }

            .login-visual .brand-lockup {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .login-visual .brand-logo {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                background: rgba(255, 255, 255, 0.92);
                display: grid;
                place-items: center;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.10);
            }

            .login-visual .brand-logo img {
                max-width: 80%;
                max-height: 80%;
                object-fit: contain;
            }

            .login-visual .brand-logo .fallback {
                color: var(--rk-login-primary);
                font-size: 22px;
                font-weight: 700;
            }

            .login-visual .brand-title {
                font-size: 1.15rem;
                font-weight: 700;
                letter-spacing: -0.02em;
                text-shadow: 0 2px 4px rgba(0, 0, 0, 0.12);
            }

            .login-visual .brand-subtitle {
                font-size: 0.7rem;
                opacity: 0.82;
                margin-top: 2px;
            }

            .login-visual .hero-copy h1 {
                margin: 0;
                font-size: 1.1rem;
                font-weight: 700;
                line-height: 1.35;
                text-shadow: 0 2px 6px rgba(0, 0, 0, 0.10);
            }

            .login-visual .hero-copy p {
                margin: 8px 0 0;
                font-size: 0.72rem;
                line-height: 1.8;
                opacity: 0.85;
                max-width: 420px;
            }

            .login-visual .hero-divider {
                width: 48px;
                height: 2px;
                margin-top: 20px;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.30);
            }


            .form-head {
                text-align: center;
                margin-bottom: 16px;
            }

            .form-head h1 {
                margin: 0;
                font-size: 1.05rem;
                font-weight: 700;
                color: var(--rk-login-text);
            }

            .form-head h2 {
                margin: 4px 0 0;
                font-size: 0.7rem;
                font-weight: 500;
                color: var(--rk-login-muted);
            }

            .form-head hr {
                width: 36px;
                height: 2px;
                border: 0;
                border-radius: 999px;
                background: var(--rk-login-primary);
                opacity: 0.5;
                margin: 12px auto 0;
            }

            .form-group {
                margin-bottom: 10px;
            }

            .form-group label {
                display: block;
                font-size: 0.7rem;
                font-weight: 600;
                color: var(--rk-login-muted);
                margin-bottom: 4px;
            }

            .input-wrap {
                position: relative;
            }

            .input-wrap i {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 0.8rem;
                transition: color 0.2s ease;
                pointer-events: none;
            }

            .input-wrap:focus-within i {
                color: var(--rk-login-primary);
            }

            .form-control {
                width: 100%;
                height: 40px;
                padding: 8px 34px 8px 10px;
                border: 1px solid rgba(148, 163, 184, 0.35);
                border-radius: 8px;
                background: #f8fafc;
                color: var(--rk-login-text);
                font-size: 0.82rem;
                font-weight: 500;
                font-family: inherit;
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
                box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.04);
            }

            .form-control:hover {
                border-color: rgba(148, 163, 184, 0.55);
                background: #fefefe;
            }

            .form-control:focus {
                background: #fff;
                border-color: var(--rk-login-primary);
                box-shadow: 0 0 0 3px rgba(43, 124, 179, 0.10), inset 0 1px 2px rgba(0, 0, 0, 0.04);
            }

            .form-control::placeholder {
                color: #94a3b8;
                opacity: 1;
            }

            .login-options {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                margin: 2px 0 12px;
            }

            .remember-check {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                cursor: pointer;
                font-size: 0.68rem;
                font-weight: 500;
                color: var(--rk-login-muted);
            }

            .remember-check input {
                width: 14px;
                height: 14px;
                accent-color: var(--rk-login-primary);
                cursor: pointer;
            }

            .forgot-link {
                font-size: 0.68rem;
                font-weight: 600;
                color: var(--rk-login-primary);
                text-decoration: none;
            }

            .forgot-link:hover {
                text-decoration: underline;
            }

            .btn-login {
                width: 100%;
                height: 40px;
                border: 0;
                border-radius: 8px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                color: #fff;
                background: linear-gradient(135deg, var(--rk-login-primary) 0%, #1a5c8a 100%);
                box-shadow: 0 4px 14px rgba(43, 124, 179, 0.20);
                font-size: 0.84rem;
                font-weight: 700;
                cursor: pointer;
                transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
                letter-spacing: -0.01em;
            }

            .btn-login i {
                font-size: 0.95rem;
                transition: transform 0.2s ease;
            }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 22px rgba(43, 124, 179, 0.28);
                opacity: 0.95;
            }

            .btn-login:hover i {
                transform: translateX(-2px);
            }

            .btn-login:active {
                transform: translateY(0);
                box-shadow: 0 2px 8px rgba(43, 124, 179, 0.16);
            }

            .validation-summary {
                margin-bottom: 8px;
                padding: 7px 10px;
                border-radius: 8px;
                background: rgba(192, 57, 43, 0.10);
                border: 1px solid rgba(192, 57, 43, 0.22);
                color: #a03025;
                font-size: 0.68rem;
                font-weight: 500;
                line-height: 1.5;
            }

            .validation-summary:empty,
            .validation-summary-valid {
                display: none !important;
            }

            .login-footer {
                margin-top: 14px;
                text-align: center;
                font-size: 0.65rem;
                font-weight: 500;
                color: var(--rk-login-muted);
            }

            /* Responsive */
            @@media (max-width: 900px) {
                .login-wrapper {
                    grid-template-columns: 1fr;
                    max-width: 400px;
                }

                .login-visual {
                    display: none;
                }

                .login-card {
                    padding: 22px 18px;
                }
            }
    </style>
</head>

<body>
    <div class="ambient-glow top-right"></div>
    <div class="ambient-glow bottom-left"></div>

    <main class="login-wrapper">
        <!-- Left visual panel -->
        <section class="login-visual">
            <div class="brand-lockup">
                <div class="brand-logo">
                    @if (!string.IsNullOrWhiteSpace(loginLogoUrl))
                    {
                        <img src="@loginLogoUrl" alt="@loginAppTitle"
                             onerror="this.style.display='none';this.parentElement.querySelector('.fallback').style.display='grid'" />
                        <span class="fallback" style="display:none;">R</span>
                    }
                    else
                    {
                        <span class="fallback"><i class="bi bi-grid-3x3-gap-fill"></i></span>
                    }
                </div>
                <div>
                    <div class="brand-title">@loginAppTitle</div>
                    <div class="brand-subtitle">سامانه یکپارچه مدیریت سازمانی</div>
                </div>
            </div>

            <div class="hero-copy">
                <h1>به داشبورد سازمانی خوش آمدید</h1>
                <p>برای دسترسی به اطلاعات مالی، منابع انسانی، انبارداری و گزارش‌های مدیریتی، لطفاً با حساب کاربری خود
                    وارد شوید.</p>
                </div>

                <div class="hero-divider"></div>
            </section>

            <!-- Right login form panel -->
            <section class="login-card">
                <div class="form-head">
                    <h1>ورود کاربران</h1>
                    <h2>لطفا مشخصات حساب کاربری خود را وارد نمایید</h2>
                    <hr />
                </div>

                <form method="post" id="account">
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                    <div class="form-group">
                        <label asp-for="Input.Email">نام کاربری یا ایمیل</label>
                        <div class="input-wrap">
                            <i class="bi bi-person"></i>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username"
                                   placeholder="نام کاربری خود را وارد کنید" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger"
                              style="font-size:0.72rem;color:#a03025;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password">کلمه عبور</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Input.Password" type="password" class="form-control"
                                   autocomplete="current-password" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"
                              style="font-size:0.72rem;color:#a03025;"></span>
                    </div>

                    <div class="login-options">
                        <label class="remember-check">
                            <input asp-for="Input.RememberMe" />
                            <span>مرا به خاطر بسپار</span>
                        </label>
                        <a asp-area="Identity" asp-page="/Account/ForgotPassword" class="forgot-link">فراموشی رمز عبور؟</a>
                    </div>

                    <button type="submit" class="btn-login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>ورود به سامانه</span>
                    </button>
                </form>

                <div class="login-footer">
                    @loginAppTitle &mdash; نسخه ۱.۰ &copy; @DateTime.Now.Year
                </div>
            </section>
        </main>

        <script src="https://code.jquery.com/jquery-3.7.1.min.js"
                integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
        <partial name="_ValidationScriptsPartial" />
    </body>

</html>
