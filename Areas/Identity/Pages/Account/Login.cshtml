@page
@model LoginModel
@using OfficeAutomation.Services.Tenancy
@inject ITenantSettingsService TenantSettingsService
@{
    Layout = null;
    OfficeAutomation.Models.SystemSetting? loginBranding = null;
    try { loginBranding = await TenantSettingsService.GetSystemSettingsAsync(); } catch { }
    var loginAppTitle = loginBranding?.ApplicationTitle ?? "راینو";
    var loginFaviconUrl = loginBranding?.FaviconUrl;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود به سامانه - @loginAppTitle</title>

    @if (!string.IsNullOrWhiteSpace(loginFaviconUrl))
    {
        <link rel="icon" href="@loginFaviconUrl" />
    }

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />
    <!-- Rahkaran & Exact SVG Artista Stylesheet -->
    <link rel="stylesheet" href="~/css/account-login-rahkaran.css" asp-append-version="true" />
</head>

<body class="rahkaran-body">

    <!-- Geometric Light & Sky Mesh Background -->
    <div class="rahkaran-bg-ambient">
        <div class="poly-facet facet-left"></div>
        <div class="poly-facet facet-right"></div>
        <div class="light-beam-overlay"></div>
    </div>

    <!-- Main Workspace Center Stage -->
    <main class="rahkaran-viewport">
        <div class="rahkaran-stage-grid">

            <!-- Right: Exact Rhyno AI Logo with Custom SVG Artista Animations & Palette -->
            <!-- Right: Exact Rhyno AI Logo with Custom SVG Artista Animations & Palette -->
            <!-- Right: Exact Rhyno AI Logo with Custom SVG Artista Animations & Palette -->
            <!-- Right: Exact Rhyno AI Logo with Custom SVG Artista Animations & Palette -->
            <section class="brand-panel">
                <div class="logo-wrapper">
                    <div class="rhyno-ai-emblem">

                        <!-- سایز دلخواه پیکسلی برای بزرگ کردن لوگو -->
