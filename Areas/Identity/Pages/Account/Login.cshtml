@page
@model LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود - راینو ERP</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <style>
        .auth-bg-pattern {
            background-image: radial-gradient(circle at 1px 1px, rgba(148,163,184,0.12) 1px, transparent 0);
            background-size: 24px 24px;
        }
    </style>
</head>
<body class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased auth-bg-pattern">
    <main class="min-h-screen flex items-center justify-center px-4 py-10">
        <section class="w-full max-w-md">

            <!-- Logo & Brand -->
            <div class="flex items-center justify-center gap-3 mb-8">
                <span class="w-10 h-10 rounded-xl bg-slate-900 dark:bg-teal-500 text-white dark:text-slate-950 flex items-center justify-center text-base font-black shadow-md">R</span>
                <div>
                    <span class="block text-sm font-black text-slate-900 dark:text-white tracking-tight">راینو ERP</span>
                    <span class="block text-[10px] text-slate-400 dark:text-slate-500 font-medium">سامانه جامع اتوماسیون اداری</span>
                </div>
            </div>

            <!-- Login Card -->
            <div class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-xl p-8 sm:p-10 space-y-6">

                <!-- Card Header -->
                <div class="space-y-1">
                    <h1 class="text-xl font-black text-slate-900 dark:text-white tracking-tight">خوش آمدید</h1>
                    <p class="text-sm text-slate-500 dark:text-slate-400">برای ادامه، وارد حساب کاربری خود شوید.</p>
                </div>

                <!-- Validation Summary -->
                <div asp-validation-summary="All"
                     class="flex items-start gap-2.5 px-3 py-2.5 border border-rose-200 dark:border-rose-800/60 bg-rose-50 dark:bg-rose-950/30 rounded-xl text-xs text-rose-700 dark:text-rose-300 empty:hidden">
                </div>

                <!-- Form -->
                <form method="post" class="space-y-5">

                    <!-- Email / Username -->
                    <div class="space-y-1.5">
                        <label asp-for="Input.Email" class="block text-xs font-bold text-slate-700 dark:text-slate-300">نام کاربری یا ایمیل</label>
                        <input asp-for="Input.Email"
                               autocomplete="username"
                               placeholder="name@company.com"
                               dir="ltr"
                               class="w-full h-12 px-4 text-sm font-mono text-left bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl outline-none placeholder:text-slate-400 dark:placeholder:text-slate-600 text-slate-900 dark:text-slate-100 focus:border-teal-400 dark:focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 focus:bg-white dark:focus:bg-slate-800 transition" />
                        <span asp-validation-for="Input.Email" class="block text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span>
                    </div>

                    <!-- Password -->
                    <div class="space-y-1.5">
                        <label asp-for="Input.Password" class="block text-xs font-bold text-slate-700 dark:text-slate-300">رمز عبور</label>
                        <input asp-for="Input.Password"
                               type="password"
                               autocomplete="current-password"
                               placeholder="••••••••"
                               class="w-full h-12 px-4 text-sm bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl outline-none placeholder:text-slate-400 dark:placeholder:text-slate-600 text-slate-900 dark:text-slate-100 focus:border-teal-400 dark:focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 focus:bg-white dark:focus:bg-slate-800 transition" />
                        <span asp-validation-for="Input.Password" class="block text-[11px] font-semibold text-rose-600 dark:text-rose-400"></span>
                    </div>

                    <!-- Remember Me & Forgot -->
                    <div class="flex items-center justify-between gap-3">
                        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                            <input asp-for="Input.RememberMe"
                                   type="checkbox"
                                   class="w-4 h-4 rounded border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-teal-600 focus:ring-2 focus:ring-teal-500/20 accent-teal-600" />
                            <span class="text-xs font-semibold text-slate-600 dark:text-slate-400">مرا به خاطر بسپار</span>
                        </label>
                        <a asp-area="Identity" asp-page="/Account/ForgotPassword"
                           class="text-xs font-bold text-teal-600 dark:text-teal-400 hover:underline no-underline transition">
                            فراموشی رمز عبور؟
                        </a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit"
                            class="w-full py-3 px-4 bg-teal-600 hover:bg-teal-700 active:bg-teal-800 text-white text-sm font-black rounded-xl transition-colors duration-150 shadow-sm flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-teal-500/30">
                        <i class="bi bi-box-arrow-in-right text-base"></i>
                        <span>ورود به سیستم</span>
                    </button>
                </form>
            </div>

            <!-- Footer note -->
            <p class="mt-6 text-center text-[11px] text-slate-400 dark:text-slate-600">
                Rhyno Automation &mdash; Secure Workspace &copy; @DateTime.Now.Year
            </p>

        </section>
    </main>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
