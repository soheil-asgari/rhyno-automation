@page
@model LoginModel
@using OfficeAutomation.Services.Tenancy
@inject ITenantSettingsService TenantSettingsService
@{
    Layout = null;
    OfficeAutomation.Models.SystemSetting? loginBranding = null;
    try { loginBranding = await TenantSettingsService.GetSystemSettingsAsync(); } catch { }
    var loginAppTitle = loginBranding?.ApplicationTitle ?? "راینو";
    var loginFaviconUrl = loginBranding?.FaviconUrl;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود به سامانه - @loginAppTitle</title>

    @if (!string.IsNullOrWhiteSpace(loginFaviconUrl))
    {
        <link rel="icon" href="@loginFaviconUrl" />
    }

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />
    <!-- Rahkaran & Exact SVG Artista Stylesheet -->
    <link rel="stylesheet" href="~/css/account-login-rahkaran.css" asp-append-version="true" />
</head>

<body class="rahkaran-body">

    <!-- Geometric Light & Sky Mesh Background -->
    <div class="rahkaran-bg-ambient">
        <div class="poly-facet facet-left"></div>
        <div class="poly-facet facet-right"></div>
        <div class="light-beam-overlay"></div>
    </div>

    <!-- Main Workspace Center Stage -->
    <main class="rahkaran-viewport">
        <div class="rahkaran-stage-grid">

            <!-- Right: Modern Animated Text Brand Panel -->
            <section class="brand-panel">
                <div class="brand-text-wrap">
                    <div class="brand-ambient-glow"></div>
                    <h1 class="brand-title-en">RHYNO AI</h1>
                    <div class="brand-separator-line"></div>
                    <p class="brand-title-fa">نوآوران هوش مصنوعی ارمغان</p>
                </div>
            </section>

            <!-- Left: Minimalist Rahkaran Form -->
            <section class="form-panel">
                <header class="form-title-group">
                    <h2 class="form-main-heading">ورود کاربران</h2>
                    <p class="form-sub-heading">لطفاً مشخصات حساب کاربری خود را وارد نمایید</p>
                </header>

                <form method="post" id="rahkaranLoginForm" class="form-stack" novalidate>
                    <!-- Server Errors Summary -->
                    <div asp-validation-summary="ModelOnly" class="form-alert-banner" role="alert"></div>

                    <!-- Input 1: Username / Email -->
                    <div class="field-item">
                        <div class="rahkaran-input-box">
                            <span class="field-icon-lead"><i class="bi bi-person"></i></span>
                            <span class="field-pipe"></span>
                            <input asp-for="Input.Email" autocomplete="username" placeholder="نام کاربری"
                                   class="raw-text-input" dir="ltr" autofocus />
                        </div>
                        <span asp-validation-for="Input.Email" class="val-error-text"></span>
                    </div>

                    <!-- Input 2: Password with Rahkaran Circular Action Button -->
                    <div class="field-item">
                        <div class="password-action-row">
                            <button type="submit" id="btnSubmit" class="rahkaran-submit-btn" title="ورود به سامانه">
                                <i class="bi bi-chevron-left arrow-icon"></i>
                                <span class="spin-ring" style="display: none;"></span>
                            </button>

                            <div class="rahkaran-input-box password-box">
                                <span class="field-icon-lead"><i class="bi bi-lock"></i></span>
                                <span class="field-pipe"></span>
                                <input asp-for="Input.Password" id="pwdField" type="password"
                                       autocomplete="current-password" placeholder="کلمه عبور"
                                       class="raw-text-input pass-font" dir="ltr" />
                                <button type="button" id="pwdToggleBtn" class="pass-peek-btn" tabindex="-1">
                                    <i class="bi bi-eye" id="togglePassIcon"></i>
                                </button>
                            </div>
                        </div>
                        <div id="capsLockAlert" class="caps-warning" style="display: none;">
                            <i class="bi bi-capslock-fill"></i> کلید Caps Lock روشن است
                        </div>
                        <span asp-validation-for="Input.Password" class="val-error-text"></span>
                    </div>

                    <!-- Options: Remember Me & Forgot Password -->
                    <div class="form-meta-row">
                        <label class="custom-check-wrap">
                            <input asp-for="Input.RememberMe" type="checkbox" />
                            <span class="check-box-square"></span>
                            <span class="check-label-text">مرا به خاطر بسپار</span>
                        </label>
                        <a asp-page="./ForgotPassword" class="forgot-pass-anchor">فراموشی رمز عبور؟</a>
                    </div>
                </form>
            </section>

        </div>
    </main>

    <!-- Rahkaran Enterprise Dock -->
    <footer class="rahkaran-footer-dock">
        <div class="dock-content">
            <div class="dock-right">
                <div class="dock-brand-badge">
                    <span class="dock-icon">R</span>
                    <span>سامانه یکپارچه راینو &mdash; نسخه ۲.۴</span>
                </div>
            </div>
            <div class="dock-left">
                <span class="lang-text"><i class="bi bi-globe2"></i> فارسی</span>
                <span class="dock-dot">•</span>
                <span>&copy; @DateTime.Now.Year نوآوران هوش مصنوعی ارمغان</span>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account-login.js" asp-append-version="true"></script>
</body>

</html>