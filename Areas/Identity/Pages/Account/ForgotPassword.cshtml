@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "بازیابی رمز عبور";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - راینو ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-auth-modern.css" asp-append-version="true" />
</head>
<body class="auth-body flex-center">

    <div class="glow-sphere glow-top"></div>
    <div class="glow-sphere glow-bottom"></div>
    <div class="grid-pattern-overlay"></div>

    <main class="single-card-wrap">
        <div class="auth-card-panel standalone-card">
            
            <div class="auth-card-header text-center">
                <div class="icon-avatar-badge">
                    <i class="bi bi-key-fill"></i>
                </div>
                <h1 class="card-title">بازیابی رمز عبور</h1>
                <p class="card-desc">ایمیل متصل به حساب خود را وارد نمایید تا لینک بازنشانی رمز عبور ارسال شود.</p>
            </div>

            <form method="post" id="forgotPassForm" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="auth-alert danger" role="alert"></div>

                <div class="form-field">
                    <label asp-for="Input.Email" class="field-label">ایمیل سازمانی</label>
                    <div class="input-container">
                        <i class="bi bi-envelope-at-fill input-icon"></i>
                        <input asp-for="Input.Email" 
                               autocomplete="username" 
                               aria-required="true"
                               placeholder="name@company.com" 
                               class="field-input" 
                               dir="ltr" 
                               autofocus />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <button type="submit" id="submitBtn" class="btn-primary-auth">
                    <span class="btn-text">ارسال لینک بازیابی</span>
                    <i class="bi bi-send-fill btn-icon"></i>
                    <div class="btn-loader" style="display: none;">
                        <span class="spinner"></span>
                        <span>در حال ارسال...</span>
                    </div>
                </button>
            </form>

            <div class="card-divider-link">
                <a asp-page="./Login" class="return-link">
                    <i class="bi bi-arrow-right"></i>
                    <span>بازگشت به صفحه ورود</span>
                </a>
            </div>

            <footer class="auth-card-footer">
                <span>سامانه یکپارچه اداری راینو &copy; @DateTime.Now.Year</span>
            </footer>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('forgotPassForm')?.addEventListener('submit', function () {
            if ($(this).valid()) {
                const btn = document.getElementById('submitBtn');
                btn.disabled = true;
                btn.querySelector('.btn-text').style.display = 'none';
                btn.querySelector('.btn-icon').style.display = 'none';
                btn.querySelector('.btn-loader').style.display = 'flex';
            }
        });
    </script>
</body>
</html>