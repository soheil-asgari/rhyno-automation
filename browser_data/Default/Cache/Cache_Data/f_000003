label {
    position: relative;
    display: inline-table;
    text-align: center;
    font-weight: 500;
    cursor: pointer;
    color: #adabab;
    -webkit-transition: 300ms ease;
    transition: 300ms ease;
    width: calc(100% / 4 - 4px);
    font-size: 14px;
    padding: 2px 0;
}

    label:after {
        content: '';
        border: 10px solid transparent;
        position: absolute;
        bottom: -16px;
        left: calc(50% - 10px);
        -webkit-transition: inherit;
        transition: inherit;
    }
    label[for="sign-in"],
    label[for="sign-up"],
    label[for="change"],
    label[for="reset"] {
        color: #fff;
        background: #a5aeb775;
        border-radius: 7px;
    }
