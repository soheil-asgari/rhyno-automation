function runMouse(element) {
    var el=$(element).attr('data-default')
    var dataid =parseInt(el===null?0:el);
    var allowedClasses = ["Control-Item", "Mouse", "active"];
    var currentClasses = $(element).attr('class').split(' ');
    var classesToRemove = currentClasses.filter(cls => !allowedClasses.includes(cls));
    $(element).removeClass(classesToRemove.join(' '));

    $('body').removeClass('big-cursor');
    $('.reading-mask, .reading-guide').remove();
    $(document).off('mousemove', moveReadingMask);

    if (dataid == 1) {
        $('body').addClass('big-cursor');
        $(element).addClass('step1');
    } else if (dataid == 2) {
        if (!$('.reading-guide').length) {
            $('body').append(`
                <div class="reading-guide">
                    <div class="ruler-pointer"></div>
                </div>
            `);
        }
        $(element).addClass('step2');
        $(document).on('mousemove', moveReadingGuide);
    } else if (dataid == 3) {
        if (!$('.reading-mask').length) {
            $('body').append('<div class="reading-mask"></div>');
        }
        $(element).addClass('step3');
        $(document).on('mousemove', moveReadingMask);
    }
}
function moveReadingMask(e) {
    $('.reading-mask').css('top', e.clientY + 'px');
}
function moveReadingGuide(e) {
    var guide = $('.reading-guide');
    var guideWidth = guide.outerWidth();
    var newX = e.clientX - guideWidth / 2;
    var newY = e.clientY;

    guide.css({
        top: newY + 'px',
        left: newX + 'px'
    });
}

