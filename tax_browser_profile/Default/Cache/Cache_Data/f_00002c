function activeControl(element) {

    var isactive = element.getAttribute('data-default') > 0;
    if (!isactive) {
        $(element).removeClass('active');
        $(element).find('.activeated').remove();
    } else {
        $(element).addClass('active');
        $(element).find('.activeated').remove();
        $(element).append(`
            <span class="activeated">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 8" width="100%" height="100%">
                    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="m1.5 4.5 2 2 5-5"></path>
                </svg>
            </span>
        `);
    }
}
function saveState() {
    var states = {};
    $('.Control-Item').each(function () {
        var className = $(this).attr('class').split(' ')
            .filter(cls => cls !== 'Control-Item' && cls !== 'active' && cls !== 'step1' && cls !== 'step2' && cls !== 'step3')
            .join(' ');
        var dataDefault = $(this).attr('data-default');
        var isActive = $(this).attr('data-default') > 0;
        states[className] = { dataDefault, isActive };
    });
    localStorage.setItem('controlStates', JSON.stringify(states));
}
function restoreState() {
    var savedStates = JSON.parse(localStorage.getItem('controlStates')) || {};

    $('.Control-Item').each(function () {
        var className = $(this).attr('class').split(' ')
            .filter(cls => cls !== 'Control-Item' && cls !== 'active' && cls !== 'step1' && cls !== 'step2' && cls !== 'step3')
            .join(' ');

        if (savedStates[className]) {
            $(this).attr('data-default', savedStates[className].dataDefault);

            if (savedStates[className].isActive) {
                activeControl(this)
            } else {
                $(this).removeClass('active');
            }

            if (savedStates[className].isActive && run[className]) {
                run[className](this);
            }
        }
    });
    if (savedStates["Color"] && savedStates["Color"].selectedColor) {
        var colorClass = "color-" + savedStates["Color"].selectedColor
        //$("body").addClass(colorClass);
        $(".ColorChange").addClass(colorClass);
    }
}

function showlinks(element) {
    var dataid = $(element).attr('data-default');
    if (dataid == 0) {
       // $('a, a *').css({
        //    "color": "",
        //    "background-color": ""
        //})
        $.each($('a'), function (index, value) { $('a')[index].style.setProperty('color', '') });
        $.each($('a'), function (index, value) { $('a')[index].style.setProperty('background-color', '') });
    } else {
        dataid = Number(dataid) + 1;
        //$('a, a *').css({
        //    "color": "#ff0",
         //   "background-color": "#333"
        //})
         $.each($('a'), function (index, value) { $('a')[index].style.setProperty('color', '#ff0') });
        $.each($('a'), function (index, value) { $('a')[index].style.setProperty('background-color', '#333') });
    }
}

function runContrast(element) {
    var dataid = $(element).attr('data-default');
    var allowedClasses = ["Control-Item", "Contrast", "active"];
    var currentClasses = $(element).attr('class').split(' ');
    var classesToRemove = currentClasses.filter(cls => !allowedClasses.includes(cls));
    $(element).removeClass(classesToRemove.join(' '));
    if (dataid == 0) {
        $('body').css({
            "filter": "",
            "-webkit-filter": ""
        });
    } else if (dataid == 1) {
        $('body').css({
            "filter": "invert(100%)",
            "-webkit-filter": "invert(100%)"
        });
        $(element).addClass('step1');
    } else if (dataid == 2) {
        $('body').css({
            "filter": "invert(100%) brightness(1.5)",
            "-webkit-filter": "invert(100%) brightness(1.5)"
        });
        $(element).addClass('step2');
    } else if (dataid == 3) {
        $('body').css({
            "filter": "invert(100%) contrast(1.5)",
            "-webkit-filter": "invert(100%) contrast(1.5)"
        });
        $(element).addClass('step3');
    }
}
