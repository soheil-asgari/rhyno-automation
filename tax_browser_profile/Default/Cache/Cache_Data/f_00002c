$(document).on('click', '.WebAccessibilityButton', function (e) {
    $('.WebAccessibilityControl').toggleClass('active');
    e.stopPropagation();
});
$(document).on('click', '.CloseBtn', function (e) {
    $('.WebAccessibilityControl').removeClass('active');
});
$(document).on("mouseup", function (e) {
    if (
        $('.WebAccessibilityControl').hasClass('active') &&
        !$(e.target).closest('.WebAccessibilityButton, .WebAccessibilityControl').length
    ) {
        $('.WebAccessibilityControl').removeClass("active");
    }
});
const textSteps = {
    Contrast: ["کنتراست +", "رنگ های معکوس", "تضاد کنتراست", "کنتراست روشن"],
    Links: ["پیوندهای برجسته", "پیوندهای برجسته"],
    FontSize: ["متن بزرگتر", "متن بزرگ", "متن خیلی بزرگ", "بزرگترین متن"],
    LetterSpace:["فاصله متن","با فاصله","فاصله متوسط","فاصله زیاد"]

};
const initFontSize ="12px";
$(document).ready(function () {
    $(".Control-Item").each(function () {
        var item = $(this);
        var type = item.attr("class").split(" ")[1]; // گرفتن نام نوع (Contrast, Links, FontSize)
        var maxStep = parseInt(item.attr("max-step"), 10); // دریافت مقدار max-step
        var currentStep = parseInt(item.attr("data-default"), 10); // مقدار اولیه

        // تابع تغییر متن
        function updateText(step) {
            if (textSteps[type] && textSteps[type][step]) {
                item.find(".text").text(textSteps[type][step]);
            }
        }

        // مقداردهی اولیه
        updateText(currentStep);

        // تغییر استپ با کلیک (یا هر رویداد دیگر)
        item.on("click", function () {
            currentStep = (currentStep + 1) % (maxStep + 1); // چرخش بین استپ‌ها
            updateText(currentStep);
        });
    });
});

