function runAll() {
    $(".ColorChange").removeClass('color-blue');
    $(".ColorChange").removeClass('color-pink');
    $(".ColorChange").removeClass('color-orange');
    $(".ColorChange").removeClass('color-green');
    $(".ColorChange").removeClass('color-black');
    localStorage.setItem('controlStates', JSON.stringify(''));
