            //$("body").addClass("color-" + colorClass);
            $(".ColorChange").addClass("color-" + colorClass);

            $(this).addClass("selected");
            var state = JSON.parse(localStorage.getItem("controlStates")) || {};
            if (!state["Color"]) state["Color"] = {};

            state["Color"].selectedColor = colorClass;
            state["Color"].isActive = true;

            localStorage.setItem("controlStates", JSON.stringify(state));
        });
   // });
}

