    var currentClasses = $(element).attr('class').split(' ');
    var classesToRemove = currentClasses.filter(cls => !allowedClasses.includes(cls));
    $(element).removeClass(classesToRemove.join(' '));
    $(element).removeClass('step1');
    if (dataid == 0) {
        var currentFilter = $('body').css('filter');
        if (currentFilter !== 'none' && currentFilter !== '') {
            currentFilter = currentFilter.replace(/grayscale\(1\)/g, '').trim();
        }
        if (currentFilter === '') {
            currentFilter = 'none';
        }
        $('body').css({
            "filter": currentFilter,
            "-webkit-filter": currentFilter
        });
    } else {
        var currentFilter = $('body').css('filter');
        if (currentFilter === 'none') currentFilter = '';
        $('body').css({
            "filter": currentFilter + " grayscale(1)",
            "-webkit-filter": currentFilter + " grayscale(1)"
        });
        $(element).addClass('step1');
    }
