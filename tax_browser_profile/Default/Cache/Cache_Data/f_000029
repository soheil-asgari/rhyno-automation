function addCode(msg, id) {
    var jcCode = $.confirm({
        title: 'تایید نهایی',
        type: 'dark',
        content: msg +
            '<form action="" class="formName">' +
            '<div class="form-group">' +
            '<input maxlength="6" type="text" placeholder="کد رمز" class="name form-control" required />' +
            '</div>' +
            '</form>',
        autoClose: 'انصراف|120000',
        columnClass: 'col-md-6 col-md-offset-2',
        buttons: {
            deleteUser: {
                text: 'ثبت کد',
                btnClass: 'btnTax btn-conf',
                action: function () {
                    var code = this.$content.find('.name').val();
                    if (!code) {
                        $.alert({ title: '', columnClass: 'col-md-4 col-md-offset-3', type: 'red', buttons: { ok: { text: 'بستن', action: function () { } } }, content: ('کد رمز وارد نشده است.'), rtl: true });
                        return false;
                    } else if (code.length != 6) {
                        $.alert({ title: '', columnClass: 'col-md-4 col-md-offset-3', type: 'red', buttons: { ok: { text: 'بستن', action: function () { } } }, content: ('کد رمز 6 کارکتر می باشد.'), rtl: true });
                        return false;
                    }
                    else
                    {
                        $.ajax({
                            type: "POST",
                            url: "/Page/ConfirmAgent",
                            data: { Id: id, Code: code },
                            success: function (res) {
                                if (res.status) {
                                    window.location = window.location;
                                }
                                else {
                                    if (res.retry >= 3)
                                        jcCode.close();
                                    $.alert({ title: '', columnClass: 'col-md-4 col-md-offset-3', type: 'red', buttons: { ok: { text: 'بستن', action: function () { } } }, content: (res.msg), rtl: true });
                                    return false;
                                }
                            },
                            error: function (response) {
                                $.alert({ title: '', columnClass: 'col-md-6 col-md-offset-2', type: 'red', buttons: { ok: { text: 'بستن', action: function () { } } }, content: ('خطا در ارسال درخواست.'), rtl: true });
                            }
                        });
                    }
                    return false;
                }
            },
            انصراف: {
                text: 'انصراف',
                btnClass: 'btnTax btn-cancel',
                action: function () {
                    window.location = window.location;
                }
            }
        }
    });

    setTimeout(function () { jcCode.close(); }, 120000)
}

