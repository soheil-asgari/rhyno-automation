function loadDocTax() {
    $.ajax({
        url: "/Page/ListDoc",
        type: "GET",
        contentType: "application/json;charset=utf-8",
        dataType: "json",
        success: function (result) {
            var html = '';
            if (result.length == 0)
                html = '<span class="lblWarning">تاکنون پرونده عملکرد برای شما ثبت نشده است.</span>';
            var odd = 'odd';
            var disable = '';
            $.each(result, function (key, item) {

                odd = 'odd';
                disable = '';
                html += '<div class="col-xs-12 col-sm-6 col-md-6 col-lg-4 FR">';
                html += '<div class="docNationalId">';
                if (item.وضعیتپرونده == 'فعال')
                    html += '<span class="titleDoc">' + item.نامکسبوکار + '</span>';
                else {
                    html += '<span class="titleDoc titleDocDisable">' + item.نامکسبوکار + '</span>';
                    odd = 'oddDisable';
                    disable = 'disable';
                }
                html += '<span class="GamID ' + disable + '"> گام' + item.gamID + '</span>';
                html += '<div class="main">';
                html += '<div class="row">';
                html += '<div class="col-xs-5 col-xs-push-7 col-sm-5 col-sm-push-7 line"><b>شماره اقتصادی:</b></div>';
                html += '<div class="col-xs-7 col-xs-pull-5 col-sm-7 col-sm-pull-5"><b>' + item.economicNo + '</b></div>';
                html += '</div>';
                html += '<div class="row ' + odd + '">';
                html += '<div class="col-xs-5 col-xs-push-7 col-sm-5 col-sm-push-7 line">شماره رهگیری:</div>';

                if (item.tprstatus > 10)
                    html += '<div class="col-xs-7 col-xs-pull-5 col-sm-7 col-sm-pull-5">' + item.شمارهرهگیری + '</div>';
                else
                    html += '<div class="col-xs-7 col-xs-pull-5 col-sm-7 col-sm-pull-5"></div>';

                html += '</div>';
                html += '<div class="row">';
                html += '<div class="col-xs-5 col-xs-push-7 col-sm-5 col-sm-push-7 line">نوع پرونده:</div>';
                html += '<div class="col-xs-7 col-xs-pull-5 col-sm-7 col-sm-pull-5">' + item.نوعپرونده + '</div>';
                html += '</div>';
                html += '<div class="row ' + odd + '">';
                html += '<div class="col-xs-5 col-xs-push-7 col-sm-5 col-sm-push-7 line">سمت:</div>';
                html += '<div class="col-xs-7 col-xs-pull-5 col-sm-7 col-sm-pull-5">' + item.سمت + '</div>';
                html += '</div>';
                html += '<div class="row">';
                html += '<div class="col-xs-5 col-xs-push-7 col-sm-5 col-sm-push-7 line">شماره پستی:</div>';
                html += '<div class="col-xs-7 col-xs-pull-5 col-sm-7 col-sm-pull-5">' + item.شمارهپستی + '</div>';
                html += '</div>';
                html += '<div class="row ' + odd + '">';
                html += '<div class="col-xs-5 col-xs-push-7 col-sm-5 col-sm-push-7 line">وضعیت پرونده:</div>';
                html += '<div class="col-xs-7 col-xs-pull-5 col-sm-7 col-sm-pull-5">' + item.وضعیتپرونده + '</div>';
                html += '</div>';
                html += '</div>';
                html += ' <div class="btnBg btnLink ##">';
                //if (item.ssoLink !== null)
                //    html += '<a target="_blank" href="' + item.ssoLink + '">ورود به پرونده</a>|';
                //else
                //    html += '<a>...</a>|';
                //html += '<a class="btnTax ' + disable + '" onclick="DetailsDoc(\'' + item.tprID + '\',\'' + item.نامکسبوکار + '\',\'' + item.hash + '\',\'' + item.ssoLink + '\')">جزئیات پرونده</a>';
                html += '<a class="btnTax ' + disable + '" href="/Page/ShowDocumentsDetails/' + item.tprID + '">جزئیات پرونده</a>';
                //html += '<a class="btnTax btnPay" onclick="DetailsDoc(\'' + item.tprID + '\',\'' + item.hash + '\',\'' + item.ssoLink + '\')">جزئیات پرونده</a>';
                //html += ' | '
                //if (disable == 'disable')
                //    html += '<a class="btnTax btnPay" onclick="EnabledOrDisabled(\'' + item.tprID + '\',1,\'' + item.سمت + '\',\'' + item.نامکسبوکار + '\')">فعال سازی</a>';
                //else
                //    html += '<a class="btnTax btnPay" onclick="EnabledOrDisabled(\'' + item.tprID + '\',0,\'' + item.سمت + '\',\'' + item.نامکسبوکار + '\')">غیرفعال سازی</a>';
                html += '</div>';
                html += ' <div class="btnBg btnLink btnForce ">';
                if (item.tprType == 1) {
                    html = html.replace('##', '')
                    //html += '<a class="btnTax btnForce" onclick="ssoNTR(\'' + item.tprID + '\')" target="_blank">ارسال اظهارنامه عملکرد و یا تبصره ماده 100</a>';
                }
                //else
                //html = html.replace('##', 'btnTop42')

                html += '</div>';
                html += '</div>';
                html += '</div>';
            });
            $('.documents').html(html);
        },
        error: function (errormessage) {
            loadDocTax()
        }
    });
}

