function agent() {
    var jc = $.confirm({
        title: 'ثبت تفویض اختیار جدید',
        rtl: true,
        draggable: false,
        content: 'url:/Page/AddAgent/',
        columnClass: 'col-md-8 col-md-offset-1',
        onContentReady: function () {
            self = this;
            if ($('#DDLTaxSource option').length == 1) {
                $.alert({ title: '', columnClass: 'col-md-4 col-md-offset-3', type: 'red', buttons: { ok: { text: 'بستن', action: function () { jc.close(); } } }, content: ('امکان تفویض اختیار هم اکنون برای شما فعال نمی باشد.'), rtl: true });
            }
        },
        buttons: {
            add: {
                text: 'تایید اطلاعات و درخواست',
                btnClass: 'btnTax btn-conf',
                action: function () {
                    if (self.$content.find('#DDLTaxSource').val() == '0') {
                        $.alert({
                            title: '',
                            columnClass: 'col-md-4 col-md-offset-3',
                            type: 'red',
                            buttons: { ok: { text: 'بستن' } },
                            content: 'لطفا سامانه مرتبط با تفویض اختیار را انتخاب نمایید.',
                            rtl: true
                        });
                        return false
                    }
                    else if (self.$content.find('#DDLTaxSource').val() != '1' && self.$content.find('#DDLTaxSource').val() != '7' &&
                        self.$content.find('#DDLTaxSource').val() != '8' && self.$content.find('#DDLTaxRegister').val() == "0") {
                        $.alert({
                            title: '',
                            columnClass: 'col-md-4 col-md-offset-3',
                            type: 'red',
                            buttons: { ok: { text: 'بستن' } },
                            content: 'لطفا پرونده الکترونیک خود را انتخاب نمایید.',
                            rtl: true
                        });
                        return false
                    }
                    else if (self.$content.find('#NationalId').val() == '') {
                        $.alert({
                            title: '',
                            columnClass: 'col-md-4 col-md-offset-3',
                            type: 'red',
                            buttons: { ok: { text: 'بستن' } },
                            content: 'لطفا کد ملی شخصی تفویض اختیار را وارد نمایید.',
                            rtl: true
                        });
                        return false
                    }
                    else if (self.$content.find('#ExpiryDate').val() == '') {
                        $.alert({
                            title: '',
                            columnClass: 'col-md-4 col-md-offset-3',
                            type: 'red',
                            buttons: { ok: { text: 'بستن' } },
                            content: 'لطفا تاریخ انتضاء را وارد نمایید.',
                            rtl: true
                        });
                        return false
                    }
                    $.ajax({
                        type: "POST",
                        url: "/Page/SetAgent",
                        data: {
                            TaxSource: self.$content.find('#DDLTaxSource').val(),
                            NationalId: self.$content.find('#NationalId').val(),
                            ExpiryDate: self.$content.find('#ExpiryDate').val(),
                            TaxRegister: self.$content.find('#DDLTaxRegister').val(),
                            TaxRegisterBranch: self.$content.find('#DDLTaxRegisterBranch').val()
                        },
                        success: function (res) {
                            if (res.status) {
                                jc.close()
                                addCode(res.msg, res.id);
                            }
                            else
                                $.alert({ title: '', columnClass: 'col-md-4 col-md-offset-3', type: 'red', buttons: { ok: { text: 'بستن', action: function () { } } }, content: (res.msg), rtl: true });
                        },
                        error: function (response) {
                            $.alert({ title: '', columnClass: 'col-md-6 col-md-offset-2', type: 'red', buttons: { ok: { text: 'بستن', action: function () { } } }, content: ('خطا در ارسال درخواست.'), rtl: true });
                        }
                    });
                    return false
                }
            },
            cancel: {
                text: 'انصراف',
                btnClass: 'btn-cancel',
                action: function () {

                }
            }
        }
    });
}

