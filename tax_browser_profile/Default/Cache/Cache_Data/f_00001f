/*----------------------------------- Slider*/
#time-range p {
    /*  font-family: "Arial", sans-serif;*/
    font-size: 14px;
    color: #333;
}

.ui-slider-horizontal {
    height: 10px;
    background: #f9f9f9;
    border: 1px solid #c3c4c5;
    box-shadow: 0 1px 0 #efefef, 0 1px 0 #f9f9f9 inset;
    clear: both;
}

.ui-slider {
    position: relative;
    text-align: left;
}

.ui-slider-horizontal .ui-slider-range {
    top: -1px;
    height: 100%;
}

.ui-slider .ui-slider-range {
    position: absolute;
    z-index: 1;
    height: 10px;
    font-size: .7em;
    display: block;
    border: 1px solid #f9ba48;
    box-shadow: 0 1px 0 #f9ba48 inset;
    -moz-border-radius: 6px;
    -webkit-border-radius: 6px;
    -khtml-border-radius: 6px;
    border-radius: 6px;
    background: #f9ba48;
    /*    background-image: url(data:image/svg+xml;base64,PD94bWwgdmVyc2lvbj0iMS4wIiBlbmNvZGluZz0idXRmLTgi…pZHRoPSIxMDAlIiBoZWlnaHQ9IjEwMCUiIGZpbGw9InVybCgjZ3JhZCkiIC8+PC9zdmc+IA==);*/
    background-size: 100%;
    background-image: -webkit-gradient(linear, 50% 0, 50% 100%, color-stop(0%, #f9ba48), color-stop(100%, #f9ba48));
    background-image: -webkit-linear-gradient(top, #f9ba48, #f9ba48);
    background-image: -moz-linear-gradient(top, #f9ba48, #f9ba48);
    background-image: -o-linear-gradient(top, #f9ba48, #f9ba48);
    background-image: linear-gradient(top, #f9ba48, #f9ba48);
}

.ui-slider .ui-slider-handle {
    border-radius: 50%;
    background: #575d65;
    /*    background-image: url(data:image/svg+xml;base64,PD94bWwgdmVyc2lvbj0iMS4wIiBlbmNvZGluZz0idXRmLTgi…pZHRoPSIxMDAlIiBoZWlnaHQ9IjEwMCUiIGZpbGw9InVybCgjZ3JhZCkiIC8+PC9zdmc+IA==);*/
    background-size: 100%;
    background-image: -webkit-gradient(linear, 50% 0, 50% 100%, color-stop(0%, #575d65), color-stop(100%, #575d65));
    background-image: -webkit-linear-gradient(top, #575d65, #575d65);
    background-image: -moz-linear-gradient(top, #C7CED6, #F9FBFA);
    background-image: -o-linear-gradient(top, #C7CED6, #F9FBFA);
    background-image: linear-gradient(top, #C7CED6, #F9FBFA);
    width: 22px;
    height: 22px;
    -webkit-box-shadow: 0 2px 3px -1px rgb(87, 93, 101), 0 -1px 0 1px rgb(87, 93, 101) inset, 0 1px 0 1px rgb(87, 93, 101) inset;
    -moz-box-shadow: 0 2px 3px -1px rgba(0, 0, 0, 0.6), 0 -1px 0 1px rgba(0, 0, 0, 0.15) inset, 0 1px 0 1px rgba(255, 255, 255, 0.9) inset;
    box-shadow: 0 2px 3px -1px rgb(87, 93, 101), 0 -1px 0 1px rgb(87, 93, 101) inset, 0 1px 0 1px rgb(87, 93, 101) inset;
    -webkit-transition: box-shadow .3s;
    -moz-transition: box-shadow .3s;
    -o-transition: box-shadow .3s;
    transition: box-shadow .3s;
}

.ui-slider .ui-slider-handle {
    position: absolute;
    z-index: 2;
    width: 22px;
    height: 22px;
    cursor: default;
    border: none;
    cursor: pointer;
}

    .ui-slider .ui-slider-handle:after {
        content: "";
        position: absolute;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        top: 50%;
        margin-top: -4px;
        left: 50%;
        margin-left: -4px;
        background: #575d65;
        -webkit-box-shadow: 0 1px 1px 1px rgb(87, 93, 101) inset, 0 1px 0 0 #575d65;
        -moz-box-shadow: 0 1px 1px 1px rgba(22, 73, 163, 0.7) inset, 0 1px 0 0 white;
        box-shadow: 0 1px 1px 1px rgb(87, 93, 101) inset, 0 1px 0 0 #575d65;
    }

.ui-slider-horizontal .ui-slider-handle {
    top: -.5em;
    margin-left: -.6em;
}

.ui-slider a:focus {
    outline: none;
}

