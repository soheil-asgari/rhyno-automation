    }

    .boxFilter input {
        width: 100%;
        height: 35px;
        border: solid 1px #e6e6e6;
        background: #fdfdfd;
        padding: 0 10px;
        padding-right: 35px;
    }

        .boxFilter input:not(.border-1):not(.border-2):not(.border-3):focus {
            border-color: #e6e6e6;
        }

        .boxFilter input:focus {
            outline: 0;
            box-shadow: 0 0 0 0 transparent, 0 0 0 0 transparent;
        }

    .boxFilter .search, .boxFilter .price {
        position: relative;
    }

    .boxFilter .search {
        margin-bottom: 15px;
    }


    .boxFilter .fa {
        position: absolute;
        top: 7px;
        right: 10px;
        color: #d6d6d6;
    }

    .boxFilter label {
        margin-bottom: -5px;
        color: #6b7177;
        font-weight: 300;
    }

    .boxFilter .price .fa {
        bottom: 9px;
        top: unset;
    }
