.topHead {
    border-bottom: 1px solid #000000;
    height: 100px;
    width: 100%;
    background-image: url(/img/grey-blocks_backs.png);
    color: #FFFFFF;
    text-align: right;
    position: fixed;
    z-index: 100;
}

    .topHead img {
        position: absolute;
        top: 0;
    }

    .topHead .PRtopHead {
        width: 280px;
        float: right;
        height: 45px;
    }

    .topHead .name {
        width: auto;
        float: left;
        background: rgb(0,0,0);
        background: linear-gradient(90deg, rgba(0,0,0,0.8463760504201681) 0%, rgba(183,185,172,0) 60%);
        height: 100%;
        margin-top: -5px;
    }

        .topHead .name span {
            padding: 0 25px;
            padding-left: 45px;
            color: #f7f7f9;
            margin-top: 10px;
            display: inline-block;
        }

        .topHead .name a:hover {
            color: #464f58;
            text-decoration: none;
        }

    .topHead .exit {
        position: absolute;
        top: 15px;
        left: 10px;
        cursor: pointer;
        z-index: 100;
    }

    .topHead .line {
        height: 30px;
        width: 1px;
        border-right: dashed 2px #8f7d5b;
        padding: 0 !important;
        margin: 6px 15px;
    }

    .topHead .infoOther {
        float: right;
        padding: 12px 15px;
        color: #efeaea;
    }

        .topHead .infoOther span {
            margin: 0 5px;
        }

