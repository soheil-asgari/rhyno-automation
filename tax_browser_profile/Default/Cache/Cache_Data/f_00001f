.Media {
    position: relative;
    background: #fff;
    border-radius: 5px;
    box-shadow: 0 1px 2px rgba(0,0,0,.05);
    overflow: auto;
    margin-bottom: 25px;
    border: solid 1px #ececec;
    border-top: solid 5px #ececec;
}

    .Media .main {
        contain: content;
    }

        .Media .main hr {
            border: 0;
            height: 1px;
            background-image: linear-gradient(to right, rgb(255 255 255), rgb(179 179 179), rgb(255 255 255));
            margin: 2px 15px;
        }

        .Media .main img {
            width: 60px;
            float: right;
            border: solid 2px #dadada;
            border-radius: 50%;
            margin-right: 5px;
            margin-top: 2px;
        }

        .Media .main .name {
            text-align: center;
            line-height: 15px;
            padding-top: 17px;
            height: 65px;
            background: #ececec;
        }

            .Media .main .name span {
                display: block;
            }

                .Media .main .name span:first-child {
                    font-weight: 600;
                    margin-bottom: 5px;
                }

        .Media .main .data {
            contain: content;
            text-align: center;
        }

            .Media .main .data .main .type {
                color: #636363;
            }

            .Media .main .data .main .value {
                color: #ff6a00;
                margin-right: 3px;
            }

            .Media .main .data .main {
                font-size: 12px;
                padding: 1px;
                margin-left: 3%;
                text-align: center;
            }


        .Media .main .category span {
            font-size: 12px;
            float: right;
            padding: 2px 5px;
            margin-left: 3%;
            text-align: center;
            background: #f3f3f3;
            line-height: 20px;
            border-radius: 5px;
            margin: 5px;
        }

            .Media .main .category span:first-child {
                margin-right: 3%;
            }

    .Media .buy {
        background: #d4e8f0;
        margin-top: 2px;
        padding: 3px 10px;
    }

        .Media .buy .oldPrice {
            font-size: 12px;
            margin-right: 5px;
            color: #fd8586;
            text-decoration: line-through;
        }

        .Media .buy .btnBuy {
            float: left;
            border: solid 1px #7d8286;
            line-height: 28px;
            padding: 0 10px;
            border-radius: 5px;
            margin-top: 3px;
            position: relative;
            padding-right: 35px;
            transition: color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;
        }

            .Media .buy .btnBuy:hover {
                background-color: #313d44;
                color: #fff;
                cursor: pointer;
            }

                .Media .buy .btnBuy:hover i {
                    color: #55b95c;
                }

            .Media .buy .btnBuy i {
                position: absolute;
                right: 10px;
                top: 5px;
            }

                .Media .buy .btnBuy i:before {
                    font-size: 16px;
                }

    .Media .Spcial {
        writing-mode: vertical-rl;
        text-orientation: mixed;
        position: absolute;
        background: #FF9800;
        left: 0;
        top: 0;
        height: 60px;
        width: 15px;
        font-size: 10px;
    }
/*------------------------- End SaleReportage*/
/*-------------------- Loading*/
.spinner {
    width: 25px;
    height: 25px;
    margin: 8px auto;
    background-color: #333;
    border-radius: 100%;
    -webkit-animation: sk-scaleout 1.0s infinite ease-in-out;
    animation: sk-scaleout 1.0s infinite ease-in-out;
}


.btnConfirm {
    position: fixed;
    left: 15px;
    top: 113px;
    z-index: 100;
    background: #8bc34a;
    color: #fff;
    padding: 0 35px;
    border-radius: 5px;
    height: 28px;
    line-height: 26px;
    -webkit-box-shadow: 1px 1px 3px 0px #c6cbd3;
    box-shadow: 1px 1px 3px 0px #c6cbd3;
    cursor: pointer;
    text-decoration:none;
}
@-webkit-keyframes sk-scaleout {
    0% {
        -webkit-transform: scale(0)
    }

    100% {
        -webkit-transform: scale(1.0);
        opacity: 0;
    }
}

@keyframes sk-scaleout {
    0% {
        -webkit-transform: scale(0);
        transform: scale(0);
    }

    100% {
        -webkit-transform: scale(1.0);
        transform: scale(1.0);
        opacity: 0;
    }
}
/*--------------------------- legend Loading*/
/*--------------------------- Box filter media*/
.sticky {
    position: sticky;
    top: 100px;
}

.boxFilter {
    background: #fff;
    height: 450px;
    border: solid 1px #e8e8e8;
    box-shadow: 0 1px 2px rgba(0,0,0,.05);
    position: sticky;
    top: 100px;
}

    .boxFilter .lblheader {
        background: #f7f7f7;
        text-align: center;
        padding: 5px;
        border-bottom: solid 1px #e8e8e8;
    }

    .boxFilter .main {
