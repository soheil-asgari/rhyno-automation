                            <label for="sign-up" class="tabLabel">دریافت اطلاعات کاربری</label>
                            <label for="reset" class="tabLabel">فراموشی کلمه عبور</label>
                            <label for="change" class="tabLabel">تغییر شماره همراه</label>

                            <input class="sign-in sign-up reset change" type="text" name="nationalcode" id="nationalcode" value="10861156384032" placeholder="شماره ملی/شناسه ملی/شماره فیدا" />
                            <input data-jdp data-jdp-min-date="1300/01/01" data-jdp-max-date="today" class="sign-up hideTimer" type="text" id="BirthDate" name="BirthDate" placeholder="تاریخ تولد 1364/01/01" autocomplete="off" />
                            <select class="sign-up" name="contacttype" id="contacttype" style="direction: rtl;font-size: 14px;">
