    <script>
        function ShowPassword() {
            var type = $("#pass")[0].type;
            var toggleType = 'password';
            var icon = 'fa-eye-slash';
            if (type == 'password') { 
                toggleType = 'text';
                icon = 'fa-eye';
            }
            $("#pass")[0].type = toggleType;
            $("#eyePass").removeClass('fa-eye-slash').addClass(icon)
        }
    </script>
    <script>
        function showAlert(title, text, typeColor) {
            $.alert({
                title: '',
                columnClass: 'col-md-6 col-md-offset-3',
                type: typeColor,
                content: ('<div style="padding-left:1%;padding-right:2%;"><span style="font-size:15px;font-weight:bold;color:#1e6a28;">' + title + '</span>' + '<br/>' + '<span style="font-size:14px;font-weight:bold;line-height: 0px;">' + text + '</span></div>'),
                buttons: { cancel: { text: 'بستن', action: function () { } } },
                rtl: true
            });
        }
        $('[name="nationalcode"]').focus();
        $(document).on('keydown', ':tabbable', function (e) {
            if (e.which == 13 || e.keyCode == 13) {
                console.log(document.activeElement)
                if ($(this).attr('name') == 'nationalcode' | $(this).attr('name') == 'pass') {
                    e.preventDefault();
                    var $canfocus = $(':tabbable:visible')
                    var index = $canfocus.index(document.activeElement) + 1;
                    if ($(this).attr('name') == 'pass')
                        index = $canfocus.index(document.activeElement) + 1;
                    if (index >= $canfocus.length) index = 0;
                    $canfocus.eq(index).focus();
                }
            }
        });
        $('form').submit(function () {
            $('#submit').prop("disabled", "disabled");
        });
        function changeNationalCodePlaceholder() {
            if (document.getElementById('change').checked || (document.getElementById('sign-up').checked))// && $("#contacttype").val() != '2'
                $("[name='mobile']").css('display', 'block');
            else
                $("[name='mobile']").css('display', 'none');

            if (document.getElementById('change').checked)
                $("[name='nationalcode']")[0].placeholder = 'شماره ملی/شماره فیدا';
                else
                $("[name='nationalcode']")[0].placeholder = 'شماره ملی/شناسه ملی/شماره فیدا';

            if(!document.getElementById('sign-up').checked)  $("[name='mobile']")[0].placeholder='شماره همراه'
            else if($("#contacttype").val()=="2") {
                $("[name='mobile']")[0].placeholder='شماره پستی';
                $("[id='sign-up']:checked ~ .button").attr('data-text','ادامه عملیات');
            }
            if (document.getElementById('sign-up').checked) {               
                $("#BirthDate").attr('style', 'display: inline-block !important');
                $("#contacttype").attr('style', 'display: inline-block !important');
                var contacttype = $("#contacttype").val();
                if (contacttype == 0) {
                    $("#BirthDate").css('visibility', 'visible');
                } else {
                    $("#BirthDate").css('visibility', 'hidden');
                }
            } else {
                $("#BirthDate").attr('style', 'display: none !important');
                $("#contacttype").attr('style', 'display: none !important');
            }
            if (document.getElementById('sign-in').checked) {
                $("#eyePass").attr('style', 'display:inline-block;');
            } else {
                $("#eyePass").attr('style', 'display:none;');
            }

        }
    </script>
    <script>
        $("#contacttype").on("change", function () {
            $("[name='mobile']").css('display', 'block');
            $("[name='mobile']")[0].placeholder='شماره همراه'
             $("[id='sign-up']:checked ~ .button").attr('data-text','دریافت اطلاعات کاربری');
            if ($(this).val() == 0) {
                $("#BirthDate").css('visibility', 'visible');
            } else {
                $("#BirthDate").css('visibility', 'hidden');
            }
            if ($(this).val() == 2) {
               //$("[name='mobile']").css('display', 'none');
               $("[name='mobile']")[0].placeholder='شماره پستی';
               $("[id='sign-up']:checked ~ .button").attr('data-text','ادامه عملیات');

            }
        });
        $(document).on('ready', function () {
            if (performance.navigation.type == 2) {
                $("#sign-in").checked = true;
            }

            changeNationalCodePlaceholder();
        });
        jalaliDatepicker.startWatch({
            minDate: "attr",
            maxDate: "attr"
        });
    </script>
