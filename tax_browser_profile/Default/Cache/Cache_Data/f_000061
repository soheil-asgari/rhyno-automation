                            <input type="radio" value="sign-up" name="rg" id="sign-up"  onchange="changeNationalCodePlaceholder()" />
                            <input type="radio" value="reset" name="rg" id="reset"  onchange="changeNationalCodePlaceholder()" />
                            <input type="radio" value="change" name="rg" id="change"  onchange="changeNationalCodePlaceholder()" />
