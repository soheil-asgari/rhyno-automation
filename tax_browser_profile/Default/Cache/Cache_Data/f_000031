        function loadNews() {
            $.ajax({
                url: "/Page/LastNews",
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    var html = '<ul>';
                    var odd = 'odd';
                    $.each(result, function (key, item) {
                        if (odd == 'odd') odd = ''; else odd = 'odd';
                        html += '<li class="blockNews ' + odd + '">';
                        html += '<a href="' + item.url + '" target="_blank">';
                        html += '<span><i>&#8226;</i> ' + item.title + '</span>: ';
                        //html += '<span class="date">' + item.datefa + '</span>';
                        html += '</a></li>';
                    });

                    $('.bodyNews').html(html).persiaNumber();
                },
                error: function (errormessage) {
                    $.alert({ title: '', columnClass: 'col-md-6 col-md-offset-2', type: 'red', buttons: { ok: { text: 'بستن', action: function () {  } } }, content: ('خطا در ارسال درخواست.'), rtl: true });
                }
            });
        }
        function CheckExitBan(pop) {
            $.ajax({
                url: "/Page/CheckExitBan",
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (pop) {
                        if (result.exitBan)
                            $.alert({
                                title: '',
                                columnClass: 'col-md-10 col-md-offset-0',
                                type: 'red',
                                buttons:
                                {
                                    ok: { text: 'بستن' },
                                    view: {
                                        text: 'نمایش بدهی',
                                        action: function () {
                                            window.location = "https://186.tax.gov.ir/Debits/List"
                                        }
                                    }
                                },
                                content: (result.exitBanMessage),
                                rtl: true
                            });
                        else
                            $.alert({ title: '', columnClass: 'col-md-10 col-md-offset-0', type: 'dark', buttons: { ok: { text: 'بستن' } }, content: (result.exitBanMessage), rtl: true });
                    }
                    else {
                        $('.Ban .spinner').remove();
                        if (result.exitBan) {
                            $('.Ban').addClass("ExitBan")
                            $('.Ban').text(result.exitBanMessage).persiaNumber();
                        } else
                            $('.Ban').remove();
                    }
                },
                error: function (errormessage) {
                    $('.Ban .spinner').remove();
                    $('.Ban').remove();
                }
            });
        }


