        function InquiryT100(followCode)
        {
            $.ajax({
                url: "/Page/InquiryT100/?followCode="+followCode,
                type: "POST",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result !="[]"){           

                            if (result.isLoaded==1 && (result.mashmooliatDossier==1 || result.mashmooliatDossier==5 || result.mashmooliatDossier==6)){
                                $('#T100_'+followCode).html('<a onclick="ssoNTR(\''+followCode+'\', true)" class="btnT100" style="background: #11ae11;color: #0a2817">ارسال تبصره 100</a>')
                            }
                            else if (result.isLoaded==1 && (result.mashmooliatDossier==2 || result.mashmooliatDossier==3 || result.mashmooliatDossier==4 || result.mashmooliatDossier==7)){
                                $('#T100_'+followCode).html('<a onclick="ssoNTR(\''+followCode+'\', true)" class="btnT100" style="background: #11ae11;color: #0a2817">ارسال اظهارنامه پیش فرض</a>')
                            }else{
                                // $('#T100_'+followCode).html('<a onclick="ssoNTR(\''+followCode+'\')" class="btnT100">ارسال اظهارنامه</a>')
                                $('#T100_'+followCode).html('<a class="btnT100"  data-cooltipz-dir="top-right" aria-label="' +result.msg+ '" style="background:#acaeac;color:#5a5b5a;font-size:10px;">عدم بارگذاری</a>')
                            }
               
                    }                    
                },
                error: function (errormessage) {
                     InquiryT100(followCode)
                }
            });
        }
        
